<?xml version="1.0" encoding="UTF-8"?>
<!-- hc-sweep 5분마다(예시 — 깔지 않는다. 쓰는 법은 docs/hc-launchd-guard/guard.md). 지킴이가 Herdr 터미널 hc-sweep에서 돌린다.
     앞 판이 아직 돌면 건너뛴다. 기록 ~/Library/Logs/hc-sweep.log
     sh -c는 $HOME을 펼치려고만 쓴다(launchd는 ProgramArguments를 펼치지 않는다). 지킴이·hc-sweep은 Go 바이너리다 —
     옛 plist(python3 …/hc-sweep)도 지킴이가 해석기를 빼고 돌린다 -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.herdr-tools.hc-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" exec "$HOME/.local/bin/hc-launchd-guard" --log "$HOME/Library/Logs/hc-sweep.log" hc-sweep -- hc-sweep</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
</dict>
</plist>
