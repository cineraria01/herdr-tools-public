<?xml version="1.0" encoding="UTF-8"?>
<!-- hc-sweep 5분마다(예시 — 깔지 않는다. 쓰는 법은 README 「launchd 작업」). 지킴이가 Herdr 터미널 hc-sweep에서 돌린다.
     앞 판이 아직 돌면 건너뛴다. 기록 ~/Library/Logs/hc-sweep.log -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.herdr-tools.hc-sweep</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin" exec "$HOME/.local/bin/hc-launchd-guard" --log "$HOME/Library/Logs/hc-sweep.log" hc-sweep -- python3 "$HOME/.local/bin/hc-sweep"</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
</dict>
</plist>
