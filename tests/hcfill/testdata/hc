#!/bin/bash
case $1 in
  ls) [ -z "${HC_FAKE_LS_FAIL-}" ] || exit 3
      [ -z "${HC_FAKE_LS_SLOW-}" ] || { echo $$ >"$T_LOG/ls-slow.pid"; exec sleep "$HC_FAKE_LS_SLOW"; }   # LS_SLOW: 초만큼 답하지 않음(pid는 ls-slow.pid)
      case " $* " in *" --label hc-lane=1 "*) e='{"terminals":[]}'; printf '%s\n' "${HC_FAKE_LS_LANE:-$e}"; exit "${HC_FAKE_LABEL_RC:-0}" ;; esac
      printf '%s\n' "${HC_FAKE_LS:-{\"terminals\":[]\}}" ;;
  machine) printf '%s\n' "$HC_FAKE_MACHINES" ;;
  get) case " ${HC_FAKE_GONE-} " in *" $2 "*) echo '{"error":{"kind":"not_found"}}'; exit 3 ;; esac
       case " ${HC_FAKE_GET_BAD-} " in *" $2 "*) echo "{\"address\":\"$2\",\"created_ms\":1700000000000,\"status\":{\"state\":\"working\"}}"; echo '{"addr'; exit 3 ;; esac   # 앞 객체는 멀쩡, 뒤가 잘리고 실패 종료
       case " ${HC_FAKE_FINISHED-} " in *" $2 "*) echo "{\"address\":\"$2\",\"state\":\"finished\",\"status\":null}"; exit 0 ;; esac
       # 실행 키: created_ms는 $HC_FAKE_CREATED(「<주소>=<ms>」 공백 목록)에 있으면 그 값, 없으면 1700000000000. name은 주소 끝 낱말
       c=1700000000000; for x in ${HC_FAKE_CREATED-}; do case $x in "$2="*) c=${x#*=} ;; esac; done
       # NOSTATUSKEY: status 칸 자체가 없는 부분 응답(null과 다르다 — 재감사2 fill/R-201)
       case " ${HC_FAKE_NOSTATUSKEY-} " in *" $2 "*) echo "{\"address\":\"$2\",\"created_ms\":$c,\"cwd\":\"/\",\"name\":\"${2##*/}\",\"state\":\"live\"}"; exit 0 ;; esac
       case " ${HC_FAKE_NOSTATUS-} " in
         *" $2 "*) echo "{\"address\":\"$2\",\"created_ms\":$c,\"cwd\":\"/\",\"name\":\"${2##*/}\",\"state\":\"live\",\"status\":null}" ;;
         *) echo "{\"address\":\"$2\",\"created_ms\":$c,\"cwd\":\"/\",\"name\":\"${HC_FAKE_GET_NAME:-${2##*/}}\",\"state\":\"live\",\"status\":{\"app\":\"claude-code\",\"state\":\"working\"}}" ;;
       esac ;;
  exec) echo "$*" >>"$T_LOG/hc.log"; case "$*" in *"${HC_FAKE_EXEC_FAIL:-@@없음@@}"*) exit 255 ;; esac
        case "$*" in *"${HC_FAKE_EXEC_NO:-@@없음@@}"*) echo no; exit 255 ;; esac   # EXEC_NO: 「no」를 찍고 실패 종료(출력은 믿으면 안 됨)
        while [ "$1" != -- ]; do [ "$1" = --on ] && export HC_FAKE_ON="$2"; shift; done; shift; exec "$@" ;;   # HC_FAKE_ON: 가짜 hc-lane이 그 기계 몫을 고른다
  send) echo "$*" >>"$T_LOG/send.log"; case " ${HC_FAKE_SEND_FAIL-} " in *" $2 "*) exit 1 ;; esac ;;   # 실패시킬 주소 목록
  *) echo "$*" >>"$T_LOG/hc.log" ;;
esac
