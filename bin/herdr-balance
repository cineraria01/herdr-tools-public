#!/usr/bin/env python3
"""Herdr 탭의 오른쪽 worker 열을 고른 높이로 다시 붙인다.

herdr-balance --main <지휘 터미널> [--add tX ...] [--drop tX ...]   한 탭을 지금 맞춤
herdr-balance --watch                                              자동 맞춤(launchd)

- worker = 지휘 터미널과 같은 탭에서 이름(hc --name)이 붙은 다른 터미널 + --add.
  이름 없는 터미널(하단 HUD 등)은 건드리지 않는다.
- worker를 terminal.park로 화면에서만 뗐다가(프로세스 유지) 반씩 나누는 순서로
  terminal.keep 해서, 높이가 최대 2배 차이 안으로 고르게 된다(2^k개면 똑같음).
  ponytail: Herdr에 분할 비율 API가 없어 이분 분할로 근사, 비율 API가 생기면 그걸로.
- 위→아래 순서는 지금 순서를 지키고 --add는 맨 아래에 붙는다.
- 끝나면 맞추기 전에 보던 터미널로 포커스를 되돌린다.
- --watch: 2초마다 화면을 보고, 이 기계 탭과 설정 balance.remote(빈칸으로 나눈 원격 탭 이름 앞부분,
  예 `w1/ w2/`, 없으면 원격 탭은 맞추지 않음 — herdr-tools-config) 탭 가운데 첫 터미널이 에이전트(지휘)이고 이름 붙은
  worker 목록이 바뀌어 4초 동안 그대로면 그 탭을 맞춘다. 마지막으로 맞춘 목록은
  ~/.local/state/herdr-balance/<탭>.json에 남겨 같은 목록이면 다시 하지 않는다.
"""
import argparse, json, os, shutil, subprocess, sys, time

STATE = os.path.expanduser("~/.local/state/herdr-balance")


def remote_prefixes():
    """balance.remote: 이 창에서 맞춰 줄 다른 기계 탭 이름 앞부분. 나머지 원격 탭은 건드리지 않는다.
    launchd PATH에는 ~/.local/bin이 없을 수 있어 거기도 본다. 못 읽거나 설정 파일이 없으면 빈 목록 + 경고 한 줄
    (키만 없으면 조용히 빈 목록)."""
    cmd = shutil.which("herdr-tools-config") or os.path.expanduser("~/.local/bin/herdr-tools-config")
    try:
        out = subprocess.run([cmd, "get", "balance.remote", ""], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as e:
        print(f"herdr-balance: herdr-tools-config 못 부름({e}) — 원격 탭은 맞추지 않음", file=sys.stderr)
        return ()
    if out.returncode != 0:
        print(f"herdr-balance: balance.remote 못 읽음({out.stderr.strip()}) — 원격 탭은 맞추지 않음", file=sys.stderr)
        return ()
    remote = tuple(out.stdout.split())
    if not remote and subprocess.run([cmd, "file", "config"], capture_output=True, timeout=10).returncode != 0:
        print("herdr-balance: 설정 파일 없음(herdr-tools-config file config) — 원격 탭은 맞추지 않음", file=sys.stderr)
    return remote


class Fail(Exception):
    pass


def app(*args):
    out = subprocess.run(["herdr-app", *args], capture_output=True, text=True)
    if out.returncode != 0:
        raise Fail(f"herdr-app {' '.join(args)} 실패: {out.stdout}{out.stderr}")
    return json.loads(out.stdout) if out.stdout.strip().startswith("{") else out.stdout


def tabs():
    for s in app("ls")["spaces"]:
        for t in s["tabs"]:
            yield t


def where(term):
    for t in tabs():
        for x in t["terminals"]:
            if x["terminal"] == term:
                return t, x
    return None, None


def wait_for(cond, what, timeout=10):
    end = time.time() + timeout
    while time.time() < end:
        if cond():
            return
        time.sleep(0.2)
    raise Fail(f"시간 초과: {what}")


def do(cmd, **kw):
    r = app("do", cmd, json.dumps(kw))
    if isinstance(r, dict) and r.get("error"):
        raise Fail(f"{cmd} 실패: {r['error']}")


def workers_of(tab, main):
    return [x["terminal"] for x in tab["terminals"] if x["terminal"] != main and x["name"]]


def save(tab_id, workers):
    os.makedirs(STATE, exist_ok=True)
    with open(f"{STATE}/{tab_id.replace('/', '__')}.json", "w") as f:
        json.dump(workers, f)


def saved(tab_id):
    try:
        with open(f"{STATE}/{tab_id.replace('/', '__')}.json") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def balance(main, add=(), drop=()):
    tab, m = where(main)
    if not tab:
        raise Fail(f"{main}이(가) 화면의 어느 탭에도 없음")
    tab_id, main_pane = tab["id"], m["pane"]
    workers = [w for w in workers_of(tab, main) if w not in drop]
    workers += [t for t in add if t not in workers]

    # 맞춘 뒤 돌아갈 곳: 지금 포커스된 pane의 터미널(pane id는 park/keep 뒤 바뀐다)
    fp = app("status").get("focused_pane")
    back = next((x["terminal"] for t in tabs() for x in t["terminals"] if x["pane"] == fp), None)

    for w in list(workers) + list(drop):
        if where(w)[0]:
            do("terminal.park", terminal=w)
            wait_for(lambda w=w: where(w)[0] is None, f"{w} park")

    def keep(term, anchor_pane, place):
        do("pane.focus", pane=anchor_pane)
        do("terminal.keep", terminal=term, place=place)
        wait_for(lambda: where(term)[0] and where(term)[0]["id"] == tab_id, f"{term} keep")
        return where(term)[1]["pane"]

    def build(group, pane):
        # group[0]은 이미 pane에 있다. 아래 절반을 group[0] 바로 밑에 붙이고 양쪽을 다시 나눈다.
        if len(group) < 2:
            return
        mid = len(group) // 2
        lower = keep(group[mid], pane, "down")
        build(group[:mid], pane)
        build(group[mid:], lower)

    try:
        if workers:
            build(workers, keep(workers[0], main_pane, "right"))
    finally:
        if back and where(back)[0]:
            do("pane.focus", terminal=back)
    save(tab_id, workers)
    return {"tab": tab_id, "main": main, "workers": workers}


def watch():
    remote = remote_prefixes()
    seen = {}  # tab id -> (workers, 처음 본 시각)
    last_err = None
    while True:
        time.sleep(2)
        try:
            for t in list(tabs()):
                tid = t["id"]
                if ("/" in tid and not tid.startswith(remote)) or not t["terminals"]:
                    continue
                main = t["terminals"][0]
                if not main["app"]:
                    continue  # 첫 터미널이 에이전트(지휘)인 탭만
                ws = workers_of(t, main["terminal"])
                last = saved(tid)
                if last is None:
                    save(tid, ws)  # 처음 보는 탭은 지금 배치를 기준으로 삼는다
                    continue
                if set(ws) == set(last):
                    seen.pop(tid, None)
                    continue
                prev = seen.get(tid)
                if not prev or set(prev[0]) != set(ws):
                    seen[tid] = (ws, time.time())
                    continue
                if time.time() - prev[1] < 4:
                    continue
                seen.pop(tid, None)
                r = balance(main["terminal"])
                print(time.strftime("%F %T"), "맞춤", json.dumps(r, ensure_ascii=False), flush=True)
            last_err = None
        except Fail as e:
            if str(e) != last_err:  # 창이 없거나 일시 오류: 같은 오류는 한 번만 남기고 다음 회차에 다시
                print(time.strftime("%F %T"), e, flush=True)
                last_err = str(e)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--main")
    ap.add_argument("--add", nargs="*", default=[])
    ap.add_argument("--drop", nargs="*", default=[])
    ap.add_argument("--watch", action="store_true")
    a = ap.parse_args()
    if a.watch:
        return watch()
    if not a.main:
        ap.error("--main 또는 --watch가 필요")
    try:
        print(json.dumps(balance(a.main, a.add, a.drop), ensure_ascii=False))
    except Fail as e:
        sys.exit(str(e))


if __name__ == "__main__":
    main()
