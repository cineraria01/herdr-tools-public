#!/bin/bash
# hc-lane: 커밋하는 레인을 자기 git 워크트리에서 hc run으로 띄우고, `hc-lane land`로 착지, `hc-lane clean`으로 정리한다
# (2026-11-04 사용자 결정, 합의안 2단계 G. clean은 2026-11-05 hc-lane-fix1. land·guard와 저장소 훅 이름 .claude/herdr-*.sh는
# 2026-11-16 사용자 결정 「wt-*.sh 는 완전 안쓰고 싶은대」 「새로운 방식으로 전체 적용해서 전체 같이 관리 되도록」 — 옛 이름 갈래 없음).
# 대기열·잠금·상태 파일·훅 없음. 의존은 git·hc뿐, 맥 /bin/bash 3.2에서 돈다.
# hc run은 호출자 환경을 넘기지 않아서 LANE_* 는 `env K=V <명령…>`으로 감싸 넘긴다.
set -u

die() { printf 'hc-lane: %s\n' "$*" >&2; [ "${cmd-}" != clean ] || cj stopped "$*"; exit 1; }
j() { printf %s "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
cj() {  # clean 결과 JSON 한 줄(앞에서 멈춰 아직 정하지 않은 값은 빈 값)
  printf '{"clean":"%s","reason":"%s","dry_run":%s,"on":"%s","repo":"%s","worktree":"%s","branch":"%s","base":"%s","teardown":"%s"}\n' \
    "$1" "$(j "${2-}")" "$([ "${dry-0}" = 1 ] && echo true || echo false)" "$(j "${on-}")" "$(j "${repo-}")" "$(j "${wt-}")" \
    "$(j "${branch-}")" "$(j "${base-}")" "${td-none}"
}
usage() {
  cat >&2 <<'EOF'
사용법: hc-lane [--on <기계>] [--read] [--branch <이름>] [--dry-run] [--print-steps] [--brief <지시문>]
               --name <레인> --repo <저장소 경로> [-- <실행 명령…>]
  기본          fetch → <저장소>.wt/<브랜치>에 origin/<기본> 기준 워크트리 → .claude/herdr-setup.sh(있으면) → hc run --bg
                원격 origin이 없는 저장소는 fetch 없이 로컬 <기본>(main, 없으면 master) 기준
  --read        워크트리 없이 저장소 폴더에서 띄운다(조사·감사처럼 커밋하지 않는 레인)
  --branch      브랜치 이름(기본: 레인 이름). 워크트리 폴더 이름은 브랜치의 / 를 - 로 바꾼 것
  --on          git·설정·실행을 그 기계에서(hc exec/run --on). --repo는 그 기계의 절대 경로(로컬 ~ 펼침 주의).
                설정 단계는 그 기계에 zsh·~/.zshrc가 있으면 그걸 읽고 돈다(hc 코어 PATH에 bun 등이 없다)
  --dry-run     만들지도 띄우지도 않고 할 일과 착지 절차만 출력
  --print-steps 레인 지시문에 붙일 착지·정리 절차만 출력(실행 명령 불필요)
  --brief       지시문에 착지·정리 절차(--read는 판정 알림)를 붙인 실행용 사본을 대상 기계에 두고, 실행 명령의 {brief}
                자리에 그 경로를 넣는다. 사본 자리: 설정 lane.brief_dir(그 기계 경로, ~ 는 그 기계 집)/<레인>-run.md,
                없으면 지시문과 같은 폴더의 <이름>-run.md. -- 뒤 명령이 없으면 설정 lane.run 틀(셸 문법)
  띄운 뒤       화면에 Claude 폴더 신뢰 질문(「❯ No, exit」·「Yes, I trust this folder」)이 보이면 그 터미널에만 신뢰를 고른다
                (설정 lane.auto_trust off면 안 함). 글자가 다르면 건드리지 않고 「모름 — 시작 화면 확인」.
                --start-wait <초>(이 호출만) 또는 설정 lane.start_wait초(기본 60, 0이면 이 단계를 끔. status를 내지 않는
                명령·CLI는 0으로) 안에 hc get status가 안 잡히면 화면 끝에서 막힘 낱말을 찾아
                한 줄로 알리고 종료 5 시작 안 됨(원인 모름·신뢰 질문·끝남), 6 로그인·인증 막힘, 7 키체인 막힘(터미널은 남긴다)
       hc-lane clean [--on <기계>] [--dry-run] --repo <저장소 경로> (--branch <브랜치> | --name <레인>)
  clean         착지한 레인의 워크트리·브랜치를 지운다: fetch 뒤 브랜치(와 워크트리 HEAD)가 origin/<기본>에
                들어갔는지 → 추적 변경·무시되지 않은 untracked가 없는지(등록이 지워지고 폴더만 남았으면 저장소
                .gitignore로) 확인하고, 하나라도 걸리면 아무것도 지우지 않고 멈춘다(종료 1) → .claude/herdr-teardown.sh
                (있으면, 실패해도 계속) → worktree remove → 남은 무시 파일 폴더 삭제 → branch -d
       hc-lane fetch [--on <기계>] --repo <저장소 경로> [<참조…>]
  fetch         그 기계 저장소에서 git fetch origin [<참조…>]. --on이면 hc exec로, zsh·~/.zshrc가 있으면 그걸 읽은 셸에서
                (맨 ssh·hc 코어 환경에는 git 자격 도우미 PATH가 없다). 종료 0 받음, 1 실패
레인 환경: HC_LANE LANE_REPO LANE_WORKTREE LANE_BRANCH LANE_BASE (--read는 HC_LANE LANE_REPO LANE_BASE). hc run 라벨 hc-lane=1
       hc-lane land [<기본 브랜치>]   (레인 작업 폴더 안에서)
  land          착지: .claude/herdr-land.sh가 있으면 HERDR_LAND=1 bash .claude/herdr-land.sh <기본>. 없으면
                fetch → rebase origin/<기본> → .claude/herdr-verify.sh(없으면 실패, push 안 함) →
                HERDR_LAND=1 git push origin HEAD:<기본>(fast-forward만, 거절이면 fetch부터 HERDR_LAND_TRIES번, 기본 5)
                origin이 없으면 fetch·push 대신 로컬 <기본> 기준으로 rebase하고, 메인 클론의 로컬 <기본>을 fast-forward로 올린다
                (<기본>이 체크아웃된 폴더면 그 폴더에서 merge --ff-only, 아니면 update-ref. 앞서 나갔으면 처음부터 다시)
                종료 0 착지, 1 검증 실패·검증 없음·push 실패·인자 오류, 3 rebase 충돌, 4 거절 횟수 넘음
       hc-lane gc [--on <기계>] [--dry-run] [--integ[=<접두>]] [--remote-branches] [--min-age <시간>] --repo <저장소 경로>
  gc            끝난 레인 정리: 연결된 작업 폴더마다 HEAD가 origin/<기본>에 다 들어갔고(조상이거나 git cherry에 + 없음)
                깨끗하고(추적 변경·untracked 없음, 무시된 보관물 .qa/ 없음) 그 폴더를 cwd로 쓰는 hc 터미널이 없고
                마지막 git 활동이 --min-age보다 오래됐을 때만 teardown → worktree remove --force → branch -D.
                작업 폴더 없이 남은 로컬 가지(기본·현재 HEAD·작업 폴더에 붙은 가지·설정 gc.keep_branches 무늬 빼고)도 같은 판정에
                커밋·가지 reflog가 --min-age보다 오래됐으면 branch -D(「지움 가지 <가지> <sha>」, 되돌리기 git branch <가지> <sha>).
                --integ: 원격 <접두>*(기본 refs/integ/) 가운데 커밋이 origin/<기본>에 다 들어갔고 --min-age보다 오래된 것만
                지운다(값이 그대로일 때만). --remote-branches: 원격 refs/heads/*(기본 가지·gc.keep_branches 빼고)도 같은 꼴로.
                안 들어간 가지는 지우지 않고 「남김 <가지> 안 들어감 <n>개 · 마지막 <날짜>」. --min-age 기본 24h(숫자에 s·m·h·d,
                단위 없으면 시간). 메인 폴더·기본 가지·tags·claims는 안 건드린다. 마지막 줄 「지움 n · 남김 m」. 오류 종료 1
       hc-lane guard install|status|remove --repo <저장소 경로> [--branch <기본 브랜치>(install, 기본: origin/HEAD)]
  guard         그 클론의 공용 git 폴더 hooks/pre-push(워크트리 모두에 먹음)에 관문을 넣는다: refs/heads/<기본>으로 가는
                push는 HERDR_LAND=1일 때만 받고, 아니면 새 착지 줄을 알리고 거절한다. 다른 브랜치·참조는 통과.
                다른 pre-push 훅이 있거나 core.hooksPath가 있으면 건드리지 않고 멈춘다. remove는 자기가 넣은 것만 지운다.
                status 종료: 0 깔림, 1 없음, 3 다른 훅. 원격이 하나도 없는 저장소는 push가 없어 「설치할 것 없음」(종료 0)
       hc-lane report <중간|완료|착지|막힘|판정> [<sha>|-] [<한 줄>…] [--name <레인>]   (레인 안에서)
  report        이 기계 ${XDG_STATE_HOME:-~/.local/state}/hc-lane/events.tsv에 한 줄을 더한다(지우지 않음):
                시각(UTC)·기계(HC_LANE_MACHINE, 없으면 hostname)·터미널($HC_TERMINAL_ID)·레인·상태·sha·한 줄(탭·줄바꿈은 빈칸)·
                그때의 hc turn(터미널 밖이면 -). 옛 7칸 줄도 읽는다.
                레인 이름은 --name → $HC_LANE(hc-lane이 띄울 때 넣음) → 작업 트리 가지 순. sha 자리가 sha가 아니면 한 줄로 본다
       hc-lane events [--all | --on <기계>…] [--since <시각|30m·2h·1d>]
  events        이 기계(와 --all이면 hc machine ls의 연결된 기계마다 hc exec --on 한 번)의 events.tsv를 시각 순으로.
                원격 줄의 기계·터미널은 hc 이름(<기계>/<t…>)으로 바꿔 찍는다. 읽지 못한 기계는 「모름 <기계>」 한 줄
       hc-lane wait [--all | --on <기계>…] [--timeout <분>(기본 110)] [--state <상태,…>] [--since <시각>]
  wait          아직 본 적 없는 사건이 생길 때까지 HC_LANE_WAIT_TICK초(기본 60)마다 보고, 생기면 그 줄(들)을 찍고 종료 0.
                상한이면 종료 75. 찍은 사건은 이 기계 …/hc-lane/seen.<$HC_TERMINAL_ID>(지휘마다, 터미널 밖이면 seen)에
                적어 다시 알리지 않는다(바꾸는 것은 그 파일뿐). 새 커서는 --since(없으면 2시간 전)부터 본다.
                hc-lane이 띄운 레인 터미널(라벨 hc-lane=1)이 착지·막힘·판정 없이 끝났거나, 완료·착지·막힘·판정 없이(또는
                그 report의 turn+1보다 뒤에) done·idle로 쉬거나, blocked·error면 「멈춤」 사건(한 줄 칸 「<상태> turn <n>」).
                done·idle은 쉰 지 설정 lane.wait_grace분(기본 10, 0이면 끔)이 지나고 화면의 마지막 상태 줄(lane.wait_line
                기본 ✻ 턴 끝 줄, 또는 표시 줄 가운데 맨 아래)에 lane.wait_busy(확장 정규식, 기본 shells? still running|monitors?
                still running, 빈 값이면 끔) 표시가 없을 때 멈춤(배경 작업이 끝나면 레인이 스스로 이어 간다). 표시가 있어도
                쉰 지 lane.wait_busy_max분(기본 30)이 넘으면 멈춤. blocked·error·끝남은 바로.
                못 읽은 기계의 레인은 그 바퀴에 건너뛴다. 원격은 바퀴마다 기계당 한 번(쉬는 레인 확인만 그 터미널에 hc get·read)
준비·정리 훅: .claude/herdr-setup.sh(환경 LANE_*: LANE_REPO=메인 폴더, LANE_BASE=기본 브랜치), .claude/herdr-teardown.sh
실행 명령은 env K=V 로 감싸므로 hc 템플릿 이름은 쓸 수 없다. 마지막 줄은 JSON 한 줄.
EOF
  exit 2
}
val() { [ $# -ge 2 ] || die "$1 값이 없다"; }
# cfg <키> <기본값>: 개인 설정(herdr-tools-config, 곁의 것 먼저). 도구가 없는 기계는 기본값, 읽기 오류는 종료 1
cfg() {
  c=${0%/*}/herdr-tools-config
  [ -x "$c" ] || c=$(command -v herdr-tools-config) || { printf '%s\n' "$2"; return 0; }
  "$c" get "$1" "$2" || die "설정 $1 을 읽지 못했다(herdr-tools-config)"
}
# capt <초> <명령…>: 그 초 안에 안 끝나면 끊는다(perl alarm, 없으면 그냥). 코어가 응답하지 않아도 멈추지 않게
capt() { if command -v perl >/dev/null 2>&1; then perl -e 'alarm shift; exec @ARGV' "$@"; else shift; "$@"; fi; }

# ---- 레인 사건(2026-11-16 lane-events): 레인이 상태를 직접 적고(report) 지휘는 그것만 읽는다(events·wait) ----
# 화면 글자·보고 파일 끝 줄을 긁던 감시가 칸이 한 줄이거나 파일 이름이 다르면 완료를 놓쳤다(레인이 20~80분 놀았다).
evdir=${XDG_STATE_HOME:-$HOME/.local/state}/hc-lane
evstates='중간 완료 착지 막힘 판정'
tab=$(printf '\t')
utc() { if [ $# = 0 ]; then date -u +%Y-%m-%dT%H:%M:%SZ; else date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ; fi; }
flat() { printf %s "$1" | tr '\t\r\n' '   '; }
# bcut <바이트> <글>: 로캘과 상관없이 바이트로 자르고, 끝에 남은 반쪽 UTF-8 글자는 버린다(iconv -c)
bcut() {
  ( LC_ALL=C; s=$2
    [ ${#s} -gt "$1" ] || { printf %s "$s"; exit 0; }
    r=$(printf %s "${s:0:$1}" | iconv -c -f UTF-8 -t UTF-8 2>/dev/null); [ -n "$r" ] || r=${s:0:$1}
    printf %s "$r" )
}
# jrec <키…>: JSON을 { 마다 끊어 조각마다 키의 문자열 값(없거나 null이면 -)을 탭으로. 첫 키가 없는 조각은 버린다(jq 없이)
jrec() {
  tr '{' '\n' | awk -v K="$*" 'BEGIN { nk = split(K, k, " ") }
    { o = ""
      for (i = 1; i <= nk; i++) {
        v = "-"
        if (match($0, "\"" k[i] "\" *: *(\"[^\"]*\"|-?[0-9]+)")) { v = substr($0, RSTART, RLENGTH); sub(/^"[^"]*" *: *"?/, "", v); sub(/"$/, "", v) }
        if (i == 1 && v == "-") next
        o = o (i > 1 ? "\t" : "") v
      }
      print o }'
}
report_cmd() {
  rn= st= sha= msg= k=0
  while [ $# -gt 0 ]; do
    case $1 in --name) val "$@"; rn=$2; shift 2; continue ;; -h|--help) usage ;; esac
    k=$((k + 1)); case $k in 1) st=$1 ;; 2) sha=$1 ;; 3) msg=$1 ;; *) msg="$msg $1" ;; esac; shift
  done
  case " $evstates " in *" $st "*) [ -n "$st" ] ;; *) false ;; esac ||
    { echo "hc-lane report: 상태는 $evstates 가운데 하나: ${st:-(없음)}" >&2; exit 2; }
  case $sha in
    ''|-) sha=- ;;
    *[!0-9a-f]*) msg="$sha${msg:+ $msg}" sha=- ;;   # hc-lane report 막힘 "이유"
    *) [ ${#sha} -ge 7 ] && [ ${#sha} -le 40 ] || { msg="$sha${msg:+ $msg}" sha=-; } ;;
  esac
  lane=${rn:-${HC_LANE-}}
  [ -n "$lane" ] || lane=$(git symbolic-ref -q --short HEAD 2>/dev/null)
  m=${HC_LANE_MACHINE:-$(hostname -s 2>/dev/null)}
  # 줄 전체를 1000바이트 안으로: bash printf는 약 1KB씩 나눠 쓰니, 넘으면 여러 레인이 함께 더할 때 줄이 섞여
  # 두 사건이 다 7칸이 아니게 된다(감사 실측). 앞 칸은 64바이트씩, 남는 자리를 한 줄 칸이 쓴다
  # 여덟째 칸 = 그때의 hc turn(그 턴이 끝나 쉬면 turn+1). wait가 「report 뒤 더 일하고 report 없이 쉼」을 가린다
  # 코어가 응답하지 않아도 report가 멈추지 않게 3초 상한(perl alarm, 없으면 그냥), 넘으면 turn -
  tn=; [ -z "${HC_TERMINAL_ID-}" ] || tn=$(capt 3 hc get "$HC_TERMINAL_ID" --json 2>/dev/null | sed -n 's/.*"turn" *: *\([0-9][0-9]*\).*/\1/p' | tail -n 1)
  tail_="$tab${tn:--}"
  line="$(utc)$tab$(bcut 64 "$(flat "${m:--}")")$tab$(bcut 64 "$(flat "${HC_TERMINAL_ID:--}")")$tab$(bcut 64 "$(flat "${lane:--}")")$tab$st$tab$(flat "$sha")$tab"
  line=$(bcut $((1000 - ${#tail_})) "$line$(flat "${msg:--}")")$tail_
  mkdir -p "$evdir" || die "report: 폴더를 만들지 못했다: $evdir"
  # 더하기만 한다(O_APPEND 한 번). ponytail: 늘기만 하는 파일 — 수만 줄이 되면 오래된 줄을 옮겨 자르는 단계를 더한다
  printf '%s\n' "$line" >>"$evdir/events.tsv" || die "report: 쓰지 못했다: $evdir/events.tsv"
  echo "$(printf %s "$line" | cut -f4) $st: $sha $(printf %s "$line" | cut -f7)"
}
# pick: --all이면 hc machine ls에서 연결된 기계를 ems에, 아닌 기계를 unk에. --on으로 준 기계는 늘 ems에
pick() {
  ems=$ons unk= pbad=0
  [ $all = 1 ] || return 0
  js=$(hc machine ls --json 2>/dev/null) || { echo "hc-lane $ec: hc machine ls 실패 — 이 기계만 본다" >&2; pbad=1; return 0; }
  recs=$(printf '%s\n' "$js" | jrec name state)
  while IFS=$tab read -r mn ms; do
    [ -n "$mn" ] || continue
    case " $ems " in *" $mn "*) continue ;; esac
    if [ "$ms" = connected ]; then ems="$ems $mn"; else unk="$unk $mn"; fi
  done <<EOF
$recs
EOF
}
# evread <끝 줄 수(0이면 전부)>: 이 기계와 ems 기계의 events.tsv(7칸 이상 줄만 — 옛 줄은 turn 칸이 없다). 원격 줄은 기계·터미널 칸을 hc 이름으로.
# 원격은 기계마다 hc exec 한 번. 못 읽은 기계는 「모름 <기계>」
evread() {
  rd='f=${XDG_STATE_HOME:-$HOME/.local/state}/hc-lane/events.tsv; [ -f "$f" ] || exit 0; if [ "$1" = 0 ]; then cat "$f"; else tail -n "$1" "$f"; fi'
  sh -c "$rd" hc-lane "$1" | awk -F'\t' 'NF >= 7'
  for mn in $unk; do echo "모름 $mn"; done
  for mn in $ems; do
    o=$(hc exec --on "$mn" --timeout 60 -- sh -c "$rd" hc-lane "$1" </dev/null 2>/dev/null) || { echo "모름 $mn"; continue; }
    printf '%s\n' "$o" | M=$mn awk -F'\t' -v OFS='\t' 'NF >= 7 { $2 = ENVIRON["M"]; if ($3 != "-" && index($3, "/") == 0) $3 = ENVIRON["M"] "/" $3; print }'
  done
}
# stopped <사건 줄들>: 라벨 hc-lane=1 터미널 가운데 멈춘 것을 멈춤 사건 줄로(한 줄 칸 「<상태> turn <n>」). hc ls 한 번.
# 그 터미널(주소와 레인 이름이 같은)의 마지막 사건으로 가린다: 끝남은 착지·막힘·판정이면, done·idle(report 없이 쉬는
# 레인 — 2026-11-16 사고 꼴)은 완료·착지·막힘·판정이고 지금 turn이 그 사건 turn+1 이하일 때만(그 턴이 끝나 쉼) 빼고,
# blocked·error는 늘 알린다. 이번 바퀴에 못 읽은 기계(모름·hc machine ls 실패)의 레인은 사건을 모르니 건너뛴다.
# ponytail: report 뒤 같은 지시 안에서 막혔다 풀려도 turn이 올라 거짓 멈춤이 날 수 있다(놓치는 쪽보다 낫다)
# done·idle은 resting을 거친다(유예). blocked·error·끝남은 바로 알린다.
# resting <주소> <커서 열쇠>: 쉬는 레인이 정말 멈췄나(wait-grace, 2026-11-16 실측 — 배경 셸이 도는 동안 턴을 끝낸 Claude
# 레인을 멈춤으로 알렸다. 배경 작업이 끝나면 스스로 이어 간다). 쉰 지 lane.wait_grace분이 지났고, 화면의 마지막 상태 줄
# (lane.wait_line 또는 lane.wait_busy에 걸리는 줄 가운데 맨 아래 — 옛 턴의 끝 줄·본문은 안 봄)에 lane.wait_busy 표시가 없을 때
# 참. 표시가 있어도 쉰 지 lane.wait_busy_max분이 넘으면 참(셸이 죽어 이어 가지 못한 레인을 영영 붙들지 않게).
# 쉰 시각은 이 열쇠(같은 turn의 쉼)를 처음 본 status_ms를 커서에 「#rest」 줄로 남겨 쓴다(done→idle로 status_ms가 새로 찍혀도).
# status_ms를 못 읽으면(hc get 실패·옛 코어) 바로 참, hc read가 실패하면 표시 없음(놓치지 않는 쪽).
# 주소는 hc ls 그대로(<기계>/t…)라 이 기계 코어가 잇는다.
# ponytail: 상한이 30분이라 (1) 이어 간 턴이 ✻ 줄 없이 끝나면 옛 표시 줄이 최대 30분 붙들고, (2) 정상으로 30분 넘게 배경을
# 기다리는 레인은 같은 turn에 거짓 멈춤이 한 번 난다(재감사 [낮음]). 잦으면 lane.wait_busy_max를 올리거나 꼬리 바의 살아 있는
# 개수(「⏵⏵ … · N shells」)를 본다.
resting() {
  sm=$(capt 10 hc get "$1" --json </dev/null 2>/dev/null | sed -n 's/.*"status_ms" *: *\([0-9][0-9]*\).*/\1/p' | tail -n 1)
  [ -n "$sm" ] || return 0
  r=$(grep -F -- "#rest$tab$2$tab" "$cur" 2>/dev/null | tail -n 1); r=${r##*"$tab"}
  case $r in ''|*[!0-9]*) printf '#rest\t%s\t%s\n' "$2" "$sm" >>"$cur"; r=$sm ;; esac
  [ "$sm" -ge "$r" ] || r=$sm
  ag=$(($(date +%s) - r / 1000))
  [ $ag -ge $((wgrace * 60)) ] || return 1
  [ -n "$wbusy" ] && [ $ag -lt $((wbmax * 60)) ] || return 0
  ! capt 10 hc read "$1" </dev/null 2>/dev/null | grep -Ei -e "$wline" -e "$wbusy" | tail -n 1 | grep -Eiq -e "$wbusy"
}
stopped() {  # stopped <사건 줄들> <이번 바퀴 모름 기계들>
  tl=$(hc ls --all --json --label hc-lane=1 2>/dev/null) || { echo "hc-lane wait: hc ls 실패 — 이번 바퀴는 멈춘 레인을 못 봤다" >&2; return 0; }
  me=${HC_LANE_MACHINE:-$(hostname -s 2>/dev/null)}
  printf '%s\n' "$tl" | jrec address name state status turn | while IFS=$tab read -r a nm s ss tn; do
    case $a in
      */*) [ $all = 1 ] || case " $ons " in *" ${a%%/*} "*) ;; *) continue ;; esac; mn=${a%%/*}
           [ "${pbad:-0}" = 0 ] || continue
           case " $2 " in *" $mn "*) continue ;; esac ;;
      *) mn=${me:--} ;;
    esac
    lr=$(printf '%s\n' "$1" | A=$a N=$nm LC_ALL=C awk -F'\t' '$3 == ENVIRON["A"] && $4 == ENVIRON["N"] { l = $5 "\t" (NF >= 8 ? $8 : "-") } END { print l }')
    last=${lr%%"$tab"*} lt=${lr#*"$tab"}
    why=
    if [ "$s" != live ]; then case $last in 착지|막힘|판정) ;; *) why=$s ;; esac
    else case $ss in
        blocked|error) why=$ss ;;
        done|idle) case $last in
            완료|착지|막힘|판정) case $lt$tn in *[!0-9]*|'') ;; *) [ "$tn" -le $((lt + 1)) ] || why=$ss ;; esac ;;
            *) why=$ss ;;
          esac ;;
      esac
    fi
    [ -n "$why" ] || continue
    case $why in done|idle)
      # 이미 알린 쉼(열쇠는 evkey와 같은 꼴)은 다시 볼 것 없다 — 바퀴마다 원격 hc get·read를 부르지 않게
      k_="멈춤$tab$a$tab$(flat "$nm")${tab}쉼 turn $tn"
      ! grep -Fxq -- "$k_" "$cur" 2>/dev/null || continue
      { [ "$wgrace" = 0 ] && [ -z "$wbusy" ]; } || resting "$a" "$k_" || continue ;;
    esac
    printf '%s\t%s\t%s\t%s\t멈춤\t-\t%s turn %s\n' "$(utc)" "$mn" "$a" "$(flat "$nm")" "$why" "$tn"
  done
}
# 사건의 열쇠: 보통 줄은 줄 그대로, 멈춤은 터미널·레인·「상태 turn」(시각은 바퀴마다 바뀌니 뺀다. turn이 바뀌면 다시 알린다)
# done·idle은 「쉼」으로 묶는다(같은 turn에서 done→idle로 바뀌어도 두 번 알리지 않게)
# 사건 awk는 LC_ALL=C로 돈다: macOS awk는 UTF-8 로캘에서 문자열 비교가 strcoll이라 "착지" == "멈춤"이 참이었다
# (같은 한 줄의 완료→착지가 삼켜지고 --state 한 상태 거름이 꺼짐 — wait-grace 레인에서 발견해 함께 고침)
evkey='function key(  w) { if ($5 != "멈춤") return $0; w = $7; sub(/^(done|idle) /, "쉼 ", w); return "멈춤\t" $3 "\t" $4 "\t" w }'
ev_cmd() {
  ec=$1; shift
  all=0 ons= since= to=110 sts=
  while [ $# -gt 0 ]; do
    case $1 in
      --all) all=1; shift ;;
      --on) val "$@"; case $2 in ''|*/*|*' '*) die "--on 기계 이름이 이상하다: $2" ;; esac; ons="$ons $2"; shift 2 ;;
      --since) val "$@"; since=$2; shift 2 ;;
      --timeout) [ $ec = wait ] || die "--timeout은 wait에서만 쓴다"; val "$@"; to=$2; shift 2 ;;
      --state) [ $ec = wait ] || die "--state는 wait에서만 쓴다"; val "$@"; sts=$2; shift 2 ;;
      -h|--help) usage ;;
      *) die "알 수 없는 인자: $1" ;;
    esac
  done
  case $to in ''|*[!0-9]*) die "--timeout은 분(0 이상 정수): $to" ;; esac
  for x_ in $(printf %s "$sts" | tr ',' ' '); do
    case " $evstates 멈춤 " in *" $x_ "*) ;; *) die "--state는 $evstates 멈춤 가운데: $x_" ;; esac
  done
  case $since in
    ''|*[!0-9smhd]*|[smhd]*) ;;   # 비었거나 그대로 시각(문자열 비교: 2026-11-16T02:00:00Z 꼴)
    *) k=${since%[smhd]} u=${since#"$k"}
       case $k in ''|*[!0-9]*) die "--since는 시각(UTC 2026-11-16T02:00:00Z) 또는 숫자에 s·m·h·d: $since" ;; esac
       case $u in s) k=$k ;; m) k=$((k * 60)) ;; d) k=$((k * 86400)) ;; *) k=$((k * 3600)) ;; esac
       since=$(utc $(($(date +%s) - k))) ;;
  esac
  if [ $ec = events ]; then
    pick
    out=$(evread 0)
    printf '%s\n' "$out" | grep "$tab" | S=$since awk -F'\t' '$1 >= ENVIRON["S"]' | sort -s -t "$tab" -k1,1
    printf '%s\n' "$out" | grep '^모름 '
    return 0
  fi
  # 커서는 지휘(부른 터미널)마다 따로: 한 기계의 지휘 여럿이 서로의 사건을 먹지 않게. 터미널 밖이면 seen
  cur=$evdir/seen${HC_TERMINAL_ID:+.$(printf %s "$HC_TERMINAL_ID" | tr -c 'A-Za-z0-9_-' _)}
  mkdir -p "$evdir" || die "wait: 폴더를 만들지 못했다: $evdir"
  # 새 커서는 바닥 시각(--since, 없으면 2시간 전)을 첫 줄에 적는다: 처음 wait가 옛 사건을 쏟지 않게.
  # 레인을 띄운 뒤 2시간 안에 첫 wait를 걸면 그 사이 사건은 놓치지 않는다
  [ -e "$cur" ] || printf '#since\t%s\n' "${since:-$(utc $(($(date +%s) - 7200)))}" >"$cur" || die "wait: 커서 파일을 쓰지 못했다: $cur"
  wgrace=$(cfg lane.wait_grace 10) || exit 1
  case $wgrace in ''|*[!0-9]*) die "설정 lane.wait_grace는 0 이상 정수(분): $wgrace" ;; esac
  wbusy=$(cfg lane.wait_busy 'shells? still running|monitors? still running') || exit 1
  wbmax=$(cfg lane.wait_busy_max 30) || exit 1
  case $wbmax in ''|*[!0-9]*) die "설정 lane.wait_busy_max는 0 이상 정수(분): $wbmax" ;; esac
  wline=$(cfg lane.wait_line '^[[:space:]]*(✻|✶|✳|✢|✽)') || exit 1
  [ -n "$wline" ] || wline='$.^'   # 빈 값: 상태 줄을 안 고름(표시 줄 가운데 맨 아래만). 아무 줄에도 안 맞는 식
  tick=${HC_LANE_WAIT_TICK:-60}
  case $tick in ''|*[!0-9]*) tick=60 ;; esac
  end=$(($(date +%s) + to * 60)) told=
  while :; do
    pick
    # ponytail: 바퀴마다 기계마다 끝 500줄만 본다 — 한 바퀴 사이에 한 기계에 500건 넘게 쌓이면 앞의 것을 놓친다
    out=$(evread 500)
    for mn in $(printf '%s\n' "$out" | sed -n 's/^모름 //p'); do
      case " $told " in *" $mn "*) ;; *) echo "hc-lane wait: 모름 $mn (연결되면 그때 본다)" >&2; told="$told $mn" ;; esac
    done
    evl=$(printf '%s\n' "$out" | grep "$tab") mu=$(printf '%s\n' "$out" | sed -n 's/^모름 //p' | tr '\n' ' ')
    cand=$evl
    case ",${sts:-멈춤}," in *,멈춤,*) cand=$(printf '%s\n%s' "$evl" "$(stopped "$evl" "$mu")") ;; esac
    # 커서는 BEGIN에서 읽는다(빈 파일이면 NR == FNR가 입력 줄까지 먹는다). 「#since<탭>시각」 줄은 바닥
    new=$(printf '%s\n' "$cand" | grep "$tab" | F=$cur S=$since W=",$sts," LC_ALL=C awk -F'\t' "$evkey"'
      BEGIN { fl = ""; while ((getline l < ENVIRON["F"]) > 0) { if (l ~ /^#since\t/) fl = substr(l, 8); else seen[l] = 1 } }
      $1 >= ENVIRON["S"] && $1 >= fl && (ENVIRON["W"] == ",," || index(ENVIRON["W"], "," $5 ",")) && !(key() in seen) && !(key() in done) { done[key()] = 1; print }' |
      sort -s -t "$tab" -k1,1)
    if [ -n "$new" ]; then
      printf '%s\n' "$new" | LC_ALL=C awk -F'\t' "$evkey"'{ print key() }' >>"$cur" || die "wait: 커서 파일을 쓰지 못했다"
      printf '%s\n' "$new"
      return 0
    fi
    [ "$(date +%s)" -lt $end ] || { echo "hc-lane wait: ${to}분 동안 새 사건 없음" >&2; return 75; }
    sleep "$tick"
  done
}
case ${1-} in
  report) shift; report_cmd "$@"; exit $? ;;
  events|wait) c_=$1; shift; ev_cmd "$c_" "$@"; exit $? ;;
esac

on= read=0 branch= dry=0 steps=0 name= repo= cmd=launch lbase= act= integ= minage= brief= swarg= rb=0
case ${1-} in
  clean) cmd=clean; shift ;;
  fetch) cmd=fetch; shift ;;
  gc) cmd=gc; shift ;;
  land) cmd=land; shift; case ${1-} in ''|-*) ;; *) lbase=$1; shift ;; esac ;;
  guard) cmd=guard; shift; act=${1-}; [ $# = 0 ] || shift ;;
esac
while [ $# -gt 0 ]; do
  case $1 in
    --on) val "$@"; on=$2; shift 2 ;;
    --branch) val "$@"; branch=$2; shift 2 ;;
    --name) val "$@"; name=$2; shift 2 ;;
    --repo) val "$@"; repo=$2; shift 2 ;;
    --read) read=1; shift ;;
    --brief) val "$@"; brief=$2; shift 2 ;;
    --start-wait) val "$@"; swarg=$2; shift 2 ;;
    --dry-run) dry=1; shift ;;
    --print-steps) steps=1; shift ;;
    --integ) integ=refs/integ/; shift ;;
    --integ=*) integ=${1#--integ=}; [ -n "$integ" ] || die "--integ= 뒤에 접두가 없다"; shift ;;
    --min-age) val "$@"; minage=$2; shift 2 ;;
    --remote-branches) rb=1; shift ;;
    -h|--help) usage ;;
    --) shift; break ;;
    -*) die "알 수 없는 인자: $1" ;;
    *) [ $cmd = fetch ] && break; die "알 수 없는 인자: $1 (실행 명령 앞에는 -- 를 둔다)" ;;
  esac
done
[ $cmd = launch ] || [ -z "$brief$swarg" ] || die "--brief·--start-wait는 레인을 띄울 때만 쓴다"
if [ $cmd = fetch ]; then
  [ -n "$repo" ] || usage
  [ -z "$name$branch" ] && [ $read$dry$steps = 000 ] || die "fetch에는 --on·--repo와 참조만 쓴다"
  for a; do case $a in -*) die "fetch 참조는 - 로 시작하지 않는다(git 옵션으로 읽힌다): $a" ;; esac; done
elif [ $cmd = clean ]; then
  [ -n "$repo" ] && [ -n "$name$branch" ] || usage
  [ $read = 0 ] && [ $steps = 0 ] && [ $# = 0 ] || die "clean에는 --read·--print-steps·실행 명령을 쓰지 않는다"
elif [ $cmd = gc ]; then
  [ -n "$repo" ] || usage
  [ -z "$name$branch" ] && [ $read$steps = 00 ] && [ $# = 0 ] || die "gc에는 --on·--repo·--dry-run·--integ·--min-age·--remote-branches만 쓴다"
  case $integ in
    '') ;;
    refs/heads/*|refs/tags/*|refs/claims/*|refs/remotes/*) die "--integ 접두로 가지·태그·선점 참조는 쓰지 않는다: $integ" ;;
    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789/_.-]*) die "--integ 접두에 쓸 수 없는 글자가 있다: $integ" ;;
    refs/?*/) ;;
    *) die "--integ 접두는 refs/<이름>/ 꼴: $integ" ;;
  esac
  m=${minage:-24h} u=${m#"${m%[smhd]}"} k=${m%[smhd]}
  case $k in ''|*[!0-9]*) die "--min-age는 숫자에 s·m·h·d(단위 없으면 시간): $m" ;; esac
  case $u in s) secs=$k ;; m) secs=$((k * 60)) ;; d) secs=$((k * 86400)) ;; *) secs=$((k * 3600)) ;; esac
  mins=$(((secs + 59) / 60))
elif [ $cmd = land ]; then
  [ -z "$on$name$branch$repo" ] && [ $read$dry$steps = 000 ] && [ $# = 0 ] ||
    die "land는 레인 작업 폴더 안에서 인자 없이(또는 기본 브랜치 하나만) 부른다: hc-lane land [<기본 브랜치>]"
elif [ $cmd = guard ]; then
  case $act in install|status|remove) ;; *) usage ;; esac
  [ -n "$repo" ] || usage
  [ -z "$on$name" ] && [ $read$dry$steps = 000 ] && [ $# = 0 ] ||
    die "guard에는 --repo(와 --branch <기본 브랜치>)만 쓴다. 다른 기계는 hc exec --on <기계> -- hc-lane guard …"
else
  [ -n "$name" ] && [ -n "$repo" ] || usage
fi
[ $cmd = gc ] || { [ -z "$integ$minage" ] && [ $rb = 0 ]; } || die "--integ·--min-age·--remote-branches는 gc에서만 쓴다"
case $name in *[!abcdefghijklmnopqrstuvwxyz0123456789_-]*) die "--name은 a-z 0-9 - _ 만 쓴다(hc 규칙): $name" ;; esac
[ ${#name} -le 32 ] || die "--name은 32자까지: $name"
[ $cmd != launch ] || [ $steps = 1 ] || [ $# -gt 0 ] || [ -n "$brief" ] || die "-- 뒤에 실행 명령이 없다"

# 대상 기계에서 실행(종료 코드 그대로).
x() { if [ -n "$on" ]; then hc exec --on "$on" --timeout 600 -- "$@"; else "$@"; fi; }
xi() { if [ -n "$on" ]; then hc exec -i --on "$on" --timeout 600 -- "$@"; else "$@"; fi; }   # 표준 입력을 넘긴다
# zx <폴더> <명령…>: 대상 기계의 그 폴더에서. --on이면 hc 코어 환경이라 ~/.zshrc의 PATH(bun·gh 자격 도우미 등)가 없다
# (150·151 실측, 2026-11-16 감사 대상 fetch가 「could not read Username」). zsh·~/.zshrc가 있으면 로그인 셸(~/.zprofile의
# brew shellenv)로 ~/.zshrc까지 읽고 돈다. -i(대화형)는 쓰지 않는다: 프롬프트·자동 붙기 같은 대화형 설정이 출력을 섞거나 멈춘다.
zx() {
  x sh -c 'cd "$1" || exit 1
    if [ -n "$2" ] && [ -f "$HOME/.zshrc" ] && command -v zsh >/dev/null 2>&1; then
      d=$1; shift 2
      exec zsh -lc "source \"\$HOME/.zshrc\" >/dev/null 2>&1; cd \"\$1\" && shift && exec \"\$@\"" zsh "$d" "$@"
    fi
    shift 2; exec "$@"' hc-lane "$1" "$on" "${@:2}"
}
q() { printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"; }

# 출력하는 명령에 따옴표 없이 넣으므로 브랜치 이름은 이 글자만 받는다.
plain() { case $1 in '' | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789/_.-]*) return 1 ;; esac; }

# origin_base <저장소>: origin/HEAD가 가리키는 기본 브랜치, 없으면 main. origin이 없으면(로컬 저장소) 로컬 main, 없으면 master
origin_base() {
  if git -C "$1" remote get-url origin >/dev/null 2>&1; then
    b=$(git -C "$1" symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null); b=${b#origin/}
  elif ! git -C "$1" show-ref -q --verify refs/heads/main && git -C "$1" show-ref -q --verify refs/heads/master; then b=master
  else b=; fi
  echo "${b:-main}"
}

# land: 레인 작업 폴더에서 착지. 저장소의 .claude/herdr-land.sh가 있으면 그것에 맡기고, 없으면 같은 순서를 여기서 한다.
# 검증 스크립트가 없으면 push하지 않는다(옛 착지 줄의 「건너뜀」 뒤 push를 막는다). push는 HERDR_LAND=1로(pre-push 관문 통과).
land_cmd() {
  top=$(git rev-parse --show-toplevel 2>/dev/null) && cd "$top" || die "land: git 작업 폴더 안에서 부른다(레인 워크트리): $PWD"
  base=${lbase:-$(origin_base .)}
  plain "$base" || die "land: 기본 브랜치 이름에 쓸 수 없는 글자가 있다: $base"
  if [ -f .claude/herdr-land.sh ]; then
    echo "hc-lane land: .claude/herdr-land.sh $base 에 맡긴다"
    HERDR_LAND=1 exec bash .claude/herdr-land.sh "$base"
  fi
  # origin이 없는 저장소(맥의 game·hwanhon 등)는 로컬 <기본>이 기준이고 착지는 그것을 fast-forward로 올리는 것이다
  if git remote get-url origin >/dev/null 2>&1; then remote=1 bref=refs/remotes/origin/$base blab=origin/$base
  else remote=0 bref=refs/heads/$base blab="로컬 $base"; fi
  tries=${HERDR_LAND_TRIES:-5}
  case $tries in ''|*[!0-9]*|0) tries=5 ;; esac
  i=0
  while :; do
    i=$((i + 1))
    [ -z "$(git status --porcelain --untracked-files=no)" ] || die "land: 커밋 안 된 변경이나 멈춘 rebase가 있다(git status). 커밋하거나 rebase를 마친 뒤 같은 줄을 다시"
    [ $remote = 0 ] || git fetch -q origin || die "land: git fetch 실패"
    git rev-parse -q --verify "$bref^{commit}" >/dev/null || die "land: $blab 가 없다"
    if ! git rebase -q "$bref"; then
      echo "hc-lane land: rebase 충돌. 양쪽 내용을 살려 풀고 git add → git rebase --continue 뒤 같은 줄(hc-lane land $base)을 다시" >&2
      exit 3
    fi
    [ -f .claude/herdr-verify.sh ] ||
      die "land: .claude/herdr-verify.sh 가 없어 push하지 않았다(검증 없는 착지는 없다). 저장소에 검증 스크립트(또는 .claude/herdr-land.sh)를 두거나 지휘에 알린다"
    bash .claude/herdr-verify.sh || die "land: 검증 실패, push하지 않았다. 고쳐 커밋한 뒤 같은 줄을 다시"
    if [ $remote = 1 ]; then
      if HERDR_LAND=1 git push origin "HEAD:refs/heads/$base"; then
        echo "hc-lane land: 착지 $(git rev-parse --short HEAD) → origin/$base"
        return 0
      fi
      git fetch -q origin || die "land: push 실패 뒤 git fetch 실패"
      git merge-base --is-ancestor "$bref" HEAD &&
        die "land: push 실패(다른 쪽 push가 앞선 것이 아니다 — 위 git 출력을 본다)"
    else
      new=$(git rev-parse HEAD) old=$(git rev-parse "$bref")
      # <기본>이 체크아웃된 폴더(보통 메인 클론)가 있으면 그 폴더 작업 트리도 같이 올리고, 없으면 기대값 확인 update-ref
      at=$(git worktree list --porcelain | B="branch $bref" awk '/^worktree /{w=substr($0,10)} $0==ENVIRON["B"]{print w; exit}')
      if [ -n "$at" ]; then HERDR_LAND=1 git -C "$at" merge --ff-only -q "$new"
      else git merge-base --is-ancestor "$old" "$new" && git update-ref "$bref" "$new" "$old"; fi &&
        { echo "hc-lane land: 착지 $(git rev-parse --short HEAD) → 로컬 $base${at:+ (폴더 $at)}"; return 0; }
      git merge-base --is-ancestor "$bref" HEAD &&
        die "land: 로컬 $base 를 fast-forward로 올리지 못했다${at:+(폴더 $at 에 커밋 안 된 변경?)} — 위 git 출력을 본다"
    fi
    if [ $i -ge $tries ]; then
      echo "hc-lane land: 다른 쪽 착지가 먼저 들어가 ${tries}번 거절됐다. 같은 줄을 다시" >&2
      exit 4
    fi
    echo "hc-lane land: 다른 쪽 착지가 먼저 들어가 거절됨, 처음부터 다시 ($((i + 1))/$tries)" >&2
  done
}

# guard: 클론의 공용 git 폴더 hooks/pre-push에 관문. 표지 줄로 자기가 넣은 것을 알아보고, 남의 훅은 건드리지 않는다.
gmark='# hc-lane guard v1'
guard_cmd() {
  common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "guard: git 저장소가 아니다: $repo"
  hp=$(git -C "$repo" config --get core.hooksPath)
  f=$common/hooks/pre-push
  st=none
  if [ -e "$f" ] || [ -L "$f" ]; then if grep -Fqx "$gmark" "$f" 2>/dev/null; then st=ours; else st=other; fi; fi
  if [ -z "$(git -C "$repo" remote)" ] && [ $act != remove ]; then
    echo "guard: 원격이 없는 저장소라 push가 없다. 설치할 것 없음(착지는 hc-lane land가 로컬 <기본>을 fast-forward로 올린다): $repo"
    return 0
  fi
  case $act in
    status)
      case $st in
        ours) b=$(sed -n 's/^base=//p' "$f")
              if [ -n "$hp" ]; then echo "guard: 깔려 있지만 core.hooksPath=$hp 라 git이 부르지 않는다: $f"; return 1; fi
              echo "guard: 깔림(기본 브랜치 $b): $f"; return 0 ;;
        none) echo "guard: 없음: $f"; return 1 ;;
        other) echo "guard: 다른 pre-push 훅이 있다(hc-lane 관문 아님): $f"; return 3 ;;
      esac ;;
    install)
      [ -z "$hp" ] || die "guard: core.hooksPath=$hp 라 $f 는 git이 부르지 않는다. 건드리지 않았다(그 훅 폴더에 연결할지 지휘가 정한다)"
      [ $st != other ] || die "guard: 다른 pre-push 훅이 있다: $f. 덮지 않았다(그 훅에 관문을 이을지 지휘가 정한다)"
      b=${branch:-$(origin_base "$repo")}
      plain "$b" || die "guard: 기본 브랜치 이름에 쓸 수 없는 글자가 있다: $b"
      mkdir -p "$common/hooks" || die "guard: 훅 폴더를 만들지 못했다: $common/hooks"
      tmp=$f.hc-lane.$$
      cat >"$tmp" <<EOF || die "guard: 쓰지 못했다: $tmp"
#!/bin/sh
$gmark
# hc-lane guard install이 넣었다(지우기: hc-lane guard remove --repo <경로>). refs/heads/<기본>으로 가는 push는
# 착지 줄(hc-lane land, .claude/herdr-land.sh)이 주는 HERDR_LAND=1일 때만 받는다. 다른 브랜치·참조는 통과.
base=$b
[ "\${HERDR_LAND-}" = 1 ] && exit 0
while read -r lref lsha rref rsha; do
  [ "\$rref" = "refs/heads/\$base" ] || continue
  cat >/dev/null
  echo "push 막힘: \$base 로 가는 push는 착지 줄로만 한다." >&2
  echo "새 착지 줄: hc-lane land \$base" >&2
  echo "(사람이 손으로 넣을 때만 HERDR_LAND=1 git push … 로 명시)" >&2
  exit 1
done
exit 0
EOF
      chmod +x "$tmp" && mv -f "$tmp" "$f" || { rm -f "$tmp"; die "guard: 넣지 못했다: $f"; }
      [ $st = ours ] && echo "guard: 새로 씀(기본 브랜치 $b): $f" || echo "guard: 깔았다(기본 브랜치 $b): $f" ;;
    remove)
      case $st in
        ours) rm -f "$f" || die "guard: 지우지 못했다: $f"; echo "guard: 지웠다: $f" ;;
        none) echo "guard: 지울 것 없음: $f" ;;
        other) die "guard: hc-lane 관문이 아닌 pre-push 훅이라 지우지 않았다: $f" ;;
      esac ;;
  esac
}

case $cmd in
  land) land_cmd; exit $? ;;
  guard) guard_cmd; exit $? ;;
  fetch)
    zx "$repo" git fetch origin "$@" || die "fetch 실패: ${on:+$on:}$repo (위 git 출력을 본다)"
    echo "hc-lane fetch: 받음 ${on:+$on:}$repo origin${1:+ $*}"; exit 0 ;;
esac

top=$(x git -C "$repo" worktree list --porcelain | sed -n '1s/^worktree //p')
[ -n "$top" ] || die "git 저장소가 아니다: $repo${on:+ (기계 $on)}"
repo=$top
# origin이 없는 저장소는 fetch 없이 로컬 <기본>(main, 없으면 master)이 기준이다
if x git -C "$repo" remote get-url origin >/dev/null 2>&1; then
  remote=1
  base=$(x git -C "$repo" symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null)
  base=${base#origin/}
else
  remote=0 base=
  x git -C "$repo" show-ref -q --verify refs/heads/main || ! x git -C "$repo" show-ref -q --verify refs/heads/master || base=master
fi
[ -n "$base" ] || base=main
if [ $remote = 1 ]; then bref=refs/remotes/origin/$base blab=origin/$base; else bref=refs/heads/$base blab="로컬 $base"; fi
plain "$base" || die "기본 브랜치 이름에 쓸 수 없는 글자가 있다: $base"
if [ $cmd != gc ]; then
  [ -n "$branch" ] || branch=$name
  plain "$branch" && x git -C "$repo" check-ref-format --branch "$branch" >/dev/null 2>&1 ||
    die "브랜치 이름이 올바르지 않다(영문·숫자·/ _ . - 만): $branch"
  wt=${repo%/*}/${repo##*/}.wt/$(printf %s "$branch" | tr / -)
  rx=${on:+hc exec --on $on -- }   # 안내하는 명령은 호출한 쪽에서 돌리므로 --on이면 hc exec를 붙인다
  undo="${rx}git -C $(q "$repo") worktree remove --force $(q "$wt") && ${rx}git -C $(q "$repo") branch -d $branch"
fi

print_steps() {
  n=0
  s() { n=$((n + 1)); printf '%s. %s\n' "$n" "$*"; }
  printf '### 착지·정리 (hc-lane이 채움)\n'
  printf -- '- 작업 폴더 %s (브랜치 %s, 기준 %s). 편집·명령은 이 폴더 안에서만 한다.\n' "$wt" "$branch" "$blab"
  printf -- '- 커밋은 경로를 지정한다: git add -- <경로…> && git commit -m "<메시지>" -- <경로…> (add -A·commit -a·stash·reset --hard·강제 push 금지)\n'
  # rebase·검증·push는 한 줄: 앞 단계가 실패하면 push가 나가지 않는다(2026-11-05 레인이 ;로 이어 써서 검증 실패 뒤 push가
  # 나갔고, 따로 된 줄이면 충돌로 멈춘 rebase의 반쯤 된 HEAD도 나간다). 안내는 # 줄로 따로: 대화형 zsh에 붙여 넣어도
  # 명령이 되지 않게 ; > | & 를 쓰지 않는다.
  # 착지는 hc-lane land 한 줄: 저장소의 .claude/herdr-land.sh(있으면) 또는 fetch·rebase·herdr-verify.sh·push. 검증 스크립트가
  # 없으면 실패하고 push하지 않는다(2026-11-16 전환 안전장치: 옛 줄은 검증이 없으면 「건너뜀」 뒤 push했다).
  printf -- '- 알림: 중간·완료·착지·막힘 때 hc-lane report <상태> [<sha>] "<한 줄>"을 부른다(화면 줄과 보고 파일은 그대로 써도 됨). 지휘는 hc-lane wait로 이 사건만 기다린다\n'
  printf -- '  예: hc-lane report 완료 <sha8> "<요약>" · 아래 1이 착지하면 hc-lane report 착지 <sha8> · 막히면 hc-lane report 막힘 - "<까닭>"\n'
  s "cd $(q "$wt") && hc-lane land $base"
  printf '   # 이 한 줄을 그대로 돌린다. 나누거나 세미콜론으로 이어 쓰지 말 것. 앞 단계가 실패하면 push는 나가지 않는다\n'
  printf '   # 저장소에 .claude/herdr-land.sh가 있으면 그 스크립트가 fetch·rebase·검증·push를 하고, 없으면 hc-lane이 같은 순서로 하며 .claude/herdr-verify.sh가 없으면 push하지 않고 실패한다\n'
  printf '   # rebase가 충돌로 멈추면(종료 3) 양쪽 내용을 살려 풀고 고친 파일을 git add 한 뒤 git rebase --continue, 그다음 이 줄을 처음부터 다시\n'
  printf '   # 검증이 실패하면 고쳐 커밋하고 이 줄을 다시. push 거절 횟수(종료 4)나 잠금 기다림 상한(종료 75)으로 끝나면 이 줄을 다시, 최대 20번\n'
  s "cd $(q "$repo") && hc-lane clean --repo $(q "$repo") --branch $branch"
  printf '   # teardown·검사·워크트리·브랜치 정리를 한 번에. clean이 종료 1로 멈추면 출력된 이유를 고치고 같은 줄을 다시 돈다\n'
  printf '   # 폴더를 rm -rf로 직접 지우지 않는다. 보고는 출력 그대로, 건너뜀은 통과가 아니다\n'
  printf '   # 끝내기 전 이 작업 트리 아래에서 도는 배경 프로세스가 없는지 확인한다(pgrep -fl %s). 자기 셸·에이전트는 빼고, 남은 것은 그 정확한 pid로 kill 한다. cwd로만 도는 것(명령 줄에 경로 없음)은 pgrep에 안 보인다\n' "$(q "$wt/")"
}

read_steps() {  # --read(감사·조사) 레인: 판정은 사건으로
  printf '### 판정 알림 (hc-lane이 채움)\n'
  printf -- '- 판정이 나오면 보고 파일과 함께 이 한 줄을 부른다: hc-lane report 판정 - "<판정 한 줄(예: 감사 완료 <대상 sha8> 높음 0·중간 0·낮음 n)>"\n'
  printf -- '- 막히면 hc-lane report 막힘 - "<까닭>". 지휘는 hc-lane wait로 이 사건만 기다린다\n'
}

# hook <setup|teardown>: 워크트리 안에서 .claude/herdr-<이름>.sh. 기록은 그 워크트리의 git 관리 폴더(worktree remove 때 같이 지워진다).
# --on이면 hc 코어 환경이라 ~/.zshrc의 PATH(bun 등)가 없다(150·151 실측). zsh·~/.zshrc가 있으면 읽고 돈다.
hook() {
  log=$(x git -C "$wt" rev-parse --absolute-git-dir)/hc-lane-$1.log
  zx "$wt" env "LANE_REPO=$repo" "LANE_WORKTREE=$wt" "LANE_BRANCH=$branch" "LANE_BASE=$base" \
    sh -c 'exec bash "$1" >"$2" 2>&1 </dev/null' hc-lane ".claude/herdr-$1.sh" "$log"
}

# clean: 지우기 전에 다 확인하고, 하나라도 걸리면 아무것도 지우지 않는다(teardown도 안 돌린다).
stop() {  # stop <한 줄 이유> [자세한 목록]: stderr에 알리고 JSON, 종료 1
  printf 'hc-lane clean: %s\n' "$1" >&2
  if [ -n "${2-}" ]; then
    printf '%s\n' "$2" | sed -n '1,30s/^/    /p' >&2
    k=$(printf '%s\n' "$2" | wc -l | tr -d ' '); [ "$k" -le 30 ] || echo "    … (모두 ${k}줄)" >&2
  fi
  if [ -n "$did" ]; then printf 'hc-lane clean: 여기까지 했다: %s. 원인을 고친 뒤 같은 명령을 다시 돌린다\n' "$did" >&2
  else printf 'hc-lane clean: 아무것도 지우지 않았다. 원인을 고친 뒤 같은 명령을 다시 돌린다(폴더를 rm -rf로 직접 지우지 않는다)\n' >&2; fi
  cj stopped "$1"
  exit 1
}
# 있음(0)·없음(1)만 믿고, 그 밖의 종료 코드(hc 연결 끊김 등)는 멈춘다. "없음"으로 읽어 거짓 성공하지 않게.
exists() { x sh -c '[ -e "$1" ] || [ -L "$1" ]' hc-lane "$wt"; case $? in 0) return 0 ;; 1) return 1 ;; esac; stop "폴더를 확인하지 못했다(hc·연결?): $wt"; }
has_branch() { x git -C "$repo" show-ref --verify -q "refs/heads/$branch"; case $? in 0) return 0 ;; 1) return 1 ;; esac; stop "브랜치를 확인하지 못했다: $branch"; }
# leftover: 등록이 지워진 폴더에서 메인 폴더의 무시 규칙으로 무시되지 않는 것(추적 파일 포함)을 찍는다. 검사 오류는 종료 2.
# .git은 지워진 등록(<공용 git 폴더>/worktrees/…)을 가리키는 파일일 때만 git이 남긴 것으로 본다.
# ponytail: 규칙은 메인 폴더 작업 트리의 .gitignore — 뒤처져 규칙이 없으면 멈추고(안전 쪽), 로컬로 고쳤으면 아예 멈춘다.
#           자주 걸리면 origin/<기본> 트리의 .gitignore로 판정하게 바꾼다.
leftover() {
  x sh -c '
    cd "$2" || exit 2
    t=$(mktemp "${TMPDIR:-/tmp}/hc-lane-left.XXXXXX") || exit 2
    trap "rm -f \"\$t\" \"\$t.i\"" EXIT
    if [ -f .git ] && [ ! -L .git ]; then
      g=$(sed -n "s/^gitdir: //p" .git)
      case $g in "$3"/worktrees/?*) [ ! -e "$g" ] || echo .git ;; *) echo .git ;; esac
    elif [ -e .git ] || [ -L .git ]; then echo .git
    fi
    find . -mindepth 1 -path ./.git -prune -o ! -type d -print | sed "s|^\./||" >"$t" || exit 2
    git -c core.quotePath=false -C "$1" check-ignore --stdin <"$t" >"$t.i"; [ $? -le 1 ] || exit 2
    grep -vxF -f "$t.i" "$t"; [ $? -le 1 ] || exit 2' hc-lane "$repo" "$wt" "$common"
}
left_check() {  # left_check <어떤 폴더>
  g=$(x git -C "$repo" status --porcelain --untracked-files=all -- ':(glob)**/.gitignore') || stop "메인 폴더 git status 실패: $repo"
  [ -z "$g" ] || stop "메인 폴더의 .gitignore에 커밋 안 된 변경이 있어 $1 폴더의 무시 판정을 믿을 수 없다: $repo" "$g"
  left=$(leftover) || stop "$1 폴더를 검사하지 못했다: $wt"
  [ -z "$left" ] || stop "$1 폴더에 .gitignore로 무시되지 않는 것(추적 파일 포함)이 있다: $wt" "$left"
}
self=${HC_TERMINAL_ID-}
# term_pairs: hc ls --json에서 터미널마다 "<주소> <cwd>" 한 줄. 1 hc ls 실패, 2 형식을 못 읽음(뽑은 수가 "cwd" 수와 다름).
term_pairs() {
  tl=$(hc ls --json 2>/dev/null) || return 1
  tp=$(printf '%s\n' "$tl" | tr '{' '\n' | sed -n 's/.*"address" *: *"\([^"]*\)".*"cwd" *: *"\([^"]*\)".*/\1 \2/p')
  [ "$(printf '%s\n' "$tl" | grep -o '"cwd" *:' | grep -c .)" = "$(printf '%s\n' "$tp" | grep -c .)" ] || return 2
  printf '%s\n' "$tp"
}
# busy_terms: "<주소> <cwd>" 줄(표준 입력) 가운데 대상 기계의 터미널이고 cwd가 그 폴더 안인 것을 찍는다.
busy_terms() {
  while read -r a c; do
    case $a in "${on:+$on/}"*) a=${a#"${on:+$on/}"} ;; *) continue ;; esac
    case $a in */*) continue ;; esac                               # 다른 기계
    [ -n "$on" ] || [ "$a" != "$self" ] || continue   # 부른 터미널 자신(clean 착지 절차의 레인. gc는 빼지 않는다)
    case $c/ in "$wt"/*) echo "${on:+$on/}$a $c" ;; esac
  done
}
clean_cmd() {
  td=none did=
  [ "$branch" != "$base" ] || die "기본 브랜치($base)는 정리하지 않는다"
  here=$(pwd -P 2>/dev/null)
  common=$(x git -C "$repo" rev-parse --path-format=absolute --git-common-dir) || stop "git 관리 폴더를 찾지 못했다: $repo"
  wl=$(x git -C "$repo" worktree list --porcelain) || stop "git worktree list 실패: $repo"
  blk=$(printf '%s\n' "$wl" | W="worktree $wt" awk '$0 == ENVIRON["W"] { f = 1; next } f && /^worktree / { exit } f')
  reg=0; printf '%s\n' "$wl" | grep -Fxq "worktree $wt" && reg=1
  dir=0; exists && dir=1
  br=0; has_branch && br=1
  if [ $reg = 0 ] && [ $dir = 0 ] && [ $br = 0 ]; then
    echo "정리할 것 없음: 워크트리 $wt 와 브랜치 $branch 가 이미 없다"
    cj nothing
    return 0
  fi

  # 0) 그 폴더가 이 브랜치의 워크트리인지(브랜치 이름의 / 를 - 로 바꾼 폴더 이름은 겹칠 수 있다), 잠기지 않았는지,
  #    살아 있는 다른 터미널이 그 폴더에서 돌지 않는지(착지 절차에서 자기 자신을 지우는 레인은 $HC_TERMINAL_ID로 뺀다)
  if [ $reg = 1 ]; then
    wb=$(printf '%s\n' "$blk" | sed -n 's/^branch //p')
    [ -z "$wb" ] || [ "$wb" = "refs/heads/$branch" ] || stop "이 폴더는 다른 브랜치(${wb#refs/heads/})의 워크트리다: $wt"
    [ -n "$wb" ] || [ $br = 0 ] || stop "이 폴더는 분리 HEAD 워크트리인데 브랜치 $branch 는 따로 있다(다른 레인의 폴더일 수 있다): $wt"
    printf '%s\n' "$blk" | grep -q '^locked' && stop "잠긴 워크트리다(git worktree unlock 뒤 다시): $wt"
  fi
  if [ $dir = 1 ]; then
    pairs=$(term_pairs); case $? in
      1) stop "hc ls 실패: 이 폴더에서 도는 터미널을 확인하지 못했다" ;;
      2) stop "hc ls --json 출력을 읽지 못했다(형식이 바뀌었나?): 이 폴더에서 도는 터미널을 확인하지 못했다" ;;
    esac
    busy=$(printf '%s\n' "$pairs" | busy_terms)
    [ -z "$busy" ] || stop "살아 있는 터미널이 이 폴더에서 돈다(끝났으면 hc kill <주소> 뒤 다시): $wt" "$busy"
  fi

  # 1) 브랜치와 워크트리 HEAD가 origin/<기본>에 들어갔는지(폴더가 없어도 등록의 HEAD로 본다)
  if [ $remote = 0 ]; then :
  elif [ $dry = 1 ]; then echo "[dry-run] git fetch 건너뜀: 지금 있는 origin/$base 로 판정"
  else x git -C "$repo" fetch -q origin || stop "git fetch 실패: $repo"; fi
  x git -C "$repo" rev-parse -q --verify "$bref^{commit}" >/dev/null || stop "$blab 가 없다: $repo"
  set --
  [ $br = 1 ] && set -- "refs/heads/$branch"
  if [ $reg = 1 ]; then
    h=$(printf '%s\n' "$blk" | sed -n 's/^HEAD //p')
    [ -n "$h" ] || stop "워크트리 HEAD를 읽지 못했다: $wt"
    set -- "$@" "$h"
  fi
  for c in "$@"; do
    case $c in refs/heads/*) lab="브랜치 $branch" ;; *) lab="워크트리 HEAD $(printf %.12s "$c")" ;; esac
    x git -C "$repo" merge-base --is-ancestor "$c" "$bref" ||
      stop "$lab 이(가) $blab 에 들어가지 않았다(착지 전이거나 다른 커밋). 착지 절차의 hc-lane land부터 다시 한다" \
        "$(x git -C "$repo" log --oneline -n 10 "$bref..$c")"
  done

  # 2) 지울 폴더에 추적 변경·무시되지 않은 untracked가 없는지(status.showUntrackedFiles 설정과 무관하게 모두 본다)
  if [ $reg = 1 ] && [ $dir = 1 ]; then
    st=$(x git -c core.quotePath=false -C "$wt" status --porcelain --untracked-files=all --ignore-submodules=none) || stop "git status 실패: $wt"
    [ -z "$st" ] || stop "워크트리에 커밋 안 된 변경이나 무시되지 않은 untracked가 있다: $wt" "$st"
    ig=$(x git -c core.quotePath=false -C "$wt" status --porcelain --ignored --untracked-files=normal | sed -n 's/^!! //p' | tr '\n' ' ')
    [ -z "$ig" ] || echo "${P}무시된 것도 같이 지운다: $ig"
  elif [ $dir = 1 ]; then
    left_check "등록이 지워진"
  fi

  # 3) teardown(있으면, 실패해도 계속 — herdr-teardown.sh의 약속) → worktree remove → 남은 무시 파일 폴더 → branch -d
  if [ $reg = 1 ] && [ $dir = 1 ] && x test -f "$wt/.claude/herdr-teardown.sh"; then
    if [ $dry = 1 ]; then echo "[dry-run] 워크트리에서 bash .claude/herdr-teardown.sh"; td=dry-run
    elif hook teardown; then td=ran did=teardown
    else
      x tail -n 20 "$log" >&2
      echo "hc-lane clean: herdr-teardown.sh 실패(위는 기록 끝 20줄), 정리는 계속한다" >&2
      td=failed did=teardown
    fi
  fi
  if [ $reg = 1 ]; then
    if [ $dry = 1 ]; then echo "[dry-run] git -C $(q "$repo") worktree remove $(q "$wt")"
    else
      # 무시된 파일 때문에 "Directory not empty"로 끝나도 등록은 지워질 수 있다(git이 멈추지 않는다). 등록으로 판정한다.
      x git -C "$repo" worktree remove "$wt" >&2
      wl=$(x git -C "$repo" worktree list --porcelain) || stop "git worktree list 실패: $repo"
      printf '%s\n' "$wl" | grep -Fxq "worktree $wt" && stop "git worktree remove 실패: $wt"
      did="${did:+$did, }워크트리 등록 제거"
    fi
  fi
  if [ $dry = 1 ]; then
    [ $reg = 1 ] || [ $dir = 0 ] || echo "[dry-run] rm -rf -- $(q "$wt")  # 무시된 파일만 남은 폴더"
  elif exists; then
    left_check 남은
    x rm -rf -- "$wt" || stop "남은 폴더를 지우지 못했다: $wt"
    did="${did:+$did, }남은 무시 파일 폴더 삭제"
  fi
  if [ $br = 1 ]; then
    if [ $dry = 1 ]; then echo "[dry-run] git -C $(q "$repo") branch -d $branch"
    else
      x git -C "$repo" branch -q -d "$branch" >&2 || stop "git branch -d 실패: $branch"
      did="${did:+$did, }브랜치 삭제"
    fi
  fi

  case $td in ran) tdk=통과 ;; none) tdk='없음(건너뜀)' ;; failed) tdk='실패(정리는 계속)' ;; *) tdk='돌릴 예정' ;; esac
  if [ $dry = 1 ]; then echo "[dry-run] 정리할 것: 워크트리 $wt, 브랜치 $branch (teardown: $tdk)"
  else echo "정리 끝: 워크트리 $wt, 브랜치 $branch${on:+ @$on} (teardown: $tdk)"; fi
  if [ -z "$on" ] && [ $dry = 0 ]; then
    case "$PWD/|$here/" in "$wt"/*|*"|$wt"/*) echo "알림: 지금 셸 위치는 지운 폴더 안이었다. 다음 명령 전에 cd $(q "$repo")" ;; esac
  fi
  if [ $dry = 1 ]; then cj planned; else cj done; fi
}

# gc: 끝난 레인의 작업 폴더·가지와 원격 중간 참조를 정리한다. 하나라도 맞지 않으면 「남김 <대상> <까닭>」, 지우지 않는다.
gin() {  # gin <커밋>: $bref에 다 들어갔나. 0 들어감(조상, 또는 병합 커밋 없이 커밋마다 공백까지 같은 패치가 있음), 1 아님(gn=안 들어간 커밋 수), 2 확인 못 함
  gn=0; x git -C "$repo" merge-base --is-ancestor "$1" "$bref"; case $? in 0) return 0 ;; 1) ;; *) return 2 ;; esac
  gm=$(x git -C "$repo" rev-list --merges "$bref..$1") || return 2
  # 패치 비교는 병합 커밋을 보지 않는다 — 병합이 끼면 같은 내용인지 모른다고 보고, 조상 아닌 커밋을 다 센다
  if [ -n "$gm" ]; then gn=$(x git -C "$repo" rev-list --count "$bref..$1") || gn='?'; return 1; fi
  # git cherry처럼 patch-id로 보되 --verbatim(공백까지): 공백만 다른 변경(들여쓰기 등)은 같은 내용이 아니다(2026-11-16 감사).
  # U <id> = $bref 쪽 커밋, B <id> <커밋> = 가지 쪽, C <커밋> = 가지 커밋 목록(빈 커밋은 id가 없어 안 들어감으로 센다)
  gc_=$(x sh -c 'cd "$1" || exit 2; c=$(git rev-list --no-merges "$2..$3") || exit 2
    git log -p --no-merges --no-color --no-ext-diff "$3..$2" | git patch-id --verbatim | sed "s/^/U /"
    git log -p --no-merges --no-color --no-ext-diff "$2..$3" | git patch-id --verbatim | sed "s/^/B /"
    printf "%s\n" "$c" | sed "/^$/d; s/^/C /"' hc-lane "$repo" "$bref" "$1") || return 2
  gn=$(printf '%s\n' "$gc_" | awk '$1 == "U" { u[$2] = 1 } $1 == "B" { b[$3] = $2 } $1 == "C" { c[++n] = $2 }
    END { for (i = 1; i <= n; i++) if (!(c[i] in b) || !(b[c[i]] in u)) m++; print m + 0 }')
  [ "$gn" = 0 ]
}
# jdg <대상> <커밋> <나이 기준 시각>: 들어갔고 --min-age보다 오래됐으면 0. 아니면 「남김」을 찍고 1
jdg() {
  gin "$2"; case $? in
    0) ;;
    1) keep "$1" "안 들어감 ${gn}개 · 마지막 $(x git -C "$repo" show -s --format=%cs "$2")"; return 1 ;;
    *) keep "$1" "들어갔는지 확인하지 못함"; err=1; return 1 ;;
  esac
  [ $((now - $3)) -ge "$secs" ] || { keep "$1" "새것($(((now - $3) / 3600))시간)"; return 1; }
}
kept() {  # kept <가지>: 남길 목록(설정 gc.keep_branches, 빈칸으로 나눈 glob 무늬)에 맞나
  set -f; for p_ in $kb; do case $1 in $p_) set +f; return 0 ;; esac; done; set +f; return 1
}
# rgc <접두>: 원격 <접두>* 가운데 들어갔고 커밋이 오래된 것을 ls-remote 때 값 그대로일 때만 지운다(refs/heads면 기본·남길 목록 빼고)
rgc() {
  ls=$(x git -C "$repo" ls-remote origin "${1}*") || die "gc: git ls-remote 실패: $repo"
  # ls-remote 무늬는 참조 이름 끝에도 맞으니(refs/heads/refs/integ/x) 접두로 다시 거른다
  refs=$(printf '%s\n' "$ls" | awk -F'\t' -v p="$1" 'index($2, p) == 1 && $2 !~ /\^\{\}$/')
  set --
  while IFS=$tab read -r s r; do
    [ -n "$r" ] || continue
    case $r in refs/heads/*) [ "${r#refs/heads/}" != "$base" ] && ! kept "${r#refs/heads/}" || continue ;; esac
    x git -C "$repo" cat-file -e "$s^{commit}" 2>/dev/null || set -- "$@" "$r"
  done <<EOF
$refs
EOF
  # 판정에 쓸 커밋만 받는다. --refmap=: refs/heads는 기본 refspec에 들어 이름만 줘도 origin/*를 고치므로 참조는 하나도 안 쓴다(dry-run도)
  [ $# = 0 ] || x git -C "$repo" fetch -q --no-write-fetch-head --refmap= origin "$@" || die "gc: 원격 참조 커밋을 받지 못했다"
  while IFS=$tab read -r s r; do
    [ -n "$r" ] || continue
    case $r in refs/heads/*)
      [ "${r#refs/heads/}" != "$base" ] || continue
      ! kept "${r#refs/heads/}" || { keep "$r" "남길 목록(gc.keep_branches)"; continue; } ;;
    esac
    ct=$(x git -C "$repo" show -s --format=%ct "$s") || { keep "$r" "커밋 시각을 읽지 못함"; err=1; continue; }
    jdg "$r" "$s" "$ct" || continue
    [ $dry = 0 ] || { gone_ "$r" "$s"; continue; }
    # 값이 ls-remote 때 그대로일 때만 지운다(그사이 다시 올린 참조는 남긴다). 되돌리기: git push origin <sha>:<참조>
    x git -C "$repo" push -q --force-with-lease="$r:$s" origin ":$r" >&2 || { keep "$r" "push 지우기 실패"; err=1; continue; }
    gone_ "$r" "$s"
  done <<EOF
$refs
EOF
}
keep() { echo "${P}남김 $1 $2"; kn=$((kn + 1)); }
gone_() { echo "${P}지움 $*"; dn=$((dn + 1)); }
gc_cmd() {
  dn=0 kn=0 err=0 self= tab=$(printf '\t') now=$(date +%s)
  kb=$(cfg gc.keep_branches "") || exit 1
  pairs=$(term_pairs); case $? in
    1) die "gc: hc ls 실패 — 작업 폴더를 쓰는 터미널을 확인하지 못해 아무것도 지우지 않았다" ;;
    2) die "gc: hc ls --json 출력을 읽지 못했다(형식이 바뀌었나?) — 아무것도 지우지 않았다" ;;
  esac
  if [ $remote = 0 ]; then :
  elif [ $dry = 1 ]; then echo "[dry-run] git fetch 건너뜀: 지금 있는 origin/$base 로 판정"
  else x git -C "$repo" fetch -q origin || die "gc: git fetch 실패: $repo"; fi
  x git -C "$repo" rev-parse -q --verify "$bref^{commit}" >/dev/null || die "gc: $blab 가 없다: $repo"
  cur=$(x git -C "$repo" symbolic-ref -q --short HEAD)
  wl=$(x git -C "$repo" worktree list --porcelain) || die "gc: git worktree list 실패: $repo"
  recs=$(printf '%s\n' "$wl" | awk -v OFS='\t' '
    /^worktree / { if (p != "") print p, h, b, l; p = substr($0, 10); h = "-"; b = "-"; l = "-"; next }
    /^HEAD / { h = substr($0, 6) } /^branch / { b = substr($0, 8) } /^locked/ || /^bare/ { l = "x" }
    END { if (p != "") print p, h, b, l }')
  while IFS=$tab read -r wt h b l; do
    [ -n "$wt" ] && [ "$wt" != "$repo" ] || continue
    branch=; case $b in refs/heads/*) branch=${b#refs/heads/} ;; esac
    [ "$l" = - ] || { keep "$wt" "잠긴 작업 폴더"; continue; }
    if [ -n "$branch" ] && { [ "$branch" = "$base" ] || [ "$branch" = "$cur" ]; }; then keep "$wt" "기본·현재 가지 $branch"; continue; fi
    gin "$h"; case $? in
      0) ;;
      1) keep "$wt" "$blab 에 안 들어감(${branch:-분리 HEAD} $(printf %.12s "$h"))"; continue ;;
      *) keep "$wt" "들어갔는지 확인하지 못함"; err=1; continue ;;
    esac
    x sh -c '[ -e "$1" ] || [ -L "$1" ]' hc-lane "$wt"; case $? in 0) dir=1 ;; 1) dir=0 ;; *) keep "$wt" "폴더를 확인하지 못함"; err=1; continue ;; esac
    if [ $dir = 1 ]; then
      busy=$(printf '%s\n' "$pairs" | busy_terms | cut -d' ' -f1 | tr '\n' ' ')
      [ -z "$busy" ] || { keep "$wt" "살아 있는 터미널 ${busy% }"; continue; }
      adm=$(x git -C "$wt" rev-parse --absolute-git-dir) || { keep "$wt" "git 관리 폴더를 찾지 못함"; err=1; continue; }
      # 나이는 status보다 먼저 본다(status가 index를 다시 쓰면 묵은 폴더가 새것으로 보인다). 0 오래됨, 1 새것, 그 밖 확인 못 함
      [ "$mins" = 0 ] || x sh -c 'm=$1; shift; for f; do [ -e "$f" ] || continue; o=$(find "$f" -prune -mmin -"$m") || exit 2
        [ -z "$o" ] || exit 1; done' hc-lane "$mins" "$adm/HEAD" "$adm/index" "$adm/logs/HEAD" "$wt"
      case $? in 0) ;; 1) keep "$wt" "새것(마지막 git 활동이 --min-age ${minage:-24h} 안)"; continue ;;
        *) keep "$wt" "나이를 확인하지 못함"; err=1; continue ;; esac
      # 멈춘 rebase·merge·cherry-pick·revert·bisect는 작업 폴더에만 있는 상태라 남긴다
      ip=$(x sh -c 'for s in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
        [ ! -e "$1/$s" ] || echo "$s"; done' hc-lane "$adm") || { keep "$wt" "진행 상태를 확인하지 못함"; err=1; continue; }
      [ -z "$ip" ] || { keep "$wt" "진행 중 $(echo $ip)"; continue; }
      # --no-optional-locks: 판정만 하므로 index를 다시 쓰지 않는다(dry-run도 아무것도 안 바꾸게)
      st=$(x git --no-optional-locks -c core.quotePath=false -C "$wt" status --porcelain --untracked-files=all --ignore-submodules=none) ||
        { keep "$wt" "git status 실패"; err=1; continue; }
      [ -z "$st" ] || { keep "$wt" "커밋 안 된 변경·untracked $(printf '%s\n' "$st" | grep -c .)개"; continue; }
      ig=$(x git --no-optional-locks -c core.quotePath=false -C "$wt" status --porcelain --ignored --untracked-files=normal) ||
        { keep "$wt" "git status --ignored 실패"; err=1; continue; }
      # ponytail: 보관물은 .qa/ 하나(QA 증거 폴더 관례). 다른 저장소에 보관 폴더가 생기면 여기에 더한다
      qa=$(printf '%s\n' "$ig" | sed -n 's/^!! //p' | grep -E '(^|/)\.qa(/|$)' | tr '\n' ' ')
      [ -z "$qa" ] || { keep "$wt" "무시된 보관물 ${qa% } (옮긴 뒤 hc-lane clean)"; continue; }
    fi
    what="${branch:+가지 $branch }$(printf %.12s "$h")"
    [ $dry = 0 ] || { gone_ "$wt" "$what"; continue; }
    if [ $dir = 1 ] && x test -f "$wt/.claude/herdr-teardown.sh"; then
      hook teardown || echo "hc-lane gc: herdr-teardown.sh 실패(정리는 계속): $wt" >&2
    fi
    # 셋(들어감·깨끗함·쓰는 터미널 없음)을 다 본 뒤라 강제로 지운다: 무시 파일은 같이, rebase로 들어간 가지는 -d가 거절하므로
    x git -C "$repo" worktree remove --force "$wt" >&2 || { keep "$wt" "git worktree remove 실패"; err=1; continue; }
    if [ -n "$branch" ]; then
      if [ "$(x git -C "$repo" rev-parse -q --verify "refs/heads/$branch")" = "$h" ]; then
        x git -C "$repo" branch -q -D "$branch" >&2 || { echo "hc-lane gc: 가지 $branch 를 지우지 못했다" >&2; err=1; }
      else echo "hc-lane gc: 가지 $branch 가 그사이 움직여 남겼다" >&2; fi
    fi
    gone_ "$wt" "$what"
  done <<EOF
$recs
EOF

  # 작업 폴더 없이 남은 로컬 가지: 기본·현재 HEAD·작업 폴더에 붙은 가지는 빼고 같은 판정. 나이는 커밋과 가지 reflog 가운데 늦은 쪽
  # 멈춘 rebase의 작업 폴더는 porcelain에 분리 HEAD로 보이니 rebase-*/head-name의 가지도 붙은 가지로 센다
  att=$({ printf '%s\n' "$recs" | cut -f3; x sh -c 'c=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir) || exit 0
    cat "$c"/rebase-*/head-name "$c"/worktrees/*/rebase-*/head-name 2>/dev/null; exit 0' hc-lane "$repo"; })
  bl=$(x git -C "$repo" for-each-ref --format='%(refname)%09%(objectname)%09%(committerdate:unix)' refs/heads) ||
    die "gc: git for-each-ref 실패: $repo"
  while IFS=$tab read -r r s ct; do
    [ -n "$r" ] || continue
    b=${r#refs/heads/}
    [ "$b" != "$base" ] && [ "$b" != "$cur" ] || continue
    ! printf '%s\n' "$att" | grep -Fxq -- "$r" || continue
    ! kept "$b" || { keep "가지 $b" "남길 목록(gc.keep_branches)"; continue; }
    rl=$(x git -C "$repo" reflog -1 --date=unix --format=%gd "$r" 2>/dev/null); rl=${rl##*@\{}; rl=${rl%\}}
    case $rl in ''|*[!0-9]*) ;; *) [ "$rl" -le "$ct" ] || ct=$rl ;; esac
    jdg "가지 $b" "$s" "$ct" || continue
    [ $dry = 0 ] || { gone_ "가지 $b" "$s"; continue; }
    # 판정한 값 그대로일 때만 지운다. 되돌리기: git branch <가지> <sha>
    [ "$(x git -C "$repo" rev-parse -q --verify "$r")" = "$s" ] || { keep "가지 $b" "그사이 움직임"; continue; }
    x git -C "$repo" branch -q -D -- "$b" >&2 || { keep "가지 $b" "git branch -D 실패"; err=1; continue; }
    gone_ "가지 $b" "$s"
  done <<EOF
$bl
EOF

  if { [ -n "$integ" ] || [ $rb = 1 ]; } && [ $remote = 0 ]; then echo "원격이 없어 --integ·--remote-branches 는 할 것 없음"
  else
    [ -z "$integ" ] || rgc "$integ"
    [ $rb = 0 ] || rgc refs/heads/
  fi
  echo "${P}지움 $dn · 남김 $kn"
  return $err
}

if [ $cmd = clean ] || [ $cmd = gc ]; then
  P=; [ $dry = 1 ] && P='[dry-run] '
  ${cmd}_cmd
  exit $?
fi

if [ $steps = 1 ]; then
  if [ $read = 1 ]; then read_steps; else print_steps; fi
  exit 0
fi

# 살아 있는 터미널과 이름이 겹치면 hc run이 실패하니, 아무것도 만들기 전에 막는다.
# (<t>는 ID로도 찾으니 출력의 이름까지 맞는지 본다)
live=$(hc get "${on:+$on/}$name" --json 2>/dev/null)
case $live in *"\"name\":\"$name\""*'"state":"live"'* | *'"state":"live"'*"\"name\":\"$name\""*)
  die "살아 있는 hc 터미널이 이미 이름 $name 을 쓴다(hc ls). 다른 --name 을 쓴다" ;;
esac

# 설정·{brief}도 아무것도 만들기 전에 본다
if [ -n "$swarg" ]; then swait=$swarg; case $swait in *[!0-9]*) die "--start-wait는 0 이상 정수(초): $swait" ;; esac
else
  swait=$(cfg lane.start_wait 60) || exit 1
  case $swait in ''|*[!0-9]*) die "설정 lane.start_wait는 0 이상 정수(초): $swait" ;; esac
fi
strust=$(cfg lane.auto_trust on) || exit 1
case $strust in on|off) ;; *) die "설정 lane.auto_trust는 on·off: $strust" ;; esac
poll=${HC_LANE_POLL:-2}
if [ -n "$brief" ]; then
  [ -f "$brief" ] || die "지시문 파일이 없다: $brief"
  if [ $# = 0 ]; then
    tpl=$(cfg lane.run "") || exit 1
    [ -n "$tpl" ] || die "-- 뒤 실행 명령도 설정 lane.run(실행 명령 틀)도 없다"
    eval "set -- $tpl" || die "설정 lane.run을 셸 문법으로 나누지 못했다: $tpl"   # 설정 파일은 믿는다(hc-fill launch 틀과 같다)
  fi
  bdir=$(cfg lane.brief_dir "") || exit 1
  if [ -n "$bdir" ]; then rb=${bdir%/}/$name-run.md
  else
    bd=$(cd "$(dirname -- "$brief")" && pwd -P) || die "지시문 폴더를 찾지 못했다: $brief"
    bf=${brief##*/} rb=$bd/${bf%.md}-run.md
  fi
fi
k=0; for a; do case $a in *'{brief}'*) k=1 ;; esac; done
if [ -n "$brief" ]; then [ $k = 1 ] || die "실행 명령에 {brief} 자리가 없다(지시문 사본 경로를 넣을 곳)"
else [ $k = 0 ] || die "실행 명령에 {brief} 자리가 있는데 --brief <지시문>이 없다"; fi

if [ $read = 1 ]; then
  cwd=$repo
  wt= branch=
else
  cwd=$wt
  [ $dry = 1 ] || [ $remote = 0 ] || x git -C "$repo" fetch -q origin || die "git fetch 실패: $repo"
  again="다른 이름은 --branch <이름>"
  x git -C "$repo" show-ref --verify -q "refs/heads/$branch" && die "로컬 브랜치 $branch 가 이미 있다. $again"
  [ $remote = 1 ] && x git -C "$repo" show-ref --verify -q "refs/remotes/origin/$branch" && die "원격 브랜치 origin/$branch 가 이미 있다. $again"
  x test -e "$wt" && die "워크트리 폴더가 이미 있다: $wt. $again"
  x git -C "$repo" rev-parse -q --verify "$bref^{commit}" >/dev/null || die "$blab 가 없다: $repo"
fi

# --brief: 지시문(+착지·정리 절차)을 대상 기계 사본 자리에 두고, 실행 명령의 {brief}를 그 경로로(~는 그 기계 집으로 펼친 것)
if [ -n "$brief" ]; then
  if [ $dry = 1 ]; then
    echo "[dry-run] 지시문 사본 ${on:+$on:}$rb ← $brief + $([ $read = 1 ] && echo '판정 알림' || echo '착지·정리 절차')"
  else
    got=$({ cat "$brief"; echo; if [ $read = 1 ]; then read_steps; else print_steps; fi; } | xi sh -c 'f=$1
      case $f in "~"/*) f=$HOME/${f#"~/"} ;; esac
      mkdir -p "${f%/*}" && cat >"$f" && printf %s "$f"' hc-lane "$rb") && [ -n "$got" ] ||
      die "지시문 사본을 ${on:+$on 의 }$rb 에 두지 못했다${on:+ (그 기계에 그 경로를 쓸 수 없으면 설정 lane.brief_dir)}"
    rb=$got
  fi
  n=$#
  for a; do   # 패턴 제거로 나눠 붙인다(${a//…/…}는 bash 5.2에서 & 를, 3.2에서 따옴표를 다르게 읽는다)
    r=
    while case $a in *'{brief}'*) true ;; *) false ;; esac; do r=$r${a%%"{brief}"*}$rb a=${a#*"{brief}"}; done
    set -- "$@" "$r$a"
  done
  shift $n
fi
if [ $read = 1 ]; then set -- env "HC_LANE=$name" "LANE_REPO=$repo" "LANE_BASE=$base" "$@"
else set -- env "HC_LANE=$name" "LANE_REPO=$repo" "LANE_WORKTREE=$wt" "LANE_BRANCH=$branch" "LANE_BASE=$base" "$@"; fi

# start_check <주소>: 띄운 직후 Claude 폴더 신뢰 질문을 넘기고 hc get status가 잡히는지 본다.
# start=ok|no_status|login|keychain, 종료 0·5·6·7. 실패여도 터미널은 남긴다(사람이 로그인하면 이어질 수 있다 — hc-fill 「상태 안 잡힘」과 같다).
# 신뢰 질문 글자는 2026-11-16 Claude 2.1 실측: 「❯ No, exit」(기본) 「  Yes, I trust this folder」, 그동안 status는 null.
start_check() {
  end=$(($(date +%s) + swait)) tr= why=
  while :; do
    g=$(hc get "$1" --json 2>/dev/null)
    if printf %s "$g" | grep -Eq '"status" *: *\{'; then start=ok; return 0; fi
    if printf %s "$g" | grep -Eq '"state" *: *"finished"'; then why="터미널이 끝났다"; break; fi
    if [ -z "$tr" ]; then
      scr=$(hc read "$1" 2>/dev/null)
      case $scr in *'Accessing workspace'*|*'trust this folder'*|*'Do you trust'*|*'one you trust?'*)
        if [ $strust = off ]; then tr=off
        elif printf '%s\n' "$scr" | grep -Fq 'Is this a project you created or one you trust?' &&
          printf '%s\n' "$scr" | grep -Eq '^ *(❯ | +)No, exit *$' && printf '%s\n' "$scr" | grep -Eq '^ *(❯ | +)Yes, I trust this folder *$'; then
          # 커서(❯)가 「No, exit」(기본)이면 아래로 한 칸, 이미 신뢰에 있으면 엔터만
          # 커서가 어느 줄에도 안 보이면(글리프가 다름 등) 「모름」: 엔터가 「No, exit」에 갈 수 있다
          if printf '%s\n' "$scr" | grep -Eq '^ *❯ No, exit *$'; then set -- "$1" down enter
          elif printf '%s\n' "$scr" | grep -Eq '^ *❯ Yes, I trust this folder *$'; then set -- "$1" enter
          else set -- "$1"; fi
          if [ $# = 1 ]; then tr=unknown; echo "hc-lane: 모름 — 시작 화면 확인($1): 신뢰 질문에 커서(❯)가 안 보여 건드리지 않았다" >&2
          elif hc keys "$@" >/dev/null; then tr=passed; echo "hc-lane: 신뢰 질문 넘김($1)"
          else tr=unknown; echo "hc-lane: 모름 — 시작 화면 확인($1): 신뢰 질문 키를 보내지 못했다" >&2; fi
        else tr=unknown; echo "hc-lane: 모름 — 시작 화면 확인($1): 신뢰 질문 같은데 글자가 달라 건드리지 않았다(hc read $1)" >&2
        fi ;;
      esac
    fi
    [ "$(date +%s)" -lt "$end" ] || break
    sleep "$poll"
  done
  [ -n "$why" ] || why="${swait}초 안에 hc get status가 안 잡혔다"
  case $tr in unknown) why="$why, 신뢰 질문 모름" ;; off) why="$why, 신뢰 질문(lane.auto_trust off)" ;; esac
  scr=$(hc read "$1" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 15)
  if hit=$(printf '%s\n' "$scr" | grep -iE -m 1 'keychain|errSec'); then start=keychain rc=7 k=키체인
  elif hit=$(printf '%s\n' "$scr" | grep -iE -m 1 'login expired|/login|not logged in|log ?in again|invalid api key|oauth token|authentication_error|unauthorized|(^|[^0-9])401([^0-9]|$)'); then
    start=login rc=6 k=로그인·인증
  else start=no_status rc=5 k= hit=; fi
  hit=$(printf %s "$hit" | sed 's/^[[:space:]]*//' | cut -c 1-160)
  echo "hc-lane: 시작 안 됨 $1: $why${k:+ — 막힘($k): $hit}. 터미널은 남겼다(hc read $1). 다른 기계로 옮기려면 이 레인 작업 폴더를 정리하고 다시 띄운다" >&2
  return $rc
}

start= rc=0
if [ $dry = 1 ]; then
  if [ $read = 0 ]; then
    [ $remote = 0 ] || echo "[dry-run] git -C $(q "$repo") fetch -q origin"
    echo "[dry-run] git -C $(q "$repo") worktree add --track -b $branch $(q "$wt") $bref"
    echo "[dry-run] ($blab 에 .claude/herdr-setup.sh 가 있으면) 워크트리에서 bash .claude/herdr-setup.sh"
  fi
  printf '[dry-run] hc run --bg --json --name %s --label hc-lane=1 --cwd %s%s' "$name" "$(q "$cwd")" "${on:+ --on $on}"
  for a in "$@"; do printf ' %s' "$(q "$a")"; done
  echo
  if [ $read = 1 ]; then read_steps; else print_steps; fi
  addr=
else
  if [ $read = 0 ]; then
    # --track: branch.autoSetupMerge 설정과 무관하게 upstream을 붙여 착지 뒤 branch -d가 통한다.
    x git -C "$repo" worktree add -q --track -b "$branch" "$wt" "$bref" || die "워크트리를 만들지 못했다: $wt"
    if x test -f "$wt/.claude/herdr-setup.sh"; then
      if ! hook setup; then
        x tail -n 20 "$log" >&2
        die "herdr-setup.sh 실패, 레인을 띄우지 않았다. 워크트리 $wt, 기록 $log${on:+ (기계 $on)}. 지우려면: $undo"
      fi
    fi
  fi
  out=$(hc run --bg --json --name "$name" --label hc-lane=1 --cwd "$cwd" ${on:+--on "$on"} "$@") ||
    die "hc run 실패, 레인을 띄우지 않았다.${wt:+ 워크트리 $wt 는 남겨 둠. 지우려면: $undo}"
  addr=$(printf %s "$out" | sed -n 's/.*"address":"\([^"]*\)".*/\1/p' | head -n 1)
  [ -n "$addr" ] || printf 'hc-lane: hc run 출력에서 주소를 읽지 못했다(hc ls --json 으로 확인): %s\n' "$out" >&2
  if [ $read = 1 ]; then read_steps; else print_steps; fi
  if [ "$swait" = 0 ]; then start=off
  elif [ -n "$addr" ]; then start_check "$addr"; rc=$?; fi
fi

pre=; [ $dry = 1 ] && pre='[dry-run] 띄울 '
if [ $read = 1 ]; then
  echo "${pre}레인 $name${addr:+($addr)}${on:+ @$on}: 읽기 전용, 저장소 폴더 $repo 에서 실행"
else
  echo "${pre}레인 $name${addr:+($addr)}${on:+ @$on}: 워크트리 $wt, 브랜치 $branch, 기준 $blab"
fi
printf '{"lane":"%s","name":"%s","on":"%s","read":%s,"dry_run":%s,"repo":"%s","worktree":"%s","branch":"%s","base":"%s","brief":"%s","start":"%s"}\n' \
  "$(j "$addr")" "$name" "$(j "$on")" "$([ $read = 1 ] && echo true || echo false)" "$([ $dry = 1 ] && echo true || echo false)" \
  "$(j "$repo")" "$(j "$wt")" "$(j "$branch")" "$(j "$base")" "$(j "${rb-}")" "$start"
exit $rc
