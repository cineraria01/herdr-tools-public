#!/bin/bash
# hc-lane: 커밋하는 레인을 자기 git 워크트리에서 hc run으로 띄우고, `hc-lane land`로 착지, `hc-lane clean`으로 정리한다
# (2026-11-04 사용자 결정, 합의안 2단계 G. clean은 2026-11-05 hc-lane-fix1. land·guard와 저장소 훅 이름 .claude/herdr-*.sh는
# 2026-11-16 사용자 결정 「wt-*.sh 는 완전 안쓰고 싶은대」 「새로운 방식으로 전체 적용해서 전체 같이 관리 되도록」 — 옛 이름 갈래 없음).
# 대기열·잠금·상태 파일·훅 없음. 의존은 git·hc뿐, 맥 /bin/bash 3.2에서 돈다.
# hc run은 호출자 환경을 넘기지 않아서 LANE_* 는 `env K=V <명령…>`으로 감싸 넘긴다.
set -u

die() {
  printf 'hc-lane: %s\n' "$*" >&2; [ "${cmd-}" != clean ] || cj stopped "$*"
  # 병합기가 멈추면 막힘 사건(감사 land-merge-train-2 중간 4 — main에 쓰는 곳이 하나라 조용히 서면 전체 착지가 선다)
  [ -z "${mgrun_-}" ] || (mgrun_=; report_cmd 막힘 - "병합기 멈춤: $* (클론 ${top:-?})" --name merger) >/dev/null 2>&1
  exit 1
}
j() { printf %s "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
cj() {  # clean 결과 JSON 한 줄(앞에서 멈춰 아직 정하지 않은 값은 빈 값)
  printf '{"clean":"%s","reason":"%s","dry_run":%s,"on":"%s","repo":"%s","worktree":"%s","branch":"%s","base":"%s","teardown":"%s"}\n' \
    "$1" "$(j "${2-}")" "$([ "${dry-0}" = 1 ] && echo true || echo false)" "$(j "${on-}")" "$(j "${repo-}")" "$(j "${wt-}")" \
    "$(j "${branch-}")" "$(j "${base-}")" "${td-none}"
}
usage() {
  cat >&2 <<'EOF'
사용법: hc-lane [--on <기계>] [--read | --direct] [--branch <이름>] [--dry-run] [--print-steps] [--brief <지시문>]
               --name <레인> --repo <저장소 경로> [-- <실행 명령…>]
  기본          fetch → <저장소>.wt/<브랜치>에 origin/<기본> 기준 워크트리 → .claude/herdr-setup.sh(있으면) → hc run --bg
                쓰기 레인은 hc run 직전에 레인 임대 refs/hc-lanes/<레인>을 없을 때만 잡는다(아래 lease): 이미 있으면 「이미 돎」 종료 10,
                조회·push 실패면 종료 1 — 둘 다 띄우지 않고 방금 만든 워크트리를 되돌린다. 레인 환경 HC_LANE_LEASE = 그 임대 값
                원격 origin이 없는 저장소는 fetch 없이 로컬 <기본>(main, 없으면 master) 기준
                (모든 git fetch는 같은 클론의 참조 잠금 경합(cannot lock ref 등)이면 1·2·4초 쉬고 3번까지 다시)
                메인 폴더 앞당김: fetch 뒤(--read도 fetch 뒤)와 land 착지 뒤, 메인 폴더가 기본 브랜치이고 추적 파일 변경·진행 중인
                merge/rebase·skip-worktree 표시가 없고 메인 폴더를 cwd로 쓰는 working·blocked 터미널(자신 빼고)이 없으면
                git merge --ff-only --no-overwrite-ignore origin/<기본>. 못 하면(추적 안 된·무시된 파일과 부딪혀 git이 거절 포함) 경고
                한 줄 「메인 폴더 앞당김 건너뜀: <까닭>」 뒤 그대로 둔다(레인·착지는 그대로 진행. stash·reset 안 씀)
  --read       워크트리 없이 --repo 폴더 그대로에서 띄운다(조사·감사처럼 커밋하지 않는 레인). 저장소 안 하위 폴더나
                저장소가 아닌 폴더도 된다(맨 hc run 대신 쓰면 아래 시작 확인을 받는다)
  쓰기 레인은 대기열로: 지휘 터미널($HC_TERMINAL_ID가 살아 있고 레인·감시 터미널이 아님)이 쓰기 레인을 HC_LANE_FILL=1(hc-fill) 없이
                띄우면 아무것도 만들기 전에 「쓰기 레인은 hc-fill add로 대기열에 넣는다 …」와 종료 2. 레인 안(HC_LANE)·터미널 밖·
                판정 못 함(hc get 실패)·--read·--print-steps·--dry-run은 막지 않는다
  --direct      그래도 지금 이 자리에 띄운다(오류 출력 「대기열 밖에서 띄움(--direct)」, 레인 기록 lanes.tsv 넷째 칸 direct)
  --branch      브랜치 이름(기본: 레인 이름). 워크트리 폴더 이름은 브랜치의 / 를 - 로 바꾼 것
  --on          git·설정·실행을 그 기계에서(hc exec/run --on). --repo는 그 기계의 절대 경로(로컬 ~ 펼침 주의).
                설정 단계는 그 기계에 zsh·~/.zshrc가 있으면 그걸 읽고 돈다(hc 코어 PATH에 bun 등이 없다)
                띄운 레인은 맥 Herdr 창의 그 기계 공간(이름 = 기계)에 탭으로 보인다(hc run --label herdr.space=<id>, 창 없으면 알림만)
  --dry-run     만들지도 띄우지도 않고 할 일과 착지 절차만 출력
  --print-steps 레인 지시문에 붙일 착지·정리 절차만 출력(실행 명령 불필요)
  --brief       지시문에 착지·정리 절차(--read는 판정 알림)를 붙인 실행용 사본을 대상 기계에 두고, 실행 명령의 {brief}
                자리에 그 경로를 넣는다. 사본 자리: 설정 lane.brief_dir(그 기계 경로, ~ 는 그 기계 집)/<레인>-run.md,
                없으면 지시문과 같은 폴더의 <이름>-run.md. -- 뒤 명령이 없으면 설정 lane.run 틀(셸 문법)
  설정 lane.notify no면 hc run --no-notify(hc가 지휘 입력에 종료·막힘을 넣지 않음 — 지휘가 hc-lane wait를 늘 걸 때만)
  HC_LANE_FILL=1(hc-fill)이면 hc run --no-parent(대기열 레인·감사 줄은 부른 터미널이 끝나도 함께 꺼지지 않게)
  띄운 뒤       화면에 Claude 폴더 신뢰 질문(「❯ No, exit」·「Yes, I trust this folder」)이 보이면 그 터미널에만 신뢰를 고른다
                (설정 lane.auto_trust off면 안 함). 글자가 다르면 건드리지 않고 「모름 — 시작 화면 확인」.
                외부 가져오기 질문(「Allow external CLAUDE.md file imports?」)은 목록 경로가 모두 작업 폴더의 git 저장소
                안일 때만 허용을 고른다(lane.auto_trust off면 안 함). 밖이 하나라도 있으면 「모름 — 외부 가져오기 질문(<경로>)」, 종료 5
                --start-wait <초>(이 호출만) 또는 설정 lane.start_wait초(기본 60, 0이면 이 단계를 끔. status를 내지 않는
                명령·CLI는 0으로) 안에 hc get status가 안 잡히면 화면 끝에서 막힘 낱말을 찾아
                한 줄로 알리고 종료 5 시작 안 됨(원인 모름·신뢰 질문·끝남), 6 로그인·인증 막힘, 7 키체인 막힘(터미널은 남긴다)
                status가 잡힌 뒤 설정 lane.first_turn_wait초(기본 60, 0이면 끔) 안에 turn > 0 또는 status working을
                한 번도 못 보면 사건 막힘 「첫 턴 없음 <주소>」과 start noturn(종료 0). hc-fill에는 첫 status에서 start ok와
                주소를 돌려주고 따로 감시한다(진단은 hc-lane/watch.log).
       hc-lane clean [--on <기계>] [--dry-run] [--archive] --repo <저장소 경로> (--branch <브랜치> | --name <레인>)
  clean         착지한 레인의 워크트리·브랜치를 지운다: fetch 뒤 브랜치(와 워크트리 HEAD)가 origin/<기본>에
                들어갔는지 → 추적 변경·무시되지 않은 untracked가 없는지(등록이 지워지고 폴더만 남았으면 저장소
                .gitignore로) 확인하고, 하나라도 걸리면 아무것도 지우지 않고 멈춘다(종료 1) → .claude/herdr-teardown.sh
                (있으면, 실패해도 계속) → worktree remove → 남은 무시 파일 폴더 삭제 → branch -d
                무시된 보관물 .qa/(어느 깊이든)는 teardown 전에 메인 폴더(첫 작업 트리)의 같은 자리로 복사(덮지 않음)하고
                「옮김 <워크트리>/.qa → <메인>/.qa」 한 줄. 같은 이름의 다른 파일·복사 실패·메인 폴더 없음이면 멈춤(안 지움)
                --archive(명시할 때만): 다른 곳에서 rebase돼 착지해 안 들어간 것으로 보이는 가지도, 작업 폴더가 깨끗하면 안 들어간
                커밋을 원격 refs/archive/<가지>-<sha8>에 push해 보관한 뒤 같은 절차로 지운다(가지는 보관한 값일 때만 지움).
                push가 하나라도 실패하면 아무것도 지우지 않는다. 되살리기: git fetch origin refs/archive/<가지>-<sha8>
       hc-lane fetch [--on <기계>] --repo <저장소 경로> [<참조…>]
  fetch         그 기계 저장소에서 git fetch origin [<참조…>]. --on이면 hc exec로, zsh·~/.zshrc가 있으면 그걸 읽은 셸에서
                (맨 ssh·hc 코어 환경에는 git 자격 도우미 PATH가 없다). 종료 0 받음, 1 실패
레인 환경: HC_LANE LANE_REPO LANE_WORKTREE LANE_BRANCH LANE_BASE (--read는 HC_LANE LANE_REPO LANE_BASE), HC_LANE_OWNER가 있으면 그것도
(주인 지휘 — 레인 기록 셋째 칸, 레인 안에서 띄운 하위 레인도 물려받음), HERDR_LAND_PRIORITY가 있으면 그것도(hc-fill이 넣는
착지 줄 우선 — 이 레인을 기다리는 대기 줄 수). hc run 라벨 hc-lane=1
       hc-lane early-wait <선행 레인>…   (먼저 띄움 레인의 기다림 블록이 기한 뒤에 부른다)
  early-wait    hc-fill이 이 기계에 써 준 선행 상태(~/.local/share/hc-fill/after.tsv)로 선행마다 「<선행>: <까닭>」. 모두 go이고 기록이
                15분 안이면 「선행이 살아 진행 중 …」과 종료 0(계속 기다림), 기록 없음·묵음·stop이면 1, 인자 없으면 2
       hc-lane land [<기본 브랜치>]   (레인 작업 폴더 안에서)
  land          착지: .claude/herdr-land.sh가 있으면 HERDR_LAND=1 HERDR_LAND_PRIORITY=<수, 없거나 숫자 아니면 0> bash .claude/herdr-land.sh <기본>. 없으면
                fetch → rebase origin/<기본> → .claude/herdr-verify.sh(없으면 실패, push 안 함) →
                HERDR_LAND=1 git push origin HEAD:<기본>(fast-forward만, 거절이면 fetch부터 HERDR_LAND_TRIES번, 기본 5)
                origin이 없으면 fetch·push 대신 로컬 <기본> 기준으로 rebase하고, 메인 클론의 로컬 <기본>을 fast-forward로 올린다
                (<기본>이 체크아웃된 폴더면 그 폴더에서 merge --ff-only, 아니면 update-ref. 앞서 나갔으면 처음부터 다시)
                rebase가 내용 충돌로 멈췄는데 rerere가 기록한 풀이로 그 충돌 경로를 모두 풀었으면(미병합·rerere remaining 없음)
                GIT_EDITOR=true git rebase --continue로 이어 간다. 일부만 풀렸거나 충돌이 아닌 중단(훅 등)이면 멈춘 그대로 종료 3
                (쓰기 레인 작업 트리를 만들 때 저장소에 rerere.enabled·rerere.autoUpdate가 정해져 있지 않으면 true로 켠다)
                원격이 있으면 main push에 --atomic으로 착지 표식 refs/hc-landed/<레인>/<UTC 초>(= 착지한 커밋)와 이 레인 임대 지우기
                (HC_LANE_LEASE 값 lease)를 함께 싣는다(herdr-land.sh에는 HERDR_LAND_PUSH_EXTRA로 넘김). 못 실었으면 착지 뒤 따로
                종료 0 착지, 1 검증 실패·검증 없음·push 실패·인자 오류, 3 rebase 충돌, 4 거절 횟수 넘음
                검증(herdr-land.sh면 그 전체) 출력은 화면 그대로 + ${XDG_STATE_HOME:-~/.local/state}/hc-lane/land-logs/<레인>-<시각>-<pid>.log
                (14일 지난 것은 지움). 실패면 실패 줄(--- FAIL·FAIL <패키지>·panic·(fail)·✗·✖·not ok, 최대 40줄 — 이번에 생긴
                .qa/<날짜>/herdr-verify-* 폴더의 *.log도 뒤짐)·그 폴더·「전체 로그 <경로>」를 오류 출력에, $HC_LANE이면 중간 사건에도 경로
                병합기가 켜진 저장소(원격 참조 refs/herdr/merger/<병합기 기계>가 있음 — hc-fill 설정 「merger <프로젝트> <기계>」가
                켜고 끔)에서는 착지 대신 제출: HEAD를 refs/heads/lane/<레인> + refs/merge-queue/<UTC초>-<레인> + 제출 기록에 한 번의
                원자 push(같은 레인의 옛 표식은 지움, 기본 브랜치는 안 건드림), 접수가 확인되면 「중간 <sha> 제출 <ID> → <큐>」 사건과
                끝 줄 「제출 …」, 종료 0(이미 들어간 커밋이면 할 것 없음 0). 켜졌는지(원격 설정·켬 표식) 못 읽으면 착지하지 않고 75.
                HERDR_MERGER=1이면 늘 착지. HERDR_LAND_AFTER는 최소판에 없다(주면 1). clean은 원격 lane/*에 그 SHA 그대로 있는 가지를 「제출됨」으로 지운다.
                HERDR_LAND_PUSH_EXTRA="<git push 인자> …"(refspec — 왼쪽 HEAD = 기본 브랜치에 넣는 커밋 — 와 --force-with-lease=<참조>:<SHA>;
                병합기는 「:<큐> --force-with-lease=<큐>:<SHA>」와 HEAD:refs/hc-landed/<제출 ID>)면 기본 브랜치와 한 번의 --atomic push로
                싣고, lease 참조가 바뀌었으면(재제출) 기본 브랜치를 올리지 않고 종료 6. 병합기 안 착지(HERDR_MERGER=1)는 기본 브랜치에
                .claude/herdr-land.sh가 있으면 그 기본 브랜치 판(제출 트리 속 판 아님)에 맡기고, 기본 브랜치에 없는 스크립트가 작업 트리에
                있거나 rebase로 막 생겼으면 종료 7. 이 둘(과 HERDR_MERGER)은 검증 자식에 물려주지 않는다
       hc-lane merger --repo <병합기 전용 클론> [--once] [--tick <초>] [<기본 브랜치>]   (병합기 기계에서 하나만)
  merger        큐(refs/merge-queue/*)를 이름 순으로 하나씩 — 새 임시 작업 트리에서 준비 훅(.claude/herdr-setup.sh, 있으면) 뒤
                레인 이름 그대로의 로컬 가지로 HERDR_MERGER=1 hc-lane land, 큐 표식은 HERDR_LAND_PUSH_EXTRA로 기본 브랜치 push가 함께
                지운다. 기본 브랜치에 없는 .claude/herdr-land.sh를 제출이 새로 들이면 반송, 종료 7은 일시 실패. 바퀴마다 켬 표식이 이 기계(HC_LANE_MACHINE,
                없으면 hostname -s)인지 보고, 꺼졌으면 쉬고 다른 기계면 멈춘다. 표식은 길 안내일 뿐 — 정확성은 기본 브랜치 CAS
                (큐 참조를 건드리는 원격 쓰기는 모두 그 큐의 지금 SHA에 lease). 후보는 매번 새 임시 작업 트리(<git 폴더>/hc-merger/wt).
                착지 전에 일지(<git 폴더>/hc-merger/cur: 가지·기준·후보·제출)를 쓰고, 바퀴마다 새로 고르기 전에 그 일지부터 정리
                (원격 refs/hc-landed/<제출 ID>가 기본 브랜치의 조상 → 완료, 그 밖 → 후보 버림·제출은 큐에 남았으면 처음부터).
                착지 종료와 상관없이 원격이 후보를 담았나를 먼저 본다. 다른 기본 브랜치로 낸 제출은 건드리지 않음.
                일시 실패(75·4·원격 받기·push 결과 모름)는 큐에 두고 3번 넘으면 돌려보냄. git 조회 실패는 모두 「모르면 안 함」.
                들어가면 제출 기록을 refs/merge-done/<레인>으로 옮기고 lane 가지를 지운 뒤 「착지」 사건(--name <레인>, 제출 때 지휘가
                있으면 --to, 레인 터미널이 살아 있으면 hc send). 실패면 표식을 refs/merge-failed/<이름>으로 옮기고
                (lane 가지는 둠) 「막힘」 사건(까닭·로그 …/hc-lane/merger-logs/). 사건은 보낼 함(hc-merger/out)을 거쳐 끊겨도 다음
                바퀴가 보내고, 한 제출에 한 번만(사건·일지에 「제출 ID <ID>」 열쇠가 이미 있으면 안 적음). 잠금은 잠금 파일의 flock(착지 자식까지 물려받음). GOCACHE가 없으면
                ~/.cache/go-build. 빈 바퀴는 --tick초(기본 30) 쉼, --once는 큐가 빌 때까지(원격 오류·일시 실패로 남긴 바퀴면 75).
                전용 클론 = 레인 작업 트리를 두지 않는 클론. 종료 75 이미 돎(또는 그 착지가 아직 돎)
       hc-lane gc [--on <기계>] [--dry-run] [--integ[=<접두>]] [--remote-branches] [--min-age <시간>] --repo <저장소 경로>
  gc            끝난 레인 정리: 연결된 작업 폴더마다 HEAD가 origin/<기본>에 다 들어갔고(조상이거나 git cherry에 + 없음)
                깨끗하고(추적 변경·untracked 없음, 무시된 보관물 .qa/ 없음) 그 폴더를 cwd로 쓰는 hc 터미널이 없고
                마지막 git 활동이 --min-age보다 오래됐을 때만 teardown → worktree remove --force → branch -D.
                작업 폴더 없이 남은 로컬 가지(기본·현재 HEAD·작업 폴더에 붙은 가지·설정 gc.keep_branches 무늬 빼고)도 같은 판정에
                커밋·가지 reflog가 --min-age보다 오래됐으면 branch -D(「지움 가지 <가지> <sha>」, 되돌리기 git branch <가지> <sha>).
                --integ: 원격 <접두>*(기본 refs/integ/) 가운데 커밋이 origin/<기본>에 다 들어갔고 --min-age보다 오래된 것만
                지운다(값이 그대로일 때만). --remote-branches: 원격 refs/heads/*(기본 가지·gc.keep_branches 빼고)도 같은 꼴로.
                안 들어간 가지는 지우지 않고 「남김 <가지> 안 들어감 <n>개 · 마지막 <날짜>」. --min-age 기본 24h(숫자에 s·m·h·d,
                단위 없으면 시간). 메인 폴더·기본 가지·tags·claims는 안 건드린다. 마지막 줄 「지움 n · 남김 m」. 오류 종료 1
       hc-lane guard install|status|remove --repo <저장소 경로> [--branch <기본 브랜치>(install, 기본: origin/HEAD)]
  guard         그 클론의 공용 git 폴더 hooks/pre-push(워크트리 모두에 먹음)에 관문을 넣는다: refs/heads/<기본>으로 가는
                push는 HERDR_LAND=1일 때만 받고, 아니면 새 착지 줄을 알리고 거절한다. 다른 브랜치·참조는 통과.
                다른 pre-push 훅이 있거나 core.hooksPath가 있으면 건드리지 않고 멈춘다. remove는 자기가 넣은 것만 지운다.
                status 종료: 0 깔림, 1 없음, 3 다른 훅. 원격이 하나도 없는 저장소는 push가 없어 「설치할 것 없음」(종료 0)
       hc-lane lease show|drop [--on <기계>] --repo <저장소 경로> --name <레인>
  lease         레인 임대 refs/hc-lanes/<레인>(프로젝트 원격). 쓰기 레인은 hc run 직전에 없을 때만 만들어 잡고(이미 있으면 「이미 돎」
                종료 10, 조회·push 실패도 안 띄움 — 종료 1), land 성공(main과 같은 원자 push)·clean에서 놓는다. 그 밖(레인이 죽음·
                지휘가 hc-fill rm)으로 임대가 남아 다시 못 띄우면 이 drop으로 손으로 놓는다. show: 「값 제목」 또는 「-」
       hc-lane report <중간|완료|착지|막힘|판정|제출> [<sha>|-] [<한 줄>…] [--name <레인>] [--to <지휘>[,…]]   (레인 안에서)
  report        이 기계 ${XDG_STATE_HOME:-~/.local/state}/hc-lane/events.tsv에 한 줄을 더한다(지우지 않음):
                시각(UTC)·기계(HC_LANE_MACHINE, 없으면 hostname)·터미널($HC_TERMINAL_ID)·레인·상태·sha·한 줄(탭·줄바꿈은 빈칸)·
                그때의 hc turn(터미널 밖이면 -). 옛 7칸 줄도 읽는다.
                레인 이름은 --name → $HC_LANE(hc-lane이 띄울 때 넣음) → hc 터미널 이름 → 작업 트리 가지(기본 가지면 -) 순. sha 자리가 sha가 아니면 한 줄로 본다
                --to: 받을 지휘를 정한다(아홉째 칸) — 그 지휘들의 watch만 보낸다(레인 주인 판정 대신. hc-fill 「놀고 있음」 알림)
       hc-lane watch --to <지휘 주소> [--all | --on <기계>…] [--state <상태,…>] [--since <시각>] [--mine]
  watch         늘 도는 감시: wait와 같은 판정·같은 커서(seen.<지휘 주소> — wait와 겹쳐 두 번 알리지 않음)로 새 사건이 생기면
                지휘 터미널에 hc send <지휘> "hc-lane: <레인> <상태> <sha> <한 줄> (<터미널>) ‖ …" 한 번(보낸 뒤에만 커서에 적음,
                실패면 다음 바퀴에 다시). 바퀴는 설정 lane.watch_tick초(기본 30). 같은 지휘로 하나만(뒤 것은 종료 75).
                지휘가 질문·권한 창을 띄운 동안(hc get status blocked, status null이면 화면 맨 아래 덩어리 — 평소 입력 칸이 없고
                마지막 가로줄 아래에 lane.watch_dialog 글자)은 보내지 않고 창이 닫힌 뒤 한 번에. 상태를 못 읽으면 보냄. status blocked는
                lane.watch_hold_max분(기본 30, 0이면 막지 않음) 넘으면 보냄, 화면으로 잡은 창은 넘어도 안 보내고 watch.log에 한 줄.
                못 읽은 기계는 「연결 안 됨 <기계>」 한 번 보내고 다음 바퀴에 다시 본다(sh를 띄울 수 없는 기계 — 예: Windows — 는
                레인 기록이 없는 것으로 보고 건너뛴다). hc ls 실패는 시작·회복 때 한 번씩.
                끝남(종료 0): 지휘 터미널이 3바퀴 이어 hc get에 없거나 끝남(연결 실패는 세지 않음), 또는 그 지휘의 살아 있는
                레인(라벨 hc-lane=1, parent 모르면 그 지휘 것)도 hc-fill 대기열의 wait 요청도 새 사건도 없이
                lane.watch_idle분(기본 60). 레인·감사를 띄울 때 hc-lane이 지휘(HC_LANE_COORD — hc-fill이 대기열 주인 지휘, 없으면
                hc-lane coord로 넘김 —, 없으면 $HC_TERMINAL_ID)의 watch가 없으면 hc run --bg --no-notify --rm --name lane-watch-<지휘>
                --label hc-lane-watch=1 로 저절로 띄운다(--all). 바퀴마다·보낼 때마다 자기 지휘 정보(coord.<주소>)와 맞춰 보고
                다르면 안 보내고 끝냄. 사건은 레인 기록(lanes.tsv — HC_LANE_OWNER가 있으면 그 지휘, 없으면 띄운 지휘 터미널.
                없으면 hc parent)의 지휘 watch만 보내고, 주인을 모르거나(-) 그 지휘가 사라진 레인의 사건은 살아 있는 모든 지휘
                watch가 보낸다(넘겨받지 않음, 지휘마다 자기 커서로 한 번, sent에 안 적음)
       hc-lane coord [--set [<주소>] | --check <주소>]
  coord         지휘마다의 지휘 정보 …/hc-lane/coord.<주소>(주소·pid·이름·마지막 레인 띄운 시각 — 지휘 터미널이 레인을 띄우거나
                wait·watch를 걸 때, hc-fill add 때 남김) 가운데 지금 hc get pid·이름이 같고 가장 최근에 레인을 띄운 지휘의 주소를 찍고 0,
                없으면 「지휘 없음 — <까닭>」과 1. --set: 그 지휘(기본 $HC_TERMINAL_ID)의 지휘 정보를 지금 시각으로 남기고 주소를
                찍는다(살아 있는 지휘 터미널이 아니면 종료 1). --check: 그 지휘가 지금 살아 있고 지휘 정보와 맞으면 0,
                다름·없음 1, 모름 2(아무것도 안 씀 — hc-fill이 대기열 주인을 넘기기 전에 본다)
       hc-lane send --all [--audits] [--from <지휘 주소>] [--] <글…>   (hc-lane broadcast <글…> = send --all)
  send          이 지휘($HC_TERMINAL_ID 또는 --from)가 띄운 살아 있는 레인 전부(원격 포함 — 레인 기록 lanes.tsv의 마지막 지휘,
                없으면 hc parent)에 hc send. 감사(레인 기록 read·이름 audit-*)는 --audits일 때만. 한 줄씩 「보냄|실패 <주소> <레인>」,
                끝 줄 「보냄 n · 실패 m」. 종료 0 다 보냄(대상 없음 포함), 1 보내기·hc ls 실패, 2 인자(--all 없음 포함)
       hc-lane events [--all | --on <기계>…] [--since <시각|30m·2h·1d>]
  events        이 기계(와 --all이면 hc machine ls의 연결된 기계마다 hc exec --on 한 번)의 events.tsv를 시각 순으로.
                원격 줄의 기계·터미널은 hc 이름(<기계>/<t…>)으로 바꿔 찍는다. 읽지 못한 기계는 「모름 <기계>」 한 줄
                sh를 띄울 수 없는 기계(예: Windows)는 레인 기록이 없는 것으로 보고 건너뛴다(events·wait·watch 모두)
       hc-lane wait [--all | --on <기계>…] [--timeout <분>(기본 110)] [--state <상태,…>] [--since <시각>] [--mine]
  wait          아직 본 적 없는 사건이 생길 때까지 HC_LANE_WAIT_TICK초(기본 60)마다 보고, 생기면 그 줄(들)을 찍고 종료 0.
                상한이면 종료 75. 찍은 사건은 이 기계 …/hc-lane/seen.<$HC_TERMINAL_ID>(지휘마다, 터미널 밖이면 seen)에
                적어 다시 알리지 않는다(바꾸는 것은 그 파일뿐). 출력이 /dev/null이면 사건을 읽을 사람이 없어 seen에 안 적고 종료 2(배경이면 출력을 파일로). 새 커서는 --since(없으면 2시간 전)부터 본다.
                --mine이면 레인의 hc parent가 부른 터미널($HC_TERMINAL_ID — 원격 레인도 보통 앞부분 없는 <t…>, 옛 꼴 …/<t…>도 맞춤)인 사건만(parent를 모르면 보임).
                한 기계에 지휘가 여럿일 때만 쓴다(지휘가 바뀌었거나 wait를 다른 터미널에서 부르면 쓰지 않는다).
                hc-lane이 띄운 레인 터미널(라벨 hc-lane=1)이 착지·판정 그 턴(report turn+1 이하, turn을 모르면 밖) 밖에서 끝났거나(한 줄 칸
                「뜻밖의 종료(<상태>)」, 완료 — 착지 전 — 뒤와 착지·판정 뒤 이어 받은 일도 알림. 착지 뒤 같은 sha(- 아님)의 완료가
                같은 턴(같은 turn 값)에만 이어지면 착지로 치고 turn은 그 완료의 것), 완료·착지·막힘·판정 없이(또는
                그 report의 turn+1보다 뒤에) done·idle로 쉬거나, blocked·error면 「멈춤」 사건(한 줄 칸 「<상태> turn <n>」).
                done·idle은 쉰 지 설정 lane.wait_grace분(기본 10, 0이면 끔)이 지나고 배경 작업이 없을 때 멈춤. 배경 작업은
                터미널 pid 자손 가운데 명령 줄에 lane.wait_procs 글자(기본 shell-snapshots — Claude Bash 도구 셸)가 든 프로세스로
                본다(이 기계 ps, 원격은 기계당 hc exec 한 번). 그런 프로세스가 없거나 pid·ps를 모르면 화면의 마지막 상태 줄(lane.wait_line
                기본 ✻ 턴 끝 줄, 또는 표시 줄 가운데 맨 아래)에 lane.wait_busy(확장 정규식, 기본 shells? still running|monitors?
                still running, 빈 값이면 끔) 표시로 본다(배경 작업이 끝나면 레인이 스스로 이어 간다). 배경 작업이 있어도
                쉰 지 lane.wait_busy_max분(기본 30)이 넘으면 멈춤. blocked·error·끝남은 바로. hc-sweep이 적은 「정리됨」은 그
                터미널의 바로 앞 report가 착지·판정이고 그 turn+1 안이거나 같은 turn의 쉼으로 이미 알렸으면 버리고, 아니면
                「뜻밖의 종료(정리됨) …」 멈춤(틈에 닫혀 목록에서 사라져도).
                --read·hc-fill 레인(레인 기록 lanes.tsv 넷째 칸 read·fill)은 「완료」도 착지·판정처럼 마지막 보고다.
                지휘가 hc kill로 닫은 레인(hc ls reason killed — parent가 없거나 아직 살아 있을 때만. parent가 끝나 함께 끝난 것은
                그대로 알림)의 끝남은 알리지 않는다. 쉬는 레인은 그 작업 트리 경로가 명령 줄에 든 프로세스가 살아 있어도 바쁨으로 본다.
                커서·보냄 열쇠는 기계 이름을 뺀 꼴(주소는 끝의 t…)이라 hc 기계 이름을 바꿔도 본 사건이 다시 안 나온다(옛 꼴 줄도 읽음).
                hc ls가 3바퀴 이어 실패하면 「hc ls 실패 n바퀴」 멈춤 한 줄로 끝낸다.
                sh를 띄울 수 없는 기계(예: Windows)는 레인 기록이 없는 것으로 보고 건너뛴다(「모름」·「연결 안 됨」 없음).
                못 읽은 기계의 레인은 그 바퀴에 blocked·error만 그대로, 쉼·끝남은 「연결 안 됨 <기계> <날짜>」(하루 한 번). 원격은 바퀴마다 기계당 한 번(쉬는 레인 확인만 그 터미널에 hc get·read)
준비·정리 훅: .claude/herdr-setup.sh(환경 LANE_*: LANE_REPO=메인 폴더, LANE_BASE=기본 브랜치), .claude/herdr-teardown.sh
실행 명령은 env K=V 로 감싸므로 hc 템플릿 이름은 쓸 수 없다. 마지막 줄은 JSON 한 줄.
EOF
  exit 2
}
val() { [ $# -ge 2 ] || die "$1 값이 없다"; }
# cfg <키> <기본값>: 개인 설정(herdr-tools-config, 곁의 것 먼저). 도구가 없는 기계는 기본값, 읽기 오류는 종료 1
cfg() {
  c=${0%/*}/herdr-tools-config
  [ -x "$c" ] || c=$(command -v herdr-tools-config) || { printf '%s\n' "$2"; return 0; }
  "$c" get "$1" "$2" || die "설정 $1 을 읽지 못했다(herdr-tools-config)"
}
# capt <초> <명령…>: 그 초 안에 안 끝나면 끊는다(perl alarm, 없으면 그냥). 코어가 응답하지 않아도 멈추지 않게
capt() { if command -v perl >/dev/null 2>&1; then perl -e 'alarm shift; exec @ARGV' "$@"; else shift; "$@"; fi; }

# ---- 레인 사건(2026-11-16 lane-events): 레인이 상태를 직접 적고(report) 지휘는 그것만 읽는다(events·wait) ----
# 화면 글자·보고 파일 끝 줄을 긁던 감시가 칸이 한 줄이거나 파일 이름이 다르면 완료를 놓쳤다(레인이 20~80분 놀았다).
evdir=${XDG_STATE_HOME:-$HOME/.local/state}/hc-lane
evstates='중간 완료 착지 막힘 판정 제출'   # 제출 = 병합기 큐 접수(hc-lane land가 적음, 착지는 병합기가 따로)
tab=$(printf '\t')
utc() { if [ $# = 0 ]; then date -u +%Y-%m-%dT%H:%M:%SZ; else date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ; fi; }
flat() { printf %s "$1" | tr '\t\r\n' '   '; }
# bcut <바이트> <글>: 로캘과 상관없이 바이트로 자르고, 끝에 남은 반쪽 UTF-8 글자는 버린다(iconv -c)
bcut() {
  ( LC_ALL=C; s=$2
    [ ${#s} -gt "$1" ] || { printf %s "$s"; exit 0; }
    r=$(printf %s "${s:0:$1}" | iconv -c -f UTF-8 -t UTF-8 2>/dev/null); [ -n "$r" ] || r=${s:0:$1}
    printf %s "$r" )
}
# jrec <키…>: JSON을 { 마다 끊어 조각마다 키의 문자열 값(없거나 null이면 -)을 탭으로. 첫 키가 없는 조각은 버린다(jq 없이)
jrec() {
  tr '{' '\n' | awk -v K="$*" 'BEGIN { nk = split(K, k, " ") }
    { o = ""
      for (i = 1; i <= nk; i++) {
        v = "-"
        if (match($0, "\"" k[i] "\" *: *(\"[^\"]*\"|-?[0-9]+)")) { v = substr($0, RSTART, RLENGTH); sub(/^"[^"]*" *: *"?/, "", v); sub(/"$/, "", v) }
        if (i == 1 && v == "-") next
        o = o (i > 1 ? "\t" : "") v
      }
      print o }'
}
report_cmd() {
  rn= st= sha= msg= k=0 to_=
  while [ $# -gt 0 ]; do
    case $1 in --name) val "$@"; rn=$2; shift 2; continue ;; --to) val "$@"; to_=$2; shift 2; continue ;; -h|--help) usage ;; esac
    k=$((k + 1)); case $k in 1) st=$1 ;; 2) sha=$1 ;; 3) msg=$1 ;; *) msg="$msg $1" ;; esac; shift
  done
  case " $evstates " in *" $st "*) [ -n "$st" ] ;; *) false ;; esac ||
    { echo "hc-lane report: 상태는 $evstates 가운데 하나: ${st:-(없음)}" >&2; exit 2; }
  case $to_ in *[!A-Za-z0-9_.,/-]*) echo "hc-lane report: --to 지휘 주소 글자: $to_" >&2; exit 2 ;; esac
  # 대문자 sha도 sha로(소문자로 적음). 7~40자가 아닌 16진 낱말(DB·CAFE)은 한 줄 칸으로 그대로
  case $sha in
    ''|-) sha=- ;;
    *[!0-9A-Fa-f]*) msg="$sha${msg:+ $msg}" sha=- ;;   # hc-lane report 막힘 "이유"
    *) if [ ${#sha} -ge 7 ] && [ ${#sha} -le 40 ]; then sha=$(printf %s "$sha" | tr A-F a-f); else msg="$sha${msg:+ $msg}" sha=-; fi ;;
  esac
  m=${HC_LANE_MACHINE:-$(hostname -s 2>/dev/null)}
  # 줄 전체를 1000바이트 안으로: bash printf는 약 1KB씩 나눠 쓰니, 넘으면 여러 레인이 함께 더할 때 줄이 섞여
  # 두 사건이 다 7칸이 아니게 된다(감사 실측). 앞 칸은 64바이트씩, 남는 자리를 한 줄 칸이 쓴다
  # 여덟째 칸 = 그때의 hc turn(그 턴이 끝나 쉬면 turn+1). wait가 「report 뒤 더 일하고 report 없이 쉼」을 가린다
  # 코어가 응답하지 않아도 report가 멈추지 않게 3초 상한(perl alarm, 없으면 그냥), 넘으면 turn -
  g_=; [ -z "${HC_TERMINAL_ID-}" ] || g_=$(capt 3 hc get "$HC_TERMINAL_ID" --json 2>/dev/null)
  tn=$(printf '%s\n' "$g_" | sed -n 's/.*"turn" *: *\([0-9][0-9]*\).*/\1/p' | tail -n 1)
  # 레인 이름: --name → $HC_LANE → hc 터미널 이름(맨 위 "name" — 줄의 마지막 것, 앞의 foreground.name이 아니다) → 작업 트리 가지.
  # 가지가 기본 가지(origin/HEAD·main·master)면 쓰지 않는다: hc-lane clean으로 작업 트리를 지운 뒤 메인 폴더에서 report하면
  # 레인 칸이 「main」이 됐다(2026-11-16 실측 v5-lb → 「main 착지」, 작업 중 발견해 함께 고침)
  lane=${rn:-${HC_LANE-}}
  [ -n "$lane" ] || lane=$(printf '%s\n' "$g_" | sed -n 's/.*"name" *: *"\([^"]*\)".*/\1/p' | tail -n 1)
  if [ -z "$lane" ]; then
    lane=$(git symbolic-ref -q --short HEAD 2>/dev/null)
    ob=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); ob=${ob#origin/}
    case " main master ${ob:-main} " in *" $lane "*) lane= ;; esac
  fi
  # 병합기에 제출만 한 커밋의 「착지」는 적지 않는다(감사 land-merge-train-2 중간 1, 병합기 1차 중간 7 — --name이어도): 원격
  # lane/<레인>(제출 push가 고친 추적 참조)이 그 커밋을 담거나 이 기계 제출 기록(<공용 git 폴더>/hc-submitted — push 응답이 끊겨 추적 참조가
  # 없을 때)에 있고, 기본 브랜치에는 없으면 착지는 병합기가 적는다. 거짓 착지는 겹침 소유를 풀고 지표에 남는다
  # 기본 브랜치는 제출 기록의 셋째 칸(제출 때의 대상), 없으면 origin/HEAD(2차 중간 8 — report는 origin_base 정의 전에 돌아 늘 main이었다)
  if [ "$st" = 착지 ] && [ "$sha" != - ] && [ -n "$lane" ]; then
    sb_=$(awk -v l="$lane" -v s="$sha" '$1 == l && index($2, s) == 1 && $3 != "" { b = $3 } END { print b }' "$(git rev-parse --git-common-dir 2>/dev/null)/hc-submitted" 2>/dev/null)
    [ -n "$sb_" ] || { sb_=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); sb_=${sb_#origin/}; }
  fi
  if [ "$st" = 착지 ] && [ "$sha" != - ] && [ -n "$lane" ] && {
      git merge-base --is-ancestor "$sha" "refs/remotes/origin/lane/$lane" 2>/dev/null ||
      awk -v l="$lane" -v s="$sha" '$1 == l && index($2, s) == 1 { f = 1 } END { exit !f }' "$(git rev-parse --git-common-dir 2>/dev/null)/hc-submitted" 2>/dev/null; } &&
    ! git merge-base --is-ancestor "$sha" "refs/remotes/origin/${sb_:-main}" 2>/dev/null; then
    echo "hc-lane report: $sha 는 병합기 큐에 제출만 됐다(lane/$lane) — 착지는 병합기가 사건(착지·막힘 --name $lane)으로 적는다. 아무것도 적지 않음"
    return 0
  fi
  tail_="$tab${tn:--}${to_:+$tab$to_}"
  line="$(utc)$tab$(bcut 64 "$(flat "${m:--}")")$tab$(bcut 64 "$(flat "${HC_TERMINAL_ID:--}")")$tab$(bcut 64 "$(flat "${lane:--}")")$tab$st$tab$(flat "$sha")$tab"
  line=$(bcut $((1000 - ${#tail_})) "$line$(flat "${msg:--}")")$tail_
  mkdir -p "$evdir" || die "report: 폴더를 만들지 못했다: $evdir"
  # 더하기만 한다(O_APPEND 한 번). ponytail: 늘기만 하는 파일 — 수만 줄이 되면 오래된 줄을 옮겨 자르는 단계를 더한다
  printf '%s\n' "$line" >>"$evdir/events.tsv" || die "report: 쓰지 못했다: $evdir/events.tsv"
  echo "$(printf %s "$line" | cut -f4) $st: $sha $(printf %s "$line" | cut -f7)"
}
# pick: --all이면 hc machine ls에서 연결된 기계를 ems에, 아닌 기계를 unk에. --on으로 준 기계는 늘 ems에
pick() {
  ems=$ons unk= pbad=0
  [ $all = 1 ] || return 0
  js=$(hc machine ls --json 2>/dev/null) || { echo "hc-lane $ec: hc machine ls 실패 — 이 기계만 본다" >&2; pbad=1; return 0; }
  recs=$(printf '%s\n' "$js" | jrec name state)
  while IFS=$tab read -r mn ms; do
    [ -n "$mn" ] || continue
    case " $ems " in *" $mn "*) continue ;; esac
    if [ "$ms" = connected ]; then ems="$ems $mn"; else unk="$unk $mn"; fi
  done <<EOF
$recs
EOF
}
# nosh <hc exec 오류 글>: 그 기계가 프로그램을 띄우지 못함(spawn_failed + 「cannot start <프로그램>」 — sh·ps가 없는 Windows 등)이면 0.
# 연결은 멀쩡하고 레인 기록도 있을 수 없는 기계다(lane-nosh). 연결 실패·시간 초과·그 밖의 오류는 1
nosh() { case $1 in *'"spawn_failed"'*) case $1 in *'cannot start '*) return 0 ;; esac ;; esac; return 1; }
# rexec <기계> <명령…>: hc exec --on(60초)으로 돌려 표준 출력을 낸다. 실패했는데 nosh면 종료 9(부른 쪽이 조용히 건너뜀)
rexec() {
  rx_m=$1; shift
  rx_e=$(mktemp "${TMPDIR:-/tmp}/hc-lane-rx.XXXXXX") || { hc exec --on "$rx_m" --timeout 60 -- "$@" </dev/null 2>/dev/null; return; }
  hc exec --on "$rx_m" --timeout 60 -- "$@" </dev/null 2>"$rx_e"; rx_r=$?
  [ $rx_r = 0 ] || ! nosh "$(cat "$rx_e")" || rx_r=9
  rm -f "$rx_e"; return $rx_r
}
# evread <끝 줄 수(0이면 전부)>: 이 기계와 ems 기계의 events.tsv(7칸 이상 줄만 — 옛 줄은 turn 칸이 없다). 원격 줄은 기계·터미널 칸을 hc 이름으로.
# 원격은 기계마다 hc exec 한 번. 못 읽은 기계는 「모름 <기계>」, sh를 못 띄우는 기계(nosh)는 레인 기록이 없는 것으로 보고 0줄
evread() {
  rd='f=${XDG_STATE_HOME:-$HOME/.local/state}/hc-lane/events.tsv; [ -f "$f" ] || exit 0; if [ "$1" = 0 ]; then cat "$f"; else tail -n "$1" "$f"; fi'
  sh -c "$rd" hc-lane "$1" | awk -F'\t' 'NF >= 7'
  for mn in $unk; do echo "모름 $mn"; done
  for mn in $ems; do
    o=$(rexec "$mn" sh -c "$rd" hc-lane "$1") || { [ $? = 9 ] || echo "모름 $mn"; continue; }
    printf '%s\n' "$o" | M=$mn awk -F'\t' -v OFS='\t' 'NF >= 7 { $2 = ENVIRON["M"]; if ($3 != "-" && index($3, "/") == 0) $3 = ENVIRON["M"] "/" $3; print }'
  done
}
# stopped <사건 줄들>: 라벨 hc-lane=1 터미널 가운데 멈춘 것을 멈춤 사건 줄로(한 줄 칸 「<상태> turn <n>」). hc ls 한 번.
# 그 터미널(주소와 레인 이름이 같은)의 마지막 사건으로 가린다: 끝남은 착지·판정 그 턴(report turn+1 이하)이거나 hc-sweep
# 정리 뒤(정리됨은 wait 거름이 같은 규칙으로 판정)면, done·idle(report 없이 쉬는
# 레인 — 2026-11-16 사고 꼴)은 완료·착지·막힘·판정이고 지금 turn이 그 사건 turn+1 이하일 때만(그 턴이 끝나 쉼) 빼고,
# blocked·error는 늘 알린다. 이번 바퀴에 못 읽은 기계(모름·hc machine ls 실패)의 레인은 사건을 모르니 blocked·error만
# 그대로 알리고, 쉼·끝남은 「연결 안 됨 <기계> <날짜>」(레인마다 하루 한 번)로 알린다.
# ponytail: report 뒤 같은 지시 안에서 막혔다 풀려도 turn이 올라 거짓 멈춤이 날 수 있다(놓치는 쪽보다 낫다)
# done·idle은 resting을 거친다(유예). blocked·error·끝남은 바로 알린다.
# resting <주소> <커서 열쇠>: 쉬는 레인이 정말 멈췄나(wait-grace, 2026-11-16 실측 — 배경 셸이 도는 동안 턴을 끝낸 Claude
# 레인을 멈춤으로 알렸다. 배경 작업이 끝나면 스스로 이어 간다). 쉰 지 lane.wait_grace분이 지났고, 화면의 마지막 상태 줄
# (lane.wait_line 또는 lane.wait_busy에 걸리는 줄 가운데 맨 아래 — 옛 턴의 끝 줄·본문은 안 봄)에 lane.wait_busy 표시가 없을 때
# 참. 표시가 있어도 쉰 지 lane.wait_busy_max분이 넘으면 참(셸이 죽어 이어 가지 못한 레인을 영영 붙들지 않게).
# 쉰 시각은 이 열쇠(같은 turn의 쉼)를 처음 본 status_ms를 커서에 「#rest」 줄로 남겨 쓴다(done→idle로 status_ms가 새로 찍혀도).
# status_ms를 못 읽으면(hc get 실패·옛 코어) 바로 참, hc read가 실패하면 표시 없음(놓치지 않는 쪽).
# 주소는 hc ls 그대로(<기계>/t…)라 이 기계 코어가 잇는다.
# ponytail: 상한이 30분이라 (1) 이어 간 턴이 ✻ 줄 없이 끝나면 옛 표시 줄이 최대 30분 붙들고, (2) 정상으로 30분 넘게 배경을
# 기다리는 레인은 같은 turn에 거짓 멈춤이 한 번 난다(재감사 [낮음]). 잦으면 lane.wait_busy_max를 올리거나 꼬리 바의 살아 있는
# 개수(「⏵⏵ … · N shells」)를 본다.
# procbusy <주소> <pid>: 그 pid의 자손 가운데 명령 줄에 lane.wait_procs 글자(빈칸으로 나눈 목록, 기본 shell-snapshots —
# Claude Code Bash 도구 셸 꼴 「/bin/zsh -c source …/.claude/shell-snapshots/snapshot-zsh-….sh …」)가 든 것이 살아 있나.
# 0 있음(배경 작업 중), 1 없음, 2 모름(ps 실패). MCP 서버처럼 늘 사는 자손은 그 꼴이 아니라 세지 않는다.
# ps는 기계마다 바퀴에 한 번(이 기계는 ps, 원격은 hc exec --on 한 번) 받아 psc(「<기계><탭><ps 줄>」)에 둔다 — stopped 한 번이 한 바퀴
# psget <주소>: 그 기계(pm)의 ps를 바퀴에 한 번 psc에 받아 둔다. 0 있음, 2 모름(ps 실패)
psget() {
  case $1 in */*) pm=${1%%/*} ;; *) pm=. ;; esac
  case " $psbad " in *" $pm "*) return 2 ;; esac
  case " $psok " in *" $pm "*) return 0 ;; esac
  if [ "$pm" = . ]; then o_=$(capt 20 ps -A -o pid=,ppid=,command= </dev/null 2>/dev/null)
  else o_=$(rexec "$pm" ps -A -o pid=,ppid=,command=); fi
  pr_=$?
  [ $pr_ != 9 ] || { psok="$psok $pm"; return 0; }   # ps를 못 띄우는 기계(nosh): 레인 프로세스가 없는 것으로
  if [ $pr_ != 0 ] || [ -z "$o_" ]; then psbad="$psbad $pm"; return 2; fi
  psc=$psc$(printf '\n%s' "$o_" | sed "s|^|$pm$tab|")
  psok="$psok $pm"
}
# wtbusy <주소> <cwd>: 레인 작업 트리(<…>.wt/<레인>) 경로가 명령 줄에 든 프로세스가 그 기계에 살아 있나(sweep-rename 6 — 배경 검증을
# 기다리며 차례만 끝낸 레인이 「멈춤 done」으로 왔다. 터미널 자손이 아니어도 센다). 작업 트리가 아니거나 ps를 모르면 1(아님)
# ponytail: 명령 줄만 본다(cwd로만 도는 프로세스는 안 보임 — lsof는 바퀴마다 무겁다). 레인 자신의 명령 줄에 그 경로가 있으면
#           lane.wait_busy_max분까지 멈춤이 늦는다
wtbusy() {
  case $2 in /*/?*.wt/?*) ;; *) return 1 ;; esac
  psget "$1" || return 1
  printf '%s\n' "$psc" | M=$pm C=${2%/} LC_ALL=C awk -F'\t' '$1 == ENVIRON["M"] { c = substr($0, length($1) + 2)
      sub(/^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]*/, "", c); c = c " "
      if (index(c, ENVIRON["C"] "/") || index(c, ENVIRON["C"] " ")) { f = 1; exit } }
    END { exit !f }'
}
procbusy() {
  psget "$1" || return 2
  printf '%s\n' "$psc" | M=$pm P=$2 W=$wprocs LC_ALL=C awk -F'\t' '
    $1 == ENVIRON["M"] { r = substr($0, length($1) + 2); n = split(r, f, " "); if (n < 2) next
      c = r; sub(/^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]*/, "", c); par[f[1]] = f[2]; cmd[f[1]] = c }
    END { nw = split(ENVIRON["W"], w, " ")
      for (p in cmd) {
        hit = 0; for (i = 1; i <= nw; i++) if (index(cmd[p], w[i])) hit = 1
        if (!hit) continue
        q = par[p]; k = 0
        while (q != "" && q + 0 > 1 && k++ < 10000) { if (q == ENVIRON["P"]) exit 0; q = par[q] }
      }
      exit 1 }'
}
# hc는 원격 레인의 parent를 묻는 쪽 기준 주소로 준다(watch-parent, 2026-11-17 실측 — 레인 기계 hc get은 「<지휘 기계>/t7」,
# 지휘 기계 hc get은 앞부분 없이 「t7」). 그래서 parent는 그대로 이 기계에서 묻는다(앞부분 없음 = 이 기계 터미널).
# 옛 꼴(바꿔 주지 않은 「<이 기계 이름>/t…」)만 machine_unknown으로 알아보고 앞부분을 떼어 다시 묻는다(3차 감사 [중간] N1).
# pnorm <parent>: 「<기계>/t…」의 앞부분이 hc machine ls에 없는 이름(= 이 기계 자신)이면 뗀 주소(pq_). hc machine ls가 실패하면 그대로
pnorm() {
  pq_=$1
  case $pq_ in */*)
    [ -n "${mls_-}" ] || if mj_=$(capt 20 hc machine ls --json </dev/null 2>/dev/null) && printf '%s' "$mj_" | grep -q '"machines"'
      then mls_=" $(printf '%s\n' "$mj_" | jrec name state | cut -f1 | tr '\n' ' ') "; else mls_=fail; fi
    [ "$mls_" = fail ] || case $mls_ in *" ${pq_%%/*} "*) ;; *) pq_=${pq_#*/} ;; esac ;;
  esac
}
# plive <주소>: 그 터미널(레인의 parent)이 지금 살아 있나. 바퀴(stopped 한 번)마다 주소당 hc get 한 번(pl_에 「주소=0|1|3」).
# 0 살아 있음, 3 그 주소의 기계를 모름(machine_unknown — 이 기계 자신의 이름이 붙은 주소), 1 그 밖(끝남·없음·모름)
plive() {
  case " $pl_ " in *" $1=0 "*) return 0 ;; *" $1=1 "*) return 1 ;; *" $1=3 "*) return 3 ;; esac
  g_=$(capt 10 hc get "$1" --json </dev/null 2>&1)
  if printf '%s\n' "$g_" | sed 's/"foreground" *: *{[^}]*}//; s/"status" *: *{[^}]*}//' | grep -q '"state" *: *"live"'; then pl_="$pl_ $1=0"; return 0
  elif printf '%s\n' "$g_" | grep -q 'machine_unknown'; then pl_="$pl_ $1=3"; return 3; fi
  pl_="$pl_ $1=1"; return 1
}
# palive <parent>: parent를 그대로 먼저 묻고(들어온 연결의 상대는 machine ls에 없어도 그대로 풀린다 — 3차 감사 [낮음] L1),
# machine_unknown일 때만 pnorm으로 앞부분을 떼고 다시 묻는다
# ponytail: 앞부분 없는 parent를 레인 기계 터미널로 보던 판(바꿔 주지 않는 hc)은 안 받는다 — 그런 hc가 나오면 not_found일 때 <레인 기계>/t…도 묻는다
palive() {
  plive "$1"; r_=$?
  [ $r_ = 3 ] || return $r_
  pnorm "$1"; [ "$pq_" != "$1" ] || return 1
  plive "$pq_"
}
resting() {
  g_=$(capt 10 hc get "$1" --json </dev/null 2>/dev/null)
  sm=$(printf '%s\n' "$g_" | sed -n 's/.*"status_ms" *: *\([0-9][0-9]*\).*/\1/p' | tail -n 1)
  [ -n "$sm" ] || return 0
  # 옛 꼴(기계 이름 든 주소) #rest 줄도 nk로 견준다(재감사 [낮음] 3)
  r=$(LC_ALL=C K=$2 awk -F'\t' "$nkf"'$1 == "#rest" && NF >= 3 { k = $2; for (i = 3; i < NF; i++) k = k "\t" $i; if (nk(k) == ENVIRON["K"]) r = $NF } END { print r }' "$cur" 2>/dev/null)
  case $r in ''|*[!0-9]*) printf '#rest\t%s\t%s\n' "$2" "$sm" >>"$cur"; r=$sm ;; esac
  [ "$sm" -ge "$r" ] || r=$sm
  ag=$(($(date +%s) - r / 1000))
  [ $ag -ge $((wgrace * 60)) ] || return 1
  [ $ag -lt $((wbmax * 60)) ] || return 0
  # 작업 트리 아래 배경 실행(터미널 자손이 아니어도)이 살아 있으면 바쁨(sweep-rename 6). lane.wait_procs가 빈 값이면 프로세스 판정과 함께 끔
  [ -z "$wprocs" ] || ! wtbusy "$1" "${3-}" || return 1
  # 터미널 프로그램 pid로 프로세스 판정: 배경 셸이 있으면 바쁨. 없거나 모르면(pid 없음·1 이하·ps 실패) 화면 판정도 본다
  # (셸 없는 배경 작업 — 배경 Agent 등 — 은 화면 표시로만 보인다. 감사 [낮음] 4). 맨 위 "pid"는 foreground 뒤라 마지막 것을
  # 쓴다(맨 위가 null이면 foreground.pid — 터미널 프로그램 자신이거나 그 자손이라 Bash 셸은 여전히 그 아래다)
  tp=$(printf '%s\n' "$g_" | sed -n 's/.*"pid" *: *\([0-9][0-9]*\).*/\1/p' | tail -n 1)
  case $tp in 0|1) tp= ;; esac
  if [ -n "$wprocs" ] && [ -n "$tp" ]; then
    ! procbusy "$1" "$tp" || return 1
  fi
  [ -n "$wbusy" ] || return 0
  ! capt 10 hc read "$1" </dev/null 2>/dev/null | grep -Ei -e "$wline" -e "$wbusy" | tail -n 1 | grep -Eiq -e "$wbusy"
}
# mine <parent>: 이 지휘의 레인인가. 거르지 않으면(--mine 없음, 터미널 밖) 늘 참. parent를 모르면(-·빈 값) 참(fail-open).
# 원격 레인의 parent는 hc가 묻는 쪽 기준으로 주어 보통 앞부분 없는 <t…>, 옛 꼴 <이 기계>/<t…>도 끝의 /<t…>로 맞춘다.
# ponytail: 다른 기계의 지휘가 같은 t 이름이면 섞인다 — 잦으면 기계 이름까지 맞춘다
mine() { [ -z "$myp" ] || case $1 in ''|-|"$myp"|*/"$myp") true ;; *) false ;; esac; }
stopped() {  # stopped <사건 줄들> <이번 바퀴 모름 기계들>
  psc= psok= psbad=
  [ "$lsok" = 1 ] || { echo "hc-lane wait: hc ls 실패 — 이번 바퀴는 멈춘 레인을 못 봤다" >&2; echo '#hc-ls-fail'; return 0; }
  me=${HC_LANE_MACHINE:-$(hostname -s 2>/dev/null)}
  km_=$(lkinds) pl_= mls_=
  printf '%s\n' "$tl" | jrec address name state status turn parent reason cwd | while IFS=$tab read -r a nm s ss tn pa rs cw; do
    mine "$pa" || continue
    # uk=1: 이번 바퀴에 그 기계 events를 못 읽음(모름·hc machine ls 실패). blocked·error는 사건과 상관없이 알리고,
    # 사건이 있어야 하는 판정(쉼·끝남)은 「연결 안 됨 <기계> <날짜>」로 바꿔 레인마다 하루 한 번 알린다(다음 바퀴엔 다시 정상 판정)
    uk=0
    case $a in
      */*) [ $all = 1 ] || case " $ons " in *" ${a%%/*} "*) ;; *) continue ;; esac; mn=${a%%/*}
           [ "${pbad:-0}" = 0 ] || uk=1
           case " $2 " in *" $mn "*) uk=1 ;; esac ;;
      *) mn=${me:--} ;;
    esac
    # 정리됨(hc-sweep이 닫음)은 report가 아니라 마지막 report를 가리지 않는다. sw=1이면 그 뒤에 정리됨이 있었다
    # 착지 뒤 그 턴의 같은 sha 완료는 착지로 친다(turn만 그 완료의 것으로) — $landed 참고
    lr=$(printf '%s\n' "$1" | A=$a N=$nm LC_ALL=C awk -F'\t' "$landed"'$3 == ENVIRON["A"] && $4 == ENVIRON["N"] {
      if ($5 == "정리됨") w = 1; else { lrep($5, $6, NF >= 8 ? $8 : "-"); l = lst["x"] "\t" ltn["x"]; w = 0 } }
      END { print l "\t" (w ? 1 : 0) }')
    last=${lr%%"$tab"*} lt=${lr#*"$tab"} sw=${lr##*"$tab"} lt=${lt%"$tab"*}
    why=
    # 끝남: 착지·판정 그 턴(report turn+1 이하. turn을 모르면 알림 — 놓치는 것보다 거짓 알림 한 번)이면 알리지 않고, 아니면(완료 — 착지 전 감사 기다림, 막힘,
    # 중간, report 없음, 착지·판정 뒤 이어 받은 일) 뜻밖의 종료. hc-sweep 정리 뒤면 그 정리됨 사건이 판정한다(아래 wait 거름).
    # lane.notify no면 hc가 지휘에 종료를 알리지 않으니 이것이 유일한 알림
    # 마지막 보고: 착지·판정, --read·hc-fill 레인(레인 기록 넷째 칸 read·fill)은 완료도(sweep-rename 5). 지휘가 hc kill로 닫은 것
    # (reason killed)은 일부러 닫은 것이라 알리지 않는다 — hc-sweep이 닫은 것은 정리됨 사건이 판정한다
    # 「제출」(병합기 큐에 넣고 끝남 — 착지는 병합기가 알린다)도 정상 끝(병합기 3차 중간 10)
    fin=' 착지 판정 제출 '
    case $(printf '%s\n' "$km_" | A=${a##*/} N=$nm awk -F'\t' '$1 == ENVIRON["A"] && $2 == ENVIRON["N"] { k = $3 } END { print k }') in
      read|fill) fin=' 착지 판정 제출 완료 ' ;;
    esac
    # killed가 지휘의 hc kill인지: parent가 없거나(hc-fill 레인) 아직 살아 있을 때만. parent가 끝났거나 없어졌거나 모르면
    # die_with_parent로 함께 끝난 것이라 알린다(재감사 [중간] M1 — 지휘 칸이 죽어 함께 killed된 구현 레인을 놓쳤다)
    if [ "$s" != live ]; then [ "$sw" = 1 ] || case $fin in
        *" $last "*) case $lt$tn in *[!0-9]*|'') why="뜻밖의 종료($s)" ;; *) [ "$tn" -le $((lt + 1)) ] || why="뜻밖의 종료($s)" ;; esac ;;
        *) why="뜻밖의 종료($s)" ;;
      esac
      kq=0; [ -z "$why" ] || [ "$rs" != killed ] || case $pa in ''|-) kq=1 ;; *) ! palive "$pa" || kq=1 ;; esac
      # 조용히 넘긴 killed는 커서(watch는 sent도)에 그 멈춤 열쇠로 적는다: 지휘가 끝난 뒤 다음 판정에서 parent가 죽어 다시 오지 않게(3차 [낮음] 1)
      if [ $kq = 1 ]; then
        k_="멈춤$tab${a##*/}$tab$(flat "$nm")$tab$why turn $tn"
        inseen "$k_" "$cur" $wsf || { printf '%s\n' "$k_" >>"$cur"; [ -z "$wsf" ] || printf '%s\n' "$k_" >>"$wsf"; }
        why=
      fi
    else case $ss in
        blocked|error) why=$ss ;;
        done|idle) case $last in
            완료|착지|막힘|판정) case $lt$tn in *[!0-9]*|'') ;; *) [ "$tn" -le $((lt + 1)) ] || why=$ss ;; esac ;;
            *) why=$ss ;;
          esac ;;
      esac
    fi
    [ -n "$why" ] || continue
    case $uk$why in 1blocked|1error|0*) ;; *) why="연결 안 됨 $mn $(date -u +%Y-%m-%d)" ;; esac
    case $why in done|idle)
      # 이미 알린 쉼(열쇠는 evkey와 같은 꼴)은 다시 볼 것 없다 — 바퀴마다 원격 hc get·read를 부르지 않게
      k_="멈춤$tab${a##*/}$tab$(flat "$nm")${tab}쉼 turn $tn"
      ! inseen "$k_" "$cur" $wsf || continue
      { [ "$wgrace" = 0 ] && [ -z "$wbusy$wprocs" ]; } || resting "$a" "$k_" "$cw" || continue ;;
    esac
    printf '%s\t%s\t%s\t%s\t멈춤\t-\t%s turn %s\n' "$(utc)" "$mn" "$a" "$(flat "$nm")" "$why" "$tn"
  done
}
# 사건의 열쇠: 보통 줄은 줄 그대로, 멈춤은 터미널·레인·「상태 turn」(시각은 바퀴마다 바뀌니 뺀다. turn이 바뀌면 다시 알린다)
# done·idle은 「쉼」으로 묶는다(같은 turn에서 done→idle로 바뀌어도 두 번 알리지 않게)
# 사건 awk는 LC_ALL=C로 돈다: macOS awk는 UTF-8 로캘에서 문자열 비교가 strcoll이라 "착지" == "멈춤"이 참이었다
# (같은 한 줄의 완료→착지가 삼켜지고 --state 한 상태 거름이 꺼짐 — wait-grace 레인에서 발견해 함께 고침)
# nk <열쇠>: 기계 이름을 뺀 열쇠(sweep-rename 2 — hc 기계 이름을 바꾸면 원격 사건의 기계·주소 칸이 새 이름으로 읽혀 이미 본
# 사건이 다시 쏟아졌다). 보통 줄은 기계 칸을 *로, 주소 칸은 끝의 t…만, 멈춤 열쇠는 주소 칸만. 옛 판이 적은 커서 줄(기계 이름이 든
# 그대로)도 이것으로 읽어 같은 사건으로 본다. 이미 바꾼 열쇠에 다시 써도 그대로(#since·#rest 줄도 그대로)
# ponytail: 다른 기계의 같은 t 주소·같은 레인 이름·같은 시각(초)·같은 내용 사건은 하나로 친다 — 레인 이름이 겹치면 기계 칸을 되살린다
nkf='function nk(l,  f, n, i, o) { n = split(l, f, "\t")
  if (f[1] == "멈춤" && n == 4) { sub(/^.*\//, "", f[2]); return "멈춤\t" f[2] "\t" f[3] "\t" f[4] }
  if (n < 7 || f[1] ~ /^#/) return l
  sub(/^.*\//, "", f[3]); o = f[1] "\t*"; for (i = 3; i <= n; i++) o = o "\t" f[i]; return o }
'
# inseen <열쇠> <커서 파일…>: 그 파일들에 같은 사건(nk로 견줌 — 옛 꼴 줄 포함)이 있으면 0
inseen() { k__=$1; shift; LC_ALL=C K=$k__ awk "$nkf"'nk($0) == ENVIRON["K"] { f = 1; exit } END { exit !f }' "$@" 2>/dev/null; }
evkey='function key(  w) { if ($5 != "멈춤") return $0; w = $7; sub(/^(done|idle) /, "쉼 ", w); return "멈춤\t" $3 "\t" $4 "\t" w }'
# lrep <상태> <sha> <turn> [<열쇠>]: 레인(열쇠)의 마지막 report를 lst·ltn에. 착지 뒤 같은 sha의 완료가 같은 턴(같은 turn 값)에
# 오면 착지 그대로 두고 turn만 그 완료의 것으로(레인 틀이 착지 뒤 같은 sha 완료를 한 번 더 적는 꼴 — 2026-11-16 실측 「뜻밖의 종료」).
# sha가 -(판정, sha 없음)이거나 turn을 모르거나 사이에 turn이 올랐거나(다음 턴은 새 입력 — 재감사 [낮음] 2) 다른 sha·중간·막힘이면 새 마지막 report(새 일)
# samesha: -가 아니고, 소문자로 짧은 쪽 길이만큼 앞자리가 같다(sha8 대 40자. report가 7자 미만은 -로 적는다)
landed='function samesha(a, b,  n) { if (a == "-" || b == "-" || a == "" || b == "") return 0
  n = length(a) < length(b) ? length(a) : length(b); return tolower(substr(a, 1, n)) == tolower(substr(b, 1, n)) }
function lrep(s, h, t, k) { if (k == "") k = "x"
  if (s == "완료" && (k in lsh) && samesha(h, lsh[k]) && t ~ /^[0-9]+$/ && lt0[k] ~ /^[0-9]+$/ && t + 0 <= lt0[k] + 0) { ltn[k] = t; return }
  lst[k] = s; ltn[k] = t; delete lsh[k]; if (s == "착지" || s == "판정") { lsh[k] = h; lt0[k] = t } }
'
ev_cmd() {
  ec=$1; shift
  all=0 ons= since= to=110 sts= mn_=0 wto=
  while [ $# -gt 0 ]; do
    case $1 in
      --all) all=1; shift ;;
      --on) val "$@"; case $2 in ''|*/*|*' '*) die "--on 기계 이름이 이상하다: $2" ;; esac; ons="$ons $2"; shift 2 ;;
      --since) val "$@"; since=$2; shift 2 ;;
      --timeout) [ $ec = wait ] || die "--timeout은 wait에서만 쓴다"; val "$@"; to=$2; shift 2 ;;
      --state) [ $ec != events ] || die "--state는 wait·watch에서만 쓴다"; val "$@"; sts=$2; shift 2 ;;
      --mine) [ $ec != events ] || die "--mine은 wait·watch에서만 쓴다"; mn_=1; shift ;;
      --to) [ $ec = watch ] || die "--to는 watch에서만 쓴다"; val "$@"; wto=$2; shift 2 ;;
      -h|--help) usage ;;
      *) die "알 수 없는 인자: $1" ;;
    esac
  done
  case $to in ''|*[!0-9]*) die "--timeout은 분(0 이상 정수): $to" ;; esac
  [ $ec != watch ] || case $wto in ''|-*|*[!A-Za-z0-9_./-]*) die "watch: --to <지휘 터미널 주소>가 없거나 이상하다: $wto" ;; esac
  for x_ in $(printf %s "$sts" | tr ',' ' '); do
    case " $evstates 멈춤 " in *" $x_ "*) ;; *) die "--state는 $evstates 멈춤 가운데: $x_" ;; esac
  done
  case $since in
    ''|*[!0-9smhd]*|[smhd]*) ;;   # 비었거나 그대로 시각(문자열 비교: 2026-11-16T02:00:00Z 꼴)
    *) k=${since%[smhd]} u=${since#"$k"}
       case $k in ''|*[!0-9]*) die "--since는 시각(UTC 2026-11-16T02:00:00Z) 또는 숫자에 s·m·h·d: $since" ;; esac
       case $u in s) k=$k ;; m) k=$((k * 60)) ;; d) k=$((k * 86400)) ;; *) k=$((k * 3600)) ;; esac
       since=$(utc $(($(date +%s) - k))) ;;
  esac
  # wait는 찍은 사건을 seen에 적어 다시 알리지 않는다: 출력이 /dev/null이면 아무도 못 읽은 사건이 「본 것」이 된다(2026-11-17)
  if [ $ec = wait ] && [ /dev/stdout -ef /dev/null ]; then
    echo "hc-lane wait: 출력이 /dev/null이라 사건을 읽을 사람이 없습니다 — seen에 적지 않고 끝냅니다. 백그라운드로 기다리려면 출력을 파일로 받으세요" >&2
    exit 2
  fi
  if [ $ec = events ]; then
    pick
    out=$(evread 0)
    printf '%s\n' "$out" | grep "$tab" | S=$since awk -F'\t' '$1 >= ENVIRON["S"]' | sort -s -t "$tab" -k1,1
    printf '%s\n' "$out" | grep '^모름 '
    return 0
  fi
  # 커서는 지휘(부른 터미널)마다 따로: 한 기계의 지휘 여럿이 서로의 사건을 먹지 않게. 터미널 밖이면 seen.
  # watch는 --to 지휘의 커서를 쓴다(그 지휘의 wait와 함께 — 한쪽이 알린 사건을 다른 쪽이 다시 안 알림)
  # ponytail: 둘이 같은 바퀴에 커서를 읽으면 한 사건을 둘 다 알릴 수 있다(거짓 알림 한 번, 놓치지는 않음)
  me_=${wto:-${HC_TERMINAL_ID-}}
  cur=$evdir/seen${me_:+.$(printf %s "$me_" | tr -c 'A-Za-z0-9_-' _)}
  # watch는 「보냄」 표시(<evdir>/sent — 누구에게든 보냈거나 wait로 받은 사건)도 본 것으로 친다. wait는 자기 커서만
  wsf=; [ $ec != watch ] || wsf=$evdir/sent
  mkdir -p "$evdir" || die "wait: 폴더를 만들지 못했다: $evdir"
  [ $ec != watch ] || watch_lock
  # 지휘 정보 남기기: wait는 부른 터미널, watch는 자기 터미널의 parent가 --to일 때(지휘가 손으로 건 watch) 그 지휘를
  if [ -n "${HC_TERMINAL_ID-}" ]; then
    if [ $ec = wait ]; then coord_set "$HC_TERMINAL_ID"
    else
      pa_=$(capt 10 hc get "$HC_TERMINAL_ID" --json </dev/null 2>/dev/null | sed -n 's/.*"parent" *: *"\([^"]*\)".*/\1/p' | tail -n 1)
      case $pa_ in "$wto"|*/"$wto") wpar=1; coord_set "$wto" ;; esac
    fi
  fi
  # 새 커서는 바닥 시각(--since, 없으면 2시간 전)을 첫 줄에 적는다: 처음 wait가 옛 사건을 쏟지 않게.
  # 레인을 띄운 뒤 2시간 안에 첫 wait를 걸면 그 사이 사건은 놓치지 않는다
  [ -e "$cur" ] || printf '#since\t%s\n' "${since:-$(utc $(($(date +%s) - 7200)))}" >"$cur" || die "wait: 커서 파일을 쓰지 못했다: $cur"
  wgrace=$(cfg lane.wait_grace 10) || exit 1
  case $wgrace in ''|*[!0-9]*) die "설정 lane.wait_grace는 0 이상 정수(분): $wgrace" ;; esac
  wbusy=$(cfg lane.wait_busy 'shells? still running|monitors? still running') || exit 1
  wbmax=$(cfg lane.wait_busy_max 30) || exit 1
  case $wbmax in ''|*[!0-9]*) die "설정 lane.wait_busy_max는 0 이상 정수(분): $wbmax" ;; esac
  wprocs=$(cfg lane.wait_procs shell-snapshots) || exit 1
  wline=$(cfg lane.wait_line '^[[:space:]]*(✻|✶|✳|✢|✽)') || exit 1
  [ -n "$wline" ] || wline='$.^'   # 빈 값: 상태 줄을 안 고름(표시 줄 가운데 맨 아래만). 아무 줄에도 안 맞는 식
  if [ $ec = watch ]; then
    tick=$(cfg lane.watch_tick 30) || exit 1
    widle=$(cfg lane.watch_idle 60) || exit 1
    case $widle in ''|*[!0-9]*) die "설정 lane.watch_idle는 0 이상 정수(분): $widle" ;; esac
    widle=${HC_LANE_WATCH_IDLE:-$((widle * 60))}   # 시험용 초 단위
    idle0=$(date +%s)
    whmax=$(cfg lane.watch_hold_max 30) || exit 1
    case $whmax in ''|*[!0-9]*) die "설정 lane.watch_hold_max는 0 이상 정수(분): $whmax" ;; esac
    whmax=${HC_LANE_WATCH_HOLD_MAX:-$((whmax * 60))} wh0=   # 시험용 초 단위
    wdlg=$(cfg lane.watch_dialog 'Tab/Arrow keys to navigate|Chat about this|Type something|Do you want to proceed\?|Would you like to proceed\?|tell Claude what to do differently') || exit 1
  else tick=60; fi
  tick=${HC_LANE_WAIT_TICK:-$tick}
  case $tick in ''|*[!0-9]*) die "바퀴 간격(lane.watch_tick·HC_LANE_WAIT_TICK)은 0 이상 정수(초): $tick" ;; esac
  end=$(($(date +%s) + to * 60)) told= lsf=0 lf0= lsa=0
  # 기본은 모든 레인 사건. --mine이면 이 지휘($HC_TERMINAL_ID)가 parent인 레인의 사건만(한 기계에 지휘가 여럿일 때).
  # 기본으로 거르면 지휘가 바뀌거나(옛 parent는 죽은 터미널) wait를 다른 터미널에서 부를 때 사건이 다 가려진다(감사 3차 [높음])
  myp=; [ $mn_ = 0 ] || myp=$me_
  gone=0
  while :; do
    # watch: 지휘 터미널이 없거나 끝났으면 그 바퀴는 건너뛰고, 3바퀴 이어지면 스스로 끝낸다(보낼 곳이 없다)
    if [ $ec = watch ]; then
      # 「없음」(not_found)이나 끝난 터미널일 때만 센다. 코어 연결 실패·시간 초과는 모름이라 세지 않고 그대로 돈다(감사 5)
      g_=$(capt 10 hc get "$wto" --json </dev/null 2>&1)
      if printf '%s\n' "$g_" | grep -q '"state" *: *"live"'; then gone=0; wcheck || { wsleep; continue; }
      elif printf '%s\n' "$g_" | grep -Eq '"kind" *: *"not_found"|"address" *:'; then
        gone=$((gone + 1))
        [ $gone -lt 3 ] || { echo "hc-lane watch: 지휘 터미널 $wto 사라짐(hc get ${gone}바퀴 없음·끝남) — 끝낸다" >&2; return 0; }
        wsleep; continue
      fi
    fi
    pick
    # ponytail: 바퀴마다 기계마다 끝 500줄만 본다 — 한 바퀴 사이에 한 기계에 500건 넘게 쌓이면 앞의 것을 놓친다
    out=$(evread 500)
    mu=$(printf '%s\n' "$out" | sed -n 's/^모름 //p' | tr '\n' ' ')
    # 못 읽은 기계는 끊길 때마다 한 번 알린다(다시 읽히면 told에서 빼 다음 끊김도 알림). 다음 바퀴에 다시 읽어 본다.
    # watch는 지휘에게도 한 줄(보내지 못했으면 다음 바퀴에 다시)
    t_=; for mn in $told; do case " $mu " in *" $mn "*) t_="$t_ $mn" ;; esac; done; told=$t_
    for mn in $mu; do
      case " $told " in *" $mn "*) continue ;; esac
      echo "hc-lane $ec: 모름 $mn (연결되면 그때 본다)" >&2
      [ $ec != watch ] || wsend "hc-lane watch: 연결 안 됨 $mn — 다음 바퀴에 다시 본다" || continue
      told="$told $mn"
    done
    evl=$(printf '%s\n' "$out" | grep "$tab")
    cand=$evl
    st_= tl= lsok=1 pmap=
    # hc ls는 바퀴마다 한 번: 멈춤 판정과 parent 거름이 함께 쓴다
    if [ -n "$myp" ] || [ $ec = watch ] || case ",${sts:-멈춤}," in *,멈춤,*) true ;; *) false ;; esac; then
      tl=$(hc ls --all --json --label hc-lane=1 2>/dev/null) || lsok=0
      [ -z "$myp" ] && [ $ec != watch ] || pmap=$(printf '%s\n' "$tl" | jrec address parent)
    fi
    case ",${sts:-멈춤}," in *,멈춤,*) st_=$(stopped "$evl" "$mu"); cand=$(printf '%s\n%s' "$evl" "$st_") ;; esac
    # watch: 이 지휘의 살아 있는 레인(parent가 --to, 모르면 이 지휘 것으로 침)이 있거나 hc ls를 못 읽었으면 쉬는 시계를 새로
    if [ $ec = watch ] && { [ $lsok = 0 ] || printf '%s\n' "$tl" | jrec address state parent | W=$wto awk -F'\t' '
        $2 == "live" && ($3 == "-" || $3 == ENVIRON["W"] || substr($3, length($3) - length(ENVIRON["W"])) == "/" ENVIRON["W"]) { f = 1 }
        END { exit !f }'; } || fillq; then idle0=$(date +%s); fi
    # hc ls가 바퀴마다 실패하면 멈춤·끝남을 영영 못 본다. 3바퀴 이어지면 사건 한 줄로 끝낸다(배경 wait의 stderr는 안 보인다)
    if printf '%s\n' "$st_" | grep -qx '#hc-ls-fail'; then
      lsf=$((lsf + 1)); [ $lsf != 1 ] || lf0=$(utc)
      if [ $lsf -ge 3 ]; then
        l_="$(utc)$tab${HC_LANE_MACHINE:-$(hostname -s 2>/dev/null)}$tab-${tab}hc-lane-wait${tab}멈춤$tab-${tab}hc ls 실패 ${lsf}바퀴(${lf0}부터) — 레인 멈춤·끝남을 못 봄$tab-"
        # watch는 실패가 이어지는 동안 한 번만(lsa=1), 다시 성공하면 「회복」 한 번(감사 [중간] 2 — 3바퀴마다 새 열쇠로 폭주했다)
        if [ "$lsa" = 0 ] && emit "$l_"; then [ $ec = watch ] || return 0; lsa=1; fi
      fi
    else
      lsf=0
      [ "$lsa" = 0 ] || ! wsend "hc-lane watch: hc ls 회복 — 레인 멈춤·끝남을 다시 본다" || lsa=0
    fi
    # 커서는 BEGIN에서 읽는다(빈 파일이면 NR == FNR가 입력 줄까지 먹는다). 「#since<탭>시각」 줄은 바닥
    # 정리됨(hc-sweep이 닫고 hc rm — 목록에서 사라진다)은 그 터미널(주소·레인)의 바로 앞 report가 착지·판정이면 버리고,
    # 아니면 「뜻밖의 종료(정리됨)」 멈춤으로 바꿔 알린다: wait가 안 돌던 틈에 닫힌 보고 없는 레인도 다음 wait에서 나오게.
    # ponytail: 앞 report는 바퀴마다 보는 끝 500줄 안에서 찾는다 — 못 찾으면 알리는 쪽
    # 착지·판정 뒤라도 정리됨 turn이 그 report turn+1보다 뒤면(이어 받은 일) 또는 turn을 모르면 알린다. 같은 turn의 쉼으로 이미 알린 레인은 다시 안 알림.
    # parent 거름(PM: 「주소<탭>parent」 줄)은 찍을지에만 쓴다 — 마지막 report 추적은 모든 줄로
    new=$(printf '%s\n' "$cand" | grep "$tab" | KM=$(lkinds) F=$cur SF=$wsf S=$since W=",$sts," PM=$pmap MY=$myp LC_ALL=C awk -F'\t' -v OFS='\t' "$evkey$nkf$landed"'
      BEGIN { fl = ""; while ((getline l < ENVIRON["F"]) > 0) { if (l ~ /^#since\t/) fl = substr(l, 8); else seen[nk(l)] = 1 }
              if (ENVIRON["SF"] != "") while ((getline l < ENVIRON["SF"]) > 0) seen[nk(l)] = 1
              nk_ = split(ENVIRON["KM"], kl, "\n"); for (i = 1; i <= nk_; i++) { split(kl[i], kf, "\t"); if (kf[1] != "") kind[kf[1] SUBSEP kf[2]] = kf[3] }
              np = split(ENVIRON["PM"], pl, "\n"); for (i = 1; i <= np; i++) { split(pl[i], pf, "\t"); if (pf[1] != "") par[pf[1]] = pf[2] } }
      function num(x) { return x ~ /^[0-9]+$/ }
      { t2 = $3 SUBSEP $4 }
      $5 == "정리됨" { a3 = $3; sub(/^.*\//, "", a3)
        if ((lst[t2] == "착지" || lst[t2] == "판정" || lst[t2] == "제출" || (lst[t2] == "완료" && kind[a3 SUBSEP $4] ~ /^(read|fill)$/)) && num($8) && num(ltn[t2]) && $8 + 0 <= ltn[t2] + 1) next
        if (nk("멈춤\t" $3 "\t" $4 "\t쉼 turn " $8) in seen) next
        $5 = "멈춤"; $6 = "-"; $7 = "뜻밖의 종료(정리됨) " $7 }
      $5 != "멈춤" { lrep($5, $6, NF >= 8 ? $8 : "-", t2) }
      ENVIRON["MY"] != "" && ($3 in par) && par[$3] != "-" && par[$3] != ENVIRON["MY"] && substr(par[$3], length(par[$3]) - length(ENVIRON["MY"])) != "/" ENVIRON["MY"] { next }
      $1 >= ENVIRON["S"] && $1 >= fl && (ENVIRON["W"] == ",," || index(ENVIRON["W"], "," $5 ",")) && !(nk(key()) in seen) && !(nk(key()) in done) { done[nk(key())] = 1; print }' |
      sort -s -t "$tab" -k1,1)
    if [ -n "$new" ] && emit "$new"; then [ $ec = watch ] || return 0; idle0=$(date +%s); fi
    [ $ec = watch ] || [ "$(date +%s)" -lt $end ] || { echo "hc-lane wait: ${to}분 동안 새 사건 없음" >&2; return 75; }
    # watch: 이 지휘의 살아 있는 레인도 새 사건도 없이 lane.watch_idle분이 지나면 끝낸다(다음 레인을 띄울 때 hc-lane이 다시 띄운다)
    [ $ec = wait ] || [ $(($(date +%s) - idle0)) -lt "$widle" ] ||
      { echo "hc-lane watch: $wto 의 살아 있는 레인·새 사건 없이 $((widle / 60))분 — 끝낸다" >&2; return 0; }
    wsleep
  done
}
# emit <사건 줄들>: 커서에 적고 찍는다. watch는 먼저 지휘 터미널에 한 줄로 밀어 주고(hc send), 보낸 뒤에만 커서에 적는다
# (못 보냈으면 1 — 다음 바퀴에 다시. 지휘가 바빠도 hc send는 입력에 쌓인다)
emit() {
  if [ $ec = watch ]; then
    set -- "$(wfilter "$1")"
    [ -n "$1" ] || return 3   # 이 지휘의 사건이 없음(남의 것은 커서에 안 적어 그 지휘·wait 몫으로 남긴다)
    m_=$(printf '%s\n' "$1" | LC_ALL=C awk -F'\t' '{ s = $4 " " $5 ($6 != "-" ? " " $6 : "") " " $7 " (" $3 ")"; o = o (NR > 1 ? " ‖ " : "") s }
      END { print "hc-lane: " o }' | LC_ALL=C tr -d '\000-\037\177')   # 제어 문자(ESC·Ctrl-C 등)는 지휘 입력에 넣지 않는다
    wsend "$m_" || return 1
  fi
  k_=$(printf '%s\n' "$1" | LC_ALL=C awk -F'\t' "$evkey$nkf"'{ print nk(key()) }')
  printf '%s\n' "$k_" >>"$cur" || die "$ec: 커서 파일을 쓰지 못했다"
  # 「보냄」 표시(<evdir>/sent)는 watch만 쓴다 — 사건 하나에 한 번, 주인 watch가 보냈으면 끝(4차 [중간] 1). 끌어오는 wait는
  # 자기 커서만: 남의 지휘 wait가 본 사건도 주인 watch는 보낸다(5차 [중간] 1 — wait가 sent에 적어 주인이 못 보냈다)
  # ponytail: 늘기만 하는 파일(사건마다 한 줄) — 커지면 since 바닥보다 오래된 줄을 잘라 낸다
  # sent에는 이 watch가 주인인 사건만 적는다: 주인 모름(-)·주인 사라짐 사건은 다른 지휘 watch도 자기 커서로 한 번씩 보내게(wfilter)
  if [ $ec = watch ]; then
    s_=$(printf '%s\n' "$1" | while IFS= read -r l_; do [ "$(owner "$(printf '%s\n' "$l_" | cut -f3)")" != "${wto##*/}" ] || printf '%s\n' "$l_"; done |
      LC_ALL=C awk -F'\t' "$evkey$nkf"'{ print nk(key()) }')
    [ -z "$s_" ] || printf '%s\n' "$s_" >>"$evdir/sent" || echo "hc-lane $ec: 보냄 표시를 쓰지 못했다: $evdir/sent" >&2
  fi
  printf '%s\n' "$1"
}
# wfilter <사건 줄들>: 이 watch(--to 지휘)가 보낼 줄만(3차 감사 [중간] 1 — 지휘마다 나눈다). 레인의 지휘(owner)가
#  이 지휘면 보냄 · 다른 지휘이고 그 지휘가 살아 있거나(0) 모르면(2) 안 보냄(그 지휘 몫) ·
#  주인을 모르거나(-: 주인 없는 hc-fill 줄·터미널 밖 report·옛 레인) 그 지휘가 사라졌으면(1) 살아 있는 모든 지휘 watch가 보냄 —
#  놓치는 것보다 겹치는 게 낫다(2026-11-17 hcfill-owner: 가장 최근 지휘 한 곳이 넘겨받아 영구 주인이 되어, 레인을 넣은 지휘가
#  2시간 못 받음 · 감사 [중간] 1: 주인이 사라진 레인도 같은 꼴). 넘겨받지 않고(레인 기록에 안 더함) sent에도 안 적어 지휘마다 자기
#  커서로 한 번. 주인이 사라진 사건은 옛 주인이 자기 wait로 이미 본 것(prevseen)을 뺀다.
#  보낼지는 「주인이 나(또는 모름·사라짐) + sent·내 커서에 없음」(앞의 사건 awk가 거름) watch 자신의 알림 줄(hc-lane-wait)은 늘 보냄.
#  확인은 이 부름 안에서 지휘마다 한 번(hc get)
wfilter() {
  w0_=${wto##*/} occ_=
  printf '%s\n' "$1" | while IFS= read -r l_; do
    [ -n "$l_" ] || continue
    a_=$(printf '%s\n' "$l_" | cut -f3) n_=$(printf '%s\n' "$l_" | cut -f4)
    [ "$n_" != hc-lane-wait ] || { printf '%s\n' "$l_"; continue; }
    # 아홉째 칸(report --to): 받을 지휘를 정한 사건은 그 지휘들의 watch만(주인 판정 안 함)
    t_=$(printf '%s\n' "$l_" | cut -f9)
    if [ -n "$t_" ] && [ "$t_" != - ]; then case ",$t_," in *",$w0_,"* | *"/$w0_,"*) printf '%s\n' "$l_" ;; esac; continue; fi
    o_=$(owner "$a_")
    [ "$o_" != - ] || { printf '%s\n' "$l_"; continue; }
    [ "$o_" != "$w0_" ] || { prevseen "$a_" "$l_" "$o_" || printf '%s\n' "$l_"; continue; }
    case " $occ_ " in *" $o_=0 "*) r_=0 ;; *" $o_=1 "*) r_=1 ;; *" $o_=2 "*) r_=2 ;; *) coord_check "$o_"; r_=$?; occ_="$occ_ $o_=$r_" ;; esac
    [ $r_ = 1 ] || continue
    # 주인이 사라짐: 모든 지휘가 보냄. 옛 주인이 자기 wait로 이미 본 사건은 그 주인에게 간 것이라 보내지 않는다
    prevseen "$a_" "$l_" "$o_" || printf '%s\n' "$l_"
  done
}
# prevseen <레인 주소> <사건 줄> <지금 owner>: 「보낸 것」 = sent ∪ 그 레인의 옛 주인 seen(6차 감사 — 주인이 사라진 뒤 옛 주인이
# wait로 받은 사건을 다시 보냈다). 옛 주인 = 레인 기록의 그 레인 지휘들과 지금 owner 가운데 이 watch가 아닌 것(seen 파일이 없으면 sent만).
# 있으면 0 — 받은 것으로 치고 이 watch 커서에도 적어 다음 바퀴에 다시 거르지 않는다
prevseen() {
  k_=$(printf '%s\n' "$2" | LC_ALL=C awk -F'\t' "$evkey$nkf"'{ print nk(key()) }')
  for p_ in $( { awk -F'\t' -v a="$1" '$1 == a { print $3 }' "$evdir/lanes.tsv" 2>/dev/null; echo "$3"; } | sed 's|.*/||' | sort -u); do
    [ "$p_" != - ] && [ "$p_" != "$w0_" ] || continue
    if inseen "$k_" "$evdir/seen.$(ckey "$p_")"; then printf '%s\n' "$k_" >>"$cur"; return 0; fi
  done
  return 1
}
# lkinds: 레인 기록에서 「주소(끝의 t…)<탭>레인<탭>종류」(넷째 칸 read·fill이 있는 줄만). 구현 레인 줄은 3칸 그대로
lkinds() { awk -F'\t' 'NF >= 4 && ($4 == "read" || $4 == "fill") { a = $1; sub(/^.*\//, "", a); print a "\t" $2 "\t" $4 }' "$evdir/lanes.tsv" 2>/dev/null; }
# owner <레인 주소>: 그 레인을 띄운 지휘 — 레인 기록(<evdir>/lanes.tsv, hc-lane이 띄울 때 적음)의 마지막 줄, 없으면 hc ls parent,
# 없으면 -. <기계>/t… 꼴은 끝의 t…(watch·지휘 정보는 지휘 기계 것이다).
# ponytail: 다른 기계 지휘의 parent가 이 기계 지휘와 같은 t 이름이면 섞인다 — 잦으면 기계 이름까지 맞춘다
owner() {
  o_=$(awk -F'\t' -v a="$1" '$1 == a { o = $3 } END { print o }' "$evdir/lanes.tsv" 2>/dev/null)
  # 기록이 -(띄울 때 지휘 확인 실패 등)여도 hc parent가 있으면 그것(4차 감사 [낮음] 1. hc-fill 레인은 parent도 없다)
  [ -n "$o_" ] && [ "$o_" != - ] || o_=$(printf '%s\n' "$pmap" | awk -F'\t' -v a="$1" '$1 == a { print $2; exit }')
  o_=${o_:--}; [ "$o_" = - ] || o_=${o_##*/}
  printf %s "$o_"
}
# wsend <글>: 지휘 터미널에 붙여 넣고 Enter. 사람이 쓰던 초안이 있으면 hc가 기다리니 60초 상한(넘으면 실패 — 다음 바퀴에 다시)
# 보내기 전마다 coord_check: 지휘 정보와 다르거나 없으면 보내지 않고(남의 터미널 send 0) 「지휘 없음」을 남기고 끝낸다 — 커서에 안
# 적었으니 사건은 events에 남아 지휘가 돌아와 wait/watch를 걸면 받는다. 코어 연결 실패(모름)는 다음 바퀴에 다시
wsend() { wcheck || return 1; ! wheld || return 1; capt 60 hc send "$wto" "$1" </dev/null >/dev/null 2>&1 || { echo "hc-lane watch: hc send $wto 실패 — 다음 바퀴에 다시" >&2; return 1; }; }
# wheld: 지휘가 질문·권한 창을 띄웠으면 0(보내지 않음 — 다음 바퀴에 다시, 사건은 쌓였다가 창이 닫힌 뒤 한 번에). watch-hold 2026-11-19:
# 창이 떠 있을 때 보낸 알림 글이 그 창의 자유 입력 칸에 들어가 사용자 답으로 제출됐다. 막힘 = hc get status.state가 blocked, 또는
# status가 null(하단 줄 실행기 안의 Claude처럼 상태를 안 알림)이고 화면이 창(wdialog).
# hc get·hc read를 못 읽으면 아님(알림을 잃지 않는 쪽). lane.watch_hold_max분(0이면 막지 않음)은 status blocked에만: 넘으면 보낸다
# (hc가 blocked면 스스로 거절해 — --force를 안 쓴다 — 창이 닫힐 때까지 실패로 다시 돈다). 화면으로 잡은 창은 상한이 지나도 보내지
# 않는다(감사 M1: hc가 막지 않아 창에 답으로 들어간다). 미룬 사건은 커서에 안 적혀 지휘의 hc-lane wait로도 받으니 잃지 않는다.
# 상한을 넘으면 한 줄만(stderr·watch.log — 바퀴마다 되풀이하지 않음)
# 「"state":"blocked"」는 status 안에만 나온다(맨 위 state는 live·finished, msg 안 따옴표는 \"로 이스케이프돼 안 걸림)
wheld() {
  [ "$whmax" -gt 0 ] || return 1
  hg_=$(capt 10 hc get "$wto" --json </dev/null 2>/dev/null) || hg_=
  if printf '%s\n' "$hg_" | grep -Eq '"state" *: *"blocked"'; then hw_=blocked
  elif printf '%s\n' "$hg_" | grep -Eq '"status" *: *null' && capt 10 hc read "$wto" </dev/null 2>/dev/null | wdialog; then hw_=화면
  else wh0= wlg_=; return 1; fi
  now_=$(date +%s)
  [ -n "$wh0" ] || { wh0=$now_ wlg_=; echo "hc-lane watch: 지휘 $wto 질문·권한 창($hw_) — 보내지 않고 창이 닫히면 한 번에 보낸다" >&2; }
  [ $((now_ - wh0)) -ge "$whmax" ] || return 0
  if [ "$hw_" = 화면 ]; then
    [ -n "$wlg_" ] || { wlg_=1; l_="$(utc) hc-lane watch: $wto 질문 창 $(((now_ - wh0) / 60))분째 — 보류 중(화면으로 잡은 창은 보내지 않는다, 사건은 hc-lane wait로도 받음)"
      printf '%s\n' "$l_" >&2; printf '%s\n' "$l_" >>"$evdir/watch.log"; }
    return 0
  fi
  [ -n "$wlg_" ] || { wlg_=1; echo "hc-lane watch: 지휘 $wto 질문·권한 창이 $((whmax / 60))분 넘게 — 보낸다(blocked면 hc가 거절해 창이 닫힐 때까지 다시)" >&2; }
  return 1
}
# wdialog: 화면(stdin)이 Claude Code 질문·권한 창이면 0(감사 M2 — 대화 글에 인용된 창 글자에 걸리지 않게 화면 맨 아래 덩어리만).
# 가로줄 = 앞 빈칸 뒤 ─·╌ 셋 이상으로 시작하는 줄. 마지막 두 가로줄이 평소 입력 칸(가로줄 바로 아래 ❯ 줄, 그 아래 다시 가로줄)이면
# 창 아님 — 화면 위쪽(지휘가 hc read로 본 남의 입력 칸 등)은 안 본다(재감사 R-M1: 한 번 본 입력 칸이 맨 아래 진짜 창을 가렸다).
# 아니면 마지막 가로줄 아래 줄에서만 lane.watch_dialog 글자를 찾는다. 가로줄이 없으면 아님.
# 실측 꼴(Claude Code 2.1.328): 질문 창은 「─ / ☐ 머리 / 질문 / ❯ 1. … / Type something. / ─ / 4. Chat about this / Enter to select …」,
# 권한 창은 「╌ / 설명 / Do you want to proceed? / ❯ 1. Yes / 2. No / Esc to cancel …」 — 둘 다 입력 칸이 없다
wdialog() {
  LC_ALL=C awk '
    function rule(s) { return s ~ /^[ \t]*(─|╌)(─|╌)(─|╌)/ }
    { l[NR] = $0; if (rule($0)) { box = (lr && lr + 1 < NR && l[lr + 1] ~ /^[ \t]*❯/); lr = NR } }
    END { if (box || !lr) exit 1; for (i = lr + 1; i <= NR; i++) print l[i] }' | grep -Eq -e "$wdlg"
}
# wcheck: 이 watch의 지휘 정보가 맞나. 다르거나 없으면 「지휘 없음」을 남기고 끝낸다(exit 0), 모르면 1, 맞으면 0.
# 바퀴마다 앞에서도 부른다(남의 사건만 있어 보낼 일이 없어도 지휘가 사라졌으면 끝나게)
wcheck() {
  coord_check "$wto"; c_=$?
  # 손으로 건 watch가 시작 때 지휘 정보를 못 적었으면(hc get 잠깐 실패) 여기서 다시 적어 본다(3차 감사 [낮음] 2)
  if [ $c_ = 1 ] && [ "${wpar-0}" = 1 ] && [ ! -f "$evdir/coord.$(ckey "$wto")" ]; then coord_set "$wto"; coord_check "$wto"; c_=$?; fi
  [ $c_ != 2 ] || { echo "hc-lane watch: 지휘 $wto 확인 못 함(hc get 실패) — 다음 바퀴에 다시" >&2; return 1; }
  if [ $c_ != 0 ]; then
    l_="$(utc) hc-lane watch: 지휘 없음 $wto — $cwhy. 보내지 않고 끝낸다(사건은 events에 남음, 지휘가 wait/watch를 걸면 받음)"
    printf '%s\n' "$l_" >&2; printf '%s\n' "$l_" >>"$evdir/watch.log"
    exit 0
  fi
}
# wsleep: 끄면(TERM·INT·HUP) 바로 끝나게 sleep을 배경으로 두고 기다린다(트랩이 그 sleep도 끈다)
wsleep() { sleep "$tick" & sp_=$!; wait $sp_; sp_=; }
# watch_lock: 같은 지휘 주소로 watch는 하나만(뒤 것은 종료 75). 잠금 폴더 <evdir>/watch.<주소>/pid.
# 남은 잠금(그 pid가 없거나 hc-lane이 아님)은 넘겨받는다. 끝날 때(지휘 사라짐·TERM·INT·HUP) 자기 잠금만 지운다
# ---- 지휘 정보(2차 감사 [중간] B, 3차 [중간] 1): 지휘 주소를 설정에 박지 않는다. 지휘가 레인을 띄우거나 wait·watch를 걸 때
# 자기 정보 「주소<탭>pid<탭>이름<탭>마지막으로 레인을 띄운 시각(초, 없으면 0)」을 지휘마다 <evdir>/coord.<주소>에 남기고,
# watch는 보낼 때마다 자기 지휘의 것과 그 주소의 hc get pid·이름이 같은지 본다. 코어가 다시 떠 주소가 남에게 가면 pid가 달라
# 보내지 않는다. 지휘가 다음 레인을 띄우면 새로 써진다.
# ponytail: coord.* 는 지우지 않는다(지휘 세션마다 하나) — 많아지면 coord_default가 확인 못 하는(없음) 것을 지운다
ckey() { printf %s "$1" | tr -c 'A-Za-z0-9_-' _; }
# tinfo <주소>: 그 터미널의 맨 위 pid·이름(tp_·tn_, 이름 없으면 -)과 레인·감시 라벨 여부(tl_ 1/0). 0 살아 있음,
# 1 없음·끝남·pid 모름, 2 모름(코어 연결 실패 등 — JSON이 아님). foreground·status 안의 pid·name은 빼고 본다
tinfo() {
  g_=$(capt 10 hc get "$1" --json </dev/null 2>&1)
  printf '%s\n' "$g_" | grep -Eq '"kind" *: *"not_found"|"address" *:' || return 2
  g_=$(printf '%s\n' "$g_" | sed 's/"foreground" *: *{[^}]*}//; s/"status" *: *{[^}]*}//')
  printf '%s\n' "$g_" | grep -q '"state" *: *"live"' || return 1
  tp_=$(printf '%s\n' "$g_" | sed -n 's/.*"pid" *: *\([0-9][0-9]*\).*/\1/p' | tail -n 1)
  tn_=$(printf '%s\n' "$g_" | sed -n 's/.*"name" *: *"\([^"]*\)".*/\1/p' | tail -n 1); tn_=${tn_:--}
  tl_=0; ! printf '%s\n' "$g_" | grep -Eq '"hc-lane(-watch)?" *: *"1"' || tl_=1
  [ -n "$tp_" ]
}
# coord_is <주소>: 그 터미널이 살아 있고 레인·감시 터미널이 아니면 0(지휘로 받음). 아무것도 안 쓴다. 1 아님, 2 모름(hc get 실패)
coord_is() { tinfo "$1" || return; [ "$tl_" = 0 ]; }
# coord_set <주소> [launch]: 그 터미널이 살아 있고 레인·감시 터미널이 아니면 지휘 정보로 적는다(레인이 하위 레인을 띄워도 덮지
# 않게 — 그때 1). launch면 띄운 시각을 지금으로, 아니면 같은 pid의 옛 시각 그대로
coord_set() {
  coord_is "$1" || return 1
  f_=$evdir/coord.$(ckey "$1") ts_=0
  if IFS=$tab read -r a_ p_ n_ t_ 2>/dev/null <"$f_" && [ "$p_" = "$tp_" ]; then case $t_ in ''|*[!0-9]*) ;; *) ts_=$t_ ;; esac; fi
  [ "${2-}" != launch ] || ts_=$(date +%s)
  mkdir -p "$evdir" && printf '%s\t%s\t%s\t%s\n' "$1" "$tp_" "$(flat "$tn_")" "$ts_" >"$f_.$$" && mv -f "$f_.$$" "$f_"
}
# coord_check <주소>: 그 지휘의 정보(coord.<주소>)가 있고 지금 hc get pid·이름이 같으면 0(주소는 cad_, 띄운 시각은 cts_).
# 1 다름·없음(까닭은 cwhy), 2 모름(hc get 연결 실패)
coord_check() {
  IFS=$tab read -r cad_ cpi_ cnm_ cts_ 2>/dev/null <"$evdir/coord.$(ckey "$1")" ||
    { cwhy="지휘 정보 없음($evdir/coord.$(ckey "$1") — 지휘가 레인을 띄우거나 wait를 걸면 생김)"; return 1; }
  tinfo "$cad_"; r_=$?
  [ $r_ != 2 ] || { cwhy="hc get $cad_ 실패"; return 2; }
  [ $r_ = 0 ] || { cwhy="$cad_ 터미널이 없거나 끝남"; return 1; }
  [ "$tp_" = "$cpi_" ] && [ "$(flat "$tn_")" = "$cnm_" ] || { cwhy="$cad_ 의 pid·이름($tp_ $tn_)이 지휘 정보($cpi_ $cnm_)와 다름"; return 1; }
}
# coord_default: 살아 있고 pid·이름이 맞는 지휘 가운데 가장 최근에 레인을 띄운 곳(cad_). hc-lane coord가 찍고, 주인 없는(또는 주인이
# 사라진) hc-fill 줄을 띄울 때 hc-fill이 watch 대상으로 넘긴다(사건은 wfilter가 모든 지휘에게). 1 그런 지휘 없음, 2 그보다 최근 지휘를 확인 못 함(hc get 실패 — 남에게 보내지 않게)
coord_default() {
  bt_=-1 ba_= ut_=-1
  for cf_ in "$evdir"/coord.*; do
    case ${cf_##*/} in coord.*.*) continue ;; esac   # 쓰는 중인 coord.<주소>.<pid>
    IFS=$tab read -r ca_ cp_ cn_ ct_ 2>/dev/null <"$cf_" || continue
    case $ct_ in ''|*[!0-9]*) ct_=0 ;; esac
    coord_check "$ca_"; r_=$?
    if [ $r_ = 0 ]; then [ "$ct_" -le "$bt_" ] || { bt_=$ct_ ba_=$ca_; }
    elif [ $r_ = 2 ] && [ "$ct_" -gt "$ut_" ]; then ut_=$ct_; fi
  done
  [ -n "$ba_" ] || { cwhy="살아 있고 pid·이름이 맞는 지휘가 없다(지휘가 레인을 띄우거나 wait를 걸면 생김)"; return 1; }
  [ "$ut_" -le "$bt_" ] || { cwhy="더 최근 지휘를 확인 못 했다(hc get 실패)"; return 2; }
  cad_=$ba_
}
# fillq: hc-fill 대기열(${HC_FILL_DATA:-~/.local/share/hc-fill}/queue.tsv, 여섯째 칸 상태)에 아직 안 띄운 요청(wait)이 있으면 0.
# up은 세지 않는다: 살아 있는 up 레인은 hc ls(라벨 hc-lane=1)가 세고, 끝난 up 줄(hc-fill add 줄은 rm할 때까지 남음)을 세면
# 쉼 종료가 영영 안 온다(2차 감사 [중간] A). 받은편지 요청은 hc-fill이 바퀴마다 이 대기열로 옮기므로 함께 보인다
fillq() { awk -F'\t' '$6 == "wait" { f = 1; exit } END { exit !f }' "${HC_FILL_DATA:-$HOME/.local/share/hc-fill}/queue.tsv" 2>/dev/null; }
# watch_alive <잠금 폴더>: 그 잠금의 pid가 살아 있는 hc-lane watch면 0(그 pid를 op에)
watch_alive() {
  op=$(cat "$1/pid" 2>/dev/null)
  case $op in ''|*[!0-9]*) return 1 ;; esac
  kill -0 "$op" 2>/dev/null && ps -p "$op" -o command= 2>/dev/null | grep -q 'hc-lane.*watch'
}
watch_lock() {
  lk=$evdir/watch.${cur##*/seen.}
  if ! mkdir "$lk" 2>/dev/null; then
    ! watch_alive "$lk" || { echo "hc-lane watch: $wto 감시가 이미 돈다(pid $op)" >&2; exit 75; }
    rm -rf "$lk"; mkdir "$lk" 2>/dev/null || { echo "hc-lane watch: $wto 감시가 막 떴다" >&2; exit 75; }
  fi
  echo $$ >"$lk/pid" || die "watch: 잠금을 쓰지 못했다: $lk"
  sp_=
  trap '[ -z "$sp_" ] || kill "$sp_" 2>/dev/null; [ "$(cat "$lk/pid" 2>/dev/null)" != $$ ] || rm -rf "$lk"' EXIT
  trap 'exit 143' TERM; trap 'exit 130' INT; trap 'exit 129' HUP
}
# send --all [--audits] [--from <지휘 주소>] <글…>: 이 지휘가 띄운 살아 있는 레인 전부에 hc send(2026-11-17 지휘 「실수는 바로
# 코드로」 — 착지 마감 연장을 원격 레인에만 보내 맥 레인이 멈췄다). 주인은 owner()(레인 기록 마지막 지휘, 없으면 hc parent)의 끝 t….
# 감사(레인 기록 read·이름 audit-*)는 --audits일 때만. 한 줄씩 「보냄|실패 <주소> <레인>」, 끝 줄 「보냄 n · 실패 m」.
# 종료 0 다 보냄(대상 없음 포함), 1 보내기·hc ls 실패, 2 인자
send_cmd() {
  sall=0 saud=0 sfrom=${HC_TERMINAL_ID-} smsg=
  while [ $# -gt 0 ]; do
    case $1 in
      --all) sall=1 ;;
      --audits) saud=1 ;;
      --from) val "$@"; sfrom=$2; shift ;;
      -h|--help) usage ;;
      --) shift; smsg="${smsg:+$smsg }$*"; break ;;   # 끝 표시: 뒤 낱말은 옵션이어도 글(감사 L4)
      *) smsg="${smsg:+$smsg }$1" ;;
    esac
    shift
  done
  [ $sall = 1 ] || { echo "hc-lane send: --all 을 준다(이 지휘의 레인 전부에 보낸다. 한 레인만이면 hc send <주소>)" >&2; exit 2; }
  [ -n "$sfrom" ] || { echo "hc-lane send: 지휘 주소를 모른다(지휘 터미널에서 부르거나 --from <주소>)" >&2; exit 2; }
  [ -n "$smsg" ] || { echo "hc-lane send: 보낼 글이 없다" >&2; exit 2; }
  tl=$(capt 30 hc ls --all --json --label hc-lane=1 </dev/null 2>/dev/null) ||
    { echo "hc-lane send: hc ls 실패 — 아무에게도 안 보냈다" >&2; exit 1; }
  pmap=$(printf '%s\n' "$tl" | jrec address parent) km_=$(lkinds) ok_=0 bad_=0
  while IFS=$tab read -r a_ n_; do
    [ -n "$a_" ] && [ "$(owner "$a_")" = "${sfrom##*/}" ] || continue
    if [ $saud = 0 ]; then
      case $n_ in audit-*) continue ;; esac
      ! printf '%s\n' "$km_" | A=${a_##*/} N=$n_ awk -F'\t' '$1 == ENVIRON["A"] && $2 == ENVIRON["N"] && $3 == "read" { f = 1 } END { exit !f }' || continue
    fi
    if e_=$(capt 60 hc send "$a_" "$smsg" </dev/null 2>&1 >/dev/null); then echo "보냄 $a_ $n_"; ok_=$((ok_ + 1))
    else echo "실패 $a_ $n_ — $(flat "${e_:-hc send 실패}")"; bad_=$((bad_ + 1)); fi
  done <<EOF
$(printf '%s\n' "$tl" | jrec address state name | awk -F'\t' '$2 == "live" { print $1 "\t" $3 }')
EOF
  echo "보냄 $ok_ · 실패 $bad_"
  [ $bad_ = 0 ]
}
# early-wait <선행…>: 먼저 띄움 레인의 기다림 블록이 기한에 닿았을 때. hc-fill이 바퀴마다 이 기계에 써 주는 선행 상태
# (~/.local/share/hc-fill/after.tsv: 선행 go|stop 까닭 쓴시각(초))를 읽어 선행마다 「<선행>: <까닭>」. 모두 go이고 기록이 15분 안이면 0
# (계속 기다림), 기록 없음·묵음(hc-fill이 안 돎)·stop이 하나라도 있으면 1(예전처럼 멈춤), 인자 없으면 2
early_wait_cmd() {
  [ $# -gt 0 ] || { echo "사용법: hc-lane early-wait <선행 레인>…" >&2; return 2; }
  af_=$HOME/.local/share/hc-fill/after.tsv now_=$(date +%s) bad_=0
  for p_ in "$@"; do
    l_=$(awk -F'\t' -v n="$p_" '$1 == n { l = $0 } END { print l }' "$af_" 2>/dev/null)
    IFS=$'\t' read -r _ s_ w_ t_ <<<"$l_"
    case $t_ in '' | *[!0-9]*) t_= ;; esac
    if [ -z "$l_" ]; then echo "$p_: 기록 없음(선행 상태 모름 — $af_)"; bad_=1
    elif [ -z "$t_" ] || [ $((now_ - t_)) -gt 900 ]; then echo "$p_: 기록이 $(( (now_ - ${t_:-0}) / 60 ))분 묵음(hc-fill이 안 돎) — $w_"; bad_=1
    elif [ "$s_" = go ]; then echo "$p_: $w_"
    else echo "$p_: $w_"; bad_=1; fi
  done
  [ $bad_ = 0 ] || return 1
  echo "선행이 살아 진행 중 — 기한이 지나도 계속 기다린다"
}
case ${1-} in
  early-wait) shift; early_wait_cmd "$@"; exit $? ;;
  report) shift; report_cmd "$@"; exit $? ;;
  send) shift; send_cmd "$@"; exit $? ;;
  broadcast) shift; send_cmd --all "$@"; exit $? ;;
  events|wait|watch) c_=$1; shift; ev_cmd "$c_" "$@"; exit $? ;;
  coord)
    # coord --set [<주소>]: 그 지휘(기본 $HC_TERMINAL_ID)의 지휘 정보를 남긴다(hc-fill add — 넣은 지휘가 레인을 직접 띄운 적이 없어도
    # 그 지휘의 watch가 뜨고 보내게). 띄운 시각도 지금으로. 살아 있는 지휘 터미널이 아니면(레인·감시·없음) 종료 1
    if [ "${2-}" = --set ]; then
      sa_=${3:-${HC_TERMINAL_ID-}}
      [ -n "$sa_" ] || { echo "hc-lane coord --set: 주소가 없다(지휘 터미널에서 부르거나 주소를 준다)" >&2; exit 2; }
      coord_set "$sa_" launch && { echo "$sa_"; exit 0; }
      echo "hc-lane coord --set: $sa_ 는 살아 있는 지휘 터미널이 아니다(레인·감시 터미널이거나 없음)" >&2; exit 1
    fi
    # coord --check <주소>: 그 지휘가 지금 살아 있고 지휘 정보(pid·이름)와 맞나 — 0 맞음, 1 다름·없음, 2 모름(hc get 실패). 아무것도 안 씀
    if [ "${2-}" = --check ]; then
      [ -n "${3-}" ] || { echo "hc-lane coord --check: 주소를 준다" >&2; exit 2; }
      coord_check "$3"; c_=$?; [ $c_ = 0 ] || echo "hc-lane coord --check: $cwhy" >&2; exit $c_
    fi
    coord_default; c_=$?; [ $c_ = 0 ] && { echo "$cad_"; exit 0; }; echo "hc-lane coord: 지휘 없음 — $cwhy" >&2; exit 1 ;;
esac

on= read=0 direct=0 archive=0 branch= dry=0 steps=0 name= repo= cmd=launch lbase= act= integ= minage= brief= swarg= rb=0
case ${1-} in
  clean) cmd=clean; shift ;;
  fetch) cmd=fetch; shift ;;
  gc) cmd=gc; shift ;;
  land) cmd=land; shift; case ${1-} in ''|-*) ;; *) lbase=$1; shift ;; esac ;;
  merger) cmd=merger; shift; mga_=("$@"); set -- ;;   # 자기 인자는 merger_cmd가 읽는다(아래 함수 정의 뒤에 부름)
  guard) cmd=guard; shift; act=${1-}; [ $# = 0 ] || shift ;;
  lease) cmd=lease; shift; act=${1-}; [ $# = 0 ] || shift ;;
esac
while [ $# -gt 0 ]; do
  case $1 in
    --on) val "$@"; on=$2; shift 2 ;;
    --branch) val "$@"; branch=$2; shift 2 ;;
    --name) val "$@"; name=$2; shift 2 ;;
    --repo) val "$@"; repo=$2; shift 2 ;;
    --read) read=1; shift ;;
    --direct) direct=1; shift ;;
    --brief) val "$@"; brief=$2; shift 2 ;;
    --start-wait) val "$@"; swarg=$2; shift 2 ;;
    --dry-run) dry=1; shift ;;
    --print-steps) steps=1; shift ;;
    --integ) integ=refs/integ/; shift ;;
    --integ=*) integ=${1#--integ=}; [ -n "$integ" ] || die "--integ= 뒤에 접두가 없다"; shift ;;
    --min-age) val "$@"; minage=$2; shift 2 ;;
    --remote-branches) rb=1; shift ;;
    --archive) archive=1; shift ;;
    -h|--help) usage ;;
    --) shift; break ;;
    -*) die "알 수 없는 인자: $1" ;;
    *) [ $cmd = fetch ] && break; die "알 수 없는 인자: $1 (실행 명령 앞에는 -- 를 둔다)" ;;
  esac
done
[ $cmd = launch ] || [ -z "$brief$swarg" ] || die "--brief·--start-wait는 레인을 띄울 때만 쓴다"
[ $cmd = launch ] || [ $direct = 0 ] || die "--direct는 레인을 띄울 때만 쓴다"
[ $read$direct != 11 ] || { echo "hc-lane: --read와 --direct는 함께 쓰지 않는다(--direct는 쓰기 레인만)" >&2; exit 2; }   # 감사 [낮음] 2
if [ $cmd = fetch ]; then
  [ -n "$repo" ] || usage
  [ -z "$name$branch" ] && [ $read$dry$steps = 000 ] || die "fetch에는 --on·--repo와 참조만 쓴다"
  for a; do case $a in -*) die "fetch 참조는 - 로 시작하지 않는다(git 옵션으로 읽힌다): $a" ;; esac; done
elif [ $cmd = clean ]; then
  [ -n "$repo" ] && [ -n "$name$branch" ] || usage
  [ $read = 0 ] && [ $steps = 0 ] && [ $# = 0 ] || die "clean에는 --read·--print-steps·실행 명령을 쓰지 않는다"
elif [ $cmd = gc ]; then
  [ -n "$repo" ] || usage
  [ -z "$name$branch" ] && [ $read$steps = 00 ] && [ $# = 0 ] || die "gc에는 --on·--repo·--dry-run·--integ·--min-age·--remote-branches만 쓴다"
  case $integ in
    '') ;;
    refs/heads/*|refs/tags/*|refs/claims/*|refs/remotes/*) die "--integ 접두로 가지·태그·선점 참조는 쓰지 않는다: $integ" ;;
    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789/_.-]*) die "--integ 접두에 쓸 수 없는 글자가 있다: $integ" ;;
    refs/?*/) ;;
    *) die "--integ 접두는 refs/<이름>/ 꼴: $integ" ;;
  esac
  m=${minage:-24h} u=${m#"${m%[smhd]}"} k=${m%[smhd]}
  case $k in ''|*[!0-9]*) die "--min-age는 숫자에 s·m·h·d(단위 없으면 시간): $m" ;; esac
  case $u in s) secs=$k ;; m) secs=$((k * 60)) ;; d) secs=$((k * 86400)) ;; *) secs=$((k * 3600)) ;; esac
  mins=$(((secs + 59) / 60))
elif [ $cmd = land ]; then
  [ -z "$on$name$branch$repo" ] && [ $read$dry$steps = 000 ] && [ $# = 0 ] ||
    die "land는 레인 작업 폴더 안에서 인자 없이(또는 기본 브랜치 하나만) 부른다: hc-lane land [<기본 브랜치>]"
elif [ $cmd = merger ]; then
  :   # 인자는 merger_cmd가 읽는다
elif [ $cmd = lease ]; then
  case $act in show|drop) ;; *) usage ;; esac
  [ -n "$repo" ] && [ -n "$name" ] && [ -z "$branch" ] && [ $read$dry$steps = 000 ] && [ $# = 0 ] || die "lease show|drop에는 --on·--repo·--name만 쓴다"
elif [ $cmd = guard ]; then
  case $act in install|status|remove) ;; *) usage ;; esac
  [ -n "$repo" ] || usage
  [ -z "$on$name" ] && [ $read$dry$steps = 000 ] && [ $# = 0 ] ||
    die "guard에는 --repo(와 --branch <기본 브랜치>)만 쓴다. 다른 기계는 hc exec --on <기계> -- hc-lane guard …"
else
  [ -n "$name" ] && [ -n "$repo" ] || usage
fi
[ $cmd = clean ] || [ $archive = 0 ] || die "--archive는 clean에서만 쓴다"
[ $cmd = gc ] || { [ -z "$integ$minage" ] && [ $rb = 0 ]; } || die "--integ·--min-age·--remote-branches는 gc에서만 쓴다"
case $name in *[!abcdefghijklmnopqrstuvwxyz0123456789_-]*) die "--name은 a-z 0-9 - _ 만 쓴다(hc 규칙): $name" ;; esac
[ ${#name} -le 32 ] || die "--name은 32자까지: $name"
[ $cmd != launch ] || [ $steps = 1 ] || [ $# -gt 0 ] || [ -n "$brief" ] || die "-- 뒤에 실행 명령이 없다"

# 대상 기계에서 실행(종료 코드 그대로).
# core=1(hook이 hc 터미널 밖 로컬에서 켬): 로컬도 hc 코어 문맥(hc exec --)으로. launchd(hc-fill)가 띄운 bash는 ~/Documents의
# 스크립트를 못 읽는다(TCC 「Operation not permitted」, 2026-11-17 travel-c0 실측). 코어가 띄우는 프로그램은 읽는다
x() { if [ -n "$on" ]; then hc exec --on "$on" --timeout 600 -- "$@"; elif [ -n "${core-}" ]; then hc exec --timeout 600 -- "$@"; else "$@"; fi; }
xi() { if [ -n "$on" ]; then hc exec -i --on "$on" --timeout 600 -- "$@"; else "$@"; fi; }   # 표준 입력을 넘긴다
# zx <폴더> <명령…>: 대상 기계의 그 폴더에서. --on이면 hc 코어 환경이라 ~/.zshrc의 PATH(bun·gh 자격 도우미 등)가 없다
# (150·151 실측, 2026-11-16 감사 대상 fetch가 「could not read Username」). zsh·~/.zshrc가 있으면 로그인 셸(~/.zprofile의
# brew shellenv)로 ~/.zshrc까지 읽고 돈다. -i(대화형)는 쓰지 않는다: 프롬프트·자동 붙기 같은 대화형 설정이 출력을 섞거나 멈춘다.
zx() {
  x sh -c 'cd "$1" || exit 1
    if [ -n "$2" ] && [ -f "$HOME/.zshrc" ] && command -v zsh >/dev/null 2>&1; then
      d=$1; shift 2
      exec zsh -lc "source \"\$HOME/.zshrc\" >/dev/null 2>&1; cd \"\$1\" && shift && exec \"\$@\"" zsh "$d" "$@"
    fi
    shift 2; exec "$@"' hc-lane "$1" "$on${core-}" "${@:2}"
}
# fetchr <명령…>: git fetch(그대로 또는 x·zx로)를 돌리고, 같은 클론에서 다른 레인의 착지·fetch가 원격 참조를 함께 고쳐 난
# 참조 잠금 경합(cannot lock ref·unable to update local ref·is at … but expected, 한국어 git 메시지 포함)이면 1·2·4초 쉬고
# 최대 3번 다시 한다(2026-11-18 워커 기계의 레인 시작 실패 실측). 다른 실패는 바로 그 종료 코드로. 쉬는 간격은
# HC_LANE_FETCH_WAITS(시험용). 한국어 git(2.56.1 ko 카탈로그, 2026-11-19 mini-m4 실측): 「cannot lock ref」·「is at … but
# expected」는 번역이 없어 영어 그대로, 「unable to update local ref」→「로컬 레퍼런스를 업데이트할 수 없습니다」,
# 「Unable to create '….lock': …」→「'….lock'을 만들 수 없습니다: …」
fetchr() {
  fr_e=$(mktemp "${TMPDIR:-/tmp}/hc-lane-fetch.XXXXXX") || { "$@"; return; }
  for fr_w in ${HC_LANE_FETCH_WAITS:-1 2 4} -; do
    "$@" 2>"$fr_e"; fr_rc=$?
    cat "$fr_e" >&2
    [ $fr_rc != 0 ] && [ "$fr_w" != - ] &&
      grep -Eq "cannot lock ref|unable to update local ref|is at [0-9a-f]+ but expected|로컬 레퍼런스를 업데이트할 수 없습니다|\.lock'을 만들 수 없습니다" "$fr_e" || break
    echo "hc-lane: git fetch 참조 잠금 경합(같은 클론의 다른 fetch·착지) — ${fr_w}초 뒤 다시" >&2
    sleep "$fr_w"
  done
  rm -f "$fr_e"; return $fr_rc
}
q() { printf "'%s'" "$(printf %s "$1" | sed "s/'/'\\\\''/g")"; }

# ffmain <메인 폴더> <기본>: 메인 폴더를 origin/<기본>으로 fast-forward(2026-11-18 main-folder-ff — 워커 기계 메인 폴더가 이틀 동안
# 안 앞당겨져 main보다 375~497커밋 뒤, --read 감사가 옛 CLAUDE.md·계약·시험을 읽었다). 기본 브랜치에 있고 추적 파일 변경과
# 진행 중인 merge·rebase·cherry-pick·revert가 없을 때만 merge --ff-only. 추적 안 된 파일과 부딪히면 git이 거절해 그대로 둔다.
# 무시된 파일도 덮지 않는다(--no-overwrite-ignore — git 기본은 덮음, 감사 M1: 무시된 .env를 upstream이 추적하기 시작하면 조용히 바뀜).
# skip-worktree·assume-unchanged 표시 파일은 status에 안 보여 건너뛴다(감사 L4). 그 기계에서 메인 폴더(아래)를 cwd로 쓰는 살아 있는
# working·blocked 터미널(부른 터미널 자신 빼고)이 있으면 건너뛴다 — 일하는 세션 발밑에서 파일이 바뀌지 않게(감사 M2). idle·done이면 앞당긴다.
# stash·reset·checkout은 쓰지 않는다. 결과 한 줄(앞당김·최신은 표준 출력, 건너뜀은 오류 출력), 늘 종료 0(레인·착지는 막지 않음)
# mainbusy <폴더>: 그 기계에서 그 폴더(아래)를 cwd로 쓰는 일하는 터미널 주소를 빈칸으로. hc ls 실패·꼴을 못 읽으면 종료 1.
# 일하는 터미널: status가 working·blocked, 또는 status가 없는데(셸에서 실행기로 띄운 대화형 지휘 — hc ls에 agent zsh·status 없음,
# 재감사 R-M1) hc get의 foreground pid가 터미널 pid와 다름(셸 위에 에이전트·빌드 등이 돎). 그 판정을 못 하면 일하는 중으로 친다
mainbusy() {
  mb_=$(hc ls --json 2>/dev/null </dev/null) || return 1
  case $mb_ in *'"terminals"'*) ;; *) return 1 ;; esac   # 성공했는데 꼴이 다르면 모름(재감사 R-L1)
  printf '%s\n' "$mb_" | jrec address state status cwd | while IFS=$tab read -r a s ss c; do
    case $a in "${on:+$on/}"*) a=${a#"${on:+$on/}"} ;; *) continue ;; esac
    case $a in */*) continue ;; esac                         # 다른 기계
    [ -n "$on" ] || [ "$a" != "${HC_TERMINAL_ID-}" ] || continue   # 부른 터미널 자신(앞당김을 청한 쪽)
    [ "$s" = live ] || continue
    case $c/ in "$1"/*) ;; *) continue ;; esac
    case $ss in
      working|blocked) ;;
      -) g_=$(hc get "${on:+$on/}$a" --json </dev/null 2>/dev/null)
         fp_=$(printf %s "$g_" | sed -n 's/.*"foreground" *: *{[^}]*"pid" *: *\([0-9][0-9]*\).*/\1/p')
         tp_=$(printf %s "$g_" | sed -n 's/.*"pid" *: *\([0-9][0-9]*\).*/\1/p')   # 맨 위 pid는 foreground 뒤라 마지막 것
         [ -z "$fp_" ] || [ "$fp_" != "$tp_" ] || continue ;;           # 셸만 떠 있음
      *) continue ;;
    esac
    printf '%s ' "${on:+$on/}$a"
  done
}
ffmain() {
  if ! fb=$(mainbusy "$1"); then fr="건너뜀: hc ls 실패(메인 폴더에서 일하는 세션을 모름)"
  elif [ -n "$fb" ]; then fr="건너뜀: 메인 폴더에서 일하는 세션 ${fb% }"
  else
  fr=$(x sh -c 'cd "$1" 2>/dev/null || { echo "건너뜀: 폴더 없음"; exit 1; }
    b=$2 gd=$(git rev-parse --absolute-git-dir 2>/dev/null) || { echo "건너뜀: git 폴더를 못 찾음"; exit 1; }
    [ "$(git rev-parse --is-bare-repository 2>/dev/null)" != true ] || { echo "건너뜀: 맨(bare) 저장소"; exit 1; }
    for f in MERGE_HEAD rebase-merge rebase-apply CHERRY_PICK_HEAD REVERT_HEAD; do
      [ ! -e "$gd/$f" ] || { echo "건너뜀: 진행 중인 merge/rebase($f)"; exit 1; }
    done
    h=$(git symbolic-ref -q --short HEAD)
    [ "$h" = "$b" ] || { echo "건너뜀: 기본 브랜치($b)가 아니다(${h:-분리된 HEAD})"; exit 1; }
    [ -z "$(git status --porcelain --untracked-files=no 2>&1)" ] || { echo "건너뜀: 추적 파일에 커밋 안 된 변경"; exit 1; }
    ! git ls-files -v 2>/dev/null | grep -q "^[a-zS]" || { echo "건너뜀: skip-worktree·assume-unchanged 표시 파일이 있다"; exit 1; }
    o=$(git rev-parse -q --verify "refs/remotes/origin/$b^{commit}") || { echo "건너뜀: origin/$b 없음"; exit 1; }
    a=$(git rev-parse --short HEAD) n=$(git rev-parse --short "$o")
    [ "$(git rev-parse HEAD)" != "$o" ] || { echo "최신 $a"; exit 0; }
    git merge-base --is-ancestor HEAD "$o" || { echo "건너뜀: 로컬 $b 에 origin/$b 에 없는 커밋이 있다"; exit 1; }
    e=$(git merge --ff-only --no-overwrite-ignore -q "$o" 2>&1) || { echo "건너뜀: git이 거절 — $(printf %s "$e" | head -n 1)"; exit 1; }
    echo "앞당김 ${a}→${n}"' hc-lane "$1" "$2" 2>/dev/null)
  fi
  case $fr in
    앞당김*|최신*) echo "hc-lane: 메인 폴더 $fr (${on:+$on:}$1)" ;;
    *) echo "hc-lane: 경고 — 메인 폴더 앞당김 ${fr:-건너뜀: 결과를 못 읽음} — 그대로 둠 (${on:+$on:}$1)" >&2 ;;
  esac
  return 0
}

# 출력하는 명령에 따옴표 없이 넣으므로 브랜치 이름은 이 글자만 받는다.
plain() { case $1 in '' | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789/_.-]*) return 1 ;; esac; }

# origin_base <저장소>: origin/HEAD가 가리키는 기본 브랜치, 없으면 main. origin이 없으면(로컬 저장소) 로컬 main, 없으면 master
origin_base() {
  if git -C "$1" remote get-url origin >/dev/null 2>&1; then
    b=$(git -C "$1" symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null); b=${b#origin/}
  elif ! git -C "$1" show-ref -q --verify refs/heads/main && git -C "$1" show-ref -q --verify refs/heads/master; then b=master
  else b=; fi
  echo "${b:-main}"
}

# land: 레인 작업 폴더에서 착지. 저장소의 .claude/herdr-land.sh가 있으면 그것에 맡기고, 없으면 같은 순서를 여기서 한다.
# 검증 스크립트가 없으면 push하지 않는다(옛 착지 줄의 「건너뜀」 뒤 push를 막는다). push는 HERDR_LAND=1로(pre-push 관문 통과).
# 착지 로그(2026-11-17 land-log — senior-web 착지 실패가 끝 15줄에 패키지 없는 FAIL만 남겨 어느 시험인지 몰랐다): 검증(또는
# herdr-land.sh) 출력을 화면 그대로 + 상태 폴더 land-logs/<레인>-<시각>-<pid>.log에. 작업 폴더 .qa가 아닌 까닭: clean이 무시
# 파일과 함께 지우고, gc는 .qa가 남은 작업 폴더를 안 지운다. 실패면 실패 줄(최대 40)·이번에 생긴 .qa/*/herdr-verify-* 폴더·로그
# 경로를 찍고, 레인 안($HC_LANE)이면 「중간」 사건에도 로그 경로를 싣는다
llog_init() {
  ld=$evdir/land-logs
  mkdir -p "$ld" 2>/dev/null || { llog=; return 0; }   # 로그를 못 남겨도 착지는 막지 않는다
  find "$ld" -name '*.log' -mtime +14 -delete 2>/dev/null   # ponytail: 14일 지난 것만 지움, 더 오래 둘 일이 생기면 설정으로
  ln_=${HC_LANE:-$(git symbolic-ref -q --short HEAD 2>/dev/null)}
  llog=$ld/$(printf %s "${ln_:-land}" | tr -c 'A-Za-z0-9._-' '-')-$(date +%Y%m%d-%H%M%S)-$$.log
  : >"$llog" 2>/dev/null || llog=
}
qadirs() { find .qa -mindepth 2 -maxdepth 2 -type d -name 'herdr-verify-*' 2>/dev/null | sort; }
# lrun <명령…>: 출력(오류 출력 포함)을 화면과 로그에. 종료 코드는 명령 것
lrun() {
  [ -n "$llog" ] || { "$@"; return; }
  printf '=== %s HEAD %s: %s\n' "$(date '+%F %T')" "$(git rev-parse --short HEAD 2>/dev/null)" "$*" >>"$llog"
  "$@" 2>&1 | tee -a "$llog"
  return "${PIPESTATUS[0]}"
}
lfail() {
  [ -n "$llog" ] || return 0
  qn=$(qadirs | grep -vxF -- "$qa0")
  echo "hc-lane land: 실패 줄(로그에서, 최대 40줄):" >&2
  { cat "$llog"
    printf '%s\n' "$qn" | while IFS= read -r d; do [ -z "$d" ] || find "$d" -type f -name '*.log' -exec cat {} + 2>/dev/null; done
  } | LC_ALL=C grep -E -- '--- FAIL:|^FAIL[[:space:]]+[^[:space:]]|panic:|\(fail\)|✗|✖|not ok' | awk '!s[$0]++' | head -n 40 >&2
  printf '%s\n' "$qn" | while IFS= read -r d; do [ -z "$d" ] || echo "hc-lane land: 검증 로그 폴더 $PWD/${d#./}" >&2; done
  echo "hc-lane land: 전체 로그 $llog" >&2
  [ -z "${HC_LANE-}" ] || (report_cmd 중간 - "land 실패(종료 $1) — 전체 로그 $llog") >/dev/null 2>&1 || true
}
mainwt() { git worktree list --porcelain | sed -n '1s/^worktree //p'; }   # 메인 폴더(첫 작업 트리)
rr_paths() { printf '%s\n' "$1" | sed -n 's/^CONFLICT ([^)]*): Merge conflict in //p'; }   # LC_ALL=C rebase 출력의 내용 충돌 경로
# rr_ok <rebase 출력>: 멈춘 rebase를 rerere가 다 풀었나(2026-11-19 lane-overlap-guard, 지휘 검토 ④ — 미병합이 비었다는 것만으로는
# 이어 가지 않는다). 커밋 적용 중 멈췄고(REBASE_HEAD), 충돌 줄이 모두 내용 충돌(지움·이름 바꿈 충돌은 rerere가 못 푼다)이며, 그 경로가
# 모두 「Staged '<경로>' using previous resolution」이고, 미병합·rerere remaining이 비었을 때만 0. 훅 실패 등 다른 중단은 1(멈춤 그대로)
rr_ok() {
  git rev-parse -q --verify REBASE_HEAD >/dev/null || return 1
  rp_=$(rr_paths "$1")
  [ -n "$rp_" ] && [ "$(printf '%s\n' "$1" | grep -c '^CONFLICT ')" = "$(printf '%s\n' "$rp_" | grep -c .)" ] || return 1
  rs_=$(printf '%s\n' "$1" | sed -n "s/^Staged '\\(.*\\)' using previous resolution\\.\$/\\1/p")
  printf '%s\n' "$rp_" | RS_="$rs_" awk 'BEGIN { n = split(ENVIRON["RS_"], a, "\n"); for (i = 1; i <= n; i++) ok[a[i]] = 1 } !($0 in ok) { f = 1 } END { exit f }' || return 1
  # 두 확인 명령이 각각 성공했고 결과가 빌 때만(명령이 실패해 빈 출력이면 이어 가지 않는다 — 아스트라 감사 중간 1)
  u_=$(git diff --name-only --diff-filter=U) && [ -z "$u_" ] && u_=$(git rerere remaining) && [ -z "$u_" ]
}
# ---- 병합기(2026-11-20 레인 land-merger-mvp — 사용자 결정 「중앙 병합기, 브랜치만 (추천)」 → 「병합기 최소 버전을 먼저 만들어서
# 전체 적용시키고 일단 사용부터」. 왜: 레인마다 fetch·rebase·검증·차례·push를 하니 rebase 충돌·차례 다툼·재검증으로 착지가 밀렸다.
# main에 쓰는 프로세스를 하나로 하면 그 다툼이 통째로 없어진다) ----
# 켜는 곳은 원격 하나: 원격 참조 refs/herdr/merger/<병합기 기계>(값은 아무 커밋)가 있으면 그 저장소의 hc-lane land는 제출(lane/<레인> +
# 큐 표식)로 바뀌고, 그 기계의 hc-lane merger가 큐를 하나씩 기존 착지(HERDR_MERGER=1 hc-lane land)로 넣는다. 지우면 다음 착지부터 예전
# 그대로. 개인 설정이 아닌 까닭: 워커 기계에는 개인 설정(herdr-tools-config)이 없어 레인이 도는 기계가 읽지 못한다. 원격 참조는
# ls-remote 한 번으로 모든 기계·레인(rebase 안 해도)에 바로 닿고, 착지의 fetch 횟수를 늘리지 않는다.
# 원격을 못 읽으면(켜졌는지 모름) 몇 번 다시 보고, 끝내 못 읽으면 직접 착지하지 않는다(아스트라 1차 높음 5 — 조회 한 번 실패로
# 큐·차례를 건너뛰어 main을 올렸다). 「조회 성공 + 표식 없음」일 때만 예전 착지 길
mgon() {  # 0 켜짐(병합기 기계를 mg_에), 1 꺼짐(조회 성공·표식 없음), 2 모름(조회 실패)
  # 원격 없는 저장소(get-url 종료 2)만 병합기가 없다. 그 밖의 실패는 모름(2차 높음 5 — 종료 128을 「꺼짐」으로 읽어 큐를 건너뛰었다)
  git remote get-url origin >/dev/null 2>&1
  case $? in 0) ;; 2) return 1 ;; *) echo "hc-lane land: 원격 설정(git remote get-url origin)을 읽지 못해 병합기가 켜졌는지 모른다 — 착지하지 않았다. 같은 줄을 다시" >&2; return 2 ;; esac
  for w_ in ${HC_LANE_MGON_WAITS:-1 2 4} -; do
    mgt_=$(git ls-remote origin 'refs/herdr/merger/*' 2>/dev/null) && break
    [ "$w_" = - ] && { echo "hc-lane land: 원격을 읽지 못해 병합기가 켜졌는지 모른다 — 착지하지 않았다. 같은 줄을 다시" >&2; return 2; }
    sleep "$w_"
  done
  mg_=$(printf '%s\n' "$mgt_" | awk 'NF == 2 { sub(/^refs\/herdr\/merger\//, "", $2); print $2; exit }')
  [ -n "$mg_" ]
}
# 레인 이름 = hc-fill 레인 이름 규칙(okname: a-z 0-9 _ - 32자) + git 가지 이름으로 쓸 수 있음(git check-ref-format --branch). 레인을 띄울
# 때(hc-lane이 그 이름으로 가지를 만든다)와 같은 두 검사다(3차 중간 13 — 「_audit」을 받는 쪽과 거절하는 쪽이 갈렸다, 2차 중간 13 — 「-audit」).
# 글자를 늘어놓는다: [a-z] 범위는 로캘에 따라 대문자도 받는다(시험 14에서 Bad_Name이 통과)
lname_ok() {
  case $1 in ''|*[!abcdefghijklmnopqrstuvwxyz0123456789_-]*) return 1 ;; esac
  [ ${#1} -le 32 ] && git check-ref-format --branch "$1" >/dev/null 2>&1
}
# 제출: HEAD를 refs/heads/lane/<레인>과 큐 표식 refs/merge-queue/<UTC초>-<레인>에 한 번의 원자 push로(같은 레인의 옛 표식은 같은
# push에서 지움 — 다시 제출하면 새 것만 남는다). 기본 브랜치는 건드리지 않는다. 결과를 모르면(전송 오류) 원격을 다시 읽어 둘 다
# 그 SHA면 제출로, 그 밖·읽기 실패는 멈춤(같은 줄을 다시 돌리면 같은 결과로 모인다). 종료 0 제출(또는 이미 들어감), 1 실패
submit_cmd() {
  llog_init
  ln_=${HC_LANE:-$(git symbolic-ref -q --short HEAD 2>/dev/null)}
  lname_ok "$ln_" || die "land(제출): 레인 이름은 a-z 0-9 - _ 32자까지여야 큐에 넣는다: ${ln_:-(분리된 HEAD)}"
  # 병합기 클론의 로컬 가지와 겹치는 이름(기본 브랜치·묶음 가지)은 받지 않는다(감사 낮음 3)
  case $ln_ in "$base"|merge-batch|batch|main|master) die "land(제출): 레인 이름 $ln_ 은 병합기가 쓰는 가지 이름이라 큐에 넣지 않는다 — 레인 작업 트리에서 HC_LANE=<레인>으로" ;; esac
  git remote get-url origin >/dev/null 2>&1 || die "land(제출): origin이 없는 저장소는 병합기로 넣지 않는다"
  for f_ in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD; do
    # 경로 조회가 실패하면 빈 경로가 「없음」으로 통과했다(3차 높음 5) — 모르면 제출하지 않는다
    gp_=$(git rev-parse --git-path "$f_") && [ -n "$gp_" ] || die "land(제출): git rev-parse --git-path 실패 — 진행 중인 rebase·merge가 있는지 모른다"
    [ ! -e "$gp_" ] || die "land(제출): 진행 중인 rebase·merge가 있다($f_). 마친 뒤 같은 줄을 다시"
  done
  # 무시되지 않은 새 파일도 본다(아스트라 1차 중간 8 — 빠진 새 파일로 제출이 되고 뒤 clean이 그 파일로 멈췄다)
  st_=$(git status --porcelain --untracked-files=normal) || die "land(제출): git status 실패 — 작업 트리를 모른다"
  [ -z "$st_" ] || die "land(제출): 커밋 안 된 변경·새 파일이 있다(git status). 커밋하거나 치운 뒤 같은 줄을 다시"
  # 선행(HERDR_LAND_AFTER)은 최소판에서 뺐다(2026-11-20 지휘 — 이름만으로는 그 실행의 선행을 못 가린다, 2판에서 작업 ID로). 선행이 아직이면
  # 제출하지 말고 기다린다(hc-fill --after가 띄우기를 막는다)
  [ -z "${HERDR_LAND_AFTER-}" ] || die "land(제출): 선행(HERDR_LAND_AFTER)은 병합기 최소판에 없다 — 선행이 main에 들어간 뒤 HERDR_LAND_AFTER 없이 같은 줄을"
  sh_=$(git rev-parse -q --verify HEAD) || die "land(제출): HEAD를 읽지 못했다"
  lrun fetchr git fetch -q origin || die "land(제출): git fetch 실패"
  ob_=$(git rev-parse -q --verify "refs/remotes/origin/$base^{commit}") || die "land(제출): origin/$base 가 없다"
  git merge-base --is-ancestor "$sh_" "$ob_"; ia_=$?
  case $ia_ in
    0) echo "hc-lane land: 이 레인의 커밋은 이미 origin/$base 에 있다 — 제출할 것 없음"; exit 0 ;;
    1) ;;
    *) die "land(제출): git merge-base --is-ancestor 실패(종료 $ia_)" ;;
  esac
  rs_=$(git ls-remote origin "refs/heads/lane/$ln_" 'refs/merge-queue/*' 'refs/merge-queue-meta/*' 'refs/merge-failed/*' "refs/merge-done/$ln_") ||
    die "land(제출): 원격을 읽지 못했다(git ls-remote) — 같은 줄을 다시"
  # 병합기가 이 레인의 앞 제출을 넣는 중이어도 다시 제출할 수 있다: 병합기의 main push가 그 큐 표식을 lease로 함께 지우니, 여기서 옛
  # 표식을 지우면 그 push는 통째로 거절된다(구조 B)
  cur_=$(printf '%s\n' "$rs_" | awk -v r="refs/heads/lane/$ln_" '$2 == r { print $1 }')
  # 같은 커밋을 이미 냈으면 새 제출을 만들지 않는다(3차 중간 1 — 접수 확인이 끊겨 같은 줄을 다시 돌리면, 이미 rebase돼 들어간 원본은
  # 조상 검사에서 빠져 새 제출이 됐다): 큐에 그 SHA로 남아 있으면 접수 그대로, refs/merge-done/<레인>(넣은 제출 기록)의 원본이 이
  # 커밋이면 이미 넣음
  if [ "$cur_" = "$sh_" ] && printf '%s\n' "$rs_" | awk -v l="$ln_" -v s="$sh_" '{ n = $2 } sub(/^refs\/merge-queue\/[0-9]+-/, "", n) && n == l && $1 == s { f = 1 } END { exit !f }'; then
    echo "hc-lane land: 이 커밋($(git rev-parse --short "$sh_"))은 이미 병합기 큐에 있다(lane/$ln_) — 새로 내지 않음. 결과는 병합기가 사건으로 알린다"; exit 0
  fi
  dn_=$(printf '%s\n' "$rs_" | awk -v r="refs/merge-done/$ln_" '$2 == r { print $1 }')
  if [ -n "$dn_" ]; then
    fetchr git fetch -q origin "+refs/merge-done/$ln_:refs/hc-lane/merge-done/$ln_" || die "land(제출): 넣은 제출 기록을 받지 못했다(git fetch) — 같은 줄을 다시"
    if [ "$(git rev-parse -q --verify "$dn_^" 2>/dev/null)" = "$sh_" ]; then
      echo "hc-lane land: 이 커밋은 병합기가 이미 $base 에 넣었다(refs/merge-done/$ln_) — 제출할 것 없음"; exit 0
    fi
  fi
  # 같은 레인의 옛 표식·기록(다시 제출하면 새 것만 남는다)
  olds_=$(printf '%s\n' "$rs_" | awk -v l="$ln_" '{ n = $2; if (sub(/^refs\/merge-queue(-meta)?\//, "", n) && n ~ /^[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-/ && substr(n, 12) == l) print $2, $1 }')
  # 큐 이름은 지금 큐와 반송된 것(refs/merge-failed/)에 없는 초로(3차 중간 2 — 같은 초에 세 번 내면 옛 반송 이름과 겹쳤다)
  e_=$(date -u +%s)
  while printf '%s\n' "$rs_" | grep -Eq "[[:space:]]refs/merge-(queue|failed)/$e_-$ln_\$"; do e_=$((e_ + 1)); done
  q_=refs/merge-queue/$e_-$ln_ qm_=refs/merge-queue-meta/$e_-$ln_
  # 제출 기록(아스트라 비교 검증 2026-11-20 ①): 감사받은 그 SHA(원본)·갈래점·고유 제출 ID(이 착지 시도 ID)·기계·터미널을 빈 트리 커밋
  # 메시지로(부모 = 원본). 병합기가 결과 사건·돌려보낼 때 이 값을 남긴다
  fk_=$(git merge-base "$sh_" "$ob_") || die "land(제출): 갈래점을 구하지 못했다(git merge-base)"
  # owner = 결과를 받을 지휘(HC_LANE_OWNER, 없으면 -) — 병합기가 사건 --to로 넘긴다(아스트라 1차 중간 12)
  ow_=$(printf %s "${HC_LANE_OWNER:--}" | tr -c 'A-Za-z0-9_.,/-' -)
  # 기계(병합기가 hc send 할지 견주는 값 — merger의 mme_와 같은 출처)·제출 ID(<기계>-<UTC 시각>-<pid>)
  mt_=$(printf %s "${HC_LANE_MACHINE:-$(hostname -s 2>/dev/null)}" | tr -c 'A-Za-z0-9_.-' -); mt_=${mt_:--}
  sid_=$mt_-$(date -u +%Y%m%dT%H%M%S)-$$
  et_=$(git hash-object -t tree -w /dev/null) &&
    mc_=$(git commit-tree "$et_" -p "$sh_" -m "merge-queue lane=$ln_ id=$sid_ orig=$sh_ fork=$fk_ base=$base host=$mt_ term=${HC_TERMINAL_ID:--} owner=$ow_ job=$(printf %s "${HC_LANE_JOB:--}" | tr -c 'A-Za-z0-9_.~-' -)") ||
    die "land(제출): 제출 기록 커밋을 만들지 못했다"
  set -- "$sh_:refs/heads/lane/$ln_" "$sh_:$q_" "$mc_:$qm_" "--force-with-lease=refs/heads/lane/$ln_:$cur_" "--force-with-lease=$q_:" "--force-with-lease=$qm_:"
  while read -r or_ os_; do
    [ -n "$or_" ] || continue
    set -- "$@" ":$or_" "--force-with-lease=$or_:$os_"
  done <<<"$olds_"
  po_=$(git push --atomic --porcelain origin "$@" 2>&1); pr_=$?
  [ -z "$llog" ] || printf '%s\n' "$po_" >>"$llog"
  # 원격 접수 확인: push가 0이어도 다시 읽어 본다(응답이 끊긴 실패도 같은 판정). 제출 기록 커밋(mc_ — 이 제출 ID가 든 이번 push만의 값)이
  # 큐 기록 자리에 있거나, 그새 병합기가 처리해 refs/merge-done/<레인>(넣음)·refs/merge-failed-meta/<이름>(돌려보냄)에 있으면 접수다.
  # 큐 표식은 병합기의 main push가 lease로 먼저 지우니 보지 않는다(2차 중간 1 — 그 틈에 부르면 접수를 실패로 냈다, 1차 중간 1)
  rb_=$(git ls-remote origin "$qm_" "refs/merge-done/$ln_" "refs/merge-failed-meta/$e_-$ln_") ||
    die "land(제출): 원격 접수를 확인하지 못했다(git ls-remote) — 같은 줄을 다시(다시 제출해도 큐에는 하나만 남는다)"
  printf '%s\n' "$rb_" | awk -v c="$qm_" -v d="refs/merge-done/$ln_" -v f="refs/merge-failed-meta/$e_-$ln_" -v m="$mc_" '
    ($2 == c || $2 == d || $2 == f) && $1 == m { g = 1 } END { exit !g }' ||
    { printf '%s\n' "$po_" >&2; die "land(제출): push 실패(위 git 출력, 종료 $pr_) — 같은 줄을 다시"; }
  # 접수가 확정된 뒤에만(2차 중간 14): 이 기계 기록 <공용 git 폴더>/hc-submitted(레인·SHA·기본 브랜치 — report 착지가 push 응답 유실로
  # 추적 참조가 없어도 제출만 한 커밋을 가린다, 1차 중간 7·2차 중간 8)과 「제출」 사건(제출 ID·큐 이름)
  printf '%s %s %s\n' "$ln_" "$sh_" "$base" >>"$(git rev-parse --git-common-dir)/hc-submitted" || echo "hc-lane land: 제출 기록(hc-submitted)을 쓰지 못했다" >&2
  # 사건 상태 「제출」(3차 중간 10 — 중간이면 wait가 「뜻밖의 종료」로 봤다). 한 줄 첫 낱말이 제출 ID — 병합기의 착지·막힘 사건(「제출 ID <ID>」)과
  # hc-fill이 이것으로 잇는다
  (report_cmd 제출 "$sh_" "$sid_ → $q_ (병합기 $mg_ 가 $base 에 넣는다)" --name "$ln_") >/dev/null || echo "hc-lane land: 제출 사건을 쓰지 못했다" >&2
  echo "hc-lane land: 제출 $(git rev-parse --short "$sh_") → $q_ (lane/$ln_) — 병합기(${mg_})가 $base 에 넣고 결과를 사건(착지·막힘 --name $ln_)으로 알린다. 이 레인은 여기서 끝(report 착지는 부르지 않아도 된다 — 불러도 적히지 않음)"
  exit 0
}
# merger --repo <병합기 전용 클론> [--once] [--tick <초>] [<기본 브랜치>]: 큐를 이름(초) 순으로 하나씩 처리한다. 한 클론에 하나만(잠금).
# 전용 클론: 레인 작업 트리를 두지 않는 곳이어야 한다(제출마다 레인 이름 그대로의 로컬 가지를 만들어 착지한다 — 문서 자리표시
# v0.NEXT@<레인>·착지 스크립트가 가지 이름을 레인으로 읽는다).
merger_cmd() {
  # MVP-1은 한 건씩만(2026-11-20 지휘 t1cj 2차 「최소판을 더 작게」 — 묶음·준비 훅은 MVP-2)
  mo_=0 mt_=30 mr_= mb_=
  while [ $# -gt 0 ]; do
    case $1 in
      --repo) val "$@"; mr_=$2; shift 2 ;;
      --once) mo_=1; shift ;;
      --tick) val "$@"; mt_=$2; shift 2 ;;
      -h|--help) usage ;;
      -*) die "merger: 알 수 없는 인자: $1" ;;
      *) [ -z "$mb_" ] || die "merger: 남는 인자: $1"; mb_=$1; shift ;;
    esac
  done
  case $mt_ in ''|*[!0-9]*) die "merger: --tick은 초(정수): $mt_" ;; esac
  [ -n "$mr_" ] || die "merger: --repo <병합기 전용 클론> 이 필요하다"
  # Go 빌드 캐시를 macOS가 비우는 ~/Library/Caches 밖에(2026-11-20 verify-speed-study: 워커 Mac mini에서 캐시 항목이 사라져 「could not
  # import os … no such file」로 전체 검증을 처음부터 다시 두 번). 병합기는 같은 클론·같은 캐시를 계속 쓰니 캐시가 곧 속도다
  [ -n "${GOCACHE-}" ] || export GOCACHE="$HOME/.cache/go-build"
  case $0 in /*) self_=$0 ;; */*) self_=$PWD/$0 ;; *) self_=$(command -v "$0" 2>/dev/null || echo "$0") ;; esac
  cd "$mr_" 2>/dev/null && top=$(git rev-parse --show-toplevel 2>/dev/null) && cd "$top" || die "merger: git 저장소가 아니다: $mr_"
  git remote get-url origin >/dev/null 2>&1 || die "merger: origin이 없다: $top"
  base=${mb_:-$(origin_base .)}
  plain "$base" || die "merger: 기본 브랜치 이름에 쓸 수 없는 글자가 있다: $base"
  # 켜졌는지는 바퀴마다 본다(mround — 켬 표식이 이 기계가 아니면 큐를 건드리지 않는다)
  # 전용 착지 스크립트(.claude/herdr-land.sh)가 있는 저장소도 받는다 — 착지는 그 스크립트의 origin/<기본> 판을 쓴다(제출 트리 속 판이
  # 아니다, 2단계 2026-11-20 지휘 t1cj). 새 임시 작업 트리의 준비 훅(LANE_REPO)은 이 클론을 메인 폴더로 본다
  mtop_=$top
  mkdir -p "$evdir" || die "merger: 상태 폴더를 만들지 못했다: $evdir"
  # 잠금 = 이 셸의 열린 파일(fd 19)에 건 flock(구조 C, 검증 잠금 단순판과 같은 꼴): 착지 자식·검증 손자까지 같은 열린 파일을 물려받아
  # 트리가 다 끝나야 풀린다 — 병합기만 SIGKILL돼도 살아 있는 착지와 새 병합기가 같은 클론을 쓰지 않는다(1차 높음 9). pid를 보지 않는다.
  # macOS엔 flock 명령이 없어 perl의 flock(2)로 같은 fd를 잠근다
  lk=$evdir/merger.$(ckey "$top").lock
  # 먼저 닫는다: macOS bash 3.2는 이미 열린 fd 19에 exec 19>>파일을 해도 fd를 바꾸지 않는다 — 다른 병합기 아래(그 착지가 돌린 시험 등)에서
  # 뜨면 물려받은 바깥 잠금(같은 열린 파일이라 flock도 성공)을 쥐고 자기 잠금은 비운 채 돌았다(2026-11-20 병합기 첫 착지 15분 멈춤)
  exec 19>&-
  exec 19>>"$lk" || die "merger: 잠금 파일을 열지 못했다: $lk"
  if command -v flock >/dev/null 2>&1; then flock -n 19; lr_=$?; [ $lr_ != 1 ] || lr_=75
  else perl -e 'use Fcntl qw(:flock); open(my $f, ">&=", 19) or exit 1; flock($f, LOCK_EX | LOCK_NB) or exit 75; exit 0'; lr_=$?; fi
  case $lr_ in
    0) ;;
    75) echo "hc-lane merger: 이 클론의 병합기(또는 그 착지)가 아직 돈다 — 잠금 $lk" >&2; exit 75 ;;
    *) die "merger: 잠금을 걸지 못했다(종료 $lr_): $lk" ;;
  esac
  mgrun_=1   # 여기부터 die는 막힘 사건도 남긴다
  trap 'exit 143' TERM; trap 'exit 130' INT; trap 'exit 129' HUP
  mj_=$(git rev-parse --git-path hc-merger) && mkdir -p "$mj_/out" "$mj_/fail" "$mj_/wt" && mj_=$(cd "$mj_" && pwd -P) || die "merger: 일지 폴더를 만들지 못했다"
  # 클론 작업 트리는 분리 HEAD로 둔다 — 가지를 체크아웃해 두면 착지 뒤 메인 폴더 맞추기(ffmain)가 클론 작업 트리를 바꾼다(3차 높음 6과 같은
  # 꼴: 바꾸다 꺼지면 클론이 더러워져 큐가 멈춘다). 클론이 깨끗할 때만, 한 번
  if git symbolic-ref -q HEAD >/dev/null; then
    st_=$(git status --porcelain --untracked-files=all) && [ -z "$st_" ] && git checkout -q --detach || die "merger: 병합기 클론을 분리 HEAD로 두지 못했다(커밋 안 된 변경?): $top"
  fi
  ml_=$evdir/merger-logs
  mkdir -p "$ml_" || die "merger: 로그 폴더를 만들지 못했다: $ml_"
  mme_=${HC_LANE_MACHINE:-$(hostname -s 2>/dev/null)}
  if [ $mo_ = 1 ]; then echo "hc-lane merger: $top ($base) 큐가 빌 때까지 한 번"; else echo "hc-lane merger: $top ($base) 큐를 본다 — 빈 바퀴 ${mt_}초"; fi
  while :; do
    mround
    # --once: 큐가 빌 때까지(시험·손으로 한 번 돌리기). 원격 오류로 못 본 바퀴면 75(아스트라 1차 중간 4 — 빈 큐와 가린다)
    if [ $mo_ = 1 ] && [ -z "$mq_" ]; then [ -z "$mer_" ] || exit 75; break; fi
    [ -n "$mq_" ] || sleep "$mt_"
  done
}
# 한 바퀴. mq_ = 처리한 큐 참조(없거나 원격 오류로 쉬면 빈 값), mer_ = 원격 오류로 못 본 것이 있음.
# 일지 하나(구조 A, $mj_/cur): 착지를 부르기 **전에** 원자적으로(tmp→mv) 「<가지> <기준 B> <후보 C>」 한 줄 + 담긴 제출마다 「<큐 참조>
# <제출 SHA> <레인> <기록 SHA|->」를 쓴다. 바퀴마다 새 제출을 고르기 전에 그 일지부터 정리한다(mrecover). 큐 표식은 기본 브랜치 push가
# lease로 함께 지우고(구조 B), 정리는 기본 브랜치가 후보를 담은 것을 본 뒤에만 한다
mround() {
  mq_= mer_= mbn_= ls0_= ls1_=
  mflush
  # 병합기 클론은 병합기만 쓴다 — 앞 실행이 남긴 멈춘 rebase는 풀고, 그래도 깨끗하지 않으면 멈춘다(모르는 변경을 지우지 않음)
  rbabort
  st_=$(git status --porcelain --untracked-files=all) || die "merger: git status 실패 — 클론 상태를 모른다"
  [ -z "$st_" ] || die "merger: 병합기 클론에 커밋 안 된 변경·새 파일이 있다 — 살펴 치운 뒤 다시 띄운다: $PWD"
  mwtclean
  mrecover || return 0
  mfretry
  qs_=$(git ls-remote origin 'refs/merge-queue/*' 'refs/merge-queue-meta/*' 'refs/herdr/merger/*') || { echo "hc-lane merger: 원격 큐를 읽지 못했다(git ls-remote) — 다음 바퀴에" >&2; mer_=1; return 0; }
  # 켬 표식이 이 기계인지 바퀴마다 본다 — 길 안내일 뿐 정확성 조건이 아니다(3차 지휘 t1cj: main에 쓰는 모든 길이 main CAS라 병합기가
  # 둘 돌거나 전환 중 직접 착지가 끼어도 main은 틀리지 않는다 — 한쪽 push가 거절되고 다시 할 뿐. 큐를 고치는 원격 쓰기는 모두 그 큐
  # 참조의 지금 SHA에 lease를 건다)
  msha_=$(printf '%s\n' "$qs_" | awk -v r="refs/herdr/merger/$mme_" '$2 == r { print $1 }')
  if [ -z "$msha_" ]; then
    mo2_=$(printf '%s\n' "$qs_" | awk 'index($2, "refs/herdr/merger/") == 1 { print substr($2, 19); exit }')
    [ -z "$mo2_" ] || die "merger: 켬 표식이 다른 기계(refs/herdr/merger/$mo2_)다 — 이 병합기($mme_)는 멈춘다(기계를 옮겼거나 이름이 다르면 HC_LANE_MACHINE=<표식의 기계>로)"
    echo "hc-lane merger: 켬 표식 refs/herdr/merger/$mme_ 가 없다(꺼짐) — 큐를 건드리지 않고 쉰다" >&2
    mer_=1; return 0
  fi
  # 제출 기록(원본·갈래점·제출 ID·기본 브랜치·지휘 — 레인이 같은 push로 올림)을 한 번에 받는다. 못 받으면 이 바퀴는 쉰다
  if printf '%s\n' "$qs_" | grep -q 'refs/merge-queue-meta/'; then
    fetchr git fetch -q origin '+refs/merge-queue-meta/*:refs/hc-merger/meta/*' 2>/dev/null ||
      { echo "hc-lane merger: 제출 기록을 받지 못했다(git fetch) — 다음 바퀴에" >&2; mer_=1; return 0; }
  fi
  # 큐를 이름(초) 순으로 맨 앞 하나(MVP-1 — 묶음 없음). 반송을 다시 하는 중(fail/)·다른 기본 브랜치 제출은 건너뛴다
  bq_=() bs_=() bl_=() bm_=() bi_=() bj_= bd_=
  while read -r mq_ ms_; do
    [ -n "$mq_" ] || continue
    mn_=${mq_#refs/merge-queue/}
    [ ! -f "$mj_/fail/$mn_" ] || continue   # 돌려보내기를 다시 하는 중(mfretry)
    ln_=${mn_#??????????-}
    case $mn_ in [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-?*) ;; *) ln_= ;; esac
    mm_=$(printf '%s\n' "$qs_" | awk -v r="refs/merge-queue-meta/$mn_" '$2 == r { print $1 }')
    # 레인 이름이 가지 이름으로 못 쓰는 꼴이면 그 항목만 반송(2차 중간 13 — 후보 가지를 만들다 병합기가 멈춰 큐 전체가 막혔다)
    if ! lname_ok "$ln_"; then
      mfail "$mq_" "$ms_" "${ln_:--}" "${mm_:--}" - "큐 이름 꼴이 아니다(<UTC초 10자리>-<레인>, 레인은 가지 이름으로 쓸 수 있는 a-z 0-9 - _)" || mer_=1; mq_=x; return 0
    fi
    mmeta "$mm_" "$ms_" || { echo "hc-lane merger: 제출 기록 $mn_ 을 읽지 못했다(또는 원본과 안 맞음) — 다음 바퀴에" >&2; mer_=1; mq_=; return 0; }
    # 다른 기본 브랜치로 낸 제출은 건드리지 않는다 — 그 브랜치의 병합기 몫(1차 높음 7)
    if [ -n "$mbs_" ] && [ "$mbs_" != "$base" ]; then echo "hc-lane merger: $ln_ 건너뜀 — 기본 브랜치 $mbs_ 로 낸 제출(이 병합기는 $base)" >&2; continue; fi
    bq_+=("$mq_") bs_+=("$ms_") bl_+=("$ln_") bm_+=("${mm_:--}") bi_+=("$mi_") bj_=$mjb_ bd_=$mid_
    break
  done <<<"$(printf '%s\n' "$qs_" | awk 'NF == 2 && index($2, "refs/merge-queue/") == 1 { print $2, $1 }' | LC_ALL=C sort)"
  mq_=
  [ ${#bq_[@]} -gt 0 ] || return 0
  mq_=${bq_[0]}
  fetchr git fetch -q origin "+refs/heads/$base:refs/remotes/origin/$base" '+refs/merge-queue/*:refs/hc-merger/q/*' ||
    { echo "hc-lane merger: git fetch 실패 — 다음 바퀴에" >&2; mer_=1; mq_=; return 0; }
  B_=$(git rev-parse -q --verify "refs/remotes/origin/$base^{commit}") || die "merger: origin/$base 가 없다"
  # 이미 기본 브랜치에 든 제출은 착지 없이 정리만(병합기를 켜기 전에 들어갔거나 손으로 넣음). 정리가 안 되면 쉰다 — --once가 같은 항목을
  # 쉬지 않고 되풀이하지 않게(3차 중간 3). 후보는 그 제출 자신(작업 표식도 그것으로 — 3차 중간 4)
  if ianc "${bs_[0]}" "$B_"; then
    mbn_=1; mi_=${bi_[0]}; mdone "${bq_[0]}" "${bs_[0]}" "${bl_[0]}" "${bm_[0]}" "${bs_[0]}" "제출이 이미 $base 에 있음" || { mer_=1; mq_=; }
    return 0
  fi
  # 제출 내용이 이미 기본 브랜치에 다 들었으면(같은 패치가 다른 SHA로 — 합친 트리 = 기본 브랜치 트리) 착지·검증 없이 정리만
  # (2026-11-20 지휘 t1cj — 이미 든 커밋을 rebase 뒤 main과 같은 트리로 전체 검증했다)
  if mt_=$(git merge-tree --write-tree "$B_" "${bs_[0]}" 2>/dev/null) && [ "$mt_" = "$(git rev-parse "$B_^{tree}")" ]; then
    mbn_=1; mi_=${bi_[0]}; mdone "${bq_[0]}" "${bs_[0]}" "${bl_[0]}" "${bm_[0]}" "$B_" "제출 내용이 이미 $base 에 있음(합친 트리가 같음)" || { mer_=1; mq_=; }
    return 0
  fi
  # 착지 스크립트는 기본 브랜치 판을 쓰니(land_cmd) 제출이 그 스크립트를 고쳐도 된다. 다만 기본 브랜치에 없는 스크립트를 제출이 새로
  # 들이면 반송 — 병합기가 제출 트리 속 착지 코드를 실행하지 않게(2차 높음 1)
  hl_=$(git ls-tree --name-only "${bs_[0]}" -- .claude/herdr-land.sh) && hb_=$(git ls-tree --name-only "$B_" -- .claude/herdr-land.sh) ||
    die "merger: git ls-tree 실패(${bs_[0]} · $B_)"
  if [ -n "$hl_" ] && [ -z "$hb_" ]; then
    mi_=${bi_[0]}; mfail "${bq_[0]}" "${bs_[0]}" "${bl_[0]}" "${bm_[0]}" - "$mhook_" || mer_=1
    return 0
  fi
  # main push에 함께(HERDR_LAND_PUSH_EXTRA = git push 인자 목록 — 착지 표식과 같은 이름·꼴, 지휘 t1cj):
  #  · 큐 표식 삭제 + 그 SHA lease(구조 B — 다시 제출했으면 main도 안 움직인다)
  #  · 제출 ID 표식 HEAD:refs/hc-landed/<제출 ID>(3차 높음 4 — 재시작 때 이 표식이 main의 조상이면 완료, 패치 일치로 판정하지 않는다)
  #  · 작업 표식 HEAD:refs/hc-landed/<작업 ID>(2차 중간 12 — 원격에 아직 없을 때만)
  ex_=":${bq_[0]} --force-with-lease=${bq_[0]}:${bs_[0]}"
  [ -z "$bd_" ] || ! git check-ref-format "refs/hc-landed/$bd_" || ex_="$ex_ HEAD:refs/hc-landed/$bd_"
  if [ -n "$bj_" ] && [ "$bj_" != - ] && [ "$bj_" != "$bd_" ] && git check-ref-format "refs/hc-landed/$bj_"; then
    hk_=$(git ls-remote origin "refs/hc-landed/$bj_") || { echo "hc-lane merger: 작업 표식을 보지 못했다(git ls-remote) — 다음 바퀴에" >&2; mer_=1; mq_=; return 0; }
    [ -n "$hk_" ] || ex_="$ex_ HEAD:refs/hc-landed/$bj_"
  fi
  br_=${bl_[0]} mlab_=${bl_[0]}
  lgf_=$ml_/${bl_[0]}-$(date +%Y%m%d-%H%M%S)-$$.log
  C0_=${bs_[0]}
  # 일지 — 행동 전에(작업 트리를 만들기 전에 — 3차 높음 6)
  { printf '%s %s %s\n' "$br_" "$B_" "$C0_"
    for i_ in "${!bq_[@]}"; do printf '%s %s %s %s\n' "${bq_[i_]}" "${bs_[i_]}" "${bl_[i_]}" "${bm_[i_]}"; done
  } >"$mj_/cur.tmp" && mv -f "$mj_/cur.tmp" "$mj_/cur" || die "merger: 일지를 쓰지 못했다"
  # 후보는 매번 새 임시 작업 트리(병합기 자기 폴더 hc-merger/wt/)에서 레인 이름 가지로 — 병합기 클론의 작업 트리는 건드리지 않는다.
  # 만들다 꺼져도 다음 바퀴가 그 폴더의 작업 트리를 지우고 다시 만든다(3차 높음 6 — 클론에서 체크아웃하다 꺼지면 더러운 클론으로 큐 전체가 멈췄다)
  # 이름의 .train-: 저장소 준비 훅이 코드 색인을 건너뛰는 표시(곧 지울 폴더를 후보마다 색인하지 않게)
  mwt_=$(mktemp -d "$mj_/wt/.train-c.XXXXXX") && git worktree add -q -f -B "$br_" "$mwt_" "$C0_" || die "merger: 후보 작업 트리를 만들지 못했다($br_)"
  echo "hc-lane merger: 착지 시작 — $mlab_ (기준 $(printf %.8s "$B_"))"
  mbn_=1 ls0_=$(date +%s)
  # 새 작업 트리라 준비 훅(.claude/herdr-setup.sh — 의존성·빌드 산출물)을 레인을 만들 때처럼 먼저. 실패는 일시 실패로(75 — 망 등)
  if [ -f "$mwt_/.claude/herdr-setup.sh" ] &&
    ! (cd "$mwt_" && LANE_REPO=$mtop_ LANE_BASE=$base exec bash .claude/herdr-setup.sh) >>"$lgf_" 2>&1 </dev/null; then
    echo "hc-lane merger: 준비 훅(.claude/herdr-setup.sh) 실패" >>"$lgf_"; lr_=75
  else
    (cd "$mwt_" && HERDR_MERGER=1 HC_LANE=$br_ HERDR_LAND_PUSH_EXTRA="$ex_" exec "$self_" land "$base") >>"$lgf_" 2>&1 </dev/null; lr_=$?
  fi
  ls1_=$(date +%s)
  tail -n 5 "$lgf_"
  mjudge
}
mhook_="기본 브랜치에 없는 전용 착지 스크립트(.claude/herdr-land.sh)를 들이는 제출 — 병합기는 제출 트리 속 착지 코드를 실행하지 않는다(그 스크립트는 레인이 직접 착지해 먼저 넣는다)"
# mwtclean: 병합기 자기 임시 작업 트리(hc-merger/wt/ 아래)를 모두 지운다 — 앞 실행이 남긴 것 포함(병합기 것만이라 지워도 된다)
mwtclean() {
  mkdir -p "$mj_/wt" || die "merger: 작업 트리 폴더를 만들지 못했다: $mj_/wt"
  wl_=$(git worktree list --porcelain) || die "merger: git worktree list 실패"
  printf '%s\n' "$wl_" | sed -n 's/^worktree //p' | while IFS= read -r w_; do
    case $w_ in "$mj_/wt/"*) git worktree remove -f -f "$w_" >/dev/null 2>&1 || echo "hc-lane merger: 남은 작업 트리를 지우지 못했다: $w_" >&2 ;; esac
  done
  git worktree prune >/dev/null 2>&1
  # ponytail: 등록 전에 끊긴 빈 폴더(mktemp만 된 것)는 남는다 — 비어 있어 해가 없다, 쌓이면 손으로
  mwt_=
}
# mjudge: 착지(종료 lr_) 뒤 판정. 종료 코드와 상관없이 먼저 원격이 후보를 담았는지 본다(1차 높음 3 — 응답 유실로 1이어도 들어갔을 수 있다).
# 못 보면 일지를 두고 쉰다(다음 바퀴의 mrecover가 같은 판정)
mjudge() {
  fetchr git fetch -q origin "+refs/heads/$base:refs/remotes/origin/$base" ||
    { echo "hc-lane merger: 착지 뒤 git fetch 실패 — 일지를 두고 다음 바퀴에 판정" >&2; mer_=1; mq_=; return 0; }
  O_=$(git rev-parse -q --verify "refs/remotes/origin/$base^{commit}") && C_=$(git rev-parse -q --verify "refs/heads/$br_") ||
    die "merger: 착지 뒤 후보·origin/$base 를 읽지 못했다 — 다음 실행이 일지로 판정한다"
  if ianc "$C_" "$O_"; then
    mdone_all "$C_" "병합기 착지" || { mer_=1; mq_=; return 0; }
    mfin; return 0
  fi
  case $lr_ in
    0) lr_="0(그런데 $base 에 없음)" ;;
    6) echo "hc-lane merger: 함께 실은 lease 참조가 바뀜(그새 다시 제출함) — 후보를 버리고 다음 바퀴에" >&2; mfin; return 0 ;;
  esac
  if mtrans "$lr_" "$lgf_" && mtry "${bq_[0]}" "${bl_[0]}"; then
    # 일시 실패(기다림 상한·push 거절 횟수·원격 받기 실패)는 큐에 그대로 두고 쉰다(1차 중간 2 — 3번 넘으면 돌려보냄).
    # --once는 75로 끝난다(2차 중간 11 — 큐를 남긴 채 0이었다)
    echo "hc-lane merger: ${bl_[0]} 일시 실패(종료 $lr_, 로그 $lgf_) — 큐에 두고 다음 바퀴에" >&2
    mfin; mq_=; mer_=1; return 0
  fi
  mtrans "$lr_" "$lgf_" && lr_="$lr_, 일시 실패가 3번 넘음"
  mfin
  mi_=${bi_[0]}; mfail "${bq_[0]}" "${bs_[0]}" "${bl_[0]}" "${bm_[0]}" "$lgf_" "착지 실패(종료 $lr_)" || mer_=1
}
# mrecover: 일지가 있으면(앞 실행이 끊김) 먼저 정리. 0 정리함(새로 골라도 됨) · 1 원격을 못 봐 쉼.
#  제출 ID 표식이 main에 있음 → 그 제출 완료 / 그 밖 → 후보 버림, 제출은 큐에 남아 있으면 다시 고른다(큐 표식은 main push로만 지워진다)
mrecover() {
  [ -f "$mj_/cur" ] || return 0
  read -r br_ jB_ jC_ <"$mj_/cur" || die "merger: 일지를 읽지 못했다: $mj_/cur"
  fetchr git fetch -q origin "+refs/heads/$base:refs/remotes/origin/$base" ||
    { echo "hc-lane merger: 끊긴 앞 실행 판정에 git fetch 실패 — 다음 바퀴에" >&2; mer_=1; return 1; }
  O_=$(git rev-parse -q --verify "refs/remotes/origin/$base^{commit}") || die "merger: origin/$base 가 없다"
  # 들어갔는지는 main push가 원자로 함께 실은 제출 ID 표식 refs/hc-landed/<제출 ID>로만 본다 — 그 표식이 있고 그 SHA가 main의
  # 조상이면 완료, 아니면 처음부터(제출은 큐에 남아 있으면 다시 고른다). 패치 일치(git cherry)는 쓰지 않는다(3차 높음 4 — 다시 제출해
  # 철회된 옛 제출이 같은 패치로 완료가 됐다). 제출 기록이 없는 큐 항목(손으로 넣음)만 후보 가지 끝으로 본다
  bq_=() bs_=() bl_=() bm_=() bi_=() bd2_=()
  while read -r q_ s_ ln_ m_; do
    [ -n "$q_" ] || continue
    # 제출 기록이 있는데 못 읽으면 쉰다(3차 중간 7 — 제출 ID 없이 끝냈다)
    mmeta "${m_#-}" "$s_" 2>/dev/null || { echo "hc-lane merger: 끊긴 앞 실행의 제출 기록($ln_)을 읽지 못했다 — 일지를 두고 다음 바퀴에" >&2; mer_=1; return 1; }
    bq_+=("$q_") bs_+=("$s_") bl_+=("$ln_") bm_+=("$m_") bi_+=("$mi_") bd2_+=("$mid_")
  done < <(tail -n +2 "$mj_/cur")
  mbn_=${#bq_[@]}
  set --; for i_ in "${!bq_[@]}"; do [ -z "${bd2_[i_]}" ] || set -- "$@" "refs/hc-landed/${bd2_[i_]}"; done
  lk2_=; [ $# = 0 ] || lk2_=$(git ls-remote origin "$@") || { echo "hc-lane merger: 끊긴 앞 실행 판정에 제출 ID 표식을 못 읽음 — 다음 바퀴에" >&2; mer_=1; return 1; }
  for i_ in "${!bq_[@]}"; do
    if [ -n "${bd2_[i_]}" ]; then
      hs_=$(printf '%s\n' "$lk2_" | awk -v r="refs/hc-landed/${bd2_[i_]}" '$2 == r { print $1 }')
      [ -n "$hs_" ] && { git cat-file -e "$hs_^{commit}" 2>/dev/null || fetchr git fetch -q origin "+refs/heads/$base:refs/remotes/origin/$base"; } &&
        ianc "$hs_" "$O_" || { echo "hc-lane merger: 끊긴 앞 실행의 ${bl_[i_]} — 제출 ID 표식이 main에 없다, 처음부터(큐에 남아 있으면 다시 고른다)"; continue; }
    else
      C_=$(git rev-parse -q --verify "refs/heads/$br_"); cr_=$?
      case $cr_ in 0) ;; 1) C_=$jC_ ;; *) echo "hc-lane merger: 끊긴 앞 실행의 후보 가지를 읽지 못했다(종료 $cr_) — 일지를 두고 다음 바퀴에" >&2; mer_=1; return 1 ;; esac
      ianc "$C_" "$O_" || { echo "hc-lane merger: 끊긴 앞 실행의 ${bl_[i_]}(제출 기록 없음) — main에 없다, 처음부터"; continue; }
      hs_=$C_
    fi
    echo "hc-lane merger: 끊긴 앞 실행의 ${bl_[i_]} 가 $base 에 있다($(printf %.8s "$hs_")) — 완료 처리"
    mi_=${bi_[i_]}; mdone "${bq_[i_]}" "${bs_[i_]}" "${bl_[i_]}" "${bm_[i_]}" "$hs_" "앞 병합기 실행이 넣었음" || { mer_=1; return 1; }
  done
  mfin
  mq_=x   # 이 바퀴에 일을 했다(--once가 이어 돈다)
  return 0
}
# mdone_all <C> <까닭>: 담긴 제출(bq_…)을 모두 완료. 망 오류면 1(일지를 두고 다음 바퀴에)
mdone_all() {
  for i_ in "${!bq_[@]}"; do
    mi_=${bi_[i_]}; mdone "${bq_[i_]}" "${bs_[i_]}" "${bl_[i_]}" "${bm_[i_]}" "$1" "$2" || return 1
  done
}
# mfin: 임시 작업 트리·후보 가지·일지를 치운다(병합기 클론의 작업 트리는 건드리지 않는다)
mfin() {
  mwtclean
  [ -z "${br_-}" ] || ! git show-ref -q --verify "refs/heads/$br_" || git branch -q -D "$br_" || die "merger: 후보 가지 $br_ 를 지우지 못했다"
  rm -f "$mj_/cur"
}
# mmeta <기록 SHA|빈 값> <제출 SHA>: 제출 기록을 읽어 mbs_(기본 브랜치)·mi_(사건에 붙일 글)·mo__(지휘)·mh_(기계)·mtm_(터미널)에.
# 기록이 없으면(손으로 넣은 큐 표식) 빈 값으로 0. 읽기 실패·부모가 제출 SHA가 아니면 1(1차 높음 6 — 파이프가 git 실패를 가렸다)
mmeta() {
  mbs_= mi_= mo__= mh_= mtm_= mid_= mjb_=
  [ -n "$1" ] && [ "$1" != - ] || return 0
  mp_=$(git rev-parse -q --verify "$1^" 2>/dev/null) && [ "$mp_" = "$2" ] || return 1
  mb_l=$(git log -1 --format=%B "$1" 2>/dev/null) || return 1
  mb_l=${mb_l%%$'\n'*}
  for kv_ in $mb_l; do
    case $kv_ in base=*) mbs_=${kv_#base=} ;; owner=*) mo__=${kv_#owner=} ;; host=*) mh_=${kv_#host=} ;; term=*) mtm_=${kv_#term=} ;; esac
  done
  [ "$mo__" != - ] || mo__=
  mid_=$(printf '%s\n' "$mb_l" | tr ' ' '\n' | sed -n 's/^id=//p') mjb_=$(printf '%s\n' "$mb_l" | tr ' ' '\n' | sed -n 's/^job=//p')
  mi_=$(printf '%s\n' "$mb_l" | tr ' ' '\n' | awk -F= '$1 == "id" { i = $2 } $1 == "fork" { f = substr($2, 1, 8) } END { if (i != "") printf "제출 ID %s, 갈래점 %s", i, f }')
}
# ianc <a> <b>: a가 b에 들어갔나 — 0 예, 1 아니오, 그 밖은 멈춤(git 실패를 「아니오」로 읽지 않는다)
ianc() { git merge-base --is-ancestor "$1" "$2"; ia_=$?; case $ia_ in 0|1) return $ia_ ;; esac; die "merger: git merge-base --is-ancestor 실패(종료 $ia_)"; }
rbabort() { if [ -e "$(git rev-parse --git-path rebase-merge)" ] || [ -e "$(git rev-parse --git-path rebase-apply)" ]; then git rebase --abort >/dev/null 2>&1; fi; }
# mtrans <종료> <로그>: 다시 하면 될 착지 실패면 0(감사 중간 2) — 종료 75(검증 자리·원격 차례·공개 선점 기다림 상한)·4(push 거절
# 횟수), 원격 받기 실패(내장 착지 「land: git fetch 실패」·「push 결과 모름」, 착지 스크립트 「git fetch origin 실패」). 충돌·검증 실패는 1
# 내장 착지의 「push 실패(다른 쪽 push가 앞선 것이 아니다」도 — push 전송만 끊기고 원격은 후보를 받지 않은 꼴(3차 중간 8 — 한 번 만에
# 반송했다. 들어갔으면 mjudge가 먼저 착지로, lease가 바뀌었으면 종료 6으로 가린다)
# 7: 착지가 rebase로 기본 브랜치에 막 생긴 착지 스크립트를 만남 — 다음 바퀴에는 그 판으로 맡긴다(2단계)
mtrans() { case $1 in 75|4|7) return 0 ;; esac; grep -Eq 'git fetch( origin)? 실패|push 결과 모름|push 실패\(다른 쪽' "$2" 2>/dev/null; }
# mtry <큐> <레인>: 그 제출의 일시 실패를 하나 세어 3번까지면 0(큐에 두고 쉼), 넘으면 1(돌려보냄 — 같은 실패를 끝없이 되풀이하지 않게)
mtry() {
  tf_=$mj_/$2.tr tc_=
  [ ! -f "$tf_" ] || tc_=$(awk -v q="$1" '$1 == q { print $2 }' "$tf_")
  tc_=$(( ${tc_:-0} + 1 ))
  printf '%s %s\n' "$1" "$tc_" >"$tf_" || die "merger: 일시 실패 횟수를 쓰지 못했다: $tf_"
  [ "$tc_" -le 3 ]
}
# mjrec <큐 이름> <레인> <결과> <후보|-> <까닭>: 병합기 일지 …/hc-lane/merger-journal.tsv에 제출마다 한 줄(2026-11-20 지휘 — 효과 수치는
# 병합기 자기 일지 하나에서, 착지 시도 기록 대신). 칸(탭): 적은 시각 · 큐 이름 · 레인 · 제출 ID · 작업 ID(HC_LANE_JOB) · 제출 시각 ·
# 묶음 크기(그 착지에 든 제출 수) · 착지 시작 · 착지 끝(push 응답을 받은 뒤 — 시각은 이 병합기가 잰 것) · 결과(착지|돌려보냄) ·
# 후보 SHA(40자 — 기본 브랜치가 담은 것, 돌려보냄은 -) · 까닭. 모르는 칸은 -. 한 번 O_APPEND(1000바이트 안)
# ponytail: 끊긴 실행을 다음 바퀴가 다시 정리하면 같은 큐 이름 줄이 둘일 수 있다 — 읽는 쪽이 큐 이름으로 하나만 센다
mjrec() {
  mt0_=-; [ -z "${ls0_-}" ] || mt0_=$(utc "$ls0_"); mt1_=-; [ -z "${ls1_-}" ] || mt1_=$(utc "$ls1_")
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(utc)" "$1" "$2" "${mid_:--}" "${mjb_:--}" "$(utc "${1%%-*}")" "${mbn_:--}" \
    "$mt0_" "$mt1_" "$3" "$4" "$(bcut 300 "$(flat "$5")")" >>"$evdir/merger-journal.tsv" || echo "hc-lane merger: 병합기 일지를 쓰지 못했다" >&2
}
# mkey <큐 이름>: 그 제출의 결과를 가리는 열쇠 — 제출 기록이 있으면 「제출 ID <ID>」(제출마다 하나), 없으면 「큐 <이름>」. 결과 사건의 한 줄과
# 병합기 일지에 이 열쇠를 넣고, 같은 열쇠가 이미 적혔으면 다시 적지 않는다(3차 중간 6 — 사건·일지를 쓴 뒤 표시를 따로 써 그 사이에 죽으면
# 겹쳤다, 2차 중간 5). mmeta 뒤에 부른다
mkey() { if [ -n "${mid_-}" ]; then printf '제출 ID %s' "$mid_"; else printf '큐 %s' "$1"; fi; }
# mjonce <mjrec 인자…>: 같은 큐 이름·제출 ID·결과의 일지 줄이 없을 때만 적는다
mjonce() {
  LC_ALL=C awk -F'\t' -v n="$1" -v i="${mid_:--}" -v r="$3" '$2 == n && $4 == i && $10 == r { f = 1 } END { exit !f }' "$evdir/merger-journal.tsv" 2>/dev/null ||
    mjrec "$@"
}
# mdone <큐> <제출 SHA> <레인> <기록 SHA|-> <들어간 후보 C> <까닭>: 기본 브랜치가 C를 담은 뒤의 정리 — 한 번의 원자 push로, 원격에 지금 남은
# 것만: 제출 기록을 refs/merge-done/<레인>으로(접수 확인·결과 조회용, 기록 없는 큐면 C), 큐 표식·lane 가지·기록은 그 제출 값일 때만 lease로
# 지우고(3차 높음 3 — 옛 병합기가 새 제출을 지울 수 없다), 작업 표식이 없으면 C로(3차 중간 4). 정리가 확인된 뒤에만 결과 사건을 보낼 함에
# 쓴다(3차 중간 5 — 지우기가 계속 실패해도 사건이 나갔다). 정리 뒤 사건 전에 죽으면 일지(cur)가 남아 다음 바퀴가 같은 정리(할 것 없음)·사건을
# 한다. 제출 기록이 있는데 못 읽으면 쉰다(3차 중간 7). 망 오류·거절이면 1(일지를 두고 다음 바퀴가 같은 판정)
mdone() {
  q_=$1 s_=$2 ln_=$3 m_=${4#-} C_=$5 why_=$6 n_=${1#refs/merge-queue/}
  mmeta "$m_" "$s_" 2>/dev/null || { echo "hc-lane merger: 제출 기록($n_)을 읽지 못했다 — 다음 바퀴에" >&2; return 1; }
  dn_=${m_:-$C_} jk_=
  [ -z "$mjb_" ] || [ "$mjb_" = - ] || ! git check-ref-format "refs/hc-landed/$mjb_" || jk_=refs/hc-landed/$mjb_
  rr_=$(git ls-remote origin "$q_" "refs/heads/lane/$ln_" "refs/merge-queue-meta/$n_" "refs/merge-done/$ln_" ${jk_:+"$jk_"}) ||
    { echo "hc-lane merger: 정리할 참조를 보지 못했다(git ls-remote) — 다음 바퀴에 일지로 판정" >&2; return 1; }
  rv_() { printf '%s\n' "$rr_" | awk -v r="$1" '$2 == r { print $1 }'; }
  set --
  [ "$(rv_ "refs/merge-done/$ln_")" = "$dn_" ] || set -- "$@" "+$dn_:refs/merge-done/$ln_"
  [ "$(rv_ "$q_")" != "$s_" ] || set -- "$@" ":$q_" "--force-with-lease=$q_:$s_"
  [ "$(rv_ "refs/heads/lane/$ln_")" != "$s_" ] || set -- "$@" ":refs/heads/lane/$ln_" "--force-with-lease=refs/heads/lane/$ln_:$s_"
  [ -z "$m_" ] || [ "$(rv_ "refs/merge-queue-meta/$n_")" != "$m_" ] || set -- "$@" ":refs/merge-queue-meta/$n_" "--force-with-lease=refs/merge-queue-meta/$n_:$m_"
  [ -z "$jk_" ] || [ -n "$(rv_ "$jk_")" ] || set -- "$@" "$C_:$jk_"
  if [ $# -gt 0 ] && ! git push -q --atomic --porcelain origin "$@" >/dev/null 2>&1; then
    echo "hc-lane merger: $ln_ 의 큐·lane·기록 참조를 정리하지 못했다(git push) — 다음 바퀴에 일지로 판정" >&2; return 1
  fi
  rm -f "$mj_/$ln_.tr"
  mjonce "$n_" "$ln_" 착지 "$C_" "$why_"
  moutbox "$n_" 착지 "$C_" "$why_ — 제출 $(printf %.8s "$s_"), $(mkey "$n_")${mi_:+ (${mi_#*, })}" "$ln_" || return 1
  msend "$n_"
  echo "hc-lane merger: $ln_ 착지 $(printf %.8s "$C_") ($why_)"
}
# mfail <큐> <제출 SHA> <레인> <기록 SHA|-> <로그|-> <까닭>: 큐 표식을 refs/merge-failed/<이름>, 기록을 refs/merge-failed-meta/<이름>으로
# 한 번의 원자 push로 옮기고(lane 가지는 둠) 막힘 사건. 옮기다 원격을 못 보면 멈추지 않고 fail/<이름>에 적어 다음 바퀴에 다시(1차 중간 3)
# — 그동안 그 제출만 건너뛰고 다른 제출은 처리한다. 1 = 아직 못 옮김
mfail() {
  q_=$1 s_=$2 ln_=$3 m_=${4#-} lg__=${5#-} why_=$6 n_=${1#refs/merge-queue/} fr_=refs/merge-failed/${1#refs/merge-queue/}
  # 제출 기록이 있는데 못 읽으면 반송하지 않고 쉰다(3차 중간 7). 이름 꼴이 틀린 항목은 기록이 맞지 않아도 반송한다(그 큐만 막히지 않게)
  mmeta "$m_" "$s_" 2>/dev/null || { case $why_ in "큐 이름 꼴이 아니다"*) mi_= mid_= ;; *) echo "hc-lane merger: 제출 기록($n_)을 읽지 못했다 — 다음 바퀴에" >&2; return 1 ;; esac; }
  # 옮기기 전에 할 일을 적고(fail/), 옮긴 것을 확인한 뒤에 사건을 보낼 함에 — 못 옮겼는데 막힘이 나가지 않게
  # 다 쓴 뒤 바꿔 넣는다(2차 중간 4 — 덮어쓰다 끊겨 빈 파일이 남으면 다시 하기가 빈 이름으로 멈췄다)
  printf '%s\n' "$q_" "$s_" "$ln_" "${m_:--}" "${lg__:--}" "$(flat "$why_")" >"$mj_/fail/$n_.tmp" && mv -f "$mj_/fail/$n_.tmp" "$mj_/fail/$n_" ||
    die "merger: 돌려보낼 일을 적지 못했다"
  ob__="병합기: $why_ — 원본 $(printf %.8s "$s_"), 기준 $(printf %.8s "${B_:--}"), $(mkey "$n_")${mi_:+ (${mi_#*, })}, $fr_ 로 옮김(lane/$ln_ 는 그대로)${lg__:+, 로그 $lg__}"
  # 옮길 제출 객체가 이 클론에 아직 없으면(큐를 받기 전에 반송 — 이름 꼴) 그 큐 참조를 받는다
  git cat-file -e "$s_^{commit}" 2>/dev/null || fetchr git fetch -q origin "+$q_:refs/hc-merger/q/$n_" 2>/dev/null ||
    { echo "hc-lane merger: 실패한 제출 $q_ 를 받지 못했다(git fetch) — 다음 바퀴에 다시" >&2; return 1; }
  set -- "$s_:$fr_" ":$q_" "--force-with-lease=$fr_:" "--force-with-lease=$q_:$s_"
  [ -z "$m_" ] || set -- "$@" "$m_:refs/merge-failed-meta/$n_" ":refs/merge-queue-meta/$n_" "--force-with-lease=refs/merge-failed-meta/$n_:" "--force-with-lease=refs/merge-queue-meta/$n_:$m_"
  git push -q --atomic --porcelain origin "$@" >/dev/null 2>&1 || {
    rb_=$(git ls-remote origin "$q_" "$fr_") || { echo "hc-lane merger: 실패한 제출을 옮겼는지 확인하지 못했다($q_) — 다음 바퀴에 다시" >&2; return 1; }
    case $(printf '%s\n' "$rb_" | awk -v a="$q_" -v b="$fr_" -v s="$s_" '$2 == a { q = 1 } $2 == b && $1 == s { f = 1 } END { print q ? "left" : (f ? "ok" : "gone") }') in
      ok) ;;   # 응답만 끊김
      gone) ob__="병합기: $why_ (그새 다시 제출해 옛 표식이 없어 옮기지 않음 — 새 제출은 큐에) — 원본 $(printf %.8s "$s_"), $(mkey "$n_")${lg__:+, 로그 $lg__}" ;;
      *) echo "hc-lane merger: 실패한 제출 $q_ 를 $fr_ 로 옮기지 못했다 — 다음 바퀴에 다시" >&2; return 1 ;;
    esac
  }
  moutbox "$n_" 막힘 - "$ob__" "$ln_" || return 1
  rm -f "$mj_/fail/$n_" "$mj_/$ln_.tr"
  mjonce "$n_" "$ln_" 돌려보냄 - "$why_"
  msend "$n_"
  echo "hc-lane merger: $ln_ 실패 — $why_ → $fr_" >&2
}
mfretry() {  # 옮기다 멈춘 돌려보내기를 다시(못 하면 그 제출만 계속 건너뜀)
  for f_ in "$mj_"/fail/*; do
    [ -f "$f_" ] || continue
    case $f_ in *.tmp) continue ;; esac
    q_= s_= ln_= m_= lg_f= why_=
    { read -r q_; read -r s_; read -r ln_; read -r m_; read -r lg_f; read -r why_; } <"$f_"
    # 읽은 칸이 꼴에 맞지 않으면(잘린 파일) 버린다 — 그 제출은 큐에 그대로라 다음 바퀴에 다시 판정된다(2차 중간 4)
    case $q_ in refs/merge-queue/?*) ;; *) q_= ;; esac
    if [ -z "$q_" ] || [ "${q_#refs/merge-queue/}" != "${f_##*/}" ] || ! printf %s "$s_" | grep -Eq '^[0-9a-f]{40}$' || [ -z "$ln_" ] || [ -z "$why_" ]; then
      echo "hc-lane merger: 돌려보낼 기록 ${f_##*/} 이 깨졌다 — 버리고 큐에서 다시 판정" >&2; rm -f "$f_"; continue
    fi
    mfail "$q_" "$s_" "$ln_" "$m_" "$lg_f" "$why_" || mer_=1
  done
}
# moutbox <이름> <상태> <sha|-> <글> <레인>: 보낼 사건을 out/<이름>에(지휘 --to·레인 터미널·결과 열쇠 함께). msend가 보내고 지운다
moutbox() {
  printf '%s\n' "$2" "$3" "$4" "$5" "${mo__-}" "${mh_-}" "${mtm_-}" "$(mkey "$1")" >"$mj_/out/$1.tmp" && mv -f "$mj_/out/$1.tmp" "$mj_/out/$1" ||
    { echo "hc-lane merger: 보낼 사건을 적지 못했다" >&2; return 1; }
}
# msend <이름>: 사건(--name <레인>, 제출 때 적은 지휘가 있으면 --to)을 — 같은 레인·상태에 같은 결과 열쇠(mkey)가 든 사건이 이 기계 사건
# 파일에 아직 없을 때만 — 적고(3차 중간 6·2차 중간 5), 제출한 레인 터미널이 살아 있고(최상위 state live) 그 이름(최상위 name)이 레인이면
# hc send로도 알린다 — 이 기계면 <터미널>, 다른 기계면 <기계>/<터미널>(2차 중간 15·3차 중간 12). 알림이 실패하면(끊김) 보낼 함에 두고
# 다음 바퀴에 다시, 세 번까지. 터미널이 없으면(not_found) 사건만. ponytail: hc get과 hc send 사이에 주소가 다른 실행에 다시 쓰이는 것은
# 막지 못한다(모델 밖 — 확실한 결과는 제출 ID가 든 사건)
msend() {
  of_=$mj_/out/$1
  [ -f "$of_" ] || return 0
  o_k=
  { read -r o_st; read -r o_sh; read -r o_msg; read -r o_ln; read -r o_to; read -r o_h; read -r o_t; read -r o_k; } <"$of_"
  if ! LC_ALL=C awk -F'\t' -v l="$o_ln" -v s="$o_st" -v k="${o_k:-$o_msg}" '$4 == l && $5 == s && index($7, k) { f = 1 } END { exit !f }' "$evdir/events.tsv" 2>/dev/null; then
    (mgrun_=; report_cmd "$o_st" "$o_sh" "$o_msg" --name "$o_ln" ${o_to:+--to "$o_to"}) >/dev/null ||
      { echo "hc-lane merger: $o_st 사건을 쓰지 못했다 — 다음 바퀴에 다시" >&2; return 0; }
  fi
  if [ -n "$o_t" ] && [ "$o_t" != - ]; then
    ad_=$o_t; [ "$o_h" = "$mme_" ] || ad_=$o_h/$o_t
    gj_=$(capt 3 hc get "$ad_" --json 2>/dev/null); gr_=$?
    nr_=0   # 다시 할까
    if [ $gr_ = 0 ]; then
      [ "$(printf '%s\n' "$gj_" | jq -r 'select(.state == "live") | .name // empty' 2>/dev/null)" != "$o_ln" ] ||
        capt 5 hc send "$ad_" "hc-lane merger: $o_ln $o_st ${o_sh#-} — $o_msg" >/dev/null 2>&1 || nr_=1
    elif [ $gr_ != 3 ]; then nr_=1; fi   # 3 = 그 터미널 없음(not_found) — 끝난 레인
    if [ $nr_ = 1 ]; then
      tr_=$(cat "$of_.try" 2>/dev/null); tr_=$(( ${tr_:-0} + 1 ))
      if [ $tr_ -lt 3 ]; then
        echo "$tr_" >"$of_.try"; echo "hc-lane merger: $o_ln 레인 터미널($ad_)에 알리지 못했다 — 다음 바퀴에 다시($tr_/3)" >&2; return 0
      fi
      echo "hc-lane merger: $o_ln 레인 터미널($ad_) 알림을 세 번 못 보냈다 — 사건만 남김" >&2
    fi
  fi
  rm -f "$of_" "$of_.try"
}
mflush() { for f_ in "$mj_"/out/*; do case $f_ in *.tmp|*.try) continue ;; esac; [ ! -f "$f_" ] || msend "${f_##*/}"; done; }
# ---- 레인 임대(2026-11-20 fill-dup-guard, 지휘 결정): 프로젝트 원격 ref refs/hc-lanes/<레인>(빈 트리 커밋, 제목 「hc-lane lease <레인>
# <기계> <UTC 시각>」) 하나가 그 이름의 실행 하나다. 띄울 때(hc run 직전) 잡고, land 성공(main과 같은 원자 push)·clean에서 놓는다.
# lease_core <take|show|drop> <저장소> <레인> [<기계(take)>|<기대값(drop)>] — 원격 기계에서도 그대로 돌게 이 함수만으로(declare -f).
#   take: 0 잡음(찍는 값 = 임대 커밋 — push 응답을 잃었어도 원격 값이 이것이면) · 3 누가 쥐고 있다(「값 제목」) ·
#         4 원격(origin) 없음이 확인됨(remote get-url 종료 2 — 「no-origin」을 찍는다. 부르는 쪽은 그 글자도 본다: hc exec의 종료 4와 가름) ·
#         1 못 잡음·조회 실패(저장소 아님 포함) · 5 모름(push 실패 뒤 원격 조회도 실패)
#   show: 「값 제목」 또는 「-」. 0 · 1 조회 실패 · 4 원격 없음
#   drop: 기대값을 주면 그 값일 때만(다르면 3, 지금 값을 찍음), 안 주면 지금 값을 lease로 지움. 0 지움(없음·원격 없음 포함) · 1 실패
lease_core() {
  lc_op=$1 lc_r=$2 lc_n=$3 lc_x=${4-} lc_ref=refs/hc-lanes/$3
  lc_g() { GIT_AUTHOR_NAME=hc-lane GIT_AUTHOR_EMAIL=hc-lane@localhost GIT_COMMITTER_NAME=hc-lane GIT_COMMITTER_EMAIL=hc-lane@localhost git -C "$lc_r" "$@"; }
  lc_cur() { lc_l=$(lc_g ls-remote origin "$lc_ref" </dev/null) || return 1; printf '%s' "${lc_l%%[[:space:]]*}"; }
  lc_sub() {  # 그 임대 커밋의 제목(없으면 받아 온다 — FETCH_HEAD는 안 씀)
    lc_g cat-file -e "$1^{commit}" 2>/dev/null || lc_g fetch -q --no-tags --no-write-fetch-head origin "$lc_ref" </dev/null 2>/dev/null
    lc_g log -1 --format=%s "$1" 2>/dev/null || echo '?'
  }
  lc_g remote get-url origin >/dev/null 2>&1; lc_o=$?
  if [ $lc_o = 2 ]; then echo no-origin; [ "$lc_op" != drop ] || return 0; return 4; fi
  [ $lc_o = 0 ] || return 1
  case $lc_op in
    take)
      lc_t=$(lc_g hash-object -t tree -w /dev/null) &&
        # 본문의 고유값: 같은 기계·같은 초·같은 이름이면 커밋 해시가 같아져 남의 임대를 자기 것으로 읽는다(응답 유실 판정)
        lc_c=$(printf 'hc-lane lease %s %s %s\n\n%s-%s-%s\n' "$lc_n" "${lc_x:--}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$$" "$RANDOM" "$RANDOM" | lc_g commit-tree "$lc_t") || return 1
      lc_g push -q --porcelain origin "--force-with-lease=$lc_ref:" "$lc_c:$lc_ref" </dev/null >/dev/null 2>&1 && { echo "$lc_c"; return 0; }
      lc_v=$(lc_cur) || return 5   # push 실패: 원격 값으로 판정(응답만 잃었을 수 있다)
      [ "$lc_v" != "$lc_c" ] || { echo "$lc_c"; return 0; }
      [ -z "$lc_v" ] || { echo "$lc_v $(lc_sub "$lc_v")"; return 3; }
      return 1 ;;
    show) lc_v=$(lc_cur) || return 1; if [ -n "$lc_v" ]; then echo "$lc_v $(lc_sub "$lc_v")"; else echo -; fi; return 0 ;;
    drop)
      lc_v=$(lc_cur) || return 1
      [ -n "$lc_v" ] || return 0
      [ -z "$lc_x" ] || [ "$lc_x" = "$lc_v" ] || { echo "$lc_v"; return 3; }
      lc_g push -q --porcelain origin "--force-with-lease=$lc_ref:$lc_v" ":$lc_ref" </dev/null >/dev/null 2>&1 && return 0
      lc_v=$(lc_cur) && [ -z "$lc_v" ] && return 0   # 지운 응답만 잃었는지
      return 1 ;;
  esac
  return 1
}
# lease_x <take|show|drop> <레인> [<기계|기대값>]: 대상 기계($on)의 $repo에서 — 원격은 로그인 셸(zx: git 자격 도우미 PATH)로
lease_x() { zx "$repo" bash -c "$(declare -f lease_core); lease_core \"\$@\"" hc-lane-lease "$1" "$repo" "$2" "${3-}"; }
# lease_cmd: hc-lane lease show|drop [--on <기계>] --repo <저장소> --name <레인> — 임대가 남아 다시 못 띄우면(레인이 죽음·지휘가 rm) 손으로
lease_cmd() {
  lo_=$(lease_x "$act" "$name"); r_=$?
  case $act:$r_ in
    show:0) printf '%s\n' "$lo_" ;;
    show:4) [ "$lo_" = no-origin ] && echo "- (원격 없음 — 임대 없음)" || { echo "hc-lane lease: 조회하지 못했다(종료 4)" >&2; return 1; } ;;
    drop:0) echo "hc-lane lease: 놓음 refs/hc-lanes/$name" ;;
    *) echo "hc-lane lease: ${act}하지 못했다(git ls-remote·push origin, 종료 $r_): ${on:+$on:}$repo" >&2; return 1 ;;
  esac
}
# ---- 착지 표식(2026-11-20 fill-dup-guard, 지휘 결정 「착지 증거를 하나로」 — carousel-save-race가 선행 main-split의 착지를 커밋 제목
# 머리로 못 알아봐(「feat(frontend): main-split-1 …」) 먼저 띄움 기한을 넘겼다): land는 main과 같은 --atomic push에
# refs/hc-landed/<레인>/<UTC 초>(값 = 착지한 커밋)과 그 레인 임대 지우기(HC_LANE_LEASE 값 lease)를 싣는다. 기다리는 쪽(hc-fill 선행
# 판정·먼저 띄움 기다림 줄)은 그 선행 줄을 넣은 뒤의 표식 sha가 origin/<기본>의 조상인지 본다. 표식은 지우지 않는다(작고, 지우는 쪽 경합)
# lmname: 이 레인 이름(레인 환경 HC_LANE, 없으면 가지 이름) — 표식·임대 ref에 쓸 수 있을 때만
lmname() {
  lmn_=${HC_LANE:-$(git branch --show-current 2>/dev/null)}
  case $lmn_ in '' | *[!abcdefghijklmnopqrstuvwxyz0123456789_-]*) return 1 ;; esac
  echo "$lmn_"
}
# land_after <기본> <표식 ref>: main push 뒤 — 표식이 그 push에 못 실렸으면 따로(그 커밋이 origin/<기본>에 들어갔을 때만), 임대가 남았으면
# 놓는다. 못 하면 알리기만(착지는 됨 — 표식이 없으면 기다리는 쪽이 커밋 제목 규칙으로만 풀려 더 기다릴 뿐, 남은 임대는 clean·손으로)
land_after() {
  if [ -n "${2-}" ]; then
    la_=$(git ls-remote origin "$2" </dev/null 2>/dev/null)
    if [ -z "$la_" ] && ! { git fetch -q origin </dev/null 2>/dev/null && git merge-base --is-ancestor HEAD "refs/remotes/origin/$1" &&
        git push -q origin "HEAD:$2" </dev/null 2>/dev/null; }; then
      echo "hc-lane land: 착지 표식 $2 를 두지 못했다(착지는 됨 — 기다리는 레인은 커밋 제목 규칙으로만 풀린다)" >&2
    fi
  fi
  [ -n "${HC_LANE_LEASE-}" ] && lmn_=$(lmname) || return 0
  ld_=$(git ls-remote origin "refs/hc-lanes/$lmn_" </dev/null 2>/dev/null) || { echo "hc-lane land: 임대를 확인하지 못했다(착지는 됨) — hc-lane clean이 놓는다" >&2; return 0; }
  [ "${ld_%%[[:space:]]*}" = "$HC_LANE_LEASE" ] || return 0   # 이미 놓았거나 다른 실행의 것
  git push -q origin "--force-with-lease=refs/hc-lanes/$lmn_:$HC_LANE_LEASE" ":refs/hc-lanes/$lmn_" </dev/null 2>/dev/null &&
    echo "hc-lane land: 임대 놓음 refs/hc-lanes/$lmn_" || echo "hc-lane land: 임대를 놓지 못했다(착지는 됨) — hc-lane clean이 놓는다" >&2
}
land_cmd() {
  top=$(git rev-parse --show-toplevel 2>/dev/null) && cd "$top" || die "land: git 작업 폴더 안에서 부른다(레인 워크트리): $PWD"
  base=${lbase:-$(origin_base .)}
  plain "$base" || die "land: 기본 브랜치 이름에 쓸 수 없는 글자가 있다: $base"
  # 병합기가 켜진 저장소(원격 refs/herdr/merger/<기계>)면 착지 대신 제출 — 병합기 안에서 부른 착지(HERDR_MERGER=1)는 아래 그대로.
  # 켜졌는지 모르면 착지하지 않는다(종료 75 — 같은 줄을 다시). 이 분기만 병합기 몫이고 아래 본문은 착지 안전(land-safety) 몫이다
  # (2026-11-20 t68과 정한 경계 — 나중에 착지하는 쪽이 rebase로 맞춘다)
  if [ "${HERDR_MERGER-}" != 1 ]; then
    mgon; case $? in 0) submit_cmd ;; 2) exit 75 ;; esac
  fi
  # 이 착지의 인자는 이 착지만 쓴다 — 검증 자식(저장소 시험이 다시 부르는 hc-lane land 등)에 물려주지 않는다(2차 높음 3: 병합기가 넘긴
  # 큐 삭제 인자가 herdr-tools 자체 시험의 가짜 원격 push에 실려 거절됐다). 착지 스크립트에는 이름을 붙여 넘긴다
  px_=${HERDR_LAND_PUSH_EXTRA-} mgx_=${HERDR_MERGER-}
  unset HERDR_LAND_PUSH_EXTRA HERDR_MERGER
  llog= qa0=$(qadirs)
  # 낡은 착지 스크립트(2026-11-20 land-stale-script — 한 레인이 문서 조각 접기 전 판 herdr-land.sh로 착지해 조각이
  # main에 남았다. bash는 rebase 전에 읽은 옛 판을 끝까지 돈다). fetch는 스크립트가 없는 가지도 한다(<기본>에 새로 생긴 것을 보려고): 가지가 그 스크립트를 스스로 바꾸지 않았는데(HEAD 판 = 갈래점 판)
  # 갈래점 판이 <기본> 판과 다르면(새로 생기거나 지워진 것 포함) 먼저 rebase해 <기본> 판으로 이어 간다. 바꾼 가지는 제 판 그대로
  lf_=.claude/herdr-land.sh
  if git remote get-url origin >/dev/null 2>&1; then ob_=refs/remotes/origin/$base; fetchr git fetch -q origin || die "land: git fetch 실패"
  else ob_=refs/heads/$base; fi
  # 병합기 안 착지: 기본 브랜치에 전용 착지 스크립트가 있으면 그 기본 브랜치 판(방금 받은 것)을 꺼내 맡긴다 — 제출 트리 속 판(레인이
  # 고쳤을 수 있음)은 실행하지 않는다(2단계 2026-11-20 지휘 t1cj). 스크립트는 자기 자리($0)를 쓰지 않는 것을 전제로 임시 파일에서 돈다
  if [ "$mgx_" = 1 ] && git cat-file -e "$ob_:$lf_" 2>/dev/null; then
    mls_=$(mktemp "${TMPDIR:-/tmp}/hc-merger-land.XXXXXX") && git show "$ob_:$lf_" >"$mls_" || die "land: 기본 브랜치의 $lf_ 를 꺼내지 못했다"
    echo "hc-lane land: 병합기 — ${ob_#refs/remotes/} 판 $lf_ 에 맡긴다"
    llog_init
    lrun env HERDR_LAND=1 ${px_:+HERDR_LAND_PUSH_EXTRA="$px_"} bash "$mls_" "$base"; rc=$?
    rm -f "$mls_"
    # 내장 길의 병합기 안 착지와 같게: push는 병합기 인자 그대로, 착지 표식 refs/hc-landed/<레인>/<UTC 초>는 착지 뒤 따로(fill-dup-guard)
    if [ $rc = 0 ]; then lmr_=; ! lmn_=$(lmname) || lmr_=refs/hc-landed/$lmn_/$(date -u +%s); land_after "$base" "$lmr_"; else lfail $rc; fi
    exit $rc
  fi
  lb_() { git rev-parse -q --verify "$1:$lf_" 2>/dev/null; }   # 그 판의 스크립트 blob(없으면 빈 값)
  if mb_=$(git merge-base HEAD "$ob_" 2>/dev/null) && [ "$(lb_ HEAD)" = "$(lb_ "$mb_")" ] && [ "$(lb_ "$mb_")" != "$(lb_ "$ob_")" ]; then
    echo "▸ hc-lane land: 가지의 $lf_ 가 ${ob_#refs/remotes/} 보다 낡음 → 먼저 rebase" >&2
    [ -z "$(git status --porcelain --untracked-files=no)" ] || die "land: 커밋 안 된 변경이나 멈춘 rebase가 있다(git status). 커밋하거나 rebase를 마친 뒤 같은 줄을 다시"
    ro=$(LC_ALL=C git rebase -q "$ob_" 2>&1); rr=$?
    [ -z "$ro" ] || printf '%s\n' "$ro" >&2
    while [ $rr != 0 ] && rr_ok "$ro"; do
      echo "hc-lane land: rerere가 기록한 풀이로 충돌을 다 풀었다($(rr_paths "$ro" | paste -sd , -)) — rebase를 이어 간다" >&2
      ro=$(LC_ALL=C GIT_EDITOR=true git rebase --continue 2>&1); rr=$?
      [ -z "$ro" ] || printf '%s\n' "$ro" >&2
    done
    [ $rr = 0 ] || { echo "hc-lane land: rebase 충돌 — 양쪽 내용을 살려 풀고 git add → git rebase --continue 한 뒤 착지 줄(hc-lane land $base)을 다시" >&2; exit 3; }
  fi
  # 병합기 안 착지: 제출·기준에 있던 스크립트는 병합기가 이미 반송하니, 여기 있는 것은 위 rebase가 들인 것 — 맡기지 않고 7(감사 7c010d9 중간 1)
  [ "$mgx_" != 1 ] || [ ! -f .claude/herdr-land.sh ] ||
    { echo "hc-lane land: 기본 브랜치에 전용 착지 스크립트(.claude/herdr-land.sh)가 생겼다 — 병합기 MVP-1은 그 스크립트에 맡기지 않는다" >&2; exit 7; }
  if [ -f .claude/herdr-land.sh ]; then
    echo "hc-lane land: .claude/herdr-land.sh $base 에 맡긴다"
    llog_init
    # 표식(과 임대 지우기)은 HERDR_LAND_PUSH_EXTRA(공백으로 나눈 refspec — 병합기가 넘긴 인자 뒤에)로 넘겨 그 스크립트가 main push에
    # --atomic으로 싣게 한다 — 임대 지우기는 원격 임대가 이 레인 값일 때만 넣는다(없는 ref 지우기로 원자 push가 실패하지 않게). 못 실었으면 land_after가 따로
    lmr_= lpx_=; if lmn_=$(lmname) && git remote get-url origin >/dev/null 2>&1; then
      lmr_=refs/hc-landed/$lmn_/$(date -u +%s) lpx_="HEAD:$lmr_"
      if [ -n "${HC_LANE_LEASE-}" ]; then lh_=$(git ls-remote origin "refs/hc-lanes/$lmn_" </dev/null 2>/dev/null) && [ "${lh_%%[[:space:]]*}" = "$HC_LANE_LEASE" ] && lpx_="$lpx_ :refs/hc-lanes/$lmn_"; fi
    fi
    ax_="${px_:+$px_${lpx_:+ }}$lpx_"
    lp_=${HERDR_LAND_PRIORITY-}; case $lp_ in '' | *[!0-9]*) lp_=0 ;; esac   # 착지 줄 우선(README 계약): 0 이상 정수, 아니면 0
    lrun env HERDR_LAND=1 HERDR_LAND_PRIORITY="$lp_" ${ax_:+HERDR_LAND_PUSH_EXTRA="$ax_"} bash .claude/herdr-land.sh "$base"; rc=$?
    if [ $rc = 0 ]; then ! git remote get-url origin >/dev/null 2>&1 || { ffmain "$(mainwt)" "$base"; land_after "$base" "$lmr_"; }; else lfail $rc; fi
    exit $rc
  fi
  # origin이 없는 저장소(맥의 game·hwanhon 등)는 로컬 <기본>이 기준이고 착지는 그것을 fast-forward로 올리는 것이다
  if git remote get-url origin >/dev/null 2>&1; then remote=1 bref=refs/remotes/origin/$base blab=origin/$base
  else remote=0 bref=refs/heads/$base blab="로컬 $base"; fi
  tries=${HERDR_LAND_TRIES:-5}
  case $tries in ''|*[!0-9]*|0) tries=5 ;; esac
  i=0
  while :; do
    i=$((i + 1))
    [ -z "$(git status --porcelain --untracked-files=no)" ] || die "land: 커밋 안 된 변경이나 멈춘 rebase가 있다(git status). 커밋하거나 rebase를 마친 뒤 같은 줄을 다시"
    [ $remote = 0 ] || fetchr git fetch -q origin || die "land: git fetch 실패"
    git rev-parse -q --verify "$bref^{commit}" >/dev/null || die "land: $blab 가 없다"
    ro=$(LC_ALL=C git rebase -q "$bref" 2>&1); rr=$?
    [ -z "$ro" ] || printf '%s\n' "$ro" >&2
    while [ $rr != 0 ] && rr_ok "$ro"; do
      echo "hc-lane land: rerere가 기록한 풀이로 충돌을 다 풀었다($(rr_paths "$ro" | paste -sd , -)) — rebase를 이어 간다" >&2
      ro=$(LC_ALL=C GIT_EDITOR=true git rebase --continue 2>&1); rr=$?
      [ -z "$ro" ] || printf '%s\n' "$ro" >&2
    done
    if [ $rr != 0 ]; then
      echo "hc-lane land: rebase 충돌. 양쪽 내용을 살려 풀고 git add → git rebase --continue 뒤 같은 줄(hc-lane land $base)을 다시" >&2
      exit 3
    fi
    # 병합기 안 착지: rebase한 기본 브랜치에 전용 착지 스크립트가 생겼으면 내장 길로 넣지 않는다 — 종료 7, 병합기가 반송(3차 높음 7)
    [ "$mgx_" != 1 ] || [ ! -f .claude/herdr-land.sh ] ||
      { echo "hc-lane land: 기본 브랜치에 전용 착지 스크립트(.claude/herdr-land.sh)가 생겼다 — 병합기 MVP-1은 내장 길로 넣지 않는다" >&2; exit 7; }
    [ -f .claude/herdr-verify.sh ] ||
      die "land: .claude/herdr-verify.sh 가 없어 push하지 않았다(검증 없는 착지는 없다). 저장소에 검증 스크립트(또는 .claude/herdr-land.sh)를 두거나 지휘에 알린다"
    [ -n "$llog" ] || llog_init
    lrun bash .claude/herdr-verify.sh || { lfail $?; die "land: 검증 실패, push하지 않았다. 고쳐 커밋한 뒤 같은 줄을 다시"; }
    if [ $remote = 1 ]; then
      # 함께 실을 것 HERDR_LAND_PUSH_EXTRA = 공백으로 나눈 git push 인자(refspec — 왼쪽 HEAD는 기본 브랜치에 넣는 그 커밋 — 와
      # --force-with-lease=<참조>:<SHA>). 있으면 기본 브랜치와 한 번의 --atomic push(전부 아니면 전무). 2026-11-20 지휘 t1cj — 착지 표식
      # (fill-dup-guard 「HEAD:refs/hc-landed/<레인>/<UTC 초>」 — 내장 길은 아래 mx_로 직접 싣는다)과 병합기 큐 표식 삭제(「:<큐> --force-with-lease=<큐>:<SHA>」, 1차 높음 4·구조 B)가
      # 한 이름·한 꼴. lease 걸린 참조가 바뀌었으면(재제출) 기본 브랜치를 올리지 않고 종료 6
      pa_=("HEAD:refs/heads/$base") ex_=
      for e_ in $px_; do pa_+=("$e_"); ex_=--atomic; done
      # 착지 표식 refs/hc-landed/<레인>/<UTC 초>와 이 레인 임대 지우기(HC_LANE_LEASE 값 lease)도 같은 --atomic push에(fill-dup-guard).
      # 표식·임대 쪽으로 함께 실패했으면(임대를 손으로 놓았음 등) 검증을 다시 돌지 않고 기본 브랜치 + 병합기 인자만 한 번 더(병합기 lease가
      # 바뀌었으면 이것도 실패해 아래 종료 6) — 표식·임대는 land_after가 따로. 병합기 안 착지(HERDR_MERGER=1)는 push를 병합기 판
      # 그대로 둔다(전송 끊김 75·응답 유실 판정이 그 인자에 묶임) — 표식은 착지 뒤 land_after가 따로
      lmr_= mx_=(); if lmn_=$(lmname); then
        lmr_=refs/hc-landed/$lmn_/$(date -u +%s)
        if [ "$mgx_" != 1 ]; then
          mx_=("HEAD:$lmr_") ex_=--atomic
          [ -z "${HC_LANE_LEASE-}" ] || mx_+=("--force-with-lease=refs/hc-lanes/$lmn_:$HC_LANE_LEASE" ":refs/hc-lanes/$lmn_")
        fi
      fi
      if HERDR_LAND=1 git push $ex_ origin "${pa_[@]}" ${mx_[0]+"${mx_[@]}"} ||
        { [ -n "${mx_[0]-}" ] && HERDR_LAND=1 git push ${pa_[1]+--atomic} origin "${pa_[@]}"; }; then
        echo "hc-lane land: 착지 $(git rev-parse --short HEAD) → origin/$base${lmr_:+ (착지 표식 $lmr_)}"
        ffmain "$(mainwt)" "$base"
        land_after "$base" "$lmr_"
        return 0
      fi
      fetchr git fetch -q origin || die "land: push 실패 뒤 git fetch 실패"
      for e_ in $px_; do
        case $e_ in --force-with-lease=?*:*) ;; *) continue ;; esac
        r_=${e_#--force-with-lease=}; s_=${r_#*:}; r_=${r_%%:*}
        xr_=$(git ls-remote origin "$r_") || die "land: push가 거절됐는데 lease 참조 $r_ 를 다시 보지 못했다(git ls-remote) — 같은 줄을 다시"
        [ "$(printf '%s\n' "$xr_" | awk -v r="$r_" '$2 == r { print $1 }')" = "$s_" ] ||
          { echo "hc-lane land: 함께 실은 lease 참조 $r_ 가 바뀌었다(다시 제출) — $base 를 올리지 않았다" >&2; exit 6; }
      done
      git merge-base --is-ancestor "$bref" HEAD &&
        die "land: push 실패(다른 쪽 push가 앞선 것이 아니다 — 위 git 출력을 본다)"
    else
      new=$(git rev-parse HEAD) old=$(git rev-parse "$bref")
      # <기본>이 체크아웃된 폴더(보통 메인 클론)가 있으면 그 폴더 작업 트리도 같이 올리고, 없으면 기대값 확인 update-ref
      at=$(git worktree list --porcelain | B="branch $bref" awk '/^worktree /{w=substr($0,10)} $0==ENVIRON["B"]{print w; exit}')
      if [ -n "$at" ]; then HERDR_LAND=1 git -C "$at" merge --ff-only -q "$new"
      else git merge-base --is-ancestor "$old" "$new" && git update-ref "$bref" "$new" "$old"; fi &&
        { echo "hc-lane land: 착지 $(git rev-parse --short HEAD) → 로컬 $base${at:+ (폴더 $at)}"; return 0; }
      git merge-base --is-ancestor "$bref" HEAD &&
        die "land: 로컬 $base 를 fast-forward로 올리지 못했다${at:+(폴더 $at 에 커밋 안 된 변경?)} — 위 git 출력을 본다"
    fi
    if [ $i -ge $tries ]; then
      echo "hc-lane land: 다른 쪽 착지가 먼저 들어가 ${tries}번 거절됐다. 같은 줄을 다시" >&2
      exit 4
    fi
    echo "hc-lane land: 다른 쪽 착지가 먼저 들어가 거절됨, 처음부터 다시 ($((i + 1))/$tries)" >&2
  done
}

# guard: 클론의 공용 git 폴더 hooks/pre-push에 관문. 표지 줄로 자기가 넣은 것을 알아보고, 남의 훅은 건드리지 않는다.
gmark='# hc-lane guard v1'
guard_cmd() {
  common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "guard: git 저장소가 아니다: $repo"
  hp=$(git -C "$repo" config --get core.hooksPath)
  f=$common/hooks/pre-push
  st=none
  if [ -e "$f" ] || [ -L "$f" ]; then if grep -Fqx "$gmark" "$f" 2>/dev/null; then st=ours; else st=other; fi; fi
  if [ -z "$(git -C "$repo" remote)" ] && [ $act != remove ]; then
    echo "guard: 원격이 없는 저장소라 push가 없다. 설치할 것 없음(착지는 hc-lane land가 로컬 <기본>을 fast-forward로 올린다): $repo"
    return 0
  fi
  case $act in
    status)
      case $st in
        ours) b=$(sed -n 's/^base=//p' "$f")
              if [ -n "$hp" ]; then echo "guard: 깔려 있지만 core.hooksPath=$hp 라 git이 부르지 않는다: $f"; return 1; fi
              echo "guard: 깔림(기본 브랜치 $b): $f"; return 0 ;;
        none) echo "guard: 없음: $f"; return 1 ;;
        other) echo "guard: 다른 pre-push 훅이 있다(hc-lane 관문 아님): $f"; return 3 ;;
      esac ;;
    install)
      [ -z "$hp" ] || die "guard: core.hooksPath=$hp 라 $f 는 git이 부르지 않는다. 건드리지 않았다(그 훅 폴더에 연결할지 지휘가 정한다)"
      [ $st != other ] || die "guard: 다른 pre-push 훅이 있다: $f. 덮지 않았다(그 훅에 관문을 이을지 지휘가 정한다)"
      b=${branch:-$(origin_base "$repo")}
      plain "$b" || die "guard: 기본 브랜치 이름에 쓸 수 없는 글자가 있다: $b"
      mkdir -p "$common/hooks" || die "guard: 훅 폴더를 만들지 못했다: $common/hooks"
      tmp=$f.hc-lane.$$
      cat >"$tmp" <<EOF || die "guard: 쓰지 못했다: $tmp"
#!/bin/sh
$gmark
# hc-lane guard install이 넣었다(지우기: hc-lane guard remove --repo <경로>). refs/heads/<기본>으로 가는 push는
# 착지 줄(hc-lane land, .claude/herdr-land.sh)이 주는 HERDR_LAND=1일 때만 받는다. 다른 브랜치·참조는 통과.
base=$b
[ "\${HERDR_LAND-}" = 1 ] && exit 0
while read -r lref lsha rref rsha; do
  [ "\$rref" = "refs/heads/\$base" ] || continue
  cat >/dev/null
  echo "push 막힘: \$base 로 가는 push는 착지 줄로만 한다." >&2
  echo "새 착지 줄: hc-lane land \$base" >&2
  echo "(사람이 손으로 넣을 때만 HERDR_LAND=1 git push … 로 명시)" >&2
  exit 1
done
exit 0
EOF
      chmod +x "$tmp" && mv -f "$tmp" "$f" || { rm -f "$tmp"; die "guard: 넣지 못했다: $f"; }
      [ $st = ours ] && echo "guard: 새로 씀(기본 브랜치 $b): $f" || echo "guard: 깔았다(기본 브랜치 $b): $f" ;;
    remove)
      case $st in
        ours) rm -f "$f" || die "guard: 지우지 못했다: $f"; echo "guard: 지웠다: $f" ;;
        none) echo "guard: 지울 것 없음: $f" ;;
        other) die "guard: hc-lane 관문이 아닌 pre-push 훅이라 지우지 않았다: $f" ;;
      esac ;;
  esac
}

case $cmd in
  land) land_cmd; exit $? ;;
  merger) merger_cmd ${mga_[@]+"${mga_[@]}"}; exit $? ;;
  guard) guard_cmd; exit $? ;;
  lease) lease_cmd; exit $? ;;
  fetch)
    fetchr zx "$repo" git fetch origin "$@" || die "fetch 실패: ${on:+$on:}$repo (위 git 출력을 본다)"
    echo "hc-lane fetch: 받음 ${on:+$on:}$repo origin${1:+ $*}"; exit 0 ;;
esac

# --read는 준 폴더 그대로에서 띄운다(rdir): 저장소 안 하위 폴더(.qa/… 등)나 저장소가 아닌 폴더도(2026-11-17 lane-import-trust).
# 저장소가 아니면 기준 브랜치 없이(LANE_REPO=그 폴더, LANE_BASE 빈 값)
rdir= norepo=0
if [ $cmd = launch ] && [ $read = 1 ]; then
  rdir=$(x sh -c 'cd "$1" && pwd -P' hc-lane "$repo") && [ -n "$rdir" ] || die "폴더가 없다: $repo${on:+ (기계 $on)}"
  x git -C "$rdir" rev-parse --git-dir >/dev/null 2>&1 || norepo=1
fi
if [ $norepo = 1 ]; then repo=$rdir remote=0 base= bref= blab=; else
top=$(x git -C "$repo" worktree list --porcelain | sed -n '1s/^worktree //p')
[ -n "$top" ] || die "git 저장소가 아니다: $repo${on:+ (기계 $on)}"
repo=$top
# origin이 없는 저장소는 fetch 없이 로컬 <기본>(main, 없으면 master)이 기준이다
if x git -C "$repo" remote get-url origin >/dev/null 2>&1; then
  remote=1
  base=$(x git -C "$repo" symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null)
  base=${base#origin/}
else
  remote=0 base=
  x git -C "$repo" show-ref -q --verify refs/heads/main || ! x git -C "$repo" show-ref -q --verify refs/heads/master || base=master
fi
[ -n "$base" ] || base=main
if [ $remote = 1 ]; then bref=refs/remotes/origin/$base blab=origin/$base; else bref=refs/heads/$base blab="로컬 $base"; fi
plain "$base" || die "기본 브랜치 이름에 쓸 수 없는 글자가 있다: $base"
if [ $cmd != gc ]; then
  [ -n "$branch" ] || branch=$name
  plain "$branch" && x git -C "$repo" check-ref-format --branch "$branch" >/dev/null 2>&1 ||
    die "브랜치 이름이 올바르지 않다(영문·숫자·/ _ . - 만): $branch"
  wt=${repo%/*}/${repo##*/}.wt/$(printf %s "$branch" | tr / -)
  rx=${on:+hc exec --on $on -- }   # 안내하는 명령은 호출한 쪽에서 돌리므로 --on이면 hc exec를 붙인다
  undo="${rx}git -C $(q "$repo") worktree remove --force $(q "$wt") && ${rx}git -C $(q "$repo") branch -d $branch"
fi
fi   # norepo

# 쓰기·읽기 레인 공통(2026-11-19 무인 레인 셋이 rm -rf $S/… · rm -f out/* 에서 Claude Code 권한 창에 막혀 멈췄다)
rm_rule() {
  printf -- '- 임시 파일은 실행마다 `mktemp -d`로 새 폴더를 만들어 쓰고 지우지 않는다. `rm -rf`·`rm -f`에 변수(`$X/…`)나 와일드카드(`*`) 경로를 쓰지 않는다 — Claude Code가 권한 창을 띄워 무인 레인이 막힌다. 꼭 지워야 하면 글자 그대로의 경로나 `"${X:?}"` 꼴로.\n'
}

print_steps() {
  n=0
  s() { n=$((n + 1)); printf '%s. %s\n' "$n" "$*"; }
  printf '### 착지·정리 (hc-lane이 채움)\n'
  printf -- '- 작업 폴더 %s (브랜치 %s, 기준 %s). 편집·명령은 이 폴더 안에서만 한다.\n' "$wt" "$branch" "$blab"
  printf -- '- 커밋은 경로를 지정한다: git add -- <경로…> && git commit -m "<메시지>" -- <경로…> (add -A·commit -a·stash·reset --hard·강제 push 금지)\n'
  rm_rule
  # rebase·검증·push는 한 줄: 앞 단계가 실패하면 push가 나가지 않는다(2026-11-05 레인이 ;로 이어 써서 검증 실패 뒤 push가
  # 나갔고, 따로 된 줄이면 충돌로 멈춘 rebase의 반쯤 된 HEAD도 나간다). 안내는 # 줄로 따로: 대화형 zsh에 붙여 넣어도
  # 명령이 되지 않게 ; > | & 를 쓰지 않는다.
  # 착지는 hc-lane land 한 줄: 저장소의 .claude/herdr-land.sh(있으면) 또는 fetch·rebase·herdr-verify.sh·push. 검증 스크립트가
  # 없으면 실패하고 push하지 않는다(2026-11-16 전환 안전장치: 옛 줄은 검증이 없으면 「건너뜀」 뒤 push했다).
  printf -- '- 알림: 중간·완료·착지·막힘 때 hc-lane report <상태> [<sha>] "<한 줄>"을 부른다(화면 줄과 보고 파일은 그대로 써도 됨). 지휘는 hc-lane wait로 이 사건만 기다린다\n'
  printf -- '  예: hc-lane report 완료 <sha8> "<요약>" · 아래 1이 착지하면 hc-lane report 착지 <sha8> · 막히면 hc-lane report 막힘 - "<까닭>"\n'
  s "cd $(q "$wt") && hc-lane land $base"
  printf '   # 이 한 줄을 그대로 돌린다. 나누거나 세미콜론으로 이어 쓰지 말 것. 앞 단계가 실패하면 push는 나가지 않는다\n'
  printf '   # 저장소에 .claude/herdr-land.sh가 있으면 그 스크립트가 fetch·rebase·검증·push를 하고, 없으면 hc-lane이 같은 순서로 하며 .claude/herdr-verify.sh가 없으면 push하지 않고 실패한다\n'
  printf '   # rebase가 충돌로 멈추면(종료 3) 양쪽 내용을 살려 풀고 고친 파일을 git add 한 뒤 git rebase --continue, 그다음 이 줄을 처음부터 다시\n'
  printf '   # 검증이 실패하면 고쳐 커밋하고 이 줄을 다시. push 거절 횟수(종료 4)나 잠금 기다림 상한(종료 75)으로 끝나면 이 줄을 다시, 최대 20번\n'
  printf '   # 병합기가 켜진 저장소면 이 줄은 큐에 제출만 하고 끝난다(「제출 … 이 레인은 여기서 끝」) — 착지는 병합기가 알리고, report 착지는 적히지 않는다. 아래 clean은 원격 lane/레인이름 에 그대로 있는 가지를 「제출됨」으로 지워 자리를 바로 비운다\n'
  s "cd $(q "$repo") && hc-lane clean --repo $(q "$repo") --branch $branch"
  printf '   # teardown·검사·워크트리·브랜치 정리를 한 번에. clean이 종료 1로 멈추면 출력된 이유를 고치고 같은 줄을 다시 돈다\n'
  printf '   # 폴더를 rm -rf로 직접 지우지 않는다. 보고는 출력 그대로, 건너뜀은 통과가 아니다\n'
  printf '   # 끝내기 전 이 작업 트리 아래에서 도는 배경 프로세스가 없는지 확인한다(pgrep -fl %s). 자기 셸·에이전트는 빼고, 남은 것은 그 정확한 pid로 kill 한다. cwd로만 도는 것(명령 줄에 경로 없음)은 pgrep에 안 보인다\n' "$(q "$wt/")"
}

read_steps() {  # --read(감사·조사) 레인: 판정은 사건으로
  printf '### 판정 알림 (hc-lane이 채움)\n'
  rm_rule
  printf -- '- 판정이 나오면 보고 파일과 함께 이 한 줄을 부른다: hc-lane report 판정 - "<판정 한 줄(예: 감사 완료 <대상 sha8> 높음 0·중간 0·낮음 n)>"\n'
  printf -- '- 막히면 hc-lane report 막힘 - "<까닭>". 지휘는 hc-lane wait로 이 사건만 기다린다\n'
}

# hook <setup|teardown>: 워크트리 안에서 .claude/herdr-<이름>.sh. 기록은 그 워크트리의 git 관리 폴더(worktree remove 때 같이 지워진다).
# --on이면 hc 코어 환경이라 ~/.zshrc의 PATH(bun 등)가 없다(150·151 실측). zsh·~/.zshrc가 있으면 읽고 돈다.
hook() {
  core=; [ -n "$on" ] || [ -n "${HC_TERMINAL_ID-}" ] || core=1   # hc 터미널 밖(launchd 등) 로컬이면 코어 문맥으로(x 위 주석)
  log=$(x git -C "$wt" rev-parse --absolute-git-dir)/hc-lane-$1.log
  zx "$wt" env "LANE_REPO=$repo" "LANE_WORKTREE=$wt" "LANE_BRANCH=$branch" "LANE_BASE=$base" \
    sh -c 'exec bash "$1" >"$2" 2>&1 </dev/null' hc-lane ".claude/herdr-$1.sh" "$log"
  r_=$?; core=; return $r_
}

# clean: 지우기 전에 다 확인하고, 하나라도 걸리면 아무것도 지우지 않는다(teardown도 안 돌린다).
stop() {  # stop <한 줄 이유> [자세한 목록]: stderr에 알리고 JSON, 종료 1
  printf 'hc-lane clean: %s\n' "$1" >&2
  if [ -n "${2-}" ]; then
    printf '%s\n' "$2" | sed -n '1,30s/^/    /p' >&2
    k=$(printf '%s\n' "$2" | wc -l | tr -d ' '); [ "$k" -le 30 ] || echo "    … (모두 ${k}줄)" >&2
  fi
  if [ -n "$did" ]; then printf 'hc-lane clean: 여기까지 했다: %s. 원인을 고친 뒤 같은 명령을 다시 돌린다\n' "$did" >&2
  else printf 'hc-lane clean: 아무것도 지우지 않았다. 원인을 고친 뒤 같은 명령을 다시 돌린다(폴더를 rm -rf로 직접 지우지 않는다)\n' >&2; fi
  cj stopped "$1"
  exit 1
}
# 있음(0)·없음(1)만 믿고, 그 밖의 종료 코드(hc 연결 끊김 등)는 멈춘다. "없음"으로 읽어 거짓 성공하지 않게.
exists() { x sh -c '[ -e "$1" ] || [ -L "$1" ]' hc-lane "$wt"; case $? in 0) return 0 ;; 1) return 1 ;; esac; stop "폴더를 확인하지 못했다(hc·연결?): $wt"; }
has_branch() { x git -C "$repo" show-ref --verify -q "refs/heads/$branch"; case $? in 0) return 0 ;; 1) return 1 ;; esac; stop "브랜치를 확인하지 못했다: $branch"; }
# leftover: 등록이 지워진 폴더에서 메인 폴더의 무시 규칙으로 무시되지 않는 것(추적 파일 포함)을 찍는다. 검사 오류는 종료 2.
# .git은 지워진 등록(<공용 git 폴더>/worktrees/…)을 가리키는 파일일 때만 git이 남긴 것으로 본다.
# ponytail: 규칙은 메인 폴더 작업 트리의 .gitignore — 뒤처져 규칙이 없으면 멈추고(안전 쪽), 로컬로 고쳤으면 아예 멈춘다.
#           자주 걸리면 origin/<기본> 트리의 .gitignore로 판정하게 바꾼다.
leftover() {
  x sh -c '
    cd "$2" || exit 2
    t=$(mktemp "${TMPDIR:-/tmp}/hc-lane-left.XXXXXX") || exit 2
    trap "rm -f \"\$t\" \"\$t.i\"" EXIT
    if [ -f .git ] && [ ! -L .git ]; then
      g=$(sed -n "s/^gitdir: //p" .git)
      case $g in "$3"/worktrees/?*) [ ! -e "$g" ] || echo .git ;; *) echo .git ;; esac
    elif [ -e .git ] || [ -L .git ]; then echo .git
    fi
    find . -mindepth 1 -path ./.git -prune -o ! -type d -print | sed "s|^\./||" >"$t" || exit 2
    git -c core.quotePath=false -C "$1" check-ignore --stdin <"$t" >"$t.i"; [ $? -le 1 ] || exit 2
    grep -vxF -f "$t.i" "$t"; [ $? -le 1 ] || exit 2' hc-lane "$repo" "$wt" "$common"
}
left_check() {  # left_check <어떤 폴더>
  g=$(x git -C "$repo" status --porcelain --untracked-files=all -- ':(glob)**/.gitignore') || stop "메인 폴더 git status 실패: $repo"
  [ -z "$g" ] || stop "메인 폴더의 .gitignore에 커밋 안 된 변경이 있어 $1 폴더의 무시 판정을 믿을 수 없다: $repo" "$g"
  left=$(leftover) || stop "$1 폴더를 검사하지 못했다: $wt"
  [ -z "$left" ] || stop "$1 폴더에 .gitignore로 무시되지 않는 것(추적 파일 포함)이 있다: $wt" "$left"
}
self=${HC_TERMINAL_ID-}
# term_pairs: hc ls --json에서 터미널마다 "<주소> <cwd>" 한 줄. 1 hc ls 실패, 2 형식을 못 읽음(뽑은 수가 "cwd" 수와 다름).
term_pairs() {
  tl=$(hc ls --json 2>/dev/null) || return 1
  tp=$(printf '%s\n' "$tl" | tr '{' '\n' | sed -n 's/.*"address" *: *"\([^"]*\)".*"cwd" *: *"\([^"]*\)".*/\1 \2/p')
  [ "$(printf '%s\n' "$tl" | grep -o '"cwd" *:' | grep -c .)" = "$(printf '%s\n' "$tp" | grep -c .)" ] || return 2
  printf '%s\n' "$tp"
}
# busy_terms: "<주소> <cwd>" 줄(표준 입력) 가운데 대상 기계의 터미널이고 cwd가 그 폴더 안인 것을 찍는다.
busy_terms() {
  while read -r a c; do
    case $a in "${on:+$on/}"*) a=${a#"${on:+$on/}"} ;; *) continue ;; esac
    case $a in */*) continue ;; esac                               # 다른 기계
    [ -n "$on" ] || [ "$a" != "$self" ] || continue   # 부른 터미널 자신(clean 착지 절차의 레인. gc는 빼지 않는다)
    case $c/ in "$wt"/*) echo "${on:+$on/}$a $c" ;; esac
  done
}
clean_cmd() {
  td=none did=
  [ "$branch" != "$base" ] || die "기본 브랜치($base)는 정리하지 않는다"
  here=$(pwd -P 2>/dev/null)
  common=$(x git -C "$repo" rev-parse --path-format=absolute --git-common-dir) || stop "git 관리 폴더를 찾지 못했다: $repo"
  wl=$(x git -C "$repo" worktree list --porcelain) || stop "git worktree list 실패: $repo"
  blk=$(printf '%s\n' "$wl" | W="worktree $wt" awk '$0 == ENVIRON["W"] { f = 1; next } f && /^worktree / { exit } f')
  reg=0; printf '%s\n' "$wl" | grep -Fxq "worktree $wt" && reg=1
  dir=0; exists && dir=1
  br=0; has_branch && br=1
  if [ $reg = 0 ] && [ $dir = 0 ] && [ $br = 0 ]; then
    echo "정리할 것 없음: 워크트리 $wt 와 브랜치 $branch 가 이미 없다"
    clean_lease
    cj nothing
    return 0
  fi

  # 0) 그 폴더가 이 브랜치의 워크트리인지(브랜치 이름의 / 를 - 로 바꾼 폴더 이름은 겹칠 수 있다), 잠기지 않았는지,
  #    살아 있는 다른 터미널이 그 폴더에서 돌지 않는지(착지 절차에서 자기 자신을 지우는 레인은 $HC_TERMINAL_ID로 뺀다)
  if [ $reg = 1 ]; then
    wb=$(printf '%s\n' "$blk" | sed -n 's/^branch //p')
    [ -z "$wb" ] || [ "$wb" = "refs/heads/$branch" ] || stop "이 폴더는 다른 브랜치(${wb#refs/heads/})의 워크트리다: $wt"
    [ -n "$wb" ] || [ $br = 0 ] || stop "이 폴더는 분리 HEAD 워크트리인데 브랜치 $branch 는 따로 있다(다른 레인의 폴더일 수 있다): $wt"
    printf '%s\n' "$blk" | grep -q '^locked' && stop "잠긴 워크트리다(git worktree unlock 뒤 다시): $wt"
  fi
  if [ $dir = 1 ]; then
    pairs=$(term_pairs); case $? in
      1) stop "hc ls 실패: 이 폴더에서 도는 터미널을 확인하지 못했다" ;;
      2) stop "hc ls --json 출력을 읽지 못했다(형식이 바뀌었나?): 이 폴더에서 도는 터미널을 확인하지 못했다" ;;
    esac
    busy=$(printf '%s\n' "$pairs" | busy_terms)
    [ -z "$busy" ] || stop "살아 있는 터미널이 이 폴더에서 돈다(끝났으면 hc kill <주소> 뒤 다시): $wt" "$busy"
  fi

  # 1) 브랜치와 워크트리 HEAD가 origin/<기본>에 들어갔는지(폴더가 없어도 등록의 HEAD로 본다)
  if [ $remote = 0 ]; then :
  elif [ $dry = 1 ]; then echo "[dry-run] git fetch 건너뜀: 지금 있는 origin/$base 로 판정"
  else fetchr x git -C "$repo" fetch -q origin || stop "git fetch 실패: $repo"; fi
  x git -C "$repo" rev-parse -q --verify "$bref^{commit}" >/dev/null || stop "$blab 가 없다: $repo"
  set --
  [ $br = 1 ] && set -- "refs/heads/$branch"
  if [ $reg = 1 ]; then
    h=$(printf '%s\n' "$blk" | sed -n 's/^HEAD //p')
    [ -n "$h" ] || stop "워크트리 HEAD를 읽지 못했다: $wt"
    set -- "$@" "$h"
  fi
  arch= btip= subm= lrr_=-
  [ $br = 0 ] || btip=$(x git -C "$repo" rev-parse -q --verify "refs/heads/$branch^{commit}") || stop "브랜치를 읽지 못했다: $branch"
  for c in "$@"; do
    case $c in refs/heads/*) lab="브랜치 $branch" ;; *) lab="워크트리 HEAD $(printf %.12s "$c")" ;; esac
    x git -C "$repo" merge-base --is-ancestor "$c" "$bref"; ia=$?
    [ $ia != 0 ] || continue
    # 병합기에 제출한 커밋: 원격에 지금(ls-remote — 낡은 추적 참조가 아니라) 그 SHA 그대로인 lane/* 참조가 있으면 원격이 그 커밋을 쥐고
    # 있으니 지워도 된다 — 레인이 접수 뒤 바로 자리를 비운다(3차 중간 9, 지휘). 원격에서 그 참조가 지워졌거나 다른 커밋이면 지우지 않는다
    # (2차 높음 4). 원격을 못 읽으면 멈춘다
    if [ $ia = 1 ] && [ $remote = 1 ] && [ $br = 1 ]; then
      [ "$lrr_" != - ] || lrr_=$(x git -C "$repo" ls-remote origin 'refs/heads/lane/*') || stop "git ls-remote 실패: $lab · origin lane/*"
      s_=$(x git -C "$repo" rev-parse -q --verify "$c^{commit}") || stop "커밋을 읽지 못했다: $lab"
      lh_=$(printf '%s\n' "$lrr_" | awk -v s="$s_" '$1 == s { print $2; exit }')
      if [ -n "$lh_" ]; then echo "${P}제출됨: $lab 은 원격 $lh_ 에 그대로 있다(병합기가 넣는다)"; subm=1; continue; fi
    fi
    if [ $ia = 1 ] && [ $archive = 1 ]; then   # 보관할 커밋(안 들어간 끝 커밋)으로 모은다 — 지우기 전 확인을 다 거친 뒤 push
      [ $remote = 1 ] || stop "원격(origin)이 없어 --archive로 보관할 수 없다: $repo"
      s_=$(x git -C "$repo" rev-parse -q --verify "$c^{commit}") || stop "커밋을 읽지 못했다: $lab"
      case " $arch " in *" $s_ "*) ;; *) arch="$arch $s_" ;; esac
      continue
    fi
    stop "$lab 이(가) $blab 에 들어가지 않았다(착지 전이거나 다른 커밋). 착지 절차의 hc-lane land부터 다시 한다(다른 곳에서 rebase돼 착지했으면 --archive)" \
      "$(x git -C "$repo" log --oneline -n 10 "$bref..$c")"
  done

  # 2) 지울 폴더에 추적 변경·무시되지 않은 untracked가 없는지(status.showUntrackedFiles 설정과 무관하게 모두 본다)
  if [ $reg = 1 ] && [ $dir = 1 ]; then
    st=$(x git -c core.quotePath=false -C "$wt" status --porcelain --untracked-files=all --ignore-submodules=none) || stop "git status 실패: $wt"
    [ -z "$st" ] || stop "워크트리에 커밋 안 된 변경이나 무시되지 않은 untracked가 있다: $wt" "$st"
    ig=$(x git -c core.quotePath=false -C "$wt" status --porcelain --ignored --untracked-files=normal | sed -n 's/^!! //p' | tr '\n' ' ')
    [ -z "$ig" ] || echo "${P}무시된 것도 같이 지운다: $ig"
  elif [ $dir = 1 ]; then
    left_check "등록이 지워진"
  fi

  # 2.5) --archive: 안 들어간 커밋을 원격 refs/archive/<가지>-<sha8>에 보관(sweep-rename 4). 하나라도 실패하면 아무것도 지우지 않는다
  for s_ in $arch; do
    ar=refs/archive/$branch-$(printf %.8s "$s_")
    if [ $dry = 1 ]; then echo "[dry-run] git -C $(q "$repo") push origin $s_:$ar"; continue; fi
    zx "$repo" git push -q origin "$s_:$ar" >&2 || stop "보관 push 실패: $ar ($s_)"
    echo "보관 $ar ($s_) — 되살리기: git fetch origin $ar"
  done

  # 2.7) 무시된 보관물 .qa: 지우기 전 메인 폴더(첫 작업 트리)의 같은 자리로 복사(덮지 않음)하고, 모든 파일이 메인 쪽과 같을 때만
  #      지운다(2026-11-19 — 한 레인이 gc의 「무시된 보관물 .qa」를 보고 손으로 지우다 무료 실행 출력을 잃었다). 같은 이름의
  #      다른 파일이 있거나 복사 실패·메인 폴더 못 찾음이면 아무것도 안 지우고 멈춘다. --on이면 그 기계 안 복사
  if [ $dir = 1 ]; then
    mw=$(printf '%s\n' "$wl" | awk 'NR == 1 { p = substr($0, 10) } /^bare/ { p = "" } /^$/ { exit } END { print p }')
    [ "$mw" != "$wt" ] || mw=
    gd=$repo; [ $reg = 0 ] || gd=$wt
    qa=$(x sh -c 'cd "$1" || exit 2
      r=$(find . -path ./.git -prune -o -type d -name .qa -print -prune) || exit 2
      [ -n "$r" ] || exit 0
      f=$(printf "%s\n" "$r" | while IFS= read -r d; do find "$d" ! -type d; done | sed "s|^\./||") || exit 2
      [ -n "$f" ] || exit 0
      i=$(printf "%s\n" "$f" | git -c core.quotePath=false -C "$3" check-ignore --stdin); [ $? -le 1 ] || exit 2
      [ -n "$i" ] || exit 0
      [ -n "$2" ] && [ -d "$2" ] || exit 3
      [ "$4" = 0 ] || { printf "%s\n" "$i" | sed "s/^/n /"; exit 0; }
      printf "%s\n" "$i" | while IFS= read -r p; do
        if [ -e "$2/$p" ] || [ -L "$2/$p" ]; then k=s; cmp -s "$p" "$2/$p" || k=d
        else k=c; { mkdir -p "$2/$(dirname "$p")" && cp -pP "$p" "$2/$p" && cmp -s "$p" "$2/$p"; } || k=f; fi
        echo "$k $p"
      done' hc-lane "$wt" "$mw" "$gd" "$dry")
    case $? in 0) ;; 3) stop "메인 폴더를 찾지 못해 무시된 .qa를 옮길 수 없다(손으로 옮긴 뒤 다시): $wt" ;;
      *) stop "무시된 .qa를 메인 폴더로 옮기지 못했다: $wt → ${mw:-?}" ;; esac
    if [ -n "$qa" ]; then
      qp=$(printf '%s\n' "$qa" | sed 's/^. //; s|^\(.*\.qa\)/.*|\1|' | sort -u |
        awk -v w="$wt" -v m="$mw" '{ printf "%s%s/%s → %s/%s", (NR > 1 ? ", " : ""), w, $0, m, $0 }')
      nf=$(printf '%s\n' "$qa" | grep -c .)
      if [ $dry = 1 ]; then echo "[dry-run] 무시된 보관물 복사(덮지 않음) 뒤 지움: $qp (파일 ${nf}개)"
      else
        dq=$(printf '%s\n' "$qa" | sed -n 's/^d /다름(메인 것 둠) /p; s/^f /복사 실패 /p')
        [ -z "$dq" ] || stop "무시된 .qa 파일 일부를 메인 폴더로 옮기지 못했다(같은 이름의 다른 파일은 덮지 않는다) — 비교·정리한 뒤 다시. 아무것도 안 지웠다: $wt" "$dq"
        echo "옮김 $qp (파일 ${nf}개 — 새로 $(printf '%s\n' "$qa" | grep -c '^c '), 이미 같음 $(printf '%s\n' "$qa" | grep -c '^s '))"
        did="${did:+$did, }.qa 메인 폴더로 복사"
      fi
    fi
  fi

  # 3) teardown(있으면, 실패해도 계속 — herdr-teardown.sh의 약속) → worktree remove → 남은 무시 파일 폴더 → branch -d
  if [ $reg = 1 ] && [ $dir = 1 ] && x test -f "$wt/.claude/herdr-teardown.sh"; then
    if [ $dry = 1 ]; then echo "[dry-run] 워크트리에서 bash .claude/herdr-teardown.sh"; td=dry-run
    elif hook teardown; then td=ran did=teardown
    else
      x tail -n 20 "$log" >&2
      echo "hc-lane clean: herdr-teardown.sh 실패(위는 기록 끝 20줄), 정리는 계속한다" >&2
      td=failed did=teardown
    fi
  fi
  if [ $reg = 1 ]; then
    if [ $dry = 1 ]; then echo "[dry-run] git -C $(q "$repo") worktree remove $(q "$wt")"
    else
      # 무시된 파일 때문에 "Directory not empty"로 끝나도 등록은 지워질 수 있다(git이 멈추지 않는다). 등록으로 판정한다.
      x git -C "$repo" worktree remove "$wt" >&2
      wl=$(x git -C "$repo" worktree list --porcelain) || stop "git worktree list 실패: $repo"
      printf '%s\n' "$wl" | grep -Fxq "worktree $wt" && stop "git worktree remove 실패: $wt"
      did="${did:+$did, }워크트리 등록 제거"
    fi
  fi
  if [ $dry = 1 ]; then
    [ $reg = 1 ] || [ $dir = 0 ] || echo "[dry-run] rm -rf -- $(q "$wt")  # 무시된 파일만 남은 폴더"
  elif exists; then
    left_check 남은
    x rm -rf -- "$wt" || stop "남은 폴더를 지우지 못했다: $wt"
    did="${did:+$did, }남은 무시 파일 폴더 삭제"
  fi
  if [ $br = 1 ]; then
    if [ $dry = 1 ]; then echo "[dry-run] git -C $(q "$repo") branch -d $branch"
    else
      if [ -n "$arch$subm" ]; then   # 보관·제출했으니 병합 여부 대신 확인한 값 그대로일 때만 지운다
        x git -C "$repo" update-ref -d "refs/heads/$branch" "$btip" >&2 || stop "브랜치를 지우지 못했다(보관 뒤 값이 바뀌었나?): $branch"
      else x git -C "$repo" branch -q -d "$branch" >&2 || stop "git branch -d 실패: $branch"; fi
      did="${did:+$did, }브랜치 삭제"
    fi
  fi

  case $td in ran) tdk=통과 ;; none) tdk='없음(건너뜀)' ;; failed) tdk='실패(정리는 계속)' ;; *) tdk='돌릴 예정' ;; esac
  if [ $dry = 1 ]; then echo "[dry-run] 정리할 것: 워크트리 $wt, 브랜치 $branch (teardown: $tdk)"
  else echo "정리 끝: 워크트리 $wt, 브랜치 $branch${on:+ @$on} (teardown: $tdk)"; fi
  if [ -z "$on" ] && [ $dry = 0 ]; then
    case "$PWD/|$here/" in "$wt"/*|*"|$wt"/*) echo "알림: 지금 셸 위치는 지운 폴더 안이었다. 다음 명령 전에 cd $(q "$repo")" ;; esac
  fi
  clean_lease
  if [ $dry = 1 ]; then cj planned; else cj done; fi
}
# clean_lease: 정리가 끝난 레인의 임대 refs/hc-lanes/<레인>을 놓는다(지휘 결정 — 풀기는 land 성공·clean). 원격 없음·이미 없음은 조용히,
# 못 놓으면 알리기만(정리는 됨 — 손으로 hc-lane lease drop)
clean_lease() {
  cl_=${name:-$branch}
  case $cl_ in '' | *[!abcdefghijklmnopqrstuvwxyz0123456789_-]*) return 0 ;; esac
  [ $remote = 1 ] || return 0
  if [ $dry = 1 ]; then echo "[dry-run] 임대 refs/hc-lanes/$cl_ 가 있으면 놓음"; return 0; fi
  clo_=$(lease_x drop "$cl_") || { echo "임대 refs/hc-lanes/$cl_ 를 놓지 못했다(정리는 됨) — hc-lane lease drop${on:+ --on $on} --repo $(q "$repo") --name $cl_" >&2; return 0; }
  [ "$clo_" = no-origin ] || echo "임대 확인: refs/hc-lanes/$cl_ 없음(놓음)"
}

# gc: 끝난 레인의 작업 폴더·가지와 원격 중간 참조를 정리한다. 하나라도 맞지 않으면 「남김 <대상> <까닭>」, 지우지 않는다.
gin() {  # gin <커밋>: $bref에 다 들어갔나. 0 들어감(조상, 또는 병합 커밋 없이 커밋마다 공백까지 같은 패치가 있음), 1 아님(gn=안 들어간 커밋 수), 2 확인 못 함
  gn=0; x git -C "$repo" merge-base --is-ancestor "$1" "$bref"; case $? in 0) return 0 ;; 1) ;; *) return 2 ;; esac
  gm=$(x git -C "$repo" rev-list --merges "$bref..$1") || return 2
  # 패치 비교는 병합 커밋을 보지 않는다 — 병합이 끼면 같은 내용인지 모른다고 보고, 조상 아닌 커밋을 다 센다
  if [ -n "$gm" ]; then gn=$(x git -C "$repo" rev-list --count "$bref..$1") || gn='?'; return 1; fi
  # git cherry처럼 patch-id로 보되 --verbatim(공백까지): 공백만 다른 변경(들여쓰기 등)은 같은 내용이 아니다(2026-11-16 감사).
  # U <id> = $bref 쪽 커밋, B <id> <커밋> = 가지 쪽, C <커밋> = 가지 커밋 목록(빈 커밋은 id가 없어 안 들어감으로 센다)
  gc_=$(x sh -c 'cd "$1" || exit 2; c=$(git rev-list --no-merges "$2..$3") || exit 2
    git log -p --no-merges --no-color --no-ext-diff "$3..$2" | git patch-id --verbatim | sed "s/^/U /"
    git log -p --no-merges --no-color --no-ext-diff "$2..$3" | git patch-id --verbatim | sed "s/^/B /"
    printf "%s\n" "$c" | sed "/^$/d; s/^/C /"' hc-lane "$repo" "$bref" "$1") || return 2
  gn=$(printf '%s\n' "$gc_" | awk '$1 == "U" { u[$2] = 1 } $1 == "B" { b[$3] = $2 } $1 == "C" { c[++n] = $2 }
    END { for (i = 1; i <= n; i++) if (!(c[i] in b) || !(b[c[i]] in u)) m++; print m + 0 }')
  [ "$gn" = 0 ]
}
# jdg <대상> <커밋> <나이 기준 시각>: 들어갔고 --min-age보다 오래됐으면 0. 아니면 「남김」을 찍고 1
jdg() {
  gin "$2"; case $? in
    0) ;;
    1) keep "$1" "안 들어감 ${gn}개 · 마지막 $(x git -C "$repo" show -s --format=%cs "$2")"; return 1 ;;
    *) keep "$1" "들어갔는지 확인하지 못함"; err=1; return 1 ;;
  esac
  [ $((now - $3)) -ge "$secs" ] || { keep "$1" "새것($(((now - $3) / 3600))시간)"; return 1; }
}
kept() {  # kept <가지>: 남길 목록(설정 gc.keep_branches, 빈칸으로 나눈 glob 무늬)에 맞나
  set -f; for p_ in $kb; do case $1 in $p_) set +f; return 0 ;; esac; done; set +f; return 1
}
# rgc <접두>: 원격 <접두>* 가운데 들어갔고 커밋이 오래된 것을 ls-remote 때 값 그대로일 때만 지운다(refs/heads면 기본·남길 목록 빼고)
rgc() {
  ls=$(x git -C "$repo" ls-remote origin "${1}*") || die "gc: git ls-remote 실패: $repo"
  # ls-remote 무늬는 참조 이름 끝에도 맞으니(refs/heads/refs/integ/x) 접두로 다시 거른다
  refs=$(printf '%s\n' "$ls" | awk -F'\t' -v p="$1" 'index($2, p) == 1 && $2 !~ /\^\{\}$/')
  set --
  while IFS=$tab read -r s r; do
    [ -n "$r" ] || continue
    case $r in refs/heads/*) [ "${r#refs/heads/}" != "$base" ] && ! kept "${r#refs/heads/}" || continue ;; esac
    x git -C "$repo" cat-file -e "$s^{commit}" 2>/dev/null || set -- "$@" "$r"
  done <<EOF
$refs
EOF
  # 판정에 쓸 커밋만 받는다. --refmap=: refs/heads는 기본 refspec에 들어 이름만 줘도 origin/*를 고치므로 참조는 하나도 안 쓴다(dry-run도)
  [ $# = 0 ] || fetchr x git -C "$repo" fetch -q --no-write-fetch-head --refmap= origin "$@" || die "gc: 원격 참조 커밋을 받지 못했다"
  while IFS=$tab read -r s r; do
    [ -n "$r" ] || continue
    case $r in refs/heads/*)
      [ "${r#refs/heads/}" != "$base" ] || continue
      ! kept "${r#refs/heads/}" || { keep "$r" "남길 목록(gc.keep_branches)"; continue; } ;;
    esac
    ct=$(x git -C "$repo" show -s --format=%ct "$s") || { keep "$r" "커밋 시각을 읽지 못함"; err=1; continue; }
    jdg "$r" "$s" "$ct" || continue
    [ $dry = 0 ] || { gone_ "$r" "$s"; continue; }
    # 값이 ls-remote 때 그대로일 때만 지운다(그사이 다시 올린 참조는 남긴다). 되돌리기: git push origin <sha>:<참조>
    x git -C "$repo" push -q --force-with-lease="$r:$s" origin ":$r" >&2 || { keep "$r" "push 지우기 실패"; err=1; continue; }
    gone_ "$r" "$s"
  done <<EOF
$refs
EOF
}
keep() { echo "${P}남김 $1 $2"; kn=$((kn + 1)); }
gone_() { echo "${P}지움 $*"; dn=$((dn + 1)); }
gc_cmd() {
  dn=0 kn=0 err=0 self= tab=$(printf '\t') now=$(date +%s)
  kb=$(cfg gc.keep_branches "") || exit 1
  pairs=$(term_pairs); case $? in
    1) die "gc: hc ls 실패 — 작업 폴더를 쓰는 터미널을 확인하지 못해 아무것도 지우지 않았다" ;;
    2) die "gc: hc ls --json 출력을 읽지 못했다(형식이 바뀌었나?) — 아무것도 지우지 않았다" ;;
  esac
  if [ $remote = 0 ]; then :
  elif [ $dry = 1 ]; then echo "[dry-run] git fetch 건너뜀: 지금 있는 origin/$base 로 판정"
  else fetchr x git -C "$repo" fetch -q origin || die "gc: git fetch 실패: $repo"; fi
  x git -C "$repo" rev-parse -q --verify "$bref^{commit}" >/dev/null || die "gc: $blab 가 없다: $repo"
  cur=$(x git -C "$repo" symbolic-ref -q --short HEAD)
  wl=$(x git -C "$repo" worktree list --porcelain) || die "gc: git worktree list 실패: $repo"
  recs=$(printf '%s\n' "$wl" | awk -v OFS='\t' '
    /^worktree / { if (p != "") print p, h, b, l; p = substr($0, 10); h = "-"; b = "-"; l = "-"; next }
    /^HEAD / { h = substr($0, 6) } /^branch / { b = substr($0, 8) } /^locked/ || /^bare/ { l = "x" }
    END { if (p != "") print p, h, b, l }')
  while IFS=$tab read -r wt h b l; do
    [ -n "$wt" ] && [ "$wt" != "$repo" ] || continue
    branch=; case $b in refs/heads/*) branch=${b#refs/heads/} ;; esac
    [ "$l" = - ] || { keep "$wt" "잠긴 작업 폴더"; continue; }
    if [ -n "$branch" ] && { [ "$branch" = "$base" ] || [ "$branch" = "$cur" ]; }; then keep "$wt" "기본·현재 가지 $branch"; continue; fi
    gin "$h"; case $? in
      0) ;;
      1) keep "$wt" "$blab 에 안 들어감(${branch:-분리 HEAD} $(printf %.12s "$h"))"; continue ;;
      *) keep "$wt" "들어갔는지 확인하지 못함"; err=1; continue ;;
    esac
    x sh -c '[ -e "$1" ] || [ -L "$1" ]' hc-lane "$wt"; case $? in 0) dir=1 ;; 1) dir=0 ;; *) keep "$wt" "폴더를 확인하지 못함"; err=1; continue ;; esac
    if [ $dir = 1 ]; then
      busy=$(printf '%s\n' "$pairs" | busy_terms | cut -d' ' -f1 | tr '\n' ' ')
      [ -z "$busy" ] || { keep "$wt" "살아 있는 터미널 ${busy% }"; continue; }
      adm=$(x git -C "$wt" rev-parse --absolute-git-dir) || { keep "$wt" "git 관리 폴더를 찾지 못함"; err=1; continue; }
      # 나이는 status보다 먼저 본다(status가 index를 다시 쓰면 묵은 폴더가 새것으로 보인다). 0 오래됨, 1 새것, 그 밖 확인 못 함
      [ "$mins" = 0 ] || x sh -c 'm=$1; shift; for f; do [ -e "$f" ] || continue; o=$(find "$f" -prune -mmin -"$m") || exit 2
        [ -z "$o" ] || exit 1; done' hc-lane "$mins" "$adm/HEAD" "$adm/index" "$adm/logs/HEAD" "$wt"
      case $? in 0) ;; 1) keep "$wt" "새것(마지막 git 활동이 --min-age ${minage:-24h} 안)"; continue ;;
        *) keep "$wt" "나이를 확인하지 못함"; err=1; continue ;; esac
      # 멈춘 rebase·merge·cherry-pick·revert·bisect는 작업 폴더에만 있는 상태라 남긴다
      ip=$(x sh -c 'for s in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD BISECT_LOG; do
        [ ! -e "$1/$s" ] || echo "$s"; done' hc-lane "$adm") || { keep "$wt" "진행 상태를 확인하지 못함"; err=1; continue; }
      [ -z "$ip" ] || { keep "$wt" "진행 중 $(echo $ip)"; continue; }
      # --no-optional-locks: 판정만 하므로 index를 다시 쓰지 않는다(dry-run도 아무것도 안 바꾸게)
      st=$(x git --no-optional-locks -c core.quotePath=false -C "$wt" status --porcelain --untracked-files=all --ignore-submodules=none) ||
        { keep "$wt" "git status 실패"; err=1; continue; }
      [ -z "$st" ] || { keep "$wt" "커밋 안 된 변경·untracked $(printf '%s\n' "$st" | grep -c .)개"; continue; }
      ig=$(x git --no-optional-locks -c core.quotePath=false -C "$wt" status --porcelain --ignored --untracked-files=normal) ||
        { keep "$wt" "git status --ignored 실패"; err=1; continue; }
      # ponytail: 보관물은 .qa/ 하나(QA 증거 폴더 관례). 다른 저장소에 보관 폴더가 생기면 여기에 더한다
      qa=$(printf '%s\n' "$ig" | sed -n 's/^!! //p' | grep -E '(^|/)\.qa(/|$)' | tr '\n' ' ')
      [ -z "$qa" ] || { keep "$wt" "무시된 보관물 ${qa% } (hc-lane clean이 메인 폴더로 옮기고 정리 — 손으로 지우지 말 것)"; continue; }
    fi
    what="${branch:+가지 $branch }$(printf %.12s "$h")"
    [ $dry = 0 ] || { gone_ "$wt" "$what"; continue; }
    if [ $dir = 1 ] && x test -f "$wt/.claude/herdr-teardown.sh"; then
      hook teardown || echo "hc-lane gc: herdr-teardown.sh 실패(정리는 계속): $wt" >&2
    fi
    # 셋(들어감·깨끗함·쓰는 터미널 없음)을 다 본 뒤라 강제로 지운다: 무시 파일은 같이, rebase로 들어간 가지는 -d가 거절하므로
    x git -C "$repo" worktree remove --force "$wt" >&2 || { keep "$wt" "git worktree remove 실패"; err=1; continue; }
    if [ -n "$branch" ]; then
      if [ "$(x git -C "$repo" rev-parse -q --verify "refs/heads/$branch")" = "$h" ]; then
        x git -C "$repo" branch -q -D "$branch" >&2 || { echo "hc-lane gc: 가지 $branch 를 지우지 못했다" >&2; err=1; }
      else echo "hc-lane gc: 가지 $branch 가 그사이 움직여 남겼다" >&2; fi
    fi
    gone_ "$wt" "$what"
  done <<EOF
$recs
EOF

  # 작업 폴더 없이 남은 로컬 가지: 기본·현재 HEAD·작업 폴더에 붙은 가지는 빼고 같은 판정. 나이는 커밋과 가지 reflog 가운데 늦은 쪽
  # 멈춘 rebase의 작업 폴더는 porcelain에 분리 HEAD로 보이니 rebase-*/head-name의 가지도 붙은 가지로 센다
  att=$({ printf '%s\n' "$recs" | cut -f3; x sh -c 'c=$(git -C "$1" rev-parse --path-format=absolute --git-common-dir) || exit 0
    cat "$c"/rebase-*/head-name "$c"/worktrees/*/rebase-*/head-name 2>/dev/null; exit 0' hc-lane "$repo"; })
  bl=$(x git -C "$repo" for-each-ref --format='%(refname)%09%(objectname)%09%(committerdate:unix)' refs/heads) ||
    die "gc: git for-each-ref 실패: $repo"
  while IFS=$tab read -r r s ct; do
    [ -n "$r" ] || continue
    b=${r#refs/heads/}
    [ "$b" != "$base" ] && [ "$b" != "$cur" ] || continue
    ! printf '%s\n' "$att" | grep -Fxq -- "$r" || continue
    ! kept "$b" || { keep "가지 $b" "남길 목록(gc.keep_branches)"; continue; }
    rl=$(x git -C "$repo" reflog -1 --date=unix --format=%gd "$r" 2>/dev/null); rl=${rl##*@\{}; rl=${rl%\}}
    case $rl in ''|*[!0-9]*) ;; *) [ "$rl" -le "$ct" ] || ct=$rl ;; esac
    jdg "가지 $b" "$s" "$ct" || continue
    [ $dry = 0 ] || { gone_ "가지 $b" "$s"; continue; }
    # 판정한 값 그대로일 때만 지운다. 되돌리기: git branch <가지> <sha>
    [ "$(x git -C "$repo" rev-parse -q --verify "$r")" = "$s" ] || { keep "가지 $b" "그사이 움직임"; continue; }
    x git -C "$repo" branch -q -D -- "$b" >&2 || { keep "가지 $b" "git branch -D 실패"; err=1; continue; }
    gone_ "가지 $b" "$s"
  done <<EOF
$bl
EOF

  if { [ -n "$integ" ] || [ $rb = 1 ]; } && [ $remote = 0 ]; then echo "원격이 없어 --integ·--remote-branches 는 할 것 없음"
  else
    [ -z "$integ" ] || rgc "$integ"
    [ $rb = 0 ] || rgc refs/heads/
  fi
  echo "${P}지움 $dn · 남김 $kn"
  return $err
}

if [ $cmd = clean ] || [ $cmd = gc ]; then
  P=; [ $dry = 1 ] && P='[dry-run] '
  ${cmd}_cmd
  exit $?
fi

if [ $steps = 1 ]; then
  if [ $read = 1 ]; then read_steps; else print_steps; fi
  exit 0
fi

# 대기열만(lane-queue-only 2026-11-19 사용자 「대기열이라는 개념을 도입해서 계속 이어서」 — 11-16~19 쓰기 레인 326개 가운데 217개를
# 지휘가 직접 띄워 hc-fill 대기열이 비었다): 지휘 터미널(coord_is — 레인 주인 판정과 같은 규칙)이 쓰기 레인을 HC_LANE_FILL=1·--direct
# 없이 띄우면 아무것도 만들기 전에 거절(종료 2). 레인 안(HC_LANE)·터미널 밖·레인·감시 터미널·판정 못 함(hc get 실패)은 그대로 띄운다
if [ $read = 0 ] && [ $dry = 0 ] && [ "${HC_LANE_FILL-}" != 1 ]; then
  if [ $direct = 1 ]; then echo "hc-lane: 대기열 밖에서 띄움(--direct)" >&2
  elif [ -z "${HC_LANE-}" ] && [ -n "${HC_TERMINAL_ID-}" ] && coord_is "$HC_TERMINAL_ID"; then
    echo "hc-lane: 쓰기 레인은 hc-fill add로 대기열에 넣는다 — 자리가 나면 기계 차례대로 이어 뜬다(hc-fill add --name <레인> --project <프로젝트> --brief <지시문> [--after …] [--priority …] [--only <기계>]). 지금 꼭 이 자리에 띄워야 하면 --direct" >&2
    exit 2
  fi
fi

# 살아 있는 터미널과 이름이 겹치면 hc run이 실패하니, 아무것도 만들기 전에 막는다.
# (<t>는 ID로도 찾으니 출력의 이름까지 맞는지 본다)
live=$(hc get "${on:+$on/}$name" --json 2>/dev/null)
case $live in *"\"name\":\"$name\""*'"state":"live"'* | *'"state":"live"'*"\"name\":\"$name\""*)
  die "살아 있는 hc 터미널이 이미 이름 $name 을 쓴다(hc ls). 다른 --name 을 쓴다" ;;
esac

# 설정·{brief}도 아무것도 만들기 전에 본다
if [ -n "$swarg" ]; then swait=$swarg; case $swait in *[!0-9]*) die "--start-wait는 0 이상 정수(초): $swait" ;; esac
else
  swait=$(cfg lane.start_wait 60) || exit 1
  case $swait in ''|*[!0-9]*) die "설정 lane.start_wait는 0 이상 정수(초): $swait" ;; esac
fi
strust=$(cfg lane.auto_trust on) || exit 1
case $strust in on|off) ;; *) die "설정 lane.auto_trust는 on·off: $strust" ;; esac
fwait=$(cfg lane.first_turn_wait 60) || exit 1
case $fwait in ''|*[!0-9]*) die "설정 lane.first_turn_wait는 0 이상 정수(초): $fwait" ;; esac
fwait=$((10#$fwait))   # 08처럼 앞 0이 붙어도 십진수로(셈에서 8진수로 읽혀 깨지지 않게)
# lane.notify no: hc가 레인 종료·막힘을 지휘 입력에 넣지 않게(--no-notify). 알림은 hc-lane wait가 다 맡는다
notify=$(cfg lane.notify yes) || exit 1
case $notify in yes) nn= ;; no) nn=--no-notify ;; *) die "설정 lane.notify는 yes·no: $notify" ;; esac
# 대기열(hc-fill, HC_LANE_FILL=1)이 띄우는 레인·감사 줄은 부모 없이 — 대기열이 주인. 지휘 터미널에서 돈 hc-fill이 띄우면 hc run 기본값으로
# 그 지휘를 부모로 물려받아, 지휘 세션이 닫히면(업데이트 재시작 등) 미커밋 일을 둔 채 함께 꺼졌다(2026-11-19 idle-once 레인)
[ "${HC_LANE_FILL-}" != 1 ] || nn="${nn:+$nn }--no-parent"
poll=${HC_LANE_POLL:-2}
if [ -n "$brief" ]; then
  [ -f "$brief" ] || die "지시문 파일이 없다: $brief"
  if [ $# = 0 ]; then
    tpl=$(cfg lane.run "") || exit 1
    [ -n "$tpl" ] || die "-- 뒤 실행 명령도 설정 lane.run(실행 명령 틀)도 없다"
    eval "set -- $tpl" || die "설정 lane.run을 셸 문법으로 나누지 못했다: $tpl"   # 설정 파일은 믿는다(hc-fill launch 틀과 같다)
  fi
  bdir=$(cfg lane.brief_dir "") || exit 1
  if [ -n "$bdir" ]; then rb=${bdir%/}/$name-run.md
  else
    bd=$(cd "$(dirname -- "$brief")" && pwd -P) || die "지시문 폴더를 찾지 못했다: $brief"
    bf=${brief##*/} rb=$bd/${bf%.md}-run.md
  fi
fi
k=0; for a; do case $a in *'{brief}'*) k=1 ;; esac; done
if [ -n "$brief" ]; then [ $k = 1 ] || die "실행 명령에 {brief} 자리가 없다(지시문 사본 경로를 넣을 곳)"
else [ $k = 0 ] || die "실행 명령에 {brief} 자리가 있는데 --brief <지시문>이 없다"; fi

if [ $read = 1 ]; then
  cwd=$rdir
  wt= branch=
  # 읽기 레인도 메인 폴더를 앞당긴다(감사가 옛 CLAUDE.md·계약을 읽지 않게). fetch가 실패해도 레인은 띄운다(예전처럼)
  if [ $dry = 0 ] && [ $norepo = 0 ] && [ $remote = 1 ]; then
    if fetchr x git -C "$repo" fetch -q origin; then ffmain "$repo" "$base"
    else echo "hc-lane: 경고 — 메인 폴더 앞당김 건너뜀: git fetch 실패 — 그대로 둠 (${on:+$on:}$repo)" >&2; fi
  fi
else
  cwd=$wt
  [ $dry = 1 ] || [ $remote = 0 ] || fetchr x git -C "$repo" fetch -q origin || die "git fetch 실패: $repo"
  again="다른 이름은 --branch <이름>"
  x git -C "$repo" show-ref --verify -q "refs/heads/$branch" && die "로컬 브랜치 $branch 가 이미 있다. $again"
  [ $remote = 1 ] && x git -C "$repo" show-ref --verify -q "refs/remotes/origin/$branch" && die "원격 브랜치 origin/$branch 가 이미 있다. $again"
  x test -e "$wt" && die "워크트리 폴더가 이미 있다: $wt. $again"
  x git -C "$repo" rev-parse -q --verify "$bref^{commit}" >/dev/null || die "$blab 가 없다: $repo"
  [ $dry = 1 ] || [ $remote = 0 ] || ffmain "$repo" "$base"
fi

# --brief: 지시문(+착지·정리 절차)을 대상 기계 사본 자리에 두고, 실행 명령의 {brief}를 그 경로로(~는 그 기계 집으로 펼친 것)
if [ -n "$brief" ]; then
  if [ $dry = 1 ]; then
    echo "[dry-run] 지시문 사본 ${on:+$on:}$rb ← $brief + $([ $read = 1 ] && echo '판정 알림' || echo '착지·정리 절차')"
  else
    got=$({ cat "$brief"; echo; if [ $read = 1 ]; then read_steps; else print_steps; fi; } | xi sh -c 'f=$1
      case $f in "~"/*) f=$HOME/${f#"~/"} ;; esac
      mkdir -p "${f%/*}" && cat >"$f" && printf %s "$f"' hc-lane "$rb") && [ -n "$got" ] ||
      die "지시문 사본을 ${on:+$on 의 }$rb 에 두지 못했다${on:+ (그 기계에 그 경로를 쓸 수 없으면 설정 lane.brief_dir)}"
    rb=$got
  fi
  n=$#
  for a; do   # 패턴 제거로 나눠 붙인다(${a//…/…}는 bash 5.2에서 & 를, 3.2에서 따옴표를 다르게 읽는다)
    r=
    while case $a in *'{brief}'*) true ;; *) false ;; esac; do r=$r${a%%"{brief}"*}$rb a=${a#*"{brief}"}; done
    set -- "$@" "$r$a"
  done
  shift $n
fi
if [ $read = 1 ]; then set -- env "HC_LANE=$name" "LANE_REPO=$repo" "LANE_BASE=$base" "$@"
else set -- env "HC_LANE=$name" "LANE_REPO=$repo" "LANE_WORKTREE=$wt" "LANE_BRANCH=$branch" "LANE_BASE=$base" "$@"; fi
# 레인 안에서도 주인 지휘를 알게. 값은 hc-lane을 부른 기계(지휘 기계)의 주소라 원격 레인에서 hc send 하려면 <지휘 기계>/<주소>.
# 레인이 이 환경에서 hc-lane으로 띄운 하위 레인(감사 등)도 물려받아 같은 지휘가 주인이 된다
[ -z "${HC_LANE_OWNER-}" ] || set -- env "HC_LANE_OWNER=$HC_LANE_OWNER" "${@:2}"
# 착지 줄 우선(hc-fill이 넣음 — 이 레인을 --after로 기다리는 대기 줄 수): 레인의 hc-lane land가 herdr-land.sh에 넘긴다
[ -z "${HERDR_LAND_PRIORITY-}" ] || set -- env "HERDR_LAND_PRIORITY=$HERDR_LAND_PRIORITY" "${@:2}"

# start_check <주소>: 띄운 직후 Claude 폴더 신뢰 질문을 넘기고 hc get status가 잡히는지 본다.
# start=ok|no_status|login|keychain, 종료 0·5·6·7. 실패여도 터미널은 남긴다(사람이 로그인하면 이어질 수 있다 — hc-fill 「상태 안 잡힘」과 같다).
# 신뢰 질문 글자는 2026-11-16 Claude 2.1 실측: 「❯ No, exit」(기본) 「  Yes, I trust this folder」, 그동안 status는 null.
start_check() {
  end=$(($(date +%s) + swait)) tr= why= im= ik=0 last=
  while :; do
    g=$(hc get "$1" --json 2>/dev/null) || g=
    if printf %s "$g" | grep -Eq '"status" *: *\{'; then
      start=ok
      [ "$fwait" != 0 ] && command -v jq >/dev/null 2>&1 || return 0
      if [ "${HC_LANE_FILL-}" = 1 ]; then
        # hc-fill은 두 출력을 함께 받는다. 감시가 그 파이프를 쥐면 다음 기계 배치 판단이 늦어진다.
        { turn_check "$1" </dev/null >&3 2>&1 3>&- & } 3>>"$evdir/watch.log" ||
          { turn_check "$1" </dev/null >/dev/null 2>&1 & }
      else
        turn_check "$1"
      fi
      return 0
    fi
    if printf %s "$g" | grep -Eq '"state" *: *"finished"'; then why="터미널이 끝났다"; break; fi
    scr=$(hc read "$1" 2>/dev/null)
    case $scr in *'Allow external CLAUDE.md file imports?'*)
      [ "$ik" -ge 3 ] || imports_q "$1" || { why="외부 가져오기 질문에 작업 폴더 저장소 밖 경로가 있다"; break; } ;;
    esac
    if [ -z "$tr" ]; then
      case $scr in *'Accessing workspace'*|*'trust this folder'*|*'Do you trust'*|*'one you trust?'*)
        if [ $strust = off ]; then tr=off
        elif printf '%s\n' "$scr" | grep -Fq 'Is this a project you created or one you trust?' &&
          printf '%s\n' "$scr" | grep -Eq '^ *(❯ | +)No, exit *$' && printf '%s\n' "$scr" | grep -Eq '^ *(❯ | +)Yes, I trust this folder *$'; then
          # 커서(❯)가 「No, exit」(기본)이면 아래로 한 칸, 이미 신뢰에 있으면 엔터만
          # 커서가 어느 줄에도 안 보이면(글리프가 다름 등) 「모름」: 엔터가 「No, exit」에 갈 수 있다
          if printf '%s\n' "$scr" | grep -Eq '^ *❯ No, exit *$'; then set -- "$1" down enter
          elif printf '%s\n' "$scr" | grep -Eq '^ *❯ Yes, I trust this folder *$'; then set -- "$1" enter
          else set -- "$1"; fi
          if [ $# = 1 ]; then tr=unknown; echo "hc-lane: 모름 — 시작 화면 확인($1): 신뢰 질문에 커서(❯)가 안 보여 건드리지 않았다" >&2
          elif hc keys "$@" >/dev/null; then tr=passed; echo "hc-lane: 신뢰 질문 넘김($1)"
          else tr=unknown; echo "hc-lane: 모름 — 시작 화면 확인($1): 신뢰 질문 키를 보내지 못했다" >&2; fi
        else tr=unknown; echo "hc-lane: 모름 — 시작 화면 확인($1): 신뢰 질문 같은데 글자가 달라 건드리지 않았다(hc read $1)" >&2
        fi ;;
      esac
    fi
    # 마감이 지나도 한 번은 더 본다: 이 바퀴에 키를 보냈으면 status는 다음 hc get에야 잡힌다
    # (2026-11-19 부하로 한 바퀴가 start_wait를 넘어 신뢰·가져오기 질문을 넘기고도 종료 5가 났다)
    if [ "$(date +%s)" -ge "$end" ]; then [ -z "$last" ] || break; last=1; fi
    sleep "$poll"
  done
  [ -n "$why" ] || why="${swait}초 안에 hc get status가 안 잡혔다"
  case $tr in unknown) why="$why, 신뢰 질문 모름" ;; off) why="$why, 신뢰 질문(lane.auto_trust off)" ;; esac
  case $im in unknown) why="$why, 외부 가져오기 질문 모름" ;; off) why="$why, 외부 가져오기 질문(lane.auto_trust off)" ;; esac
  scr=$(hc read "$1" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -n 15)
  if hit=$(printf '%s\n' "$scr" | grep -iE -m 1 'keychain|errSec'); then start=keychain rc=7 k=키체인
  elif hit=$(printf '%s\n' "$scr" | grep -iE -m 1 'login expired|/login|not logged in|log ?in again|invalid api key|oauth token|authentication_error|unauthorized|(^|[^0-9])401([^0-9]|$)'); then
    start=login rc=6 k=로그인·인증
  else start=no_status rc=5 k= hit=; fi
  hit=$(printf %s "$hit" | sed 's/^[[:space:]]*//' | cut -c 1-160)
  echo "hc-lane: 시작 안 됨 $1: $why${k:+ — 막힘($k): $hit}. 터미널은 남겼다(hc read $1). 다른 기계로 옮기려면 이 레인 작업 폴더를 정리하고 다시 띄운다" >&2
  return $rc
}

# turn_check <주소>: 첫 턴 감시(알림 전용, launch-submit-check 2026-11-20). g는 방금 읽은 hc get, lo_는 레인 주인 지휘. start=ok|noturn, 늘 종료 0.
# 첫 지시는 입력칸이 아니라 실행 인자로 넘긴다(hc-fill launch 틀의 {task}, --brief의 {brief}, 직접 띄울 때 위치 인자)라 입력칸에 남을 길이 없다.
# 그래도 2026-11-19 원격 자동 감사에서 Claude가 인자 첫 지시를 244초 제출하지 않고 idle로 멈춘 드문 경합이 있어, lane.first_turn_wait초 안에
# turn > 0 또는 status working(실측: 첫 턴 동안 working·turn 0, 턴이 끝나야 turn 1)을 한 번도 못 보면 사건 막힘 「첫 턴 없음 <주소>」 한 줄만 남긴다.
# 키는 보내지 않고 화면도 읽지 않는다. 조회 실패·빈 값은 다음 조회로(마감까지). 놓치거나 늦게 알려도 띄우기 결과에는 영향이 없다.
# lane.first_turn_wait 0·jq 없음이면 보지 않는다.
turn_check() {
  cap=$(($(date +%s) + fwait))
  while :; do
    if printf %s "$g" | jq -e '(.turn | type == "number" and . > 0) or (.status | type == "object" and .state == "working")' >/dev/null 2>&1; then
      start=ok; return 0
    fi
    r_=$((cap - $(date +%s))); [ "$r_" -gt 0 ] || break
    sleep "$(awk -v p="$poll" -v r="$r_" 'BEGIN { print (p < r ? p : r) }')"
    r_=$((cap - $(date +%s))); [ "$r_" -gt 0 ] || break
    g=$(capt "$r_" hc get "$1" --json 2>/dev/null) || g=
    [ "$(date +%s)" -le "$cap" ] || break
  done
  start=noturn
  local event_error=
  lane_event 막힘 "첫 턴 없음 $1${on:+ @$on}" || event_error=" 막힘 사건을 적지 못했다."
  echo "hc-lane: 첫 턴 없음 $1${on:+ @$on}: ${fwait}초 안에 turn > 0·working이 없었다.${event_error} 키는 보내지 않았다(화면은 hc read $1)" >&2
  return 0
}
# lane_event <상태> <한 줄>: 띄운 레인 이름으로 이 기계 사건 기록에 한 줄(터미널 칸 -). 주인 지휘가 있으면 --to로 그 지휘 watch만. 실패면 1
lane_event() {
  to_=; [ "${lo_:--}" = - ] || to_=$lo_
  env -u HC_TERMINAL_ID -u HC_LANE "$(cd "$(dirname "$0")" && pwd -P)/${0##*/}" report "$1" - "$2" --name "$name" ${to_:+--to "$to_"} >/dev/null 2>&1 </dev/null
}

# imports_q <주소>: 「Allow external CLAUDE.md file imports?」(CLAUDE.md의 @가져오기가 작업 폴더 밖 — 2026-11-17 .qa/… 폴더에서
# 띄운 레인이 저장소 루트 AGENTS.md 가져오기 질문에서 10분 멈춤). 화면 글자는 Claude 2.1.326 실측: 「External imports:」 아래
# 줄마다 「  <경로>」(~ 줄임·긴 경로는 가운데 … 생략), 넘치면 「… +N imports not shown.」, 고르기는 「❯ No, disable external
# imports」(기본)·「  Yes, allow external imports」. 경로가 모두 작업 폴더의 git 저장소(rev-parse --show-toplevel) 안일 때만
# 그 터미널에 허용을 고른다. 밖·읽을 수 없는 줄(…·생략)이 하나라도 있으면 안 고르고 1(호출자가 종료 5).
# 질문이 남아 있으면 바퀴마다 커서를 다시 보고 3번까지 보낸다(열린 직후 입력은 Claude가 버린다). im=passed|off|unknown
imports_q() {
  [ $strust = on ] || { im=off; return 0; }
  [ "$im" != unknown ] || return 0
  if [ -z "${itop+x}" ]; then
    itop=$(x git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)
    if [ -n "$on" ]; then ihome=$(x sh -c 'printf %s "$HOME"'); else ihome=$HOME; fi
  fi
  bad=
  ps_=$(printf '%s\n' "$scr" | awk '/External imports:/ { f = 1; next }
    f && (/^[[:space:]]*$/ || /Important:/ || /(Yes, allow|No, disable) external imports/) { exit }
    f { sub(/^[[:space:]]+/, ""); sub(/[[:space:]]+$/, ""); print }')
  [ -n "$ps_" ] || bad="(목록을 읽지 못함)"
  while IFS= read -r p_; do
    [ -n "$p_" ] || continue
    case $p_ in "~") p_=$ihome ;; "~/"*) p_=$ihome/${p_#"~/"} ;; esac
    case $p_ in *…*|*/../*|*/..|*/./*) ok_=0 ;; "$itop"|"$itop"/*) ok_=1 ;; *) ok_=0 ;; esac
    [ -n "$itop" ] && [ $ok_ = 1 ] || bad="${bad:+$bad, }$p_"
  done <<EOF
$ps_
EOF
  if [ -n "$bad" ]; then echo "hc-lane: 모름 — 외부 가져오기 질문($bad): 작업 폴더 저장소(${itop:-저장소 아님}) 밖이라 고르지 않았다($1)" >&2; return 1; fi
  if printf '%s\n' "$scr" | grep -Eq '^ *❯ ([0-9]+\. )?Yes, allow external imports *$'; then set -- "$1" enter
  elif printf '%s\n' "$scr" | grep -Eq '^ *❯ ([0-9]+\. )?No, disable external imports *$'; then
    yl=$(printf '%s\n' "$scr" | grep -nE '^ *( +)([0-9]+\. )?Yes, allow external imports *$' | head -n 1 | cut -d: -f1)
    nl=$(printf '%s\n' "$scr" | grep -nE '^ *❯ ([0-9]+\. )?No, disable external imports *$' | head -n 1 | cut -d: -f1)
    if [ -z "$yl" ]; then set -- "$1"
    elif [ "$yl" -gt "$nl" ]; then set -- "$1" down enter
    else set -- "$1" up enter; fi
  else set -- "$1"; fi
  if [ $# = 1 ]; then im=unknown; echo "hc-lane: 모름 — 외부 가져오기 질문($1): 고르기 줄·커서(❯)가 안 보여 건드리지 않았다" >&2
  elif hc keys "$@" >/dev/null; then im=passed ik=$((ik + 1)); echo "hc-lane: 외부 가져오기 허용($1, 저장소 $itop 안)"
  else im=unknown; echo "hc-lane: 모름 — 외부 가져오기 질문($1): 키를 보내지 못했다" >&2; fi
  return 0
}

# auto_watch: 레인·감사를 띄운 지휘(HC_LANE_COORD — hc-fill이 설정 coord로 넘김 —, 없으면 $HC_TERMINAL_ID, 둘 다 없으면 건너뜀)에게 도는 watch가 없으면 이 기계에 하나 띄운다
# (lane-push 2026-11-16 사용자 「감시를 걸지 않은 이런 문제 없도록 코드적으로」 — 지휘가 손으로 감시를 걸거나 다시 걸 일이 없게).
# watch는 지휘 터미널을 parent로(지휘가 끝나면 같이 끝남), --no-notify, 라벨 hc-lane-watch=1(hc-lane=1이 아니라 레인으로 안 셈).
# 원격 레인 사건도 보게 --all. 레인은 이미 떴으니 실패해도 한 줄 알리고 계속한다
auto_watch() {
  co=${HC_LANE_COORD:-${HC_TERMINAL_ID-}}
  [ -n "$co" ] || return 0
  coord_check "$co" || { echo "hc-lane: 지휘 없음 — $cwhy. 감시(watch)를 띄우지 않음(사건은 events에 남는다)" >&2; return 0; }
  wk=$(printf %s "$co" | tr -c 'A-Za-z0-9_-' _)
  wn=lane-watch-$(printf %s "$wk" | tr 'A-Z' 'a-z' | cut -c 1-21)
  ! watch_alive "$evdir/watch.$wk" || return 0
  self=$(cd "$(dirname "$0")" && pwd -P)/${0##*/}
  if [ $dry = 1 ]; then echo "[dry-run] hc run --bg --no-notify --rm --name $wn --label hc-lane-watch=1 --cwd $(q "$HOME") $(q "$self") watch --all --to $co"; return 0; fi
  if hc run --bg --json --no-notify --rm --name "$wn" --label hc-lane-watch=1 --cwd "$HOME" "$self" watch --all --to "$co" >/dev/null 2>&1 </dev/null
  then echo "hc-lane: 감시 $wn 띄움(지휘 $co 에게 레인 사건을 hc send로 밀어 줌)"
  else echo "hc-lane: 감시 $wn 를 띄우지 못했다(이미 그 이름이 살아 있으면 괜찮다) — 지휘는 hc-lane wait --all로 볼 것" >&2; fi
}

# rollback: 띄우기 전에 실패하면(setup·hc run) 방금 만든 워크트리·브랜치를 지운다 — 고유 커밋이 없을 때만.
# 남기면 다음 시도가 「로컬 브랜치가 이미 있다」로 영영 막힌다(2026-11-17 hc-fill travel-c0). 출력은 die에 붙일 한 줄
rollback() {
  k=$(x git -C "$repo" rev-list --count "$bref..refs/heads/$branch" 2>/dev/null) || k=?
  if [ "$k" = 0 ] && x git -C "$repo" worktree remove --force "$wt" >/dev/null 2>&1; then
    if x git -C "$repo" branch -q -d "$branch" >/dev/null 2>&1; then
      echo "방금 만든 워크트리 ${wt}·브랜치 ${branch} 는 지웠다(고유 커밋 없음). 원인을 고친 뒤 같은 명령을 다시 돌린다"
    else   # 워크트리는 이미 없으니 안내는 브랜치 지우기만(감사 [낮음] 2)
      echo "방금 만든 워크트리 ${wt} 는 지웠고 브랜치 ${branch} 는 못 지웠다. 지우려면: ${rx}git -C $(q "$repo") branch -d $branch"
    fi
  else
    echo "워크트리 $wt${on:+ (기계 $on)} 는 남겨 둠(고유 커밋 ${k}개 또는 지우기 실패)${log:+, 기록 $log}. 지우려면: $undo"
  fi
}

# 다른 기계 레인은 맥 Herdr 창의 그 기계 공간(이름 = 기계 이름, 기계마다 하나)에 탭으로 보이게 hc run --label herdr.space=<id>.
# <id>는 그 기계 쪽 공간 id(창이 보이는 「<기계>/」 접두를 뗀 것 — 붙이면 모르는 id라 새 공간이 생긴다, 2026-11-17 low-sg 공간).
# 창에 그 기계의 「<기계>」 공간이 있으면 그 id, 없으면 고정 id lanes(창이 처음 보면 공간을 만든다 — 같은 기계 다음 레인도 같은 곳).
# 창(herdr-app)이나 jq가 없으면 lanes로 붙이고 띄운 뒤 이름은 못 붙인다(알림 한 줄). 로컬 레인은 hc-fill의 herdr-balance(지휘 옆 분할)
hsp=
if [ -n "$on" ]; then
  hsp=lanes
  sp_=$(herdr-app ls 2>/dev/null | jq -r --arg m "$on" '[.spaces[]? | select(.machine == $m and .name == $m) | .id][0] // empty' 2>/dev/null)
  [ -z "$sp_" ] || hsp=${sp_#"$on/"}
fi
# show_remote: 띄운 뒤 그 공간이 이름 없이 생겼으면 기계 이름을 붙인다. 창이 터미널을 보는 데 몇 초 걸려 HC_LANE_POLL초씩 5번까지
show_remote() {
  [ -n "$hsp" ] && [ -n "$addr" ] || return 0
  i=0
  while :; do
    ls_=$(herdr-app ls 2>/dev/null) || { echo "hc-lane: Herdr 창이 없어 $on 공간 이름은 못 붙였다(창을 열면 $addr 가 보인다)" >&2; return 0; }
    # 공간이 있으면 「=<이름>」. herdr-app ls에는 named 칸이 없어(2026-11-17 실측) 이름이 기계 이름과 다르면 붙인다
    st_=$(printf %s "$ls_" | jq -r --arg id "$on/$hsp" '[.spaces[]? | select(.id == $id) | "=" + (.name // "")][0] // empty' 2>/dev/null)
    case $st_ in
      "=$on") return 0 ;;
      =*) herdr-app do space.rename --id "$on/$hsp" --name "$on" >/dev/null 2>&1 && return 0
          echo "hc-lane: Herdr 창의 $on 공간 이름을 붙이지 못했다(herdr-app do space.rename --id $on/$hsp --name $on)" >&2; return 0 ;;
    esac
    i=$((i + 1)); [ $i -lt 5 ] || { echo "hc-lane: Herdr 창에 $addr 공간($on/$hsp)이 아직 안 보인다 — 창을 확인" >&2; return 0; }
    sleep "$poll"
  done
}

start= rc=0 log=
if [ $dry = 1 ]; then
  if [ $norepo = 0 ] && [ $remote = 1 ]; then
    echo "[dry-run] git -C $(q "$repo") fetch -q origin"
    echo "[dry-run] 메인 폴더 앞당김(기본 브랜치 ${base}·추적 변경 없음·merge/rebase 없을 때만): git -C $(q "$repo") merge --ff-only $bref"
  fi
  if [ $read = 0 ]; then
    echo "[dry-run] git -C $(q "$repo") worktree add --track -b $branch $(q "$wt") $bref"
    echo "[dry-run] ($blab 에 .claude/herdr-setup.sh 가 있으면) 워크트리에서 bash .claude/herdr-setup.sh"
    echo "[dry-run] 임대 잡기 refs/hc-lanes/$name (없을 때만 — 이미 있으면 종료 10, 원격 없음이면 임대 없이)"
  fi
  printf '[dry-run] hc run --bg --json%s --name %s --label hc-lane=1%s --cwd %s%s' "${nn:+ $nn}" "$name" "${hsp:+ --label herdr.space=$hsp}" "$(q "$cwd")" "${on:+ --on $on}"
  for a in "$@"; do printf ' %s' "$(q "$a")"; done
  echo
  if [ $read = 1 ]; then read_steps; else print_steps; fi
  auto_watch
  addr=
else
  if [ $read = 0 ]; then
    # --track: branch.autoSetupMerge 설정과 무관하게 upstream을 붙여 착지 뒤 branch -d가 통한다.
    x git -C "$repo" worktree add -q --track -b "$branch" "$wt" "$bref" || die "워크트리를 만들지 못했다: $wt"
    # rerere(2026-11-19 lane-overlap-guard): 정하지 않은 저장소면 켠다 — 착지를 다시 설 때 같은 충돌을 다시 풀지 않게(land가 이어 감).
    # 정해 둔 값(사용자가 끈 false 포함, 전역·조건부 includeIf onbranch도)은 그대로 — 값은 새 작업 트리(레인 가지)에서 본 유효 값.
    # git config --get이 1(없음)일 때만 쓴다. 다른 실패(설정 파일 깨짐 등)면 쓰지 않는다
    x sh -c 'for k in rerere.enabled rerere.autoUpdate; do git -C "$2" config --get "$k" >/dev/null; r=$?; [ $r != 1 ] || git -C "$1" config "$k" true || exit 1; [ $r -le 1 ] || exit 1; done' _ "$repo" "$wt" ||
      echo "hc-lane: rerere 설정을 쓰지 못했다(착지는 그대로 된다): $repo" >&2
    if x test -f "$wt/.claude/herdr-setup.sh"; then
      if ! hook setup; then
        x tail -n 20 "$log" >&2
        die "herdr-setup.sh 실패, 레인을 띄우지 않았다. $(rollback)"
      fi
    fi
  fi
  # 레인 임대(2026-11-20 fill-dup-guard, 지휘 결정 — 중복 실행 막기는 띄우는 쪽에서): 쓰기 레인은 hc run 직전에 프로젝트 원격
  # refs/hc-lanes/<레인>을 없을 때만 만든다(원격이 원자적으로 판정). 이미 있으면 「이미 돎」 종료 10, 조회·push 실패도 안 띄움(모르면 안
  # 띄움, 종료 1). origin 없음이 확인된 저장소만 임대 없이. 풀기는 land 성공(main과 같은 원자 push)·clean, 그 밖은 손으로 hc-lane lease drop
  lsha=
  if [ $read = 0 ]; then
    lo_=$(lease_x take "$name" "${on:-$(hostname -s 2>/dev/null || echo -)}"); lr_=$?
    case $lr_ in
      0) lsha=$lo_ ;;
      4) [ "$lo_" = no-origin ] || { echo "hc-lane: 임대를 잡지 못했다(종료 4, 원격 없음 확인 못 함 — 기계 조회 실패일 수 있다). 레인을 띄우지 않았다. $(rollback)" >&2; exit 1; } ;;
      3) echo "hc-lane: 이미 돎 — refs/hc-lanes/$name 를 다른 실행이 쥐고 있다($lo_). 레인을 띄우지 않았다(그 실행이 끝났으면 hc-lane lease drop${on:+ --on $on} --repo $(q "$repo") --name $name). $(rollback)" >&2; exit 10 ;;
      *) echo "hc-lane: 임대를 잡지 못했다(git ls-remote·push origin 실패, 종료 $lr_). 레인을 띄우지 않았다 — 원격이 닿으면 다시. $(rollback)" >&2; exit 1 ;;
    esac
    set -- env "HC_LANE_LEASE=$lsha" "${@:2}"   # 레인의 land가 이 값으로 임대를 지운다(main과 같은 원자 push)
  fi
  out=$(hc run --bg --json $nn --name "$name" --label hc-lane=1 ${hsp:+--label "herdr.space=$hsp"} --cwd "$cwd" ${on:+--on "$on"} "$@") ||
    die "hc run 실패, 레인을 띄우지 않았다.${wt:+ $(rollback)}${lsha:+ 임대 refs/hc-lanes/$name 은 남겨 둠(떴는지 모름 — 끝났으면 hc-lane lease drop${on:+ --on $on} --repo $(q "$repo") --name $name)}"
  addr=$(printf %s "$out" | sed -n 's/.*"address":"\([^"]*\)".*/\1/p' | head -n 1)
  [ -n "$addr" ] || printf 'hc-lane: hc run 출력에서 주소를 읽지 못했다(hc ls --json 으로 확인): %s\n' "$out" >&2
  # 레인 기록: 이 레인의 지휘. HC_LANE_OWNER(hc-fill이 대기열에 넣은 지휘를 넘김)가 앞, 아니면 지휘 터미널에서 띄웠을 때 그 지휘.
  # 모르면(주인 없는 hc-fill 줄·터미널 밖·레인이 띄운 레인) - — 그 사건은 모든 지휘 watch가 보낸다(wfilter)
  lo_=-
  if [ -n "${HC_LANE_OWNER-}" ]; then lo_=$HC_LANE_OWNER
  elif [ -z "${HC_LANE_COORD-}" ] && [ -n "${HC_TERMINAL_ID-}" ] && coord_set "$HC_TERMINAL_ID" launch; then lo_=$HC_TERMINAL_ID; fi
  # 넷째 칸 종류: read(--read)·fill(hc-fill이 HC_LANE_FILL=1로 띄움 — HC_LANE_COORD는 물려받을 수 있어 표시로 안 씀, 재감사 [낮음] 4). 이 둘은 「완료」가 마지막 보고다(wait의 끝남 판정). 구현 레인은 3칸
  # direct: --direct로 대기열 밖에서 직접 띄운 쓰기 레인(직접 띄운 비율을 셀 수 있게). 읽는 쪽(lkinds)은 read·fill만 보니 구현 레인과 같다
  lk_=; if [ $read = 1 ]; then lk_=read; elif [ "${HC_LANE_FILL-}" = 1 ]; then lk_=fill; elif [ $direct = 1 ]; then lk_=direct; fi
  [ -z "$addr" ] || { mkdir -p "$evdir" && printf '%s\t%s\t%s%s\n' "$addr" "$name" "$lo_" "${lk_:+$tab$lk_}" >>"$evdir/lanes.tsv"; } ||
    echo "hc-lane: 레인 기록을 쓰지 못했다: $evdir/lanes.tsv" >&2
  auto_watch
  show_remote
  if [ $read = 1 ]; then read_steps; else print_steps; fi
  if [ "$swait" = 0 ]; then start=off
  elif [ -n "$addr" ]; then start_check "$addr"; rc=$?; fi
fi

pre=; [ $dry = 1 ] && pre='[dry-run] 띄울 '
if [ $read = 1 ]; then
  echo "${pre}레인 $name${addr:+($addr)}${on:+ @$on}: 읽기 전용, 폴더 $cwd 에서 실행"
else
  echo "${pre}레인 $name${addr:+($addr)}${on:+ @$on}: 워크트리 $wt, 브랜치 $branch, 기준 $blab"
fi
printf '{"lane":"%s","name":"%s","on":"%s","read":%s,"dry_run":%s,"repo":"%s","worktree":"%s","branch":"%s","base":"%s","brief":"%s","start":"%s"}\n' \
  "$(j "$addr")" "$name" "$(j "$on")" "$([ $read = 1 ] && echo true || echo false)" "$([ $dry = 1 ] && echo true || echo false)" \
  "$(j "$repo")" "$(j "$wt")" "$(j "$branch")" "$(j "$base")" "$(j "${rb-}")" "$start"
exit $rc
