#!/bin/bash
# hc-fill: 기다리는 레인을 차례대로, 선행이 풀린 것부터 빈 자리가 남는 첫 기계에 hc-lane으로 띄운다.
# 기계 차례·상한·저장소 경로·실행 명령 틀·지휘 주소는 모두 설정 파일(${HERDR_TOOLS_CONFIG:-~/.config/herdr-tools}/hc-fill.tsv,
# 예시는 저장소 config.example/hc-fill.tsv)에서 읽는다. 코드에는 기계·계정·경로 같은 개인 값을 두지 않는다.
# 의존: hc·hc-lane·git·jq·lockf(macOS). 맥 /bin/bash 3.2에서 돈다. 아무것도 지우거나 끄지 않는다
# (감사 터미널도 — 차수가 끝나면 정리할 주소를 지휘에 한 번 알린다).
set -u
shopt -u patsub_replacement 2>/dev/null   # bash 5.2+: ${x//a/b}의 b 안 & 를 글자 그대로
# 문자열 비교는 바이트로: macOS awk의 ==는 strcoll이라 en_US.UTF-8에서 "판정"=="완료"가 참(2026-11-19 fill-then 작업 중 발견)
[ -z "${LC_ALL-}" ] || export LC_CTYPE=$LC_ALL; unset LC_ALL; export LC_COLLATE=C

CONF=${HERDR_TOOLS_CONFIG:-$HOME/.config/herdr-tools}/hc-fill.tsv
DATA=${HC_FILL_DATA:-$HOME/.local/share/hc-fill}
Q=$DATA/queue.tsv   # 이름 프로젝트 지시문 선행 기계제한 상태(wait|up|sent) 기계 주소 남긴것(기계=주소,…) 더한시각 되돌릴곳 주인 — 빈 칸은 -
                    # 되돌릴곳: 받은편지에서 온 레인의 결과를 쓸 <기계>:<경로>. 손으로 넣은 줄·10칸 옛 줄은 -
                    # 주인: 넣은 지휘 주소(add의 $HC_TERMINAL_ID·--coord). 레인 사건은 그 지휘에게만. 받은편지 줄·11칸 옛 줄은 -(모든 지휘에)
                    # 우선: urgent|high|normal|low(add --priority, 기본 normal. 받은편지는 기본 high). 12칸까지의 옛 줄은 normal
                    # 먼저: -(먼저 띄움 가능) · no-early(add --no-early) · early(먼저 띄움으로 띄웠다). 13칸까지의 옛 줄은 -
                    # 감사: -(정하지 않음) · no-audit(add --no-audit) · auto(감사·착지 절을 붙여 띄웠다 — 자동 감사 대상) ·
                    #       audit=<레인>(그 레인의 자동 감사 줄). 14칸까지의 옛 줄은 -
                    # 겹침: -(겹침을 봄) · overlap-ok(add --overlap-ok — 이 줄은 겹침을 안 봄) · solo(add --solo — 단독). 15칸까지의 옛 줄은 -
WAIT=${HC_FILL_WAIT:-60} POLL=${HC_FILL_POLL:-5}

# 함수는 기능별 파일 lib/hc-fill/*.sh에 있다(2026-11-20 herdr-tools-split — 여러 레인이 한 파일을 고쳐 부딪혀서).
# 깔린 곳은 이 파일 옆 ../lib/hc-fill(~/.local/lib/hc-fill). 링크로 불려도 링크가 가리키는 실제 파일 옆을 본다
hf_s=$0
while [ -L "$hf_s" ]; do hf_l=$(readlink "$hf_s"); case $hf_l in /*) hf_s=$hf_l ;; *) hf_s=$(dirname "$hf_s")/$hf_l ;; esac; done
hf_d=$(dirname "$hf_s")/../lib/hc-fill
for hf_f in common tick audit launch overlap; do
  . "$hf_d/$hf_f.sh" || { printf 'hc-fill: 함수 파일을 못 읽었다: %s (herdr-sync가 lib도 까는지)\n' "$hf_d/$hf_f.sh" >&2; exit 1; }
done

[ -f "$CONF" ] || die "설정 파일이 없다: $CONF (저장소 config.example/hc-fill.tsv를 복사해 값을 고친다)"
# 한 값 키: 키 혼자면 빈 값, 같은 키가 두 줄이면 멈춘다
dup=$(awk '$1 ~ /^(local|agent|coord|task|launch|gc|early|early_wait|idle|hold|audit|audit_max|audit_final|wake_every|ack_max|overlap)$/ { if (c[$1]++ == 1) print $1 }' "$CONF")
[ -z "$dup" ] || die "설정에 $(echo $dup) 줄이 두 번 있다: $CONF"
LOCAL=$(conf local) AGENT=$(conf agent)
AGENT=${AGENT:-claude-code}
[ -n "$LOCAL" ] || die "설정에 local 줄이 없다: $CONF"

LED=$DATA/inbox.tsv
cmd=${1-}; [ $# = 0 ] || shift
case $cmd in
  _set) qset "$@"; exit ;;
  _then)   # _then <이름> <선행> <프로젝트> <지시문>: add --then이 run.lock·qlock 둘 다 쥐고 부른다
    # run은 지시문을 잠금 밖(launch의 cat)에서 읽고 hc-lane 띄우기·status 확인 뒤에야 up으로 바꾼다 — qlock만으로는 그 사이에
    # 붙인 절이 레인에 안 들어가고 사라진다. 그래서 run.lock(run 한 바퀴 내내)도 쥔다
    tl=$1 pre=$2
    row=$(awk -F'\t' -v n="$pre" '($1 "")==n {print; exit}' "$Q" 2>/dev/null)
    if [ -z "$row" ]; then
      x=$(thenof "$pre"); [ -z "$x" ] || refuse "${pre}은 ${x}에 이어 붙였다 — --then $x"
      refuse "선행이 대기열에 없다: $pre"
    fi
    IFS=$'\t' read -r _ pp pb _ _ ps _ _ pst _ pr _ _ _ pk _ <<<"$row"
    [ "$ps" = wait ] || refuse "$pre: 이미 떴다($ps) — --after ${pre}으로 넣거나 그 레인에 hc send"
    # 상태 안 잡힘으로 남긴 터미널은 옛 run 지시문으로 돌 수 있다(살아나면 run은 다시 띄우지 않음 — 감사 [낮음] 1)
    [ "${pst:--}" = - ] || refuse "$pre: 상태 안 잡힘으로 남긴 터미널이 있다($pst) — 정리하고 rm 뒤 다시 add, 또는 --after $pre"
    # 사본 기능(add 때 복사) 전에 넣은 옛 줄은 원본을 가리킨다 — 원본은 고치지 않는다(감사 [낮음] 2)
    case $pb in "$DATA"/briefs/added/*) ;; *) refuse "$pre: 지시문이 사본이 아니다($pb) — rm 뒤 다시 add" ;; esac
    [ "${pr:--}" = - ] || refuse "$pre: 받은편지 줄에는 이어 붙이지 않는다"
    case ${pk:--} in audit=*) refuse "$pre: 자동 감사 줄에는 이어 붙이지 않는다" ;; esac
    [ "$pp" = "$3" ] || refuse "$pre: 프로젝트가 다르다($pp)"
    awk -F'\t' -v n="$tl" '($1 "")==n {f=1} END {exit !f}' "$Q" && refuse "이미 대기열에 있다: $tl"
    x=$(thenof "$tl"); [ -z "$x" ] || refuse "${tl}은 이미 ${x}에 이어 붙였다"
    why=$(brief_bad "$4") && refuse "지시문을 읽지 못함($why): $4"
    # 임시 파일에 다 쓴 뒤 mv(반만 든 지시문이 보이지 않게)
    { cat -- "$pb" && printf '\n## 이어서: %s (hc-fill add --then, %s)\n위 일을 끝내 커밋한 뒤 같은 작업 트리에서 이어서 한다. 이 절의 커밋 제목 머리는 `%s:`으로 쓴다(이 이름을 --after로 기다리는 레인이 풀리게).\n위 일의 완료 보고·착지는 하지 않는다 — 이 절까지 끝낸 뒤 한 번만 report 완료.\n' \
      "$tl" "$(date +%Y-%m-%dT%H:%M)" "$tl" && cat -- "$4"; } >"$pb.then.$$" && mv -f "$pb.then.$$" "$pb" ||
      { rm -f "$pb.then.$$"; die "선행 지시문에 붙이지 못했다: $pb"; }
    echo "이어 붙임 $tl → $pre (새 레인 없음, 선행 지시문 $pb)"; exit 0 ;;
  _add)
    awk -F'\t' -v n="$1" '($1 "")==n {f=1} END {exit !f}' "$Q" 2>/dev/null && die "이미 대기열에 있다: $1 (hc-fill ls)"
    [ -z "${HC_FILL_BRIEF_TMP-}" ] || mv -f "$HC_FILL_BRIEF_TMP" "$3" || die "지시문 사본을 두지 못했다: $3"   # add: 이름이 새것일 때만 사본을 제자리에
    pad16 "$@"; (IFS=$'\t'; printf '%s\n' "${ROW[*]}") >>"$Q"; exit ;;
  _rmx) q_rmx "$@"; exit ;;
  _lset) lset "$@"; exit ;;
  _fix) rfix "$@"; exit ;;
  _recover) rmigrate; exit ;;
  _inadd) q_inadd "$@"; exit ;;
  _rm) q_rm "$1"; exit ;;
  _prio)
    st=$(awk -F'\t' -v n="$1" '($1 "")==n {print $6; exit}' "$Q" 2>/dev/null)
    [ -n "$st" ] || die "대기열에 없다: $1"
    [ "$st" = wait ] || die "대기 중이 아니다($st): $1 — 우선순위는 띄우기 전에만 바꾼다"
    # 옛 줄(11·12칸)은 빈 칸을 -로 채워 열셋째 칸에
    awk -F'\t' -v OFS='\t' -v n="$1" -v p="$2" '($1 "")==n { for (i = NF + 1; i < 13; i++) $i = "-"; $13 = p } 1' "$Q" >"$Q.tmp" && mv "$Q.tmp" "$Q"; exit ;;

  add)
    name= proj= brief= after=- only=- coord= cx= prio=normal early=- aud=- ovk=- thn= xo=
    while [ $# -gt 0 ]; do
      case $1 in --no-early | --no-audit | --overlap-ok | --solo | --after | --only | --priority | --coord) xo="$xo $1" ;; esac   # --then과 함께 못 씀
      [ "$1" != --no-early ] || { early=no-early; shift; continue; }
      [ "$1" != --no-audit ] || { aud=no-audit; shift; continue; }
      [ "$1" != --overlap-ok ] || { [ "$ovk" != solo ] || die "--solo는 --overlap-ok와 함께 쓰지 않는다"; ovk=overlap-ok; shift; continue; }
      [ "$1" != --solo ] || { [ "$ovk" != overlap-ok ] || die "--solo는 --overlap-ok와 함께 쓰지 않는다"; ovk=solo; shift; continue; }
      [ $# -ge 2 ] || usage
      case $1 in --name) name=$2 ;; --project) proj=$2 ;; --brief) brief=$2 ;; --after) after=$2 ;; --only) only=$2 ;; --coord) coord=$2 cx=1 ;;
        --then) thn=$2 ;;
        --priority) prio=$(pnorm "$2") || die "--priority는 긴급|높음|보통|낮음(urgent|high|normal|low): $2" ;; *) usage ;; esac
      shift 2
    done
    if [ -n "$thn" ]; then
      DRC=2   # 아래 검사에 걸리면 거절(종료 2), 아무것도 바꾸지 않음
      [ -z "$xo" ] || die "--then은${xo}와 함께 쓰지 않는다 — 이어 붙인 일은 선행 줄의 설정·주인을 따른다"
      okname "$thn" || die "--then 레인 이름: $thn"
    fi
    okname "$name" || die "--name은 a-z 0-9 - _ 32자까지: $name"
    case $name in audit-*) die "--name은 audit- 로 시작하지 않는다(자동 감사 줄 이름 자리): $name" ;; esac
    w=$(kindwhy "$name") && die "$w"
    awk -v p="$proj" '$1=="repo" && $2==p {f=1} END {exit !f}' "$CONF" || die "설정에 repo 줄이 없는 프로젝트: $proj"
    case $brief in /*) ;; *) brief=$PWD/$brief ;; esac
    [ -f "$brief" ] || die "지시문이 없다: $brief"
    case $brief in *[[:space:]]*) die "지시문 경로에 공백을 쓰지 않는다: $brief" ;; esac
    why=$(brief_bad "$brief") && die "지시문을 읽지 못함($why): $brief"
    if [ -n "$thn" ]; then
      mkdir -p "$DATA" && lockf -k -t "${HC_FILL_THEN_WAIT:-600}" "$DATA/run.lock" env HC_FILL_Q=1 lockf -k -t 30 "$DATA/queue.lock" "$0" _then "$name" "$thn" "$proj" "$brief"
      rc=$?; [ $rc != 75 ] || echo "hc-fill: run 바퀴나 대기열 잠금이 끝나지 않아 그만뒀다, 다시 부른다" >&2
      exit $rc
    fi
    x=$(thenof "$name"); [ -z "$x" ] || die "${name}은 이미 ${x}에 이어 붙였다(--then) — 다른 이름으로"
    [ "$after" = - ] || for a in $(printf %s "$after" | tr , ' '); do okname "$a" || die "--after 레인 이름: $a"; w=$(kindwhy "$a") && die "--after: $w"; done
    [ "$only" = - ] || for m in $(printf %s "$only" | tr , ' '); do
      machines | awk -v m="$m" '$1==m {f=1} END {exit !f}' || die "설정에 machine 줄이 없는 기계: $m"
    done
    # 주인 지휘: 지휘 정보를 남겨(hc-lane coord --set) 그 지휘 watch가 뜨고 보내게. 지휘가 아니면 --coord는 거절, 저절로 잡은 것은 -
    [ -n "$cx" ] || coord=${HC_TERMINAL_ID-}
    if [ -n "$coord" ]; then
      case $coord in *[!A-Za-z0-9_./-]*) die "--coord 주소 글자: $coord" ;; esac
      if ! ce=$(hc-lane coord --set "$coord" 2>&1 </dev/null); then
        [ -z "$cx" ] || die "--coord $coord 를 지휘로 적지 못했다: $(printf '%s\n' "$ce" | tail -n 1)"
        echo "알림: $coord 는 지휘 터미널이 아니라 주인 없이 넣음 — 이 레인 사건은 모든 지휘에게 간다 ($(printf '%s\n' "$ce" | tail -n 1))"; coord=
      fi
    fi
    # 지시문은 내용을 데이터 폴더로 복사해 둔다(launchd의 run이 ~/Documents 같은 곳을 못 읽어도 띄울 수 있게)
    bf=$DATA/briefs/added/$name.md
    mkdir -p "${bf%/*}" && cat -- "$brief" >"$bf.tmp.$$" && [ -s "$bf.tmp.$$" ] ||
      { rm -f "$bf.tmp.$$"; die "지시문을 복사하지 못했다: $brief → $bf"; }
    HC_FILL_BRIEF_TMP=$bf.tmp.$$ qlock _add "$name" "$proj" "$bf" "$after" "$only" wait - - - "$(date +%Y-%m-%dT%H:%M)" - "${coord:--}" "$prio" "$early" "$aud" "$ovk" ||
      { rm -f "$bf.tmp.$$"; exit 1; }
    note=; [ "$after" = - ] || note=", 선행 $after"; [ "$only" = - ] || note="$note, 기계 $only"; note="$note, 주인 ${coord:-없음(모든 지휘)}, 우선 $(plabel "$prio")"; [ "$early" = - ] || note="$note, 먼저 띄움 끔"; [ "$aud" = - ] || note="$note, 자동 감사 끔"
    case $ovk in overlap-ok) note="$note, 겹침 봄 끔" ;; solo) note="$note, 단독" ;; esac
    echo "더함 $name ($proj$note)"
    [ "$after" = - ] || for a in $(printf %s "$after" | tr , ' '); do
      awk -F'\t' -v n="$a" -v p="$proj" '($1 "")==n && $6=="wait" && $2==p && ($11=="" || $11=="-") && $15 !~ /^audit=/ {f=1} END {exit !f}' "$Q" &&
        echo "알림: ${a}가 아직 대기 중 — 같은 일의 다음 단계면 --after 대신 --then ${a}로 한 레인에 이어 붙인다"
    done
    exit 0 ;;

  rm) [ $# = 1 ] || usage; qlock _rm "$1" || exit 1; echo "뺌 $1 (떠 있는 터미널은 그대로)"; exit 0 ;;
  prio)
    [ $# = 2 ] || usage
    p=$(pnorm "$2") || die "우선순위는 긴급|높음|보통|낮음(urgent|high|normal|low): $2"
    qlock _prio "$1" "$p" || exit 1; echo "우선 $1 → $(plabel "$p")"; exit 0 ;;

  ls)
    st=$(hc ls --json) || die "hc ls 실패"
    st=$(printf '%s\n' "$st" | jq -r '.terminals[] | [.address, (.status // "-" | tostring)] | @tsv') || die "hc ls --json 출력을 읽지 못했다"
    printf '%-24s %-10s %-14s %-24s %-8s %-4s %s\n' 레인 프로젝트 상태 주소 주인 우선 선행·비고
    [ -f "$Q" ] || exit 0
    # 먼저 띄움 레인의 선행: local 저장소의 지금 있는 origin/<기본>으로(fetch 없이 — ls는 빠르게). 판정 못 하면 1
    els() {
      FR=$(repo_of "$1" "$LOCAL"); [ -n "$FR" ] || return 1
      FB=$(project_ref "$FR") || return 1
      ew= ed=
      for x in $(printf %s "$2" | tr , ' '); do eh=$(landed "$x") || return 1; if [ -n "$eh" ] || cached_mark "$1" "$x"; then ed="$ed,$x"; else ew="$ew,$x"; fi; done
      if [ -z "$ew" ]; then echo "선행 들어감 — 본 작업"; else echo "선행 기다림 ${ew#,}${ed:+ · 들어감 ${ed#,}}"; fi
    }
    while IFS=$'\t' read -r -u 3 name proj brief after only state m addr stuck added reply owner prio early ak ovk _; do
      live= lr=
      if [ "$state" = wait ]; then s=대기 a=-
      elif [ "$state" = sent ]; then s=되돌려줌 a=$addr
      else
        live=$(printf '%s\n' "$st" | awk -F'\t' -v a="$addr" '$1==a {print $2; exit}')
        if [ -n "$live" ]; then s="떠 있음($live)"; else s=끝남; fi; a=$addr
        # 마지막 보고: run이 바퀴마다 적은 last.tsv(레인 상태 sha8 사건시각 한줄 읽은시각 fresh|old)
        lr=$(awk -F'\t' -v n="$name" '($1 "")==n { if ($2 == "-") r = "보고 없음"; else { r = $2; if ($3 != "-") r = r " " $3; r = r " " $4; if ($5 != "-") r = r " " $5 }
          if ($7 == "old") r = r " (옛 값 " $6 ")"; print r; exit }' "$DATA/last.tsv" 2>/dev/null)
      fi
      note=; [ "$after" = - ] || note="선행 $after"; [ "$only" = - ] || note="$note 기계 $only"
      ew="선행 $after"; [ "${early-}" != early ] || [ -z "$live" ] || ew=$(els "$proj" "$after") || ew="선행 $after"
      case ${early-} in early) note="먼저 띄움($ew)${note#"선행 $after"}" ;; no-early) note="$note 먼저 띄움 끔" ;;
        parked) note="주차(선행 $after — 들어가면 lane/$name 에서 이어 띄움)${note#"선행 $after"}" ;; resumed) note="$note 주차에서 이어 띄움" ;; esac
      [ "$stuck" = - ] || note="$note 상태 안 잡힘 남김 $stuck"
      [ "${reply:--}" = - ] || note="$note 받은편지 ${reply%%:*}"
      tn=$(sed -n 's/^## 이어서: \([a-z0-9_-]*\) .*/\1/p' "$brief" 2>/dev/null | paste -sd , -)
      [ -z "$tn" ] || note="$note 이어서 $tn"
      case ${ak:--} in
        no-audit) note="$note 자동 감사 끔" ;;
        audit=*) note="$note 감사 대상 ${ak#audit=}" ;;
        auto) note="$note $(anote "$name")" ;;
      esac
      case ${ovk:--} in overlap-ok) note="$note 겹침 봄 끔" ;; solo) note="$note 단독" ;; esac
      # 겹침 대기: run이 바퀴마다 적은 overlap.tsv(레인 앞레인 파일)
      [ "$state" != wait ] || note="$note$(awk -F'\t' -v n="$name" '($1 "")==n { print " 겹침 대기(" $2 ": " $3 ")"; exit }' "$DATA/overlap.tsv" 2>/dev/null)"
      # 능력 막힘: run이 바퀴마다 적은 need.tsv(레인 능력 보냄)
      [ "$state" != wait ] || note="$note$(awk -F'\t' -v n="$name" '($1 "")==n { print " 필요 " $2 " — 가진 기계 없음"; exit }' "$DATA/need.tsv" 2>/dev/null)"
      note=${note# }; note=${lr:+$lr${note:+ · }}$note
      printf '%-24s %-10s %-14s %-24s %-8s %-4s %s\n' "$name" "$proj" "$s" "$a" "${owner:--}" "$(plabel "${prio-}")" "$note"
    done 3<"$Q"
    exit 0 ;;

  watch)
    every=60
    while [ $# -gt 0 ]; do case $1 in --every) [ $# -ge 2 ] || usage; every=$2; shift 2 ;; *) usage ;; esac; done
    case $every in '' | *[!0-9]*) usage ;; esac
    if [ "${HC_FILL_W-}" != 1 ]; then
      mkdir -p "$DATA"
      HC_FILL_W=1 lockf -s -k -t 0 "$DATA/watch.lock" "$0" watch --every "$every"; rc=$?
      [ $rc != 75 ] || echo "hc-fill: watch가 이미 돌고 있다($DATA/watch.lock)" >&2
      exit $rc
    fi
    while :; do echo "--- $(date '+%F %T')"; "$0" run; sleep "$every"; done ;;

  run) ;;
  *) usage ;;
esac

# ---- run: 한 바퀴 ----
dry=0
while [ $# -gt 0 ]; do case $1 in --dry-run) dry=1; shift ;; *) usage ;; esac; done
if [ "${HC_FILL_R-}" != 1 ]; then
  mkdir -p "$DATA"
  if [ $dry = 1 ]; then set -- --dry-run; fi
  HC_FILL_R=1 lockf -s -k -t 0 "$DATA/run.lock" "$0" run "$@"; rc=$?
  [ $rc != 75 ] || echo "hc-fill: 다른 run이 돌고 있다, 이번 바퀴는 건너뜀" >&2
  exit $rc
fi
P=; [ $dry = 1 ] && P='[dry-run] '

X='d=$1; shift; case $d in "~/"*) d=$HOME/${d#"~/"} ;; esac; '   # 원격 sh 머리: 첫 인자 경로의 ~/ 를 그 기계 HOME으로

# 병합기(2026-11-20 land-merger-mvp). mqload <프로젝트>: 그 프로젝트 원격의 큐 표식·켬 표식(refs/merge-queue/*·refs/herdr/merger/*)을
# 바퀴에 한 번 ls-remote로 MQS에(「프로젝트<TAB>참조」). 못 읽으면 MQBAD에 넣는다(모름 — 0·1로 읽지 않는다). 원격이 없는 저장소
# (get-url 종료 2)는 큐가 없다. 이 기계 저장소 줄이 없으면 큐를 못 보니, 병합기 설정이 있거나 켠 적이 있는 프로젝트면 모름, 아니면
# 없음(병합기 2차 중간 7 — 원격 부재와 조회 불가를 가른다)
MQP= MQS= MQBAD=

# 자리 세기 전에 끝나는 바퀴(빈 대기열 + idle 0, die 등)는 held.tsv를 비운다 — 그동안 못 본 레인이 묵은 시각을 물려받지 않게
# (감사 [낮음] 1). 다 세면 HELDW=1. dry-run은 건드리지 않는다
HELDW= SB=$DATA/.run-brief.tmp   # run.lock 안에서 한 줄씩 쓰는 사본. 다음 바퀴는 중단 때 남은 사본도 회수한다.
trap '[ $dry = 1 ] || [ -n "$HELDW" ] || : 2>/dev/null >"$DATA/held.tsv"; rm -f -- "$SB"' EXIT
[ $dry = 1 ] || qlock _recover || die "대기열 복구(받은편지 줄 옮기기) 실패, 이번 바퀴는 띄우지 않았다"
inbox_tick
merger_tick
IDLE=$(conf idle); IDLE=${IDLE:-10}
case $IDLE in *[!0-9]*) echo "알림: 설정 idle은 분(숫자)이다, 놀고 있음 알림 끔: $IDLE"; IDLE=0 ;; esac
IDLE=$((10#$IDLE))
# 대기열이 비어도 놀고 있음 알림은 자리를 봐야 한다(그때가 「띄울 것 없음」의 바로 그 꼴)
# 넘기기가 남았으면(장부 open·deliver, 끝나지 않은 감사 차수) 대기열이 비어도 바퀴를 돈다 — 복구가 빈 대기열 조기 종료보다 먼저
HPEND=; { awk -F'\t' '$4=="deliver" || $4=="open" {f=1} END {exit !f}' "$LED" 2>/dev/null ||
  awk -F'\t' 'NF >= 17 && $8 !~ /^(taken|superseded|coord|nosha|legacy)$/ {f=1} END {exit !f}' "$DATA/audit.tsv" 2>/dev/null; } && HPEND=1
[ -s "$Q" ] || [ -n "$HPEND" ] || { echo "대기열 비었음"; [ "$IDLE" != 0 ] || { gc_tick; exit 0; }; }

TASK=$(conf task) LAUNCH=$(conf launch) COORD=${HC_FILL_COORD:-$(conf coord)}
[ -n "$TASK" ] || TASK='{run}'
case $LAUNCH in *'{task}'*) ;; *) die "설정 launch 줄에 {task} 자리가 없다: $CONF" ;; esac
case $TASK in *'{run}'*) ;; *) die "설정 task 줄에 {run} 자리가 없다: $CONF" ;; esac
AUD=$(conf audit); case $AUD in "~/"*) AUD=$HOME/${AUD#"~/"} ;; esac
AFIN=$(conf audit_final)   # 최종 감사 안내(있으면 hc-fill 「감사 통과」는 착지 허가가 아니다 — 아래 ASEC 2번·통과 글)
AMAX=$(conf audit_max); AMAX=${AMAX:-2}
case $AMAX in *[!0-9]*) echo "알림: 설정 audit_max는 횟수(숫자)다, 2로: $AMAX"; AMAX=2 ;; esac
[ -z "$AUD" ] || ! why=$(brief_bad "$AUD") || die "설정 audit 틀을 읽지 못함($why): $AUD"

# 이번 바퀴의 터미널 표: 기계 주소 종류 이름 상태 cwd (local 기계 주소에는 / 가 없다)
# hc가 실패하면(빈 표로 읽어 자리가 다 빈 것처럼 띄우지 않게) 이 바퀴를 멈춘다
raw=$(hc ls --json) && [ -n "$raw" ] || die "hc ls 실패, 이번 바퀴는 띄우지 않았다"
TERMS=$(printf '%s\n' "$raw" | jq -r --arg l "$LOCAL" '.terminals | arrays | .[] |
  [(if (.address | contains("/")) then (.address | split("/")[0]) else $l end), .address, (.agent // "-"), (.name // "-"),
   (.status | if type == "object" then (.state // "-") elif . == null then "-" else tostring end), (.cwd // "-")] | @tsv') &&
  printf '%s\n' "$raw" | jq -e '.terminals | arrays' >/dev/null || die "hc ls --json 출력을 읽지 못했다, 이번 바퀴는 띄우지 않았다"
# hc-lane 레인(라벨 hc-lane=1) 주소: 상태 훅을 아직 안 보낸 레인은 hc ls에 agent가 argv 첫 낱말(env)·status가 null로 온다
raw=$(hc ls --label hc-lane=1 --json) && LANEADDR=$(printf '%s\n' "$raw" | jq -er '.terminals | arrays | map(.address) | join("\n")') ||
  die "hc ls --label hc-lane=1 실패, 이번 바퀴는 띄우지 않았다"
raw=$(hc machine ls --json) && [ -n "$raw" ] || die "hc machine ls 실패, 이번 바퀴는 띄우지 않았다"
printf '%s\n' "$TERMS" | awk -F'\t' -v g="$AGENT" '$3==g {f=1} END {exit !f}' ||
  die "경고: hc ls에 $AGENT 종류가 하나도 없다(지휘 자신도 그 종류라 늘 하나는 있어야 한다). 설정 agent 값이나 hc의 이름이 바뀌었는지 본다. 이번 바퀴는 띄우지 않았다"
CONN=$(printf '%s\n' "$raw" | jq -er '.machines | arrays | map(select(.state == "connected") | .name) | join("\n")') ||
  die "hc machine ls --json 출력을 읽지 못했다, 이번 바퀴는 띄우지 않았다"
AT=$DATA/audit.tsv
aconf
# 레인 사건은 바퀴에 한 번(2026-11-19 fill-ls-early-state): up 줄의 기계(local과 연결된 원격)를 hc-lane events --on 하나로 묶어 읽고
# 자동 감사(EV)와 마지막 보고가 함께 쓴다. 마지막 보고 $DATA/last.tsv(레인 상태 sha8 사건시각 한줄앞부분 읽은시각 fresh|old — 시각은
# 이 기계 HH:MM): up 레인마다 그 터미널이 그 이름으로 적은 마지막 사건, 없으면 상태 -(보고 없음). 연결 안 됨·못 읽은(모름) 기계의
# 레인은 지난 줄을 old로 남긴다. ls는 이 파일만 읽는다(원격 호출 없이 「끝남」이 착지인지 막힘인지 보이게). dry-run은 안 씀
EV= EVBAD= MGM=
# 쓰기 소유 실행 기록(2026-11-20 overlap-guard-2): $DATA/own.tsv 「레인 프로젝트 기계 주소 시작UTC 지시문사본 ,선행, 단독(solo|-)」.
# 사건을 읽기 전에 불러 ev_tick이 그 기계도 본다. 파일이 없거나 옛 꼴(레인 이름만)이면 OSEED — 이번 바퀴에 대기열에서 채운다(아래 겹침 절)
OWNF=$DATA/own.tsv OWND=$DATA/own OREC= OSEED=
if [ -f "$OWNF" ]; then
  OREC=$(awk -F'\t' 'NF >= 7' "$OWNF")
  awk -F'\t' 'NF && NF < 7 {f = 1} END {exit !f}' "$OWNF" && OSEED=1
else OSEED=1; fi
try_prune
ev_tick
park_tick
reply_tick   # 사건(EV) 뒤 — 제출한 받은편지 레인은 병합기 결과를 보고 회신한다(병합기 2단계)
audit_tick
# 자리에서 뺄 done·idle 터미널: 자동 감사 레인(이름이 감사 줄 — 판정 뒤, 지난 바퀴 것 포함) · 감사에 넘겨진 쓰기 레인 가운데 그 감사
# 줄이 자리를 쥔 것(감사 줄이 아직 안 뜸 wait — 이번 바퀴 긴급으로 그 자리에 뜬다 —, 또는 감사 터미널이 done·idle·없음이 아님).
# 감사가 끝났는데 아직 queued(판정을 다시 보냄·판정 없음 세 바퀴)면 레인을 다시 센다 — 둘 다 자리를 안 쥐는 사이 다른 레인이 그
# 자리를 채우고 판정 뒤 레인이 다시 일해 상한을 넘던 것(재감사 [중간] 2). 자리 1인 기계에서 레인이 자기 감사를 막지 않는 것은 그대로
AUDN= AWT=
[ -z "$AUD" ] || [ ! -f "$Q" ] || {
  AUDN=$(awk -F'\t' '$15 ~ /^audit=/ {print $1}' "$Q")
  ahold=,
  while read -r as aa ak am ask; do
    case $as in
      # 그 기계에서 상태가 안 잡혀 남긴(stuck) 감사 줄은 그 기계에 다시 못 뜬다 — 쥔 것으로 보지 않고 레인을 다시 셈(3차 감사 [낮음] 2)
      wait) case ",$ask," in *",$am="*) continue ;; esac ;;
      up) case $(alive "$aa") in gone | done | idle) continue ;; esac ;;
      *) continue ;;
    esac
    ahold="$ahold${ak#audit=},"
  done <<<"$(awk -F'\t' '$15 ~ /^audit=/ {print $6, $8, $15, $5, $9}' "$Q")"
  AWT=$(awk -F'\t' -v h="$ahold" 'NR==FNR { if (NF >= 17 && ($8 == "queued" || $8 == "opening")) w[$2] = 1; next }
    $6=="up" && $15=="auto" && ($1 in w) && index(h, "," $1 ",") {print $8}' "$AT" "$Q" 2>/dev/null)
}
# 기다리는 줄 수(2026-11-19 fill-dep-needs 사용자 「① 선행 사슬 기다림 (추천)」 — 선행 하나가 늦자 뒤 레인들이 3~5시간 기다렸다):
# 줄마다 그 줄을 --after로 기다리는 줄(대기 wait, 떠 있는 먼저 띄움 up·early) 수. --then으로 이어 붙인 이름은 그 이름을 품은 줄 몫,
# 감사 줄(audit=<레인>)은 그 레인 몫. 같은 우선순위 안에서 많은 줄이 먼저 뜨고, 띄울 때 레인 환경 HERDR_LAND_PRIORITY(착지 줄 우선)로 넘긴다
TAL=$([ ! -f "$Q" ] || awk -F'\t' '{print $1 "\t" $3}' "$Q" | while IFS=$'\t' read -r tn tb; do
  awk -v t="$tn" '/^## 이어서: [a-z0-9_-]+ / {print $3 "\t" t}' "$tb" 2>/dev/null; done)
WC=$([ ! -f "$Q" ] || TAL_=$TAL awk -F'\t' 'BEGIN { n = split(ENVIRON["TAL_"], L, "\n"); for (i = 1; i <= n; i++) if (split(L[i], f, "\t") == 2) al[f[1]] = f[2] }
  ($6 == "wait" || ($6 == "up" && $14 == "early")) && $4 != "" && $4 != "-" {
    k = split($4, a, ","); for (j = 1; j <= k; j++) { x = a[j]; if (x in al) x = al[x]; if (!((NR, x) in s)) { s[NR, x] = 1; w[x]++ } } }
  END { for (x in w) print x "\t" w[x] }' "$Q")
# 우선순위 높은 것부터, 같으면 기다리는 줄이 많은 것, 그다음 넣은 차례(셋째 키가 줄 번호). 옛 줄·빈 칸은 보통
ROWS=$([ ! -f "$Q" ] || WC_=$WC awk -F'\t' 'BEGIN { n = split(ENVIRON["WC_"], L, "\n"); for (i = 1; i <= n; i++) if (split(L[i], f, "\t") == 2) w[f[1]] = f[2] }
  { r = ($13 == "urgent") ? 0 : ($13 == "high") ? 1 : ($13 == "low") ? 3 : 2; k = $1; if ($15 ~ /^audit=/) k = substr($15, 7)
    print r "\t" (w[k] + 0) "\t" NR "\t" $0 }' "$Q" | sort -t "$(printf '\t')" -k1,1n -k2,2nr -k3,3n | cut -f 4-)
NOW=   # 이번 바퀴에 띄운 기계(한 줄에 하나)
NOWL=  # 이번 바퀴에 띄운 레인의 기계(hc-fill 레인 수)
OFF=   # 이번 바퀴에 연결 안 됨으로 알린 기계

# 선행·착지 판정: local 기계의 프로젝트 저장소에서 fetch(프로젝트마다 바퀴에 한 번) → origin/<기본> 커밋 제목 머리가 레인 이름인 커밋
# (제목이 「<레인>…」 또는 「<종류>(<범위>): <레인>…」, 단어 경계). 괄호·문장 안 언급과 본문은 세지 않는다
FETCHED= FETCHBAD=

ALLM=$(machines | awk '$4 == "all" {print $1}')
HOLD=$(conf hold); HOLD=${HOLD:-60}
case $HOLD in *[!0-9]*) echo "알림: 설정 hold는 분(숫자)이다, 쉰 레인도 셈: $HOLD"; HOLD=0 ;; esac
HOLD=$((10#$HOLD))
# hc-lane 레인 기록(이 기계 lanes.tsv: 주소 이름 지휘 [종류]): 주소마다 마지막 줄의 종류. read면 작업 트리를 cwd로 써도 읽기 레인
# 주소+이름으로(주소는 재사용된다 — 같은 주소의 옛 read 줄이 새 쓰기 레인을 읽기 레인으로 만들지 않게): 「주소<TAB>이름」 줄
LKIND=$(awk -F'\t' '{ k[$1 "\t" $2] = $4 } END { for (a in k) if (k[a] == "read") print a }' "${XDG_STATE_HOME:-$HOME/.local/state}/hc-lane/lanes.tsv" 2>/dev/null)
HELD=$(cat "$DATA/held.tsv" 2>/dev/null) HNEW= HNOW=$(date +%s)
SEATS=
while IFS=$'\t' read -r -u 5 tm ta tg tn ts tc; do
  if [ "$tg" != "$AGENT" ]; then   # 상태 모르는 hc-lane 레인(띄운 직후·훅 안 보냄)은 살아 있는 에이전트로 셈
    [ "$ts" = - ] && printf '%s\n' "$LANEADDR" | grep -Fxq -- "$ta" || continue
    echo "자리 $tm $ta $tn: $tg, 상태 모름(hc-lane 레인) → 셈"; SEATS=$(printf '%s\n%s' "$SEATS" "$tm"); continue
  fi
  case $ts in done | idle) ;; *) SEATS=$(printf '%s\n%s' "$SEATS" "$tm"); continue ;; esac
  # 쉬기 시작한 때(held.tsv): 이번 바퀴 done·idle만 이어 적는다 — working·blocked로 바뀌거나 사라진 주소는 빠진다
  hs=$(printf '%s\n' "$HELD" | awk -F'\t' -v a="$ta" '$1==a {print $2; exit}')
  case $hs in '' | *[!0-9]*) hs=$HNOW ;; esac
  HNEW="$HNEW$ta	$hs
"
  printf '%s\n' "$AUDN" | grep -Fxq -- "$tn" && { echo "자리 $tm $ta $tn: $ts, 자동 감사 레인 → 안 셈"; continue; }
  printf '%s\n' "$AWT" | grep -Fxq -- "$ta" && { echo "자리 $tm $ta $tn: $ts, 자동 감사 기다림(자리는 감사 줄이) → 안 셈"; continue; }
  printf '%s\n' "$ALLM" | grep -Fxq -- "$tm" && { SEATS=$(printf '%s\n%s' "$SEATS" "$tm"); continue; }
  case $tc in
    *.wt/*)
      # 감사·조사(hc-lane --read)가 레인 작업 트리에서 돈 것(감사 [낮음] 4). 기록이 없으면 아래처럼 판정
      printf '%s\n' "$LKIND" | grep -Fxq -- "$ta	$tn" && { echo "자리 $tm $ta $tn: $ts, 읽기 레인(레인 기록) → 안 셈"; continue; }
      case $(wt_there "$tm" "$tc") in
        yes) tw="작업 트리 있음" ;;
        no) echo "자리 $tm $ta $tn: $ts, 작업 트리 없음 → 안 셈"; continue ;;
        *) tw="작업 트리 확인 못 함" ;;
      esac
      if lane_landed "$tn" "$tc"; then echo "자리 $tm $ta $tn: $ts, 착지함(${LHIT%% *}) → 안 셈"
      elif [ "$HOLD" != 0 ] && [ $((HNOW - hs)) -ge $((HOLD * 60)) ]; then echo "자리 $tm $ta $tn: $ts, 쉰 지 $(((HNOW - hs) / 60))분(hold $HOLD) → 안 셈"
      else echo "자리 $tm $ta $tn: $ts, $tw → 셈"; SEATS=$(printf '%s\n%s' "$SEATS" "$tm"); fi ;;
    *) echo "자리 $tm $ta $tn: $ts, 읽기 전용(작업 트리 아님) → 안 셈" ;;
  esac
done 5<<<"$TERMS"
[ $dry = 1 ] || { printf '%s' "$HNEW" >"$DATA/held.tsv.tmp" && mv -f "$DATA/held.tsv.tmp" "$DATA/held.tsv"; }
HELDW=1

# 자동 감사 쓰기 레인의 run 지시문 끝 절(설정 audit이 있을 때)
ASEC='
## 감사·착지 (hc-fill 자동)
이 절이 위 지시문 본문의 감사·착지 문구보다 앞선다. 감사는 hc-fill이 띄운다(지휘가 따로 띄우지 않는다).
1. 구현·검증이 끝나면 착지하지 말고 `hc-lane report 완료 <sha> "<한 줄> (감사 hc-fill 자동)"`을 부른 뒤 턴을 끝내고 기다린다. 판정이 올 때까지 다른 hc-lane report는 하지 않는다.
2. hc-fill이 「감사 판정이 왔다 — … hc-lane verdict <ID> …」로 깨우면 이 작업 트리에서 `hc-lane verdict <ID>`를 돌리고 그 출력대로만 한다(판정은 도구가 정한다 — 글로 짐작하지 않는다). 같은 글이 또 와도 같은 줄을 다시 돌리면 된다(판정은 한 번만 받힌다).
3. 출력이 「감사 통과 …」면 그 출력의 착지 줄 `hc-lane land <기본> --verdict <ID>`로(위 착지 절차의 land 줄 대신 — 정리 절차는 그대로) main에 넣고 `hc-lane report 착지 <sha>`. 병합기가 켜진 저장소면 착지 줄이 큐에 제출만 하고 끝난다 — 그때 착지는 병합기가 알리니 report 착지 없이 끝낸다.
4. 출력이 「감사 지적 … <보고서>」면 그 보고서를 읽고 높음·중간을 고친 뒤 다시 검증하고 `hc-lane report 완료 <새 sha> "<한 줄>"`, 그리고 다시 기다린다. 출력이 「지금 커밋으로 hc-lane report 완료 …」면 그 줄을 부르고 기다린다.
'
[ -z "$AFIN" ] || afin_sec

# 겹침(2026-11-19 lane-overlap-guard, 사용자 「rebase 충돌을 근본적으로」 — 같은 파일을 고치는 레인이 동시에 떠 착지마다 충돌·재검증):
# 대기 줄(감사 줄·--overlap-ok 빼고)을 띄우기 전에 같은 프로젝트의 쓰기 소유 레인과 견준다(일반·먼저 띄움·같은 바퀴에 앞서 띄운 줄 같은 판정).
# 쓰기 소유 = 대기열의 쓰기 줄(감사 줄 빼고, up·wait 모두)로 그 이름의 살아 있는 터미널이 있는 것(대기열 주소 말고도 — 손으로 띄움·
# 상태 안 잡힘으로 남긴 것, 아스트라 감사 높음 3), 또는 up 줄인데 그 기계가 연결 안 됨(끝났는지 몰라 유지, 높음 2). 주소가 같아도 이름이
# 다르면(주소 재사용) 그 레인 터미널이 아니다. 풀림: 터미널이 (연결된 기계에서) 사라지거나, 그 터미널이 그 이름으로 적은 마지막 사건이
# 착지(이번 실행의 착지 — 옛 같은 이름 커밋 제목은 안 봄, 높음 4). 자리의 hold 만료(쉰 지 오래라 자리를 안 셈)와는 따로다.
# 이번 바퀴에 띄운 쓰기 줄(먼저 띄움 포함)도 곧바로 소유, 감사 줄은 소유가 아니다(중간 4).
# 선행: 후보의 --after 선행 예약은 후보를 막는다(선행이 먼저 — 높음 1). 거꾸로 소유 레인이 후보를 --after로 기다리면 그 소유 레인
# 예약은 후보를 막지 않는다(그 레인은 후보 착지 뒤에 일한다 — 먼저 띄운 후속이 나중에 넣은 선행을 막아 서로 기다리지 않게).
# 키: 예약(R) = 지시문 「파일:」·「쓰기:」 줄(목록 머리 -·* 허용)의 항목(쉼표·가운뎃점·세미콜론으로 나눔, 항목마다 `…` 안 또는 첫 낱말 —
# 뒤 설명 「(new)」 등은 뺌)의 경로(아직 없는 새 파일·한글 이름도)·FR ID. 언급(M) = 본문 낱말(앞뒤 괄호·따옴표·문장부호와 끝 조사를 뗌)
# 가운데 local 저장소에 있는 것, 첫 폴더가 있는 새 경로, 맨 위 실제 파일(Makefile 등 확장자 없어도)·FR ID.
# 경로 정규화: . · .. · 겹 / 를 정리(저장소 밖으로 나가면 버림), 절대 경로는 그 프로젝트 repo 줄 경로(모든 기계) 또는 그 경로의
# 「.wt/<레인>/」 아래만 받아 뗀다(다른 프로젝트·모르는 절대 경로는 버림). local 저장소에 폴더면 끝에 / — 그 아래와 겹침.
# 설정 overlap_ignore <프로젝트> <glob>… 은 뺀다.
# 설정 overlap: block(기본, 2026-11-20 지휘 t1cj — 잘못된 값도 block) — 예약끼리 겹치면 띄우지 않고 기다림(ls·overlap.tsv에 「겹침 대기」),
# 언급만 겹치면 경고 · warn — 띄우고 「겹침 경고」 한 줄과 기록(overlap-warn.log: 시각 레인 앞레인 예약|언급 키) · off — 안 봄(실행 기록은
# 그래도 바퀴마다 맞춘다 — 다시 켤 때 낡은 기록으로 넘어가지 않게). 단독(add --solo)은 설정과 상관없이. 원격 호출 없음(local 저장소만 본다)
OVM=$(conf overlap); OVM=${OVM:-block}
case $OVM in warn | block | off) ;; *) echo "알림: 설정 overlap은 warn|block|off다, block으로: $OVM"; OVM=block ;; esac
OWN=    # 쓰기 소유 키: 「프로젝트<TAB>레인<TAB>R|M<TAB>키」 줄
OVWAIT= # 이번 바퀴 겹침 대기: 「레인<TAB>앞레인<TAB>키|단독<TAB>기계제한<TAB>프로젝트」 줄(ls용 overlap.tsv·놀고 있음 사유)
# 채움: own.tsv가 없거나 옛 꼴이면 대기열 쓰기 up 줄 주소와 끊긴 기계에 남긴 주소
if [ -n "$OSEED" ]; then
  while IFS=$'\t' read -r -u 3 qn qp qb qa qst qm qad qsk qad0 qo; do
    [ -n "$qn" ] || continue
    [ "$qst" != up ] || [ "$qad" = - ] || own_add "$qn" "$qp" "$qm" "$qad" "$(utc_of "$qad0")" "$qb" "$qa" "$qo"
    [ "$qsk" = - ] || for e_ in $(printf %s "$qsk" | tr , ' '); do
      [ "${e_%%=*}" = "$LOCAL" ] || printf '%s\n' "$CONN" | grep -Fxq -- "${e_%%=*}" || own_add "$qn" "$qp" "${e_%%=*}" "${e_#*=}" "$(utc_of "$qad0")" "$qb" "$qa" "$qo"
    done
  done 3<<<"$(awk -F'\t' -v OFS='\t' '($6=="up" || $6=="wait") && $15 !~ /^audit=/ {print $1, $2, $3, $4, $6, $7, $8, $9, $10, ($16 == "" ? "-" : $16)}' "$Q" 2>/dev/null)"
fi
# 지움
while IFS=$'\t' read -r -u 3 rn rp rm_ ra rs _; do
  [ -n "$rn" ] || continue
  if [ "$rm_" != "$LOCAL" ] && ! printf '%s\n' "$CONN" | grep -Fxq -- "$rm_"; then
    [ "$OVM" = off ] || echo "겹침: $rn @$rm_ 연결 안 됨 — 끝났는지 몰라 쓰기 소유 유지"; continue
  fi
  own_pending "$rn" "$rm_" "$ra" && continue
  if lalive "$ra" "$rn"; then own_done "$rn" "$ra" "$rs" || continue
  else
    mqueued "$rp" "$rn"; mq_=$?   # 0 큐에 있음 · 1 없음 · 2 모름
    if [ $mq_ = 0 ]; then [ "$OVM" = off ] || echo "겹침: $rn 병합기 큐에 제출됨 — 들어가기 전이라 쓰기 소유 유지"; continue; fi
    if [ $mq_ = 2 ]; then [ "$OVM" = off ] || echo "겹침: $rn 병합기 큐를 못 읽음 — 들어갔는지 몰라 쓰기 소유 유지"; continue; fi
  fi
  own_rel "$rn" "$ra"
done 3<<<"$OREC"
# 입양: 대기열 쓰기 줄과 같은 이름의 살아 있는 터미널(기록이 없고 그 줄을 넣은 뒤 착지 전인 것)
while IFS=$'\t' read -r -u 3 qn qp qb qa qad0 qo; do
  [ -n "$qn" ] || continue
  for x_ in $(printf '%s\n' "$TERMS" | awk -F'\t' -v n="$qn" '($4 "")==n {print $1 "=" $2}'); do
    xa_=${x_#*=}
    printf '%s\n' "$LKIND" | grep -Fxq -- "$xa_	$qn" && continue   # LKIND = 「주소<TAB>이름」(주소 재사용)
    printf '%s\n' "$OREC" | awk -F'\t' -v n="$qn" -v a="$xa_" '($1 "")==n && $4==a {f = 1} END {exit !f}' && continue
    xs_=$(utc_of "$qad0"); own_done "$qn" "$xa_" "$xs_" && continue
    own_add "$qn" "$qp" "${x_%%=*}" "$xa_" "$xs_" "$qb" "$qa" "$qo"
  done
done 3<<<"$(awk -F'\t' -v OFS='\t' '($6=="up" || $6=="wait" || $6=="sent") && $15 !~ /^audit=/ {print $1, $2, $3, $4, $10, ($16 == "" ? "-" : $16)}' "$Q" 2>/dev/null)"
# 기다림 사슬(아스트라 2차 높음 2): 대기열 줄의 --after와, 「## 이어서: <이름>」(--then)으로 붙은 이름 → 받은 줄
QEDGES=$(awk -F'\t' -v OFS='\t' '$15 !~ /^audit=/ {print $1, "," $4 ","}' "$Q" 2>/dev/null)
THENMAP=$(awk -F'\t' '$15 !~ /^audit=/ {print $1 "\t" $3}' "$Q" 2>/dev/null | while IFS=$'\t' read -r tn tb; do
  sed -n 's/^## 이어서: \([a-z0-9_-]*\) .*/\1/p' "$tb" 2>/dev/null | awk -v t="$tn" 'NF {print $0 "\t" t}'; done)
# 키(lkeys)는 겹침을 볼 대기 줄이 있을 때만 만든다
OKEY=
[ "$OVM" = off ] || ! printf '%s\n' "$ROWS" | awk -F'\t' '$6=="wait" && $15 !~ /^audit=/ && $16 != "overlap-ok" && $16 != "solo" {f=1} END {exit !f}' || OKEY=1
[ -z "$OKEY" ] || while IFS=$'\t' read -r -u 3 rn rp _ _ _ rc _; do
  [ -n "$rn" ] || continue
  k_=$(lkeys "$rp" "$rc"); [ -z "$k_" ] || OWN="$OWN$(printf '%s\n' "$k_" | sed "s|^|$rp	$rn	|")
"
done 3<<<"$OREC"   # own.tsv는 이번 바퀴에 띄운 쓰기 줄(place)까지 더해 바퀴 끝에 쓴다

# nd_block <레인> <기계제한|-> <주인|->: 지시문 「필요:」 능력(NEED)을 가진 기계가 (기계 제한 안에) 하나도 없으면 「막힘」 한 줄을 찍고
# 그 레인 주인 지휘에 막힘 사건 한 번(need.tsv: 레인 능력 보냄1|0 — 같은 레인·능력이면 다시 안 보냄)을 보내고 0(대기 그대로). 있으면 1
NDOLD=$(cat "$DATA/need.tsv" 2>/dev/null) NDNOW=
ELIST=   # 선행에만 묶여 건너뛴 대기 레인: 「,<레인>=<기본 가지>」 — 먼저 띄움 후보(--no-early 빼고)
UPNOW=   # 이번 바퀴에 띄운 레인(「,<레인>」 — 먼저 띄움 포함, dry-run은 띄울 것)
ECAPHIT= # 먼저 띄움 상한에 걸려 남긴 후보가 있음(놀고 있음 알림 사유)
ECAPM=   # 그 후보들의 기계 제한(「,<기계>…」, - 는 모든 기계) — 상한 사유는 그 기계에만(아스트라 2차 낮음 1)
# 끊긴 기계의 이름(기존 7 — 「이미 떠 있음」은 hc ls에 있는 기계만 본다. 목록에 없음 ≠ 끝남): $DATA/seen.tsv(기계 이름 주소)에 바퀴마다
# 연결된 기계의 이름 붙은 터미널을 적고, 끊긴 기계 줄은 지난 값을 둔다. 대기 줄의 이름이 끊긴 기계 줄에 있으면 띄우지 않는다(모름)
SEEN=$(cat "$DATA/seen.tsv" 2>/dev/null)
SEENOFF=$(printf '%s\n' "$SEEN" | while IFS=$'\t' read -r sm_ sn_ sa_; do
  [ -n "$sm_" ] && [ "$sm_" != "$LOCAL" ] && ! printf '%s\n' "$CONN" | grep -Fxq -- "$sm_" && printf '%s\t%s\t%s\n' "$sm_" "$sn_" "$sa_"; done)
[ $dry = 1 ] || { { printf '%s\n' "$TERMS" | awk -F'\t' -v OFS='\t' '$4 != "-" && $4 != "" {print $1, $4, $2}'; [ -z "$SEENOFF" ] || printf '%s\n' "$SEENOFF"; } >"$DATA/seen.tsv.tmp" &&
  mv -f "$DATA/seen.tsv.tmp" "$DATA/seen.tsv"; }
while IFS=$'\t' read -r -u 3 name proj brief after only state m0 a0 stuck added reply owner _ ef ak ovk rid _; do
  RID=$rid
  # 상태가 안 잡혀 남긴 터미널이 살아났으면 같은 레인이 둘 돈다: 알리고 그 레인은 더 띄우지 않는다(지휘가 정리)
  dupr=
  if [ "$stuck" != - ]; then
    for sa in $(printf %s "$stuck" | tr , ' '); do
      sa=${sa#*=}
      printf '%s\n' "$TERMS" | awk -F'\t' -v a="$sa" '$2==a {f=1} END {exit !f}' || continue
      hc get "$sa" --json 2>/dev/null | jq -e '(.status | type) == "object"' >/dev/null || continue
      w=; [ "$state" = wait ] || w=" 지금 떠 있는 $a0 와 같은 레인이 둘 돈다."
      echo "중복 위험 $name $sa: 상태가 안 잡혀 남긴 터미널이 살아났다.$w 지휘가 하나를 정리한다"; dupr=1
    done
  fi
  [ "$state" = wait ] || continue
  [ -z "$dupr" ] || { echo "건너뜀 $name: 중복 위험이라 더 띄우지 않음"; continue; }
  # 받은편지 줄은 장부가 open일 때만(결과·취소가 이미 고정된 줄은 띄우지 않는다)
  case ${reply:--} in *'#'*) [ "$(lget "${reply##*#}" | cut -f 4)" = open ] || { echo "건너뜀 $name: 받은편지 요청 ${reply##*#} 결과가 이미 고정됐다"; continue; } ;; esac
  # 같은 이름의 끝나지 않은 감사 차수가 있으면 넘기기가 끝난 뒤에(새 실행이 옛 판정을 받지 않게)
  ax_=$(awk -F'\t' -v n="$name" 'NF >= 17 && ($2 "")==n && $8 !~ /^(taken|superseded|coord|nosha|legacy)$/ {print $1; exit}' "$AT" 2>/dev/null)
  [ -z "$ax_" ] || { echo "건너뜀 $name: 감사 $ax_ 넘기기 중 — 끝난 뒤에"; continue; }
  NEED=; case ${ak:--} in audit=*) ;; *) NEED=$(needs "$brief") ;; esac   # 감사 줄은 그 레인 기계에(능력 안 봄)
  # 같은 이름이 살아 있으면(지휘가 손으로 띄웠거나 지난 바퀴의 것) 다시 띄우지 않고 떠 있음으로 표시. 상태 안 잡혀 남긴 기계는 빼고 본다
  # 자동 감사 줄은 지난 바퀴의 감사 터미널(판정 뒤 done·idle로 남음)을, 주차한 줄은 주차하고 쉬는 터미널을 새 실행으로 잡지 않는다.
  # 채택은 hc-lane 레인(라벨 hc-lane=1)이고 cwd가 그 기계 그 프로젝트 저장소(.wt/ 포함)일 때만(4차 B 높음 7 — 이름만 같은 남의 터미널을
  # 채택하면 그 레인이 영영 안 뜬다. 안 맞으면 띄우고, 쓰기 레인 중복은 hc-lane 임대가 막는다)
  try_old_busy "$name" "$rid" && { echo "옛 실행 정리 기다림 $name"; continue; }
  live= parkbusy=
  while IFS=$'\t' read -r lm la ls_ lc_; do
    [ -n "$la" ] || continue
    inlist "$lm=$la" "$stuck" && continue
    case ${ak:--}:$ls_ in audit=*:done | audit=*:idle) continue ;; esac
    if ! printf '%s\n' "$LANEADDR" | grep -Fxq -- "$la" || ! inproj "$proj" "$lm" "$lc_"; then
      echo "알림 $name: 같은 이름 터미널 $la 는 hc-lane 레인($proj 폴더)이 아니라 채택하지 않음"; continue
    fi
    if [ "${ef:--}" = parked ]; then park_candidate "$name" "$rid" "$lm" "$la" "$ls_"; case $? in 1) continue ;; 2) parkbusy=1; continue ;; esac; fi
    live="$lm $la"; break
  done <<<"$(printf '%s\n' "$TERMS" | awk -F'\t' -v OFS='\t' -v n="$name" '($4 "")==n {print $1, $2, $5, $6}')"
  if [ -n "$live" ]; then
    echo "이미 떠 있음 $name: ${live#* } — 떠 있음으로 표시"
    if [ $dry = 0 ]; then
      # 이번 줄의 시도 기록(같은 줄 ID·기계)이면 hc-fill이 띄우고 up을 적기 전에 멈춘 것: 그때 정한 먼저 띄움·자동 감사 표시를 쓰고, 옛 보고는
      # 띄울 때 이미 비켜 뒀으니 다시 치우지 않는다(이번 실행이 쓴 받은편지 결과를 .old-로 보내지 않게 — 아스트라 2차 ⑤⑥)
      tg_=$(tryget "$name" "$rid" "${live%% *}") te_= tu_=
      [ -z "$tg_" ] || { te_=${tg_%%	*} tu_=${tg_#*	}; [ "$te_" != - ] || te_=; [ "$tu_" != - ] || tu_=; }
      # 받은편지 줄(요청 ID #r…)의 보고는 요청 ID마다 다른 파일이라 치우지 않는다(옛 꼴 되돌릴곳만)
      if [ -z "$tg_" ]; then
        case ${reply:--} in -|*'#'*) ;; *) old_report "${live%% *}" "$name" || { echo "건너뜀 $name: ${live%% *} 의 옛 보고를 비켜 두지 못했다"; continue; } ;; esac
      fi
      pget "${live#* }" || PRUN=-
      tryput "$name" "$rid" "${live%% *}" "$te_" "$tu_" "${live#* }" "$PRUN" && QRID=$rid qset "$name" up "${live%% *}" "${live#* }" "$stuck" "$te_" "$tu_"
      [ -z "$tg_" ] || echo "이미 떠 있음 $name: 띄운 뒤 멈춘 이번 시도 — 시도 기록대로(먼저 ${te_:-아님}·감사 ${tu_:-아님})"
    fi
    continue
  fi
  [ -z "$parkbusy" ] || { echo "주차 정리 기다림 $name"; continue; }
  nd_block "$name" "$only" "${owner:--}" "$proj" && continue
  sx_=$(printf '%s\n' "$SEENOFF" | awk -F'\t' -v n="$name" '($2 "")==n {print $1 " " $3; exit}')
  [ -z "$sx_" ] || { echo "건너뜀 $name: 끊긴 기계 ${sx_%% *}에 지난 바퀴 같은 이름 터미널(${sx_#* })이 있었다 — 끝났는지 몰라 띄우지 않음(다시 붙으면 본다)"; continue; }
  if [ "$after" != - ]; then
    after_ok "$name" "$proj" "$after"; ar=$?
    if [ $ar != 0 ]; then [ $ar != 1 ] || [ "${ef:--}" != - ] || ELIST="$ELIST,$name=$b"; continue; fi
  fi
  why=$(brief_bad "$brief") && { echo "실패 $name: 지시문을 읽지 못함($why): $brief"; continue; }
  snap "$name" "$brief" || continue
  ovl_check "$name" "$proj" "$SB" "$after" "${ak:--}" "${ovk:--}" "$only" || continue   # 겹침 대기: 건너뛰고 다음 줄(낮은 우선도 봄)
  # 띄우기 직전에 그 줄이 아직 이 줄 ID인지(run이 대기열을 읽은 뒤 rm·다시 add됐으면 다음 바퀴에 새 줄로)
  [ "$(awk -F'\t' -v n="$name" '($1 "")==n {print $17; exit}' "$Q" 2>/dev/null)" = "$rid" ] || { echo "건너뜀 $name: 대기열 줄이 바뀌었다(rm·다시 add) — 다음 바퀴에"; continue; }
  RESUME= RSEC=
  [ "${ef:--}" != parked ] || { RESUME=1 RSEC=$(resume_sec "$name" "$after" "$b"); }   # 주차한 줄: 그 가지에서 이어 띄움
  AK=${ak:--} PAFT=$after PSOLO=${ovk:--}; place "$name" "$proj" "$SB" "$only" "${reply:--}" "${owner:--}"
  RESUME= RSEC=
  [ -z "$placed$GOTADDR" ] || ovl_placed "$name" "$proj" "$SB" "$after" "${ak:--}"
  [ -n "$placed" ] || [ -n "$bad" ] || echo "자리 없음 $name: 대기"
done 3<<<"$ROWS"

# 먼저 띄움: 띄울 수 있는 것을 다 띄우고도 자리가 남으면 선행에만 묶인 레인을 같은 차례(우선순위·넣은 차례)로.
# 설정 early = 살아 있는 먼저 띄움 레인 수 상한(빈 값이면 남은 자리 전부, 0이면 끔), early_wait = 기다림 기한(시간, 기본 5)
ECAP=$(conf early) EWAIT=$(conf early_wait); EWAIT=${EWAIT:-5}
case $EWAIT in *[!0-9]*) ;; *) EWAIT=$((10#$EWAIT)) ;; esac   # 08·09도 십진수로(감사 [낮음] 2), 00은 아래에서 0으로 걸림
case $ECAP in *[!0-9]*) echo "알림: 설정 early는 개수(숫자)다, 먼저 띄움 끔: $ECAP"; ECAP=0 ;; esac
case $EWAIT in '' | *[!0-9]* | 0) echo "알림: 설정 early_wait는 1 이상 시간(숫자)이다, 5로: $EWAIT"; EWAIT=5 ;; esac
if [ -n "$ELIST" ] && [ "$ECAP" != 0 ]; then
  ELIVE=0
  while IFS=$'\t' read -r a an; do   # 주소+이름(주소 재사용)
    [ -n "$a" ] || continue
    printf '%s\n' "$TERMS" | awk -F'\t' -v a="$a" -v n="$an" '$2==a && ($4 "")==n {f=1} END {exit !f}' && ELIVE=$((ELIVE + 1))
  done <<<"$(printf '%s\n' "$ROWS" | awk -F'\t' '$6=="up" && $14=="early" {print $8 "\t" $1}')"
  while IFS=$'\t' read -r -u 3 name proj brief after only state m0 a0 stuck added reply owner _ _ ak ovk rid _; do
    RID=$rid
    eb=$(printf %s "$ELIST" | tr , '\n' | sed -n "s/^$name=//p"); [ -n "$eb" ] || continue
    [ "$(awk -F'\t' -v n="$name" '($1 "")==n {print $17; exit}' "$Q" 2>/dev/null)" = "$rid" ] || { echo "먼저 띄움 건너뜀 $name: 대기열 줄이 바뀌었다(rm·다시 add)"; continue; }
    # 선행 가운데 대기열에서 아직 안 뜬(wait) 레인이 있으면 빼고 그 선행이 자리를 먼저 잡게 한다(감사 [중간] 1 — 뒤 레인이 자리를 다
    # 먹어 선행이 못 떠 기한까지 교착). 그 선행이 이번 바퀴에 떴으면(먼저 띄움 포함) 후보. 대기열 밖 선행은 그대로
    # 「## 이어서」로 다른 줄에 붙은 선행은 그 받은 줄로 본다(아스트라 2차 높음 2)
    wq=; for a in $(printf %s "$after" | tr , ' '); do
      ra_=$a; [ -n "$(printf '%s\n' "$ROWS" | awk -F'\t' -v n="$a" '($1 "")==n {print 1; exit}')" ] || ra_=$(tmap "$a")
      inlist "$ra_" "$UPNOW" && continue
      [ "$(printf '%s\n' "$ROWS" | awk -F'\t' -v n="$ra_" '($1 "")==n {print $6; exit}')" != wait ] || wq="$wq${wq:+,}$a"
    done
    [ -z "$wq" ] || { echo "먼저 띄움 건너뜀 $name: 선행 $wq 가 대기열에서 아직 안 떴다(그 선행이 자리를 먼저)"; continue; }
    if [ -n "$ECAP" ] && [ "$ELIVE" -ge "$ECAP" ]; then   # 상한: 남은 후보의 기계 제한만 모으고 더 띄우지 않는다
      [ -n "$ECAPHIT" ] || echo "먼저 띄움 상한 ${ECAP}개(살아 있는 것 $ELIVE) — 나머지는 대기"
      ECAPHIT=1 ECAPM="$ECAPM,$only"; continue
    fi
    why=$(brief_bad "$brief") && { echo "실패 $name: 지시문을 읽지 못함($why): $brief"; continue; }
    snap "$name" "$brief" || continue
    ovl_check "$name" "$proj" "$SB" "$after" "${ak:--}" "${ovk:--}" "$only" || continue
    ESEC=$(early_sec "$after" "$eb")
    NEED=; case ${ak:--} in audit=*) ;; *) NEED=$(needs "$SB") ;; esac
    AK=${ak:--} PAFT=$after PSOLO=${ovk:--}; place "$name" "$proj" "$SB" "$only" "${reply:--}" "${owner:--}" "$after"
    ESEC=
    [ -z "$placed$GOTADDR" ] || ovl_placed "$name" "$proj" "$SB" "$after" "${ak:--}"
    [ -z "$placed" ] || ELIVE=$((ELIVE + 1))
  done 3<<<"$ROWS"
fi
# 겹침 대기·능력 막힘 기록(ls 비고): 이번 바퀴 것으로 바꾼다
[ $dry = 1 ] || { printf '%s' "$OVWAIT" >"$DATA/overlap.tsv.tmp" && mv -f "$DATA/overlap.tsv.tmp" "$DATA/overlap.tsv"; }
[ $dry = 1 ] || { printf '%s' "$NDNOW" >"$DATA/need.tsv.tmp" && mv -f "$DATA/need.tsv.tmp" "$DATA/need.tsv"; }
own_finish

after_tick

idle_tick
gc_tick
exit 0
