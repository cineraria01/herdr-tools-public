#!/bin/bash
# hc-fill: 기다리는 레인을 차례대로, 선행이 풀린 것부터 빈 자리가 남는 첫 기계에 hc-lane으로 띄운다.
# 기계 차례·상한·저장소 경로·실행 명령 틀·지휘 주소는 모두 설정 파일(${HERDR_TOOLS_CONFIG:-~/.config/herdr-tools}/hc-fill.tsv,
# 예시는 저장소 config.example/hc-fill.tsv)에서 읽는다. 코드에는 기계·계정·경로 같은 개인 값을 두지 않는다.
# 의존: hc·hc-lane·git·jq·lockf(macOS). 맥 /bin/bash 3.2에서 돈다. 아무것도 지우거나 끄지 않는다
# (하나 예외: 자동 감사가 판정을 레인에 보낸 뒤의 그 감사 터미널 — audit_reap).
set -u
shopt -u patsub_replacement 2>/dev/null   # bash 5.2+: ${x//a/b}의 b 안 & 를 글자 그대로
# 문자열 비교는 바이트로: macOS awk의 ==는 strcoll이라 en_US.UTF-8에서 "판정"=="완료"가 참(2026-11-19 fill-then 작업 중 발견)
[ -z "${LC_ALL-}" ] || export LC_CTYPE=$LC_ALL; unset LC_ALL; export LC_COLLATE=C

CONF=${HERDR_TOOLS_CONFIG:-$HOME/.config/herdr-tools}/hc-fill.tsv
DATA=${HC_FILL_DATA:-$HOME/.local/share/hc-fill}
Q=$DATA/queue.tsv   # 이름 프로젝트 지시문 선행 기계제한 상태(wait|up|sent) 기계 주소 남긴것(기계=주소,…) 더한시각 되돌릴곳 주인 — 빈 칸은 -
                    # 되돌릴곳: 받은편지에서 온 레인의 결과를 쓸 <기계>:<경로>. 손으로 넣은 줄·10칸 옛 줄은 -
                    # 주인: 넣은 지휘 주소(add의 $HC_TERMINAL_ID·--coord). 레인 사건은 그 지휘에게만. 받은편지 줄·11칸 옛 줄은 -(모든 지휘에)
                    # 우선: urgent|high|normal|low(add --priority, 기본 normal. 받은편지는 기본 high). 12칸까지의 옛 줄은 normal
                    # 먼저: -(먼저 띄움 가능) · no-early(add --no-early) · early(먼저 띄움으로 띄웠다). 13칸까지의 옛 줄은 -
                    # 감사: -(정하지 않음) · no-audit(add --no-audit) · auto(감사·착지 절을 붙여 띄웠다 — 자동 감사 대상) ·
                    #       audit=<레인>(그 레인의 자동 감사 줄). 14칸까지의 옛 줄은 -
WAIT=${HC_FILL_WAIT:-60} POLL=${HC_FILL_POLL:-5}

die() { printf 'hc-fill: %s\n' "$*" >&2; exit "${DRC:-1}"; }   # add --then은 DRC=2(거절)
refuse() { printf 'hc-fill: %s\n' "$*" >&2; exit 2; }
usage() {
  cat >&2 <<'EOF'
사용법: hc-fill add --name <레인> --project <프로젝트> --brief <지시문 경로> [--after <레인>[,…]] [--only <기계>[,…]] [--coord <지휘 주소>]
               [--priority <긴급|높음|보통|낮음>] [--no-early] [--no-audit]   (우선은 영어 urgent|high|normal|low도 받음, 기본 보통)
        hc-fill add --name <이름> --project <프로젝트> --brief <지시문 경로> --then <대기 중인 선행>
        hc-fill ls | rm <레인> | prio <레인> <우선순위> | run [--dry-run] | watch [--every <초, 기본 60>]
  add    대기열 끝에 한 줄. 프로젝트·기계는 설정에 있는 것만
         지시문은 이때 내용을 ~/.local/share/hc-fill/briefs/added/<레인>.md로 복사한다(못 읽거나 비었으면 거절)
         주인 지휘: --coord, 없으면 부른 터미널($HC_TERMINAL_ID). hc-lane coord --set으로 지휘 정보를 남기고 띄울 때 레인 주인
         (HC_LANE_OWNER)으로 넘겨 그 레인의 사건(hc-lane report·멈춤)은 그 지휘 watch에게만 간다. 지휘 터미널이 아니면(레인 안·
         터미널 밖) 주인 없이(-) 넣고 한 줄 — 그 사건은 모든 지휘에게. --coord가 지휘가 아니면 거절
         --no-early: 선행 착지 전 「먼저 띄움」을 끈다(선행의 산출물 없이는 준비조차 못 하는 레인)
         --no-audit: 자동 감사(설정 audit)를 붙이지 않는다(지시문이 자기 감사를 정한 레인)
         --then <선행>: 같은 일의 다음 단계는 새 줄 없이 대기(wait) 중인 선행 줄 지시문 끝에 「## 이어서: <이름>」 절로 붙인다
         (넘길 때마다 맥락이 새고 숨은 결정이 부딪힌다 — 한 레인이 이어서). 그 절의 커밋 제목 머리는 <이름>: 이라 --after <이름>도 풀린다.
         선행이 없음·떠 있음·받은편지·감사 줄·다른 프로젝트, --after·--only·--priority·--no-early·--no-audit·--coord와 함께면 거절(종료 2).
         도는 run이 끝나기를 기다렸다가(run.lock) 붙인다. 겹치는 파일 때문에 순서만 필요한 일은 그대로 --after
         --after에 대기 중인 같은 프로젝트 레인을 주면 넣기는 그대로 하고 --then을 알리는 한 줄
  prio   대기 중인 레인의 우선순위를 바꾼다(떠 있는 레인은 거절)
  ls     레인·프로젝트·상태·주소·주인 지휘(-는 모든 지휘)·우선·선행·비고(이어서 <--then 이름>,…·자동 감사: 감사 중·감사 통과 보냄·감사 지적 n번째·지휘로 넘김)
  run    한 바퀴: (설정 inbox 줄이 있으면) 그 기계 받은편지를 걷어 대기열에 넣고, 끝난 받은편지 레인의 결과를 되돌려 쓴 뒤,
         대기 레인을 우선순위 높은 것부터(긴급>높음>보통>낮음, 같으면 넣은 차례) 보며, --after 레인이 모두 local 저장소 origin/<기본> 커밋 제목 머리에
         들어갔으면(안 풀린 것은 건너뛰고 다음 것을 본다) 설정의 machine 차례에서 처음 자리가 남는 기계에 띄운다. 띄운 뒤 HC_FILL_WAIT초(기본 60) 안에
         hc get status가 안 잡히면 그 기계를 그 레인에서 빼고 다음 기계로 간다(그 터미널은 끄지 않고 ls 비고에 남긴다).
         남긴 터미널이 나중에 살아나면 「중복 위험」을 찍고 그 레인은 더 띄우지 않는다.
         자리: working·blocked는 늘 셈. done·idle은 작업 트리(<저장소>.wt/…)가 남은 쓰기 레인만 세되, 레인 이름이 그 프로젝트
         origin/<기본> 커밋 제목 머리에 있으면(착지함) 또는 설정 hold분(기본 60, 0이면 끔) 넘게 쉬었으면 안 센다(셈 all 기계는 다 셈)
         먼저 띄움: 그러고도 자리가 남으면 --after에만 묶인 대기 레인(--no-early 빼고, 선행 가운데 대기열에서 아직 안 뜬 레인이
         있는 것도 빼고 — 그 선행이 자리를 먼저)을 같은 차례로 띄운다 — run 지시문 끝에
         「먼저 띄움」 절(준비만 → 선행마다 판정 줄로 기다림, 상한 설정 early_wait시간 → 착지 뒤 rebase·본 작업)을 붙이고
         ls에 「먼저 띄움(선행 …)」. 살아 있는 먼저 띄움 레인 수 상한은 설정 early(빈 값이면 남은 자리 전부, 0이면 끔)
         놀고 있음: 바퀴 끝에도 자리가 남은 기계가 설정 idle분(기본 10, 0이면 끔) 넘게 이어지면 hc-lane report --name hc-fill-idle
         「<기계> 자리 n개 m분째 빔 — 대기열에 띄울 것 없음」 사건을 대기 줄 주인 지휘들(살아 있는 것, 주인 없는 줄이 있거나
         대기 줄이 없으면 모든 지휘)의 watch에 보낸다. 같은 기계가 계속 비면 처음 알림 포함 30분 간격으로 세 번, 그 뒤 2시간마다.
         먼저 띄움 상한에 걸려 남긴 자리면 사유를 「먼저 띄움 상한(early n)에 걸려 남김」으로
         자동 감사(설정 audit = 감사 지시문 틀): 쓰기 레인(받은편지·--no-audit 줄 빼고) run 지시문 끝에 「감사·착지 (hc-fill 자동)」 절.
         레인이 hc-lane report 완료 <sha>를 하면 그 기계에 긴급 감사 줄 audit-<레인>(hc-lane --read, 작업 트리에서)을 넣고,
         감사의 판정(「감사 완료 <sha> 높음 n·중간 n·낮음 n」)이 높음·중간 0이면 레인에 「감사 통과」, 아니면 「감사 지적」을
         hc send(지적은 audit_max번까지, 기본 2). 상한·판정 못 읽음·보내기 세 번 실패는 그 레인 주인 지휘에 hc-lane report 막힘
  watch  run을 --every초마다(한 번에 하나만, 이미 돌면 종료 75)
설정: ${HERDR_TOOLS_CONFIG:-~/.config/herdr-tools}/hc-fill.tsv (칸 설명은 저장소 config.example/hc-fill.tsv)
대기열: ~/.local/share/hc-fill/queue.tsv, run 지시문: 그 기계 ~/.local/share/hc-fill/runs/<레인>-run.md
종료: 0 정상, 1 오류, 2 잘못 부름, 75 다른 run·watch가 돌고 있음
EOF
  exit 2
}

[ -f "$CONF" ] || die "설정 파일이 없다: $CONF (저장소 config.example/hc-fill.tsv를 복사해 값을 고친다)"
# 한 값 키: 키 혼자면 빈 값, 같은 키가 두 줄이면 멈춘다
dup=$(awk '$1 ~ /^(local|agent|coord|task|launch|gc|early|early_wait|idle|hold|audit|audit_max)$/ { if (c[$1]++ == 1) print $1 }' "$CONF")
[ -z "$dup" ] || die "설정에 $(echo $dup) 줄이 두 번 있다: $CONF"
conf() { awk -v k="$1" '$1==k { sub(/^[ \t]*[^ \t]+[ \t]*/, ""); sub(/[ \t]+$/, ""); print; exit }' "$CONF"; }
machines() { awk '$1=="machine" { print $2, $3, ($4 == "" ? "-" : $4), ($5 == "" ? "-" : $5) }' "$CONF"; }   # 차례대로: 이름 상한 레인상한 셈
repo_of() { awk -v p="$1" -v m="$2" '$1=="repo" && $2==p && $3==m { sub(/^[ \t]*repo[ \t]+[^ \t]+[ \t]+[^ \t]+[ \t]+/, ""); sub(/[ \t]+$/, ""); print; exit }' "$CONF"; }
LOCAL=$(conf local) AGENT=$(conf agent)
AGENT=${AGENT:-claude-code}
[ -n "$LOCAL" ] || die "설정에 local 줄이 없다: $CONF"

# 우선순위: 한·영 값을 대기열 값으로(모르면 실패), 대기열 값을 ls 글로, 줄 정렬 순번(옛 줄·빈 칸은 보통)
pnorm() { case $1 in 긴급 | urgent) echo urgent ;; 높음 | high) echo high ;; 보통 | normal) echo normal ;; 낮음 | low) echo low ;; *) return 1 ;; esac; }
plabel() { case $1 in urgent) echo 긴급 ;; high) echo 높음 ;; low) echo 낮음 ;; *) echo 보통 ;; esac; }
okname() { case $1 in '' | *[!abcdefghijklmnopqrstuvwxyz0123456789_-]*) return 1 ;; esac; [ ${#1} -le 32 ]; }
# kindwhy <이름>: 커밋 종류 낱말과 같은 이름이면 사유를 찍고 0 — 착지·선행 판정의 「<종류>(<범위>): 」 머리가 이름이 빈 채로도 맞아서
kindwhy() {
  case $1 in feat | fix | docs | style | refactor | perf | test | build | ci | chore | revert) ;; *) return 1 ;; esac
  printf '레인 이름이 커밋 종류(%s)와 같으면 착지·선행 판정이 아무 %s: 커밋에나 맞는다 — 다른 이름을 쓴다' "$1" "$1"
}
inlist() { case ",$2," in *",$1,"*) return 0 ;; esac; return 1; }   # inlist <값> <쉼표 목록>
# brief_bad <지시문>: 실제로 열어 읽어 본다(launchd 프로그램은 TCC로 ~/Documents가 stat은 되고 읽기만 막힌다).
# 못 읽거나 비었으면 까닭을 찍고 0, 읽히면 1
brief_bad() {
  [ -f "$1" ] || { echo 없음; return 0; }
  e=$(cat -- "$1" 2>&1 >/dev/null) || { e=${e##*: }; echo "${e:-읽기 실패}"; return 0; }
  grep -q '[^[:space:]]' -- "$1" || { echo "빈 파일"; return 0; }   # 공백·줄바꿈만 든 것도 빈 것
  return 1
}

# 대기열 쓰기는 모두 이 잠금 안에서(add·rm·run의 상태 바꿈이 서로 덮지 않게)
qlock() { mkdir -p "$DATA" && HC_FILL_Q=1 lockf -k -t 30 "$DATA/queue.lock" "$0" "$@"; }
qset() {  # qset <레인> <상태> <기계> <주소> <남긴것> [<먼저>] [<감사>]: 먼저 칸(14)·감사 칸(15)을 주면 옛 줄의 빈 칸은 -로 채워 거기에
  [ "${HC_FILL_Q-}" = 1 ] || { qlock _set "$@"; return; }
  awk -F'\t' -v OFS='\t' -v n="$1" -v s="$2" -v m="$3" -v a="$4" -v k="$5" -v e="${6-}" -v u="${7-}" '$1==n {$6=s; $7=m; $8=a; $9=k
    if (e != "") { for (i = NF + 1; i < 14; i++) $i = (i == 13 ? "normal" : "-"); $14 = e }
    if (u != "") { for (i = NF + 1; i < 15; i++) $i = (i == 13 ? "normal" : "-"); $15 = u } } 1' "$Q" >"$Q.tmp" && mv "$Q.tmp" "$Q"
}

# thenof <이름>: 그 이름이 「## 이어서: <이름> 」으로 붙은 대기열 줄 이름(없으면 빈 줄)
thenof() {
  awk -F'\t' '{print $1 "\t" $3}' "$Q" 2>/dev/null | while IFS=$'\t' read -r tn tb; do
    grep -q "^## 이어서: $1 " -- "$tb" 2>/dev/null && { echo "$tn"; break; }
  done
}

cmd=${1-}; [ $# = 0 ] || shift
case $cmd in
  _set) qset "$@"; exit ;;
  _then)   # _then <이름> <선행> <프로젝트> <지시문>: add --then이 run.lock·qlock 둘 다 쥐고 부른다
    # run은 지시문을 잠금 밖(launch의 cat)에서 읽고 hc-lane 띄우기·status 확인 뒤에야 up으로 바꾼다 — qlock만으로는 그 사이에
    # 붙인 절이 레인에 안 들어가고 사라진다. 그래서 run.lock(run 한 바퀴 내내)도 쥔다
    tl=$1 pre=$2
    row=$(awk -F'\t' -v n="$pre" '$1==n {print; exit}' "$Q" 2>/dev/null)
    if [ -z "$row" ]; then
      x=$(thenof "$pre"); [ -z "$x" ] || refuse "${pre}은 ${x}에 이어 붙였다 — --then $x"
      refuse "선행이 대기열에 없다: $pre"
    fi
    IFS=$'\t' read -r _ pp pb _ _ ps _ _ pst _ pr _ _ _ pk _ <<<"$row"
    [ "$ps" = wait ] || refuse "$pre: 이미 떴다($ps) — --after ${pre}으로 넣거나 그 레인에 hc send"
    # 상태 안 잡힘으로 남긴 터미널은 옛 run 지시문으로 돌 수 있다(살아나면 run은 다시 띄우지 않음 — 감사 [낮음] 1)
    [ "${pst:--}" = - ] || refuse "$pre: 상태 안 잡힘으로 남긴 터미널이 있다($pst) — 정리하고 rm 뒤 다시 add, 또는 --after $pre"
    # 사본 기능(add 때 복사) 전에 넣은 옛 줄은 원본을 가리킨다 — 원본은 고치지 않는다(감사 [낮음] 2)
    case $pb in "$DATA"/briefs/added/*) ;; *) refuse "$pre: 지시문이 사본이 아니다($pb) — rm 뒤 다시 add" ;; esac
    [ "${pr:--}" = - ] || refuse "$pre: 받은편지 줄에는 이어 붙이지 않는다"
    case ${pk:--} in audit=*) refuse "$pre: 자동 감사 줄에는 이어 붙이지 않는다" ;; esac
    [ "$pp" = "$3" ] || refuse "$pre: 프로젝트가 다르다($pp)"
    awk -F'\t' -v n="$tl" '$1==n {f=1} END {exit !f}' "$Q" && refuse "이미 대기열에 있다: $tl"
    x=$(thenof "$tl"); [ -z "$x" ] || refuse "${tl}은 이미 ${x}에 이어 붙였다"
    why=$(brief_bad "$4") && refuse "지시문을 읽지 못함($why): $4"
    # 임시 파일에 다 쓴 뒤 mv(반만 든 지시문이 보이지 않게)
    { cat -- "$pb" && printf '\n## 이어서: %s (hc-fill add --then, %s)\n위 일을 끝내 커밋한 뒤 같은 작업 트리에서 이어서 한다. 이 절의 커밋 제목 머리는 `%s:`으로 쓴다(이 이름을 --after로 기다리는 레인이 풀리게).\n위 일의 완료 보고·착지는 하지 않는다 — 이 절까지 끝낸 뒤 한 번만 report 완료.\n' \
      "$tl" "$(date +%Y-%m-%dT%H:%M)" "$tl" && cat -- "$4"; } >"$pb.then.$$" && mv -f "$pb.then.$$" "$pb" ||
      { rm -f "$pb.then.$$"; die "선행 지시문에 붙이지 못했다: $pb"; }
    echo "이어 붙임 $tl → $pre (새 레인 없음, 선행 지시문 $pb)"; exit 0 ;;
  _add)
    awk -F'\t' -v n="$1" '$1==n {f=1} END {exit !f}' "$Q" 2>/dev/null && die "이미 대기열에 있다: $1 (hc-fill ls)"
    [ -z "${HC_FILL_BRIEF_TMP-}" ] || mv -f "$HC_FILL_BRIEF_TMP" "$3" || die "지시문 사본을 두지 못했다: $3"   # add: 이름이 새것일 때만 사본을 제자리에
    (IFS=$'\t'; printf '%s\n' "$*") >>"$Q"; exit ;;
  _put)   # 자동 감사 줄: 같은 이름 줄(지난 바퀴의 감사)을 새 줄로 바꾼다 — 이름 충돌로 막히지 않게
    awk -F'\t' -v n="$1" '$1!=n' "$Q" >"$Q.tmp" && (IFS=$'\t'; printf '%s\n' "$*") >>"$Q.tmp" && mv "$Q.tmp" "$Q"; exit ;;
  _rm)
    awk -F'\t' -v n="$1" '$1==n {f=1} END {exit !f}' "$Q" 2>/dev/null || die "대기열에 없다: $1"
    awk -F'\t' -v n="$1" '$1!=n' "$Q" >"$Q.tmp" && mv "$Q.tmp" "$Q"; exit ;;
  _prio)
    st=$(awk -F'\t' -v n="$1" '$1==n {print $6; exit}' "$Q" 2>/dev/null)
    [ -n "$st" ] || die "대기열에 없다: $1"
    [ "$st" = wait ] || die "대기 중이 아니다($st): $1 — 우선순위는 띄우기 전에만 바꾼다"
    # 옛 줄(11·12칸)은 빈 칸을 -로 채워 열셋째 칸에
    awk -F'\t' -v OFS='\t' -v n="$1" -v p="$2" '$1==n { for (i = NF + 1; i < 13; i++) $i = "-"; $13 = p } 1' "$Q" >"$Q.tmp" && mv "$Q.tmp" "$Q"; exit ;;

  add)
    name= proj= brief= after=- only=- coord= cx= prio=normal early=- aud=- thn= xo=
    while [ $# -gt 0 ]; do
      case $1 in --no-early | --no-audit | --after | --only | --priority | --coord) xo="$xo $1" ;; esac   # --then과 함께 못 씀
      [ "$1" != --no-early ] || { early=no-early; shift; continue; }
      [ "$1" != --no-audit ] || { aud=no-audit; shift; continue; }
      [ $# -ge 2 ] || usage
      case $1 in --name) name=$2 ;; --project) proj=$2 ;; --brief) brief=$2 ;; --after) after=$2 ;; --only) only=$2 ;; --coord) coord=$2 cx=1 ;;
        --then) thn=$2 ;;
        --priority) prio=$(pnorm "$2") || die "--priority는 긴급|높음|보통|낮음(urgent|high|normal|low): $2" ;; *) usage ;; esac
      shift 2
    done
    if [ -n "$thn" ]; then
      DRC=2   # 아래 검사에 걸리면 거절(종료 2), 아무것도 바꾸지 않음
      [ -z "$xo" ] || die "--then은${xo}와 함께 쓰지 않는다 — 이어 붙인 일은 선행 줄의 설정·주인을 따른다"
      okname "$thn" || die "--then 레인 이름: $thn"
    fi
    okname "$name" || die "--name은 a-z 0-9 - _ 32자까지: $name"
    case $name in audit-*) die "--name은 audit- 로 시작하지 않는다(자동 감사 줄 이름 자리): $name" ;; esac
    w=$(kindwhy "$name") && die "$w"
    awk -v p="$proj" '$1=="repo" && $2==p {f=1} END {exit !f}' "$CONF" || die "설정에 repo 줄이 없는 프로젝트: $proj"
    case $brief in /*) ;; *) brief=$PWD/$brief ;; esac
    [ -f "$brief" ] || die "지시문이 없다: $brief"
    case $brief in *[[:space:]]*) die "지시문 경로에 공백을 쓰지 않는다: $brief" ;; esac
    why=$(brief_bad "$brief") && die "지시문을 읽지 못함($why): $brief"
    if [ -n "$thn" ]; then
      mkdir -p "$DATA" && lockf -k -t "${HC_FILL_THEN_WAIT:-600}" "$DATA/run.lock" env HC_FILL_Q=1 lockf -k -t 30 "$DATA/queue.lock" "$0" _then "$name" "$thn" "$proj" "$brief"
      rc=$?; [ $rc != 75 ] || echo "hc-fill: run 바퀴나 대기열 잠금이 끝나지 않아 그만뒀다, 다시 부른다" >&2
      exit $rc
    fi
    x=$(thenof "$name"); [ -z "$x" ] || die "${name}은 이미 ${x}에 이어 붙였다(--then) — 다른 이름으로"
    [ "$after" = - ] || for a in $(printf %s "$after" | tr , ' '); do okname "$a" || die "--after 레인 이름: $a"; w=$(kindwhy "$a") && die "--after: $w"; done
    [ "$only" = - ] || for m in $(printf %s "$only" | tr , ' '); do
      machines | awk -v m="$m" '$1==m {f=1} END {exit !f}' || die "설정에 machine 줄이 없는 기계: $m"
    done
    # 주인 지휘: 지휘 정보를 남겨(hc-lane coord --set) 그 지휘 watch가 뜨고 보내게. 지휘가 아니면 --coord는 거절, 저절로 잡은 것은 -
    [ -n "$cx" ] || coord=${HC_TERMINAL_ID-}
    if [ -n "$coord" ]; then
      case $coord in *[!A-Za-z0-9_./-]*) die "--coord 주소 글자: $coord" ;; esac
      if ! ce=$(hc-lane coord --set "$coord" 2>&1 </dev/null); then
        [ -z "$cx" ] || die "--coord $coord 를 지휘로 적지 못했다: $(printf '%s\n' "$ce" | tail -n 1)"
        echo "알림: $coord 는 지휘 터미널이 아니라 주인 없이 넣음 — 이 레인 사건은 모든 지휘에게 간다 ($(printf '%s\n' "$ce" | tail -n 1))"; coord=
      fi
    fi
    # 지시문은 내용을 데이터 폴더로 복사해 둔다(launchd의 run이 ~/Documents 같은 곳을 못 읽어도 띄울 수 있게)
    bf=$DATA/briefs/added/$name.md
    mkdir -p "${bf%/*}" && cat -- "$brief" >"$bf.tmp.$$" && [ -s "$bf.tmp.$$" ] ||
      { rm -f "$bf.tmp.$$"; die "지시문을 복사하지 못했다: $brief → $bf"; }
    HC_FILL_BRIEF_TMP=$bf.tmp.$$ qlock _add "$name" "$proj" "$bf" "$after" "$only" wait - - - "$(date +%Y-%m-%dT%H:%M)" - "${coord:--}" "$prio" "$early" "$aud" ||
      { rm -f "$bf.tmp.$$"; exit 1; }
    note=; [ "$after" = - ] || note=", 선행 $after"; [ "$only" = - ] || note="$note, 기계 $only"; note="$note, 주인 ${coord:-없음(모든 지휘)}, 우선 $(plabel "$prio")"; [ "$early" = - ] || note="$note, 먼저 띄움 끔"; [ "$aud" = - ] || note="$note, 자동 감사 끔"
    echo "더함 $name ($proj$note)"
    [ "$after" = - ] || for a in $(printf %s "$after" | tr , ' '); do
      awk -F'\t' -v n="$a" -v p="$proj" '$1==n && $6=="wait" && $2==p && ($11=="" || $11=="-") && $15 !~ /^audit=/ {f=1} END {exit !f}' "$Q" &&
        echo "알림: ${a}가 아직 대기 중 — 같은 일의 다음 단계면 --after 대신 --then ${a}로 한 레인에 이어 붙인다"
    done
    exit 0 ;;

  rm) [ $# = 1 ] || usage; qlock _rm "$1" || exit 1; echo "뺌 $1 (떠 있는 터미널은 그대로)"; exit 0 ;;
  prio)
    [ $# = 2 ] || usage
    p=$(pnorm "$2") || die "우선순위는 긴급|높음|보통|낮음(urgent|high|normal|low): $2"
    qlock _prio "$1" "$p" || exit 1; echo "우선 $1 → $(plabel "$p")"; exit 0 ;;

  ls)
    st=$(hc ls --json) || die "hc ls 실패"
    st=$(printf '%s\n' "$st" | jq -r '.terminals[] | [.address, (.status // "-" | tostring)] | @tsv') || die "hc ls --json 출력을 읽지 못했다"
    printf '%-24s %-10s %-14s %-24s %-8s %-4s %s\n' 레인 프로젝트 상태 주소 주인 우선 선행·비고
    [ -f "$Q" ] || exit 0
    while IFS=$'\t' read -r -u 3 name proj brief after only state m addr stuck added reply owner prio early ak _; do
      if [ "$state" = wait ]; then s=대기 a=-
      elif [ "$state" = sent ]; then s=되돌려줌 a=$addr
      else
        live=$(printf '%s\n' "$st" | awk -F'\t' -v a="$addr" '$1==a {print $2; exit}')
        if [ -n "$live" ]; then s="떠 있음($live)"; else s=끝남; fi; a=$addr
      fi
      note=; [ "$after" = - ] || note="선행 $after"; [ "$only" = - ] || note="$note 기계 $only"
      case ${early-} in early) note="먼저 띄움(선행 $after)${note#"선행 $after"}" ;; no-early) note="$note 먼저 띄움 끔" ;; esac
      [ "$stuck" = - ] || note="$note 상태 안 잡힘 남김 $stuck"
      [ "${reply:--}" = - ] || note="$note 받은편지 ${reply%%:*}"
      tn=$(sed -n 's/^## 이어서: \([a-z0-9_-]*\) .*/\1/p' "$brief" 2>/dev/null | paste -sd , -)
      [ -z "$tn" ] || note="$note 이어서 $tn"
      case ${ak:--} in
        no-audit) note="$note 자동 감사 끔" ;;
        audit=*) note="$note 감사 대상 ${ak#audit=}" ;;
        auto) note="$note $(cat "$DATA/audit.tsv" 2>/dev/null | awk -F'\t' -v n="$name" '$1==n { r = $3; f = $4; s = $5 } END {
            if (s == "queued") print "감사 중(" r "번째)"; else if (s == "pass") print "감사 통과 보냄"
            else if (s == "fix") print "감사 지적 " f "번째"; else if (s == "coord") print "지휘로 넘김"; else if (s == "nosha") print "지휘로 넘김(완료에 sha 없음)"; else print "자동 감사(완료 기다림)" }')" ;;
      esac
      printf '%-24s %-10s %-14s %-24s %-8s %-4s %s\n' "$name" "$proj" "$s" "$a" "${owner:--}" "$(plabel "${prio-}")" "${note# }"
    done 3<"$Q"
    exit 0 ;;

  watch)
    every=60
    while [ $# -gt 0 ]; do case $1 in --every) [ $# -ge 2 ] || usage; every=$2; shift 2 ;; *) usage ;; esac; done
    case $every in '' | *[!0-9]*) usage ;; esac
    if [ "${HC_FILL_W-}" != 1 ]; then
      mkdir -p "$DATA"
      HC_FILL_W=1 lockf -s -k -t 0 "$DATA/watch.lock" "$0" watch --every "$every"; rc=$?
      [ $rc != 75 ] || echo "hc-fill: watch가 이미 돌고 있다($DATA/watch.lock)" >&2
      exit $rc
    fi
    while :; do echo "--- $(date '+%F %T')"; "$0" run; sleep "$every"; done ;;

  run) ;;
  *) usage ;;
esac

# ---- run: 한 바퀴 ----
dry=0
while [ $# -gt 0 ]; do case $1 in --dry-run) dry=1; shift ;; *) usage ;; esac; done
if [ "${HC_FILL_R-}" != 1 ]; then
  mkdir -p "$DATA"
  if [ $dry = 1 ]; then set -- --dry-run; fi
  HC_FILL_R=1 lockf -s -k -t 0 "$DATA/run.lock" "$0" run "$@"; rc=$?
  [ $rc != 75 ] || echo "hc-fill: 다른 run이 돌고 있다, 이번 바퀴는 건너뜀" >&2
  exit $rc
fi
P=; [ $dry = 1 ] && P='[dry-run] '

# 끝난 레인 정리: 설정 gc 분(기본 60, 0이면 끔)마다 한 번, repo 줄의 기계·저장소마다 hc-lane gc. 원격 중간 참조(--integ)는
# 프로젝트마다 local 기계의 저장소에서 한 번. 시각은 돌리기 전에 적는다(실패·멈춤이 바퀴마다 되풀이되지 않게). dry-run은 적지 않는다
gc_tick() {
  gm=$(conf gc); gm=${gm:-60}
  case $gm in *[!0-9]*) echo "알림: 설정 gc는 분(숫자)이다, 정리 건너뜀: $gm"; return ;; esac
  gm=$((10#$gm))   # 08·09도 십진수로(감사 [낮음] 2)
  [ "$gm" != 0 ] || return 0
  gl=$(cat "$DATA/gc.last" 2>/dev/null); gn=$(date +%s)
  case $gl in '' | *[!0-9]*) gl=0 ;; esac
  [ $((gn - gl)) -ge $((gm * 60)) ] || return 0
  [ $dry = 1 ] || echo "$gn" >"$DATA/gc.last"
  gcon=$(connected)
  awk '$1=="repo" {print $2, $3}' "$CONF" | while read -r gp gmach; do
    gr=$(repo_of "$gp" "$gmach"); [ -n "$gr" ] || continue
    if [ "$gmach" = "$LOCAL" ]; then set -- --integ
    elif printf '%s\n' "$gcon" | grep -Fxq -- "$gmach"; then set -- --on "$gmach"
    else echo "gc 건너뜀 $gp @$gmach: 연결 안 됨"; continue; fi
    [ $dry = 0 ] || set -- "$@" --dry-run
    go=$(hc-lane gc "$@" --repo "$gr" 2>&1 </dev/null); grc=$?
    printf '%s\n' "$go" | sed "s|^|gc $gp @$gmach: |"
    [ $grc = 0 ] || echo "gc 실패 $gp @$gmach (종료 $grc)"
  done
}

connected() { hc machine ls --json 2>/dev/null | jq -r '.machines | arrays | map(select(.state == "connected") | .name) | join("\n")' 2>/dev/null; }
up_ok() { [ "$1" = "$LOCAL" ] || printf '%s\n' "$ICON" | grep -Fxq -- "$1"; }   # ICON: 연결된 기계 목록
X='d=$1; shift; case $d in "~/"*) d=$HOME/${d#"~/"} ;; esac; '   # 원격 sh 머리: 첫 인자 경로의 ~/ 를 그 기계 HOME으로
onm() {  # onm [-i] <기계> <sh 본문> <경로> [인자…]: 그 기계에서(local이면 바로) sh로. -i 없으면 표준 입력은 /dev/null
  i=; [ "$1" != -i ] || { i=1; shift; }
  om=$1 ob=$X$2; shift 2
  if [ "$om" = "$LOCAL" ]; then
    if [ -n "$i" ]; then sh -c "$ob" _ "$@"; else sh -c "$ob" _ "$@" </dev/null; fi
  elif [ -n "$i" ]; then hc exec -i --on "$om" -- sh -c "$ob" _ "$@"
  else hc exec --on "$om" -- sh -c "$ob" _ "$@" </dev/null; fi
}

# 받은편지 걷기: 설정 inbox <기계> <폴더> 줄마다, 그 기계 폴더의 <이름>.req(키<TAB>값 줄: project·after·only)를 검사해
# <이름>.brief.md를 $DATA/briefs/<기계>/<이름>.md로 복사하고 대기열에 넣은 뒤(되돌릴곳 <기계>:<폴더>/done/<이름>.md)
# 그 기계에서 둘을 taken/으로 옮긴다. 검사에 걸리면 둘을 rejected/로 옮기고 rejected/<이름>.why에 사유 한 줄.
# 실행 명령·경로·모델은 받지 않는다(설정이 정한다). 연결 안 된 기계는 건너뛴다(요청은 그 기계에 그대로 쌓인다)
inbox_tick() {
  awk '$1=="inbox" {f=1} END {exit !f}' "$CONF" || return 0
  ICON=$(connected)
  while read -r -u 6 _ im idir; do
    [ -n "$idir" ] || { echo "알림: 설정 inbox 줄에 폴더가 없다: $im"; continue; }
    up_ok "$im" || { echo "받은편지 건너뜀 $im: 연결 안 됨"; continue; }
    names=$(onm "$im" 'for f in "$d"/*.req; do [ -f "$f" ] || continue; f=${f##*/}; printf "%s\n" "${f%.req}"; done' "$idir") ||
      { echo "받은편지 건너뜀 $im: 목록을 읽지 못했다"; continue; }
    while IFS= read -r -u 7 n; do
      [ -n "$n" ] || continue
      why= p= a=- o=- pr=high
      if ! okname "$n"; then why="이름은 a-z 0-9 - _ 32자까지"
      elif case $n in audit-*) true ;; *) false ;; esac; then why="이름은 audit- 로 시작하지 않는다(자동 감사 줄 이름 자리)"
      elif why=$(kindwhy "$n"); then :
      elif ! req=$(onm "$im" 'cat "$d/$1.req"' "$idir" "$n"); then echo "받은편지 $im $n: .req를 읽지 못했다, 다음 바퀴에"; continue
      else
        p=$(printf '%s\n' "$req" | awk -F'\t' '$1=="project" {print $2; exit}')
        a=$(printf '%s\n' "$req" | awk -F'\t' '$1=="after" {print $2; exit}'); a=${a:--}
        o=$(printf '%s\n' "$req" | awk -F'\t' '$1=="only" {print $2; exit}'); o=${o:--}
        # 우선순위: 적혀 있으면 그 값, 없으면 높음(회원이 겪는 오류 수정이 기능 개발보다 먼저 — 2026-11-17 지휘 결정)
        x=$(printf '%s\n' "$req" | awk -F'\t' '$1=="priority" {print $2; f=1; exit} END {if (!f) print "-"}')
        [ "$x" = - ] || pr=$(pnorm "$x") || { pr=high; why="모르는 priority: $x (긴급|높음|보통|낮음 또는 urgent|high|normal|low)"; }
        awk -v p="$p" '$1=="repo" && $2==p {f=1} END {exit !f}' "$CONF" || why="설정에 없는 project: ${p:-(없음)}"
        [ "$a" = - ] || for x in $(printf %s "$a" | tr , ' '); do okname "$x" || why="after 레인 이름: $x"; w=$(kindwhy "$x") && why="after: $w"; done
        [ "$o" = - ] || for x in $(printf %s "$o" | tr , ' '); do
          machines | awk -v m="$x" '$1==m {f=1} END {exit !f}' || why="설정에 없는 only 기계: $x"
        done
      fi
      had=$(awk -F'\t' -v n="$n" '$1==n {print ($11 == "" ? "-" : $11); exit}' "$Q" 2>/dev/null)
      hst=$(awk -F'\t' -v n="$n" '$1==n {print $6; exit}' "$Q" 2>/dev/null)
      if [ -z "$why" ] && [ -n "$had" ]; then
        if [ "$had" != "$im:$idir/done/$n.md" ]; then why="이미 대기열에 있는 이름"
        elif [ "$hst" = sent ]; then why="이미 끝난 이름(결과를 되돌려 줌) — 새 이름으로 다시 요청"
        else   # 같은 요청을 넣고 taken/으로 못 옮긴 것인지, 같은 이름의 새 요청인지: taken/에 이미 있으면 새 요청
          case $(onm "$im" 'if [ -f "$d/taken/$1.req" ]; then echo yes; else echo no; fi' "$idir" "$n") in
            yes) why="이미 받아 진행 중인 이름 — 새 이름으로 다시 요청" ;;
            no) ;;
            *) echo "받은편지 $im $n: taken/을 확인하지 못했다, 다음 바퀴에"; continue ;;
          esac
        fi
      fi
      if [ -z "$why" ] && [ -z "$had" ]; then   # 없음(no)만 거절, 확인 못 함은 다음 바퀴에
        case $(onm "$im" 'if grep -q "[^[:space:]]" "$d/$1.brief.md" 2>/dev/null; then echo yes; else echo no; fi' "$idir" "$n") in
          yes) ;;
          no) why="지시문 $n.brief.md가 없거나 비었다" ;;
          *) echo "받은편지 $im $n: 지시문을 확인하지 못했다, 다음 바퀴에"; continue ;;
        esac
      fi
      if [ -n "$why" ]; then
        if [ $dry = 1 ]; then echo "${P}거절할 $im $n: $why"; continue; fi
        onm "$im" 'mkdir -p "$d/rejected" && for e in req brief.md; do [ ! -f "$d/$1.$e" ] || mv -f "$d/$1.$e" "$d/rejected/" || exit 1; done &&
          printf "%s\n" "$2" >"$d/rejected/$1.why.tmp" && mv -f "$d/rejected/$1.why.tmp" "$d/rejected/$1.why"' "$idir" "$n" "$why" &&
          echo "거절 $im $n: $why" || echo "받은편지 $im $n: 거절($why)을 쓰지 못했다, 다음 바퀴에"
        continue
      fi
      if [ $dry = 1 ]; then echo "${P}받을 $im $n ($p)"; continue; fi
      if [ -z "$had" ]; then   # 이미 있으면(지난 바퀴에 넣고 옮기지 못함) 옮기기만
        bf=$DATA/briefs/$im/$n.md
        mkdir -p "${bf%/*}" && onm "$im" 'cat "$d/$1.brief.md"' "$idir" "$n" >"$bf.tmp" && mv -f "$bf.tmp" "$bf" ||
          { echo "받은편지 $im $n: 지시문을 가져오지 못했다, 다음 바퀴에"; continue; }
        qlock _add "$n" "$p" "$bf" "$a" "$o" wait - - - "$(date +%Y-%m-%dT%H:%M)" "$im:$idir/done/$n.md" - "$pr" - - || continue
        echo "받음 $im $n → 대기열 ($p, 우선 $(plabel "$pr"))"
      fi
      onm "$im" 'mkdir -p "$d/taken" && mv -f "$d/$1.req" "$d/taken/" && { [ ! -f "$d/$1.brief.md" ] || mv -f "$d/$1.brief.md" "$d/taken/"; }' "$idir" "$n" ||
        echo "받은편지 $im $n: taken/으로 옮기지 못했다, 다음 바퀴에 다시"
    done 7<<<"$names"
  done 6<<<"$(awk '$1=="inbox"' "$CONF")"
}

# 되돌려 주기: up이고 되돌릴곳이 있는 줄. 레인 기계에 보고(~/.local/share/hc-fill/reports/<레인>.md)가 있고 터미널이 사라졌거나
# done·idle이면 그 보고를, 보고 없이 터미널이 사라졌으면 「결과: 실패 보고 없음」을 요청한 기계에 쓰고 상태 sent.
# 레인 기계나 요청한 기계가 연결 안 됨이면 다음 바퀴로(연결 안 된 기계의 터미널은 hc ls에 없어 사라진 것으로 보이므로)
reply_tick() {
  ICON=$CONN
  while IFS=$'\t' read -r -u 6 n _ _ _ _ _ m a stuck _ rp _; do
    [ -n "$n" ] || continue
    rq=${rp%%:*} rpath=${rp#*:}
    if ! up_ok "$m" || ! up_ok "$rq"; then echo "되돌려 주기 미룸 $n: $m 또는 $rq 연결 안 됨"; continue; fi
    st=$(printf '%s\n' "$TERMS" | awk -F'\t' -v a="$a" '$2==a {print $5; f=1; exit} END {if (!f) print "gone"}')
    case $st in gone | done | idle) ;; *) continue ;; esac
    rep=$(onm "$m" 'if [ -f "$d" ]; then echo HAVE; cat "$d"; else echo NONE; fi' "~/.local/share/hc-fill/reports/$n.md") ||
      { echo "되돌려 주기 미룸 $n: $m 에서 보고를 읽지 못했다"; continue; }
    case $rep in
      HAVE*) body=${rep#HAVE}; body=${body#?} ;;
      NONE) [ "$st" = gone ] || continue
        hc get "$a" --json 2>&1 </dev/null | grep -Eq '"not_found"|"state" *: *"finished"' ||   # 없어졌거나 프로세스가 끝남
          { echo "되돌려 주기 미룸 $n: hc ls에 없지만 hc get이 없음(not_found)·끝남(finished)이라 하지 않는다"; continue; }
        body="결과: 실패 보고 없음" ;;
      *) echo "되돌려 주기 미룸 $n: $m 에서 보고를 읽지 못했다"; continue ;;
    esac
    last=$(printf '%s\n' "$body" | tail -n 1)
    if [ $dry = 1 ]; then echo "${P}되돌려 줄 $n → $rp ($last)"; continue; fi
    printf '%s\n' "$body" | onm -i "$rq" 'mkdir -p "${d%/*}" && cat >"$d.tmp" && mv -f "$d.tmp" "$d"' "$rpath" ||
      { echo "되돌려 주기 실패 $n → $rp, 다음 바퀴에"; continue; }
    qset "$n" sent "$m" "$a" "$stuck"
    echo "되돌려 줌 $n → $rp ($last)"
  done 6<<<"$(awk -F'\t' '$6=="up" && $11!="" && $11!="-"' "$Q" 2>/dev/null)"
}

# 자리 세기 전에 끝나는 바퀴(빈 대기열 + idle 0, die 등)는 held.tsv를 비운다 — 그동안 못 본 레인이 묵은 시각을 물려받지 않게
# (감사 [낮음] 1). 다 세면 HELDW=1. dry-run은 건드리지 않는다
HELDW=
trap '[ $dry = 1 ] || [ -n "$HELDW" ] || : 2>/dev/null >"$DATA/held.tsv"' EXIT
inbox_tick
IDLE=$(conf idle); IDLE=${IDLE:-10}
case $IDLE in *[!0-9]*) echo "알림: 설정 idle은 분(숫자)이다, 놀고 있음 알림 끔: $IDLE"; IDLE=0 ;; esac
IDLE=$((10#$IDLE))
# 대기열이 비어도 놀고 있음 알림은 자리를 봐야 한다(그때가 「띄울 것 없음」의 바로 그 꼴)
[ -s "$Q" ] || { echo "대기열 비었음"; [ "$IDLE" != 0 ] || { gc_tick; exit 0; }; }

TASK=$(conf task) LAUNCH=$(conf launch) COORD=${HC_FILL_COORD:-$(conf coord)}
[ -n "$TASK" ] || TASK='{run}'
case $LAUNCH in *'{task}'*) ;; *) die "설정 launch 줄에 {task} 자리가 없다: $CONF" ;; esac
case $TASK in *'{run}'*) ;; *) die "설정 task 줄에 {run} 자리가 없다: $CONF" ;; esac
AUD=$(conf audit); case $AUD in "~/"*) AUD=$HOME/${AUD#"~/"} ;; esac
AMAX=$(conf audit_max); AMAX=${AMAX:-2}
case $AMAX in *[!0-9]*) echo "알림: 설정 audit_max는 횟수(숫자)다, 2로: $AMAX"; AMAX=2 ;; esac
[ -z "$AUD" ] || ! why=$(brief_bad "$AUD") || die "설정 audit 틀을 읽지 못함($why): $AUD"

# 이번 바퀴의 터미널 표: 기계 주소 종류 이름 상태 cwd (local 기계 주소에는 / 가 없다)
# hc가 실패하면(빈 표로 읽어 자리가 다 빈 것처럼 띄우지 않게) 이 바퀴를 멈춘다
raw=$(hc ls --json) && [ -n "$raw" ] || die "hc ls 실패, 이번 바퀴는 띄우지 않았다"
TERMS=$(printf '%s\n' "$raw" | jq -r --arg l "$LOCAL" '.terminals | arrays | .[] |
  [(if (.address | contains("/")) then (.address | split("/")[0]) else $l end), .address, (.agent // "-"), (.name // "-"),
   (.status | if type == "object" then (.state // "-") elif . == null then "-" else tostring end), (.cwd // "-")] | @tsv') &&
  printf '%s\n' "$raw" | jq -e '.terminals | arrays' >/dev/null || die "hc ls --json 출력을 읽지 못했다, 이번 바퀴는 띄우지 않았다"
# hc-lane 레인(라벨 hc-lane=1) 주소: 상태 훅을 아직 안 보낸 레인은 hc ls에 agent가 argv 첫 낱말(env)·status가 null로 온다
LANEADDR=$(hc ls --label hc-lane=1 --json | jq -r '.terminals | arrays | .[].address') ||
  die "hc ls --label hc-lane=1 실패, 이번 바퀴는 띄우지 않았다"
raw=$(hc machine ls --json) && [ -n "$raw" ] || die "hc machine ls 실패, 이번 바퀴는 띄우지 않았다"
printf '%s\n' "$TERMS" | awk -F'\t' -v g="$AGENT" '$3==g {f=1} END {exit !f}' ||
  die "경고: hc ls에 $AGENT 종류가 하나도 없다(지휘 자신도 그 종류라 늘 하나는 있어야 한다). 설정 agent 값이나 hc의 이름이 바뀌었는지 본다. 이번 바퀴는 띄우지 않았다"
CONN=$(printf '%s\n' "$raw" | jq -er '.machines | arrays | map(select(.state == "connected") | .name) | join("\n")') ||
  die "hc machine ls --json 출력을 읽지 못했다, 이번 바퀴는 띄우지 않았다"
reply_tick
# 자동 감사(설정 audit — 2026-11-19 fill-auto-audit: 완료 → 지휘가 감사를 띄움 → 판정을 봄 → 착지 지시 왕복이 지휘 한 사람에게
# 줄을 서 레인이 3~10시간 자리를 붙잡았다). 감사·착지 절을 붙여 띄운 쓰기 레인(감사 칸 auto)이 「완료 <sha>」를 적으면 그 기계에
# 긴급 감사 줄 audit-<레인>을 넣고, 감사 줄의 「판정」을 읽어 레인에 통과·지적을 hc send. 사건은 hc-lane events 한 번(볼 기계마다 --on).
# 레인·감사의 사건은 그 터미널(대기열 주소)이 그 이름으로 적은 것만 본다(hc-fill이 --name으로 남긴 막힘 등은 안 셈).
# 기록 $DATA/audit.tsv: 레인 sha 몇번째 지적수 상태 보내기실패 판정없음(바퀴) — 상태 queued(감사에 넘김)·pass(통과 보냄)·fix(지적 보냄)·
# coord(지휘로 넘김)·nosha(완료에 sha 없음을 지휘에). 쓰기 줄을 새로 띄울 때 그 레인 줄을 지운다(같은 이름 새 일이 옛 기록을 안 물려받게)
AT=$DATA/audit.tsv
aget() { awk -F'\t' -v n="$1" '$1==n' "$AT" 2>/dev/null | tail -n 1; }
aput() {  # aput <레인> <sha> <몇번째> <지적수> <상태> <실패> [<판정없음>]: 그 레인 줄을 바꾼다(dry-run은 안 씀)
  [ $dry = 0 ] || return 0
  { awk -F'\t' -v n="$1" '$1!=n' "$AT" 2>/dev/null; printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" "$5" "$6" "${7:-0}"; } >"$AT.tmp" && mv -f "$AT.tmp" "$AT"
}
adel() {  # adel <레인>: 그 레인 줄을 지운다(없으면 그대로)
  [ $dry = 0 ] && [ -f "$AT" ] && awk -F'\t' -v n="$1" '$1==n {f=1} END {exit !f}' "$AT" || return 0
  awk -F'\t' -v n="$1" '$1!=n' "$AT" >"$AT.tmp" && mv -f "$AT.tmp" "$AT"
}
lalive() { printf '%s\n' "$TERMS" | awk -F'\t' -v a="$1" -v n="$2" '$2==a && $4==n {f=1} END {exit !f}'; }   # 그 주소에 그 이름 터미널
# audname <레인>: 감사 줄 이름. audit-<레인>이 32자를 넘으면 audit-<앞 21자>-<레인 cksum 아래 16비트 4자리 16진>(32자)
audname() {
  an=audit-$1; [ ${#an} -le 32 ] || an=audit-$(printf %s "$1" | cut -c 1-21)-$(printf %s "$1" | cksum | awk '{printf "%04x", $1 % 65536}')
  echo "$an"
}
alive() { printf '%s\n' "$TERMS" | awk -F'\t' -v a="$1" '$2==a {print $5; f=1; exit} END {if (!f) print "gone"}'; }   # 상태 또는 gone
lastev() {  # lastev <이름> <터미널> [<상태>]: 그 터미널이 그 이름으로 적은 마지막 사건 줄(events는 시각 순)
  printf '%s\n' "$EV" | awk -F'\t' -v n="$1" -v a="$2" -v s="${3-}" '$4==n && $3==a && (s == "" || $5==s) {l=$0} END {print l}'
}
aesc() {  # aesc <레인> <주인|-> <글>: 그 레인 주인 지휘(없으면 모든 지휘)에 막힘 사건. 0 남김(dry-run 포함)
  if [ $dry = 1 ]; then echo "${P}지휘로 넘길 $1: $3"; return 0; fi
  ao=$2; [ "$ao" != - ] || ao=
  if env -u HC_TERMINAL_ID -u HC_LANE hc-lane report 막힘 - "$3" --name "$1" ${ao:+--to "$ao"} >/dev/null 2>&1 </dev/null; then
    echo "지휘로 넘김 $1 → ${ao:-모든 지휘}: $3"; return 0
  fi
  echo "지휘로 넘기기 실패 $1(hc-lane report) — 다음 바퀴에 다시"; return 1
}
audit_tick() {
  [ -n "$AUD" ] && [ -s "$Q" ] || return 0
  # 볼 줄: 쓰기 줄(up·auto)은 터미널이 살아 있을 때, 감사 줄(up·audit=)은 그 레인이 감사에 넘겨진(queued) 동안
  LROWS= AROWS= ams=
  while IFS=$'\t' read -r -u 6 n _ _ _ _ _ m a _ _ _ _ _ _ k _; do
    case $k in
      auto) [ "$(alive "$a")" != gone ] || continue; LROWS="$LROWS$n
" ;;
      audit=*) [ "$(aget "${k#audit=}" | cut -f 5)" = queued ] || continue; AROWS="$AROWS$n
" ;;
      *) continue ;;
    esac
    [ "$m" = "$LOCAL" ] || inlist "$m" "$ams" || ams="$ams,$m"
  done 6<<<"$(awk -F'\t' '$6=="up" && ($15=="auto" || $15 ~ /^audit=/)' "$Q")"
  [ -n "$LROWS$AROWS" ] || return 0
  set --; for m in $(printf %s "$ams" | tr , ' '); do
    if printf '%s\n' "$CONN" | grep -Fxq -- "$m"; then set -- "$@" --on "$m"; else echo "자동 감사 미룸 @$m: 연결 안 됨"; fi
  done
  EV=$(hc-lane events "$@" 2>/dev/null </dev/null) || { echo "자동 감사 미룸: hc-lane events 실패, 다음 바퀴에"; return 0; }
  AUNK=$(printf '%s\n' "$EV" | sed -n 's/^모름 //p')
  aok() { [ "$1" = "$LOCAL" ] || { printf '%s\n' "$CONN" | grep -Fxq -- "$1" && ! printf '%s\n' "$AUNK" | grep -Fxq -- "$1"; }; }
  qrow() { awk -F'\t' -v n="$1" '$1==n {print; exit}' "$Q"; }
  # 1) 판정: 감사 줄마다 그 감사 터미널의 마지막 「판정」에서 높음·중간·낮음 수를 뽑아 레인에 통과·지적(또는 지휘로)
  while IFS= read -r -u 6 an; do
    [ -n "$an" ] || continue
    IFS=$'\t' read -r _ _ _ _ _ _ m aa _ _ _ _ _ _ k _ <<<"$(qrow "$an")"
    n=${k#audit=}
    IFS=$'\t' read -r _ _ _ _ _ _ lm la _ _ _ lo _ <<<"$(qrow "$n")"
    IFS=$'\t' read -r _ ash ar af ast afl anv <<<"$(aget "$n")"
    aok "$m" || continue
    rep="~/.local/share/hc-fill/reports/$an.md"
    v=$(lastev "$an" "$aa" 판정)
    if [ -z "$v" ]; then
      # 판정 없이 감사 터미널이 끝났거나(done·idle — 완료로 잘못 적음·판정 빠뜨림) 사라졌으면 세 바퀴 이어질 때 지휘로(재감사 [중간] 2)
      ats=$(alive "$aa"); [ "$aa" != - ] || ats=gone
      case $ats in
        gone | done | idle)
          anv=$((${anv:-0} + 1))
          if [ $anv -ge 3 ]; then
            lx=$(lastev "$an" "$aa" | cut -f 5,7 | tr '\t' ' ')
            aesc "$n" "$lo" "$n 감사 ${ar}번째 판정 없음 — 지휘 판단 (감사 터미널 $aa ${ats}, 마지막 사건 「${lx:-없음}」, $an @$m $rep)" &&
              aput "$n" "$ash" "$ar" "$af" coord "$afl"
          else aput "$n" "$ash" "$ar" "$af" queued "$afl" "$anv"; echo "감사 판정 없음 $an $aa ${ats} — ${anv}/3 바퀴"; fi ;;
        *) [ "${anv:-0}" = 0 ] || aput "$n" "$ash" "$ar" "$af" queued "$afl" 0 ;;
      esac
      continue
    fi
    msg=$(printf %s "$v" | cut -f 7)
    # 판정 줄의 sha가 지금 감사에 넘긴 sha가 아니면(지난 바퀴 감사의 판정) 건너뜀. sha가 없으면 받는다
    vs=$(printf %s "$msg" | sed -n 's/.*감사 완료 \([0-9a-f]\{7,40\}\).*/\1/p')
    case $vs in '' | "$ash"* ) ;; *) case $ash in "$vs"*) ;; *) continue ;; esac ;; esac
    # 레인이 그 사이 다른 sha로 완료를 다시 적었으면 이 판정은 옛 커밋 것 — 보내지 않고 아래 2)가 새 감사를 넣는다
    le=$(lastev "$n" "$la")
    if [ "$(printf %s "$le" | cut -f 5)" = 완료 ] && [ "$(printf %s "$le" | cut -f 6)" != "$ash" ]; then
      echo "판정 건너뜀 $an: $n 이 새 완료($(printf %s "$le" | cut -f 6))를 적었다 — 새 감사로"; continue
    fi
    h=$(printf %s "$msg" | sed -n 's/.*높음 *\([0-9][0-9]*\).*/\1/p') md=$(printf %s "$msg" | sed -n 's/.*중간 *\([0-9][0-9]*\).*/\1/p')
    lw=$(printf %s "$msg" | sed -n 's/.*낮음 *\([0-9][0-9]*\).*/\1/p')
    if [ -z "$h" ] || [ -z "$md" ]; then
      aesc "$n" "$lo" "$n 감사 ${ar}번째 판정 줄을 못 읽음(「${msg}」) — 지휘 판단 ($an @$m $rep)" && aput "$n" "$ash" "$ar" "$af" coord "$afl"
      continue
    fi
    if [ "$h" = 0 ] && [ "$md" = 0 ]; then
      ns=pass txt="감사 통과 ($ash, 낮음 ${lw:-?} — $rep). run 지시문의 착지 절차대로 main에 넣어라."
    elif [ "$af" -lt "$AMAX" ]; then
      ns=fix txt="감사 지적 ($ash, 높음 ${h}·중간 $md) — ${rep}를 읽고 높음·중간을 고친 뒤 다시 검증하고 hc-lane report 완료 <새 sha>."
    else
      aesc "$n" "$lo" "$n 감사 ${ar}번째 높음 ${h}·중간 $md — 지휘 판단 (지적 ${af}번, 상한 audit_max $AMAX, $an @$m $rep)" &&
        aput "$n" "$ash" "$ar" "$af" coord "$afl"
      continue
    fi
    if [ $dry = 1 ]; then echo "${P}보낼 $n $la: $txt"; continue; fi
    if ! lalive "$la" "$n"; then sw="레인 터미널 $la 없음"   # 그 주소에 그 레인 이름이 아니면(코어 재시작 등) 남에게 안 보냄
    elif hc send "$la" "$txt" >/dev/null 2>&1 </dev/null; then
      [ $ns = pass ] || af=$((af + 1))
      aput "$n" "$ash" "$ar" "$af" "$ns" 0
      if [ $ns = pass ]; then echo "감사 통과 보냄 $n $la ($ash, 낮음 ${lw:-?})"; else echo "감사 지적 보냄 $n $la ($ash, 높음 ${h}·중간 $md, ${af}번째)"; fi
      continue
    else sw="hc send 실패"; fi
    afl=$((afl + 1))
    if [ $afl -ge 3 ]; then
      aesc "$n" "$lo" "$n 감사 판정(높음 ${h}·중간 ${md})을 레인에 세 번 못 보냄($sw) — 지휘 판단 ($an @$m $rep)" &&
        aput "$n" "$ash" "$ar" "$af" coord "$afl" || aput "$n" "$ash" "$ar" "$af" queued "$afl"
    else aput "$n" "$ash" "$ar" "$af" queued "$afl"; echo "감사 판정 보내기 미룸 $n: $sw — 다음 바퀴에 다시(${afl}/3)"; fi
  done 6<<<"$AROWS"
  # 2) 완료: 쓰기 레인 터미널의 마지막 사건이 「완료 <sha>」이고 그 sha를 아직 감사에 넘기지 않았으면 그 기계에 감사 줄
  while IFS= read -r -u 6 n; do
    [ -n "$n" ] || continue
    IFS=$'\t' read -r _ proj _ _ _ _ m la _ _ _ lo _ <<<"$(qrow "$n")"
    aok "$m" || continue
    le=$(lastev "$n" "$la")
    [ "$(printf %s "$le" | cut -f 5)" = 완료 ] || continue
    sha=$(printf %s "$le" | cut -f 6)
    IFS=$'\t' read -r _ ash ar af ast afl _ <<<"$(aget "$n")"
    [ "$sha" != "${ash-}" ] || continue
    if [ "$sha" = - ]; then   # 완료에 sha가 없으면 감사할 커밋을 모른다 — 지휘에 한 번(sha 칸 -로 적어 되풀이 안 함)
      aesc "$n" "$lo" "자동 감사 못 함 $n: 완료에 sha 없음 — 지휘 판단 ($la)" && aput "$n" - "${ar:-0}" "${af:-0}" nosha 0
      continue
    fi
    an=$(audname "$n")
    if [ "${ast-}" = queued ]; then   # 지난 감사가 아직 돌면 그 판정 뒤에(두 감사가 함께 돌지 않게)
      IFS=$'\t' read -r _ _ _ _ _ ost _ oa _ <<<"$(qrow "$an")"
      if [ "${ost-}" = up ]; then case $(alive "$oa") in gone | done | idle) ;; *) echo "자동 감사 미룸 $n: 새 완료 $sha — 지난 감사($ash)가 아직 돈다"; continue ;; esac; fi
    fi
    repo=$(repo_of "$proj" "$m"); [ -n "$repo" ] || { echo "자동 감사 못 함 $n: 설정에 $proj @$m repo 줄이 없다"; continue; }
    base=$(git -C "$(repo_of "$proj" "$LOCAL")" symbolic-ref --short -q refs/remotes/origin/HEAD 2>/dev/null); base=${base#origin/}; base=${base:-main}
    nr=$((${ar:-0} + 1))
    if [ $dry = 1 ]; then echo "${P}넣을 감사 $an ← $n $sha (${nr}번째, $m)"; continue; fi
    t=$(cat -- "$AUD") || { echo "자동 감사 못 함 $n: 틀을 읽지 못함 $AUD — 다음 바퀴에"; continue; }
    t=${t//\{lane\}/$n} t=${t//\{machine\}/$m} t=${t//\{worktree\}/${repo%/}.wt/$n} t=${t//\{branch\}/$n} t=${t//\{sha\}/$sha}
    t=${t//\{base\}/$base} t=${t//\{brief\}/"~/.local/share/hc-fill/runs/$n-run.md"} t=${t//\{report\}/"~/.local/share/hc-fill/reports/$an.md"}
    bf=$DATA/briefs/audit/$an.md
    mkdir -p "${bf%/*}" && printf '%s\n' "$t" >"$bf.tmp" && mv -f "$bf.tmp" "$bf" || { echo "자동 감사 못 함 $n: 감사 지시문을 쓰지 못함 $bf"; continue; }
    qlock _put "$an" "$proj" "$bf" - "$m" wait - - - "$(date +%Y-%m-%dT%H:%M)" - "${lo:--}" urgent no-early "audit=$n" || continue
    aput "$n" "$sha" "$nr" "${af:-0}" queued 0
    echo "감사 넣음 $an ← $n $sha (${nr}번째, $m)"
  done 6<<<"$LROWS"
}
# audit_reap: 판정을 레인에 보낸(pass·fix) 감사 터미널을 끈다(hc kill <정확한 주소>) — 감사 터미널이 레인 작업 트리를 cwd로 쓰고
# 남으면 레인의 hc-lane clean이 멈춘다(2026-11-19 지휘 실측: 선행 착지 뒤 감사 터미널 때문에 정리 멈춤). 끄는 것은 이름이 그 감사
# 줄 이름이고 done·idle이며 레인 기록(hc-lane lanes.tsv) 종류가 read인 터미널만. working·blocked면 다음 바퀴에. 같은 이름의 지난
# 바퀴 감사 터미널(queued인데 지금 감사 줄 주소가 아님)도 끈다. 「지휘로 넘김」(coord)은 지휘가 보도록 남긴다
audit_reap() {
  [ -n "$AUD" ] && [ -s "$Q" ] || return 0
  lt=${XDG_STATE_HOME:-$HOME/.local/state}/hc-lane/lanes.tsv
  while IFS=$'\t' read -r -u 6 an am aa k; do   # am: 감사 줄 기계(5칸 --only) — 다른 기계의 같은 이름 터미널은 안 끔
    n=${k#audit=}
    ast=$(aget "$n" | cut -f 5)
    printf '%s\n' "$TERMS" | awk -F'\t' -v x="$an" -v m="$am" '$1==m && $4==x && ($5 == "done" || $5 == "idle") {print $2}' | while read -r ta; do
      case $ast in pass | fix) ;; queued) [ "$ta" != "$aa" ] || continue ;; *) continue ;; esac
      [ "$(awk -F'\t' -v a="$ta" '$1==a {k=$4} END {print k}' "$lt" 2>/dev/null)" = read ] || continue
      if [ $dry = 1 ]; then echo "${P}끌 감사 터미널 $an $ta"
      elif hc kill "$ta" >/dev/null 2>&1 </dev/null; then echo "감사 터미널 끔 $an $ta (판정 보낸 뒤)"
      else echo "감사 터미널 끄기 실패 $an $ta — 다음 바퀴에 다시"; fi
    done
  done 6<<<"$(awk -F'\t' -v OFS='\t' '$15 ~ /^audit=/ {print $1, $5, $8, $15}' "$Q")"
}
audit_tick
audit_reap
# 자리에서 뺄 done·idle 터미널: 자동 감사 레인(이름이 감사 줄 — 판정 뒤, 지난 바퀴 것 포함) · 감사에 넘겨진 쓰기 레인 가운데 그 감사
# 줄이 자리를 쥔 것(감사 줄이 아직 안 뜸 wait — 이번 바퀴 긴급으로 그 자리에 뜬다 —, 또는 감사 터미널이 done·idle·없음이 아님).
# 감사가 끝났는데 아직 queued(판정을 다시 보냄·판정 없음 세 바퀴)면 레인을 다시 센다 — 둘 다 자리를 안 쥐는 사이 다른 레인이 그
# 자리를 채우고 판정 뒤 레인이 다시 일해 상한을 넘던 것(재감사 [중간] 2). 자리 1인 기계에서 레인이 자기 감사를 막지 않는 것은 그대로
AUDN= AWT=
[ -z "$AUD" ] || [ ! -f "$Q" ] || {
  AUDN=$(awk -F'\t' '$15 ~ /^audit=/ {print $1}' "$Q")
  ahold=,
  while read -r as aa ak am ask; do
    case $as in
      # 그 기계에서 상태가 안 잡혀 남긴(stuck) 감사 줄은 그 기계에 다시 못 뜬다 — 쥔 것으로 보지 않고 레인을 다시 셈(3차 감사 [낮음] 2)
      wait) case ",$ask," in *",$am="*) continue ;; esac ;;
      up) case $(alive "$aa") in gone | done | idle) continue ;; esac ;;
      *) continue ;;
    esac
    ahold="$ahold${ak#audit=},"
  done <<<"$(awk -F'\t' '$15 ~ /^audit=/ {print $6, $8, $15, $5, $9}' "$Q")"
  AWT=$(awk -F'\t' -v h="$ahold" 'NR==FNR { if ($5 == "queued") w[$1] = 1; next }
    $6=="up" && $15=="auto" && ($1 in w) && index(h, "," $1 ",") {print $8}' "$AT" "$Q" 2>/dev/null)
}
# 우선순위 높은 것부터, 같으면 넣은 차례(정렬은 안정: 둘째 키가 줄 번호). 옛 줄·빈 칸은 보통
ROWS=$([ ! -f "$Q" ] || awk -F'\t' '{ r = ($13 == "urgent") ? 0 : ($13 == "high") ? 1 : ($13 == "low") ? 3 : 2; print r "\t" NR "\t" $0 }' "$Q" | sort -t "$(printf '\t')" -k1,1n -k2,2n | cut -f 3-)
NOW=   # 이번 바퀴에 띄운 기계(한 줄에 하나)
NOWL=  # 이번 바퀴에 띄운 레인의 기계(hc-fill 레인 수)
OFF=   # 이번 바퀴에 연결 안 됨으로 알린 기계

cnt() { printf '%s\n' "$1" | grep -Fxc -- "$2" || true; }

# 선행·착지 판정: local 기계의 프로젝트 저장소에서 fetch(프로젝트마다 바퀴에 한 번) → origin/<기본> 커밋 제목 머리가 레인 이름인 커밋
# (제목이 「<레인>…」 또는 「<종류>(<범위>): <레인>…」, 단어 경계). 괄호·문장 안 언급과 본문은 세지 않는다
FETCHED= FETCHBAD=
fetch_proj() {  # fetch_proj <프로젝트>: FR(local 저장소)·FB(기본 가지)를 둔다. 0 됨, 1 설정에 local repo 줄 없음, 2 fetch 실패
  FR=$(repo_of "$1" "$LOCAL"); [ -n "$FR" ] || return 1
  if ! inlist "$1" "$FETCHED"; then
    FETCHED="$FETCHED,$1"
    if [ $dry = 1 ]; then echo "${P}fetch 건너뜀: 지금 있는 origin 참조로 판정 ($FR)"
    elif ! git -C "$FR" fetch -q origin; then FETCHBAD="$FETCHBAD,$1"; fi
  fi
  inlist "$1" "$FETCHBAD" && return 2
  FB=$(git -C "$FR" symbolic-ref --short -q refs/remotes/origin/HEAD); FB=${FB#origin/}; FB=${FB:-main}
}
landed() { git -C "$FR" log "origin/$FB" --format='%h %s' | grep -E -m 1 "^[0-9a-f]+ ([a-z]+(\([^)]*\))?!?: *)?$1([^a-z0-9_-]|\$)"; }   # fetch_proj 뒤
after_ok() {  # after_ok <레인> <프로젝트> <쉼표 목록>: 0 다 들어감, 1 아직(기본 가지는 b), 2 판정 못 함
  fetch_proj "$2"
  case $? in
    1) echo "선행 $1: 판정 못 함(설정에 $2 의 $LOCAL repo 줄이 없다)"; return 2 ;;
    2) echo "선행 $1: 판정 못 함(git fetch 실패: $FR)"; return 2 ;;
  esac
  b=$FB ok=0
  for a in $(printf %s "$3" | tr , ' '); do
    hit=$(landed "$a")
    if [ -n "$hit" ]; then echo "선행 $1 ← $a: 들어감 ($hit)"; else echo "선행 $1 ← $a: 아직 (origin/$b)"; ok=1; fi
  done
  return $ok
}
# lane_landed <레인 이름> <cwd>: cwd의 <저장소>.wt/… 앞 폴더 이름과 repo 줄 경로의 이름이 같은 프로젝트에서 착지했으면 0(LHIT=커밋 줄).
# 이름이 레인 꼴이 아니거나 프로젝트를 못 찾거나 fetch 실패면 1(판정 못 함 = 셈). 하위 셸로 부르지 않는다(FETCHED가 바퀴에 남게)
lane_landed() {
  LHIT=; okname "$1" || return 1
  lp=${2%%.wt/*}; lp=${lp##*/}
  lp=$(awk -v n="$lp" '$1=="repo" { x = $0; sub(/^[ \t]*repo[ \t]+[^ \t]+[ \t]+[^ \t]+[ \t]+/, "", x); sub(/[ \t]+$/, "", x); sub(/\/+$/, "", x); sub(/.*\//, "", x)
    if (x == n) { print $2; exit } }' "$CONF")
  [ -n "$lp" ] && fetch_proj "$lp" || return 1
  LHIT=$(landed "$1"); [ -n "$LHIT" ]
}

# 자리를 차지한 에이전트(기계 한 줄에 하나). working·blocked 등은 늘 차지. done·idle은 hc-lane 작업 트리(<저장소>.wt/…)가
# 그 기계에 남은 쓰기 레인(감사·착지를 기다림)만. 읽기 전용(--read)·작업 트리가 정리된 레인은 아니다. 셈 칸이 all인 기계는 다 센다.
wt_there() {  # wt_there <기계> <폴더> → yes|no|? (확인 못 하면 ?)
  if [ "$1" = "$LOCAL" ]; then [ -d "$2" ] && echo yes || echo no; return; fi
  printf '%s\n' "$CONN" | grep -Fxq -- "$1" || { echo '?'; return; }
  v=$(hc exec --on "$1" -- sh -c '[ -d "$1" ] && echo yes || echo no' _ "$2" 2>/dev/null)
  case $v in yes | no) echo "$v" ;; *) echo '?' ;; esac
}
ALLM=$(machines | awk '$4 == "all" {print $1}')
HOLD=$(conf hold); HOLD=${HOLD:-60}
case $HOLD in *[!0-9]*) echo "알림: 설정 hold는 분(숫자)이다, 쉰 레인도 셈: $HOLD"; HOLD=0 ;; esac
HOLD=$((10#$HOLD))
# hc-lane 레인 기록(이 기계 lanes.tsv: 주소 이름 지휘 [종류]): 주소마다 마지막 줄의 종류. read면 작업 트리를 cwd로 써도 읽기 레인
LKIND=$(awk -F'\t' '{ k[$1] = $4 } END { for (a in k) if (k[a] == "read") print a }' "${XDG_STATE_HOME:-$HOME/.local/state}/hc-lane/lanes.tsv" 2>/dev/null)
HELD=$(cat "$DATA/held.tsv" 2>/dev/null) HNEW= HNOW=$(date +%s)
SEATS=
while IFS=$'\t' read -r -u 5 tm ta tg tn ts tc; do
  if [ "$tg" != "$AGENT" ]; then   # 상태 모르는 hc-lane 레인(띄운 직후·훅 안 보냄)은 살아 있는 에이전트로 셈
    [ "$ts" = - ] && printf '%s\n' "$LANEADDR" | grep -Fxq -- "$ta" || continue
    echo "자리 $tm $ta $tn: $tg, 상태 모름(hc-lane 레인) → 셈"; SEATS=$(printf '%s\n%s' "$SEATS" "$tm"); continue
  fi
  case $ts in done | idle) ;; *) SEATS=$(printf '%s\n%s' "$SEATS" "$tm"); continue ;; esac
  # 쉬기 시작한 때(held.tsv): 이번 바퀴 done·idle만 이어 적는다 — working·blocked로 바뀌거나 사라진 주소는 빠진다
  hs=$(printf '%s\n' "$HELD" | awk -F'\t' -v a="$ta" '$1==a {print $2; exit}')
  case $hs in '' | *[!0-9]*) hs=$HNOW ;; esac
  HNEW="$HNEW$ta	$hs
"
  printf '%s\n' "$AUDN" | grep -Fxq -- "$tn" && { echo "자리 $tm $ta $tn: $ts, 자동 감사 레인 → 안 셈"; continue; }
  printf '%s\n' "$AWT" | grep -Fxq -- "$ta" && { echo "자리 $tm $ta $tn: $ts, 자동 감사 기다림(자리는 감사 줄이) → 안 셈"; continue; }
  printf '%s\n' "$ALLM" | grep -Fxq -- "$tm" && { SEATS=$(printf '%s\n%s' "$SEATS" "$tm"); continue; }
  case $tc in
    *.wt/*)
      # 감사·조사(hc-lane --read)가 레인 작업 트리에서 돈 것(감사 [낮음] 4). 기록이 없으면 아래처럼 판정
      printf '%s\n' "$LKIND" | grep -Fxq -- "$ta" && { echo "자리 $tm $ta $tn: $ts, 읽기 레인(레인 기록) → 안 셈"; continue; }
      case $(wt_there "$tm" "$tc") in
        yes) tw="작업 트리 있음" ;;
        no) echo "자리 $tm $ta $tn: $ts, 작업 트리 없음 → 안 셈"; continue ;;
        *) tw="작업 트리 확인 못 함" ;;
      esac
      if lane_landed "$tn" "$tc"; then echo "자리 $tm $ta $tn: $ts, 착지함(${LHIT%% *}) → 안 셈"
      elif [ "$HOLD" != 0 ] && [ $((HNOW - hs)) -ge $((HOLD * 60)) ]; then echo "자리 $tm $ta $tn: $ts, 쉰 지 $(((HNOW - hs) / 60))분(hold $HOLD) → 안 셈"
      else echo "자리 $tm $ta $tn: $ts, $tw → 셈"; SEATS=$(printf '%s\n%s' "$SEATS" "$tm"); fi ;;
    *) echo "자리 $tm $ta $tn: $ts, 읽기 전용(작업 트리 아님) → 안 셈" ;;
  esac
done 5<<<"$TERMS"
[ $dry = 1 ] || { printf '%s' "$HNEW" >"$DATA/held.tsv.tmp" && mv -f "$DATA/held.tsv.tmp" "$DATA/held.tsv"; }
HELDW=1
agents_on() { echo $(( $(cnt "$SEATS" "$1") + $(cnt "$NOW" "$1") )); }
lanes_on() {  # hc-fill이 그 기계에 띄워 살아 있는 레인 수. 자동 감사 줄은 빼고 센다(감사 줄은 레인상한도 안 봄 — 교착, 재감사
  k=0          # [높음] 1). 감사를 기다리는 쓰기 레인은 센다: 지적 뒤 다시 일하니 착지 전까지 레인상한 자리를 쥔다(재감사 [중간] 1)
  for a in $(printf '%s\n' "$ROWS" | awk -F'\t' -v m="$1" '$6=="up" && $7==m && $15 !~ /^audit=/ {print $8}'); do
    printf '%s\n' "$TERMS" | awk -F'\t' -v a="$a" '$2==a {f=1} END {exit !f}' && k=$((k + 1))
  done
  echo $((k + $(cnt "$NOWL" "$1")))
}

status_ok() {  # 띄운 터미널의 hc get status가 WAIT초 안에 잡히는지
  end=$(( $(date +%s) + WAIT ))
  while :; do
    hc get "$1" --json 2>/dev/null | jq -e '(.status | type) == "object"' >/dev/null && return 0
    [ "$(date +%s)" -lt "$end" ] || return 1
    sleep "$POLL"
  done
}

old_report() {  # old_report <기계> <레인>: 같은 이름의 옛 보고가 새 레인 결과로 나가지 않게 .old-<시각>으로 비켜 둔다(지우지 않음)
  onm "$1" '[ ! -f "$d" ] || mv -f "$d" "$d.old-$1"' "~/.local/share/hc-fill/reports/$2.md" "$(date +%Y%m%d%H%M%S)"
}

# 자동 감사 쓰기 레인의 run 지시문 끝 절(설정 audit이 있을 때)
ASEC='
## 감사·착지 (hc-fill 자동)
이 절이 위 지시문 본문의 감사·착지 문구보다 앞선다. 감사는 hc-fill이 띄운다(지휘가 따로 띄우지 않는다).
1. 구현·검증이 끝나면 착지하지 말고 `hc-lane report 완료 <sha> "<한 줄> (감사 hc-fill 자동)"`을 부른 뒤 턴을 끝내고 기다린다.
2. hc-fill이 「감사 통과 …」를 보내면 위 착지 절차대로 main에 넣고 `hc-lane report 착지 <sha>`.
3. 「감사 지적 … <보고서>」를 보내면 그 보고서를 읽고 높음·중간을 고친 뒤 다시 검증하고 `hc-lane report 완료 <새 sha> "<한 줄>"`, 그리고 다시 기다린다.
'
launch() {  # launch <레인> <지시문> <기계> <저장소> <되돌릴곳> <주인 지휘|-> → ADDR. 실패면 1
  # 본문을 먼저 읽어 둔다: 못 읽으면 착지 줄만 든 빈 레인을 띄우지 않는다(종료 2 = 이 레인은 이번 바퀴에 그만)
  body=$(cat -- "$2" 2>&1) && [ -n "$body" ] || { body=${body##*: }; echo "실패 $1: 지시문을 읽지 못함(${body:-빈 파일}): $2"; return 2; }
  on=; [ "$3" = "$LOCAL" ] || on=$3
  rsec=; [ "${5:--}" = - ] || rsec="
## 결과 보고 (hc-fill 받은편지 레인)
끝나면(착지했든 못 했든) 이 기계 \`~/.local/share/hc-fill/reports/$1.md\`에 결과를 쓴다. 마지막 줄은 셋 중 하나다:
\`결과: 고침 <sha>\` · \`결과: 넘김 <사유>\` · \`결과: 실패 <사유>\`. hc-fill이 이 파일을 요청한 기계로 되돌려 준다.
"
  # 자동 감사(설정 audit): 감사 줄은 --read, 쓰기 줄(받은편지·--no-audit 빼고)은 「감사·착지」 절을 붙이고 감사 칸 auto
  rd= asec= LAUTO=
  case ${AK:--} in audit=*) rd=--read ;; -) [ -z "$AUD" ] || [ "${5:--}" != - ] || { asec=$ASEC LAUTO=auto; } ;; esac
  steps=$(hc-lane --print-steps $rd ${on:+--on "$on"} --name "$1" --repo "$4") || { echo "실패 $1 @$3: hc-lane --print-steps"; return 1; }
  [ -z "$rsec" ] || old_report "$3" "$1" || { echo "실패 $1 @$3: 그 기계의 옛 보고를 비켜 두지 못했다"; return 1; }
  runmd() { printf '%s\n\n%s\n' "$body" "$steps"; printf %s "$rsec"; printf %s "$asec"; printf %s "${ESEC-}"; }
  sz=$(runmd | wc -c | tr -d ' ')   # 쓴 run 지시문의 크기가 이것과 같아야 한다(본문이 다 들어갔는지)
  if [ -z "$on" ]; then
    rf=$HOME/.local/share/hc-fill/runs/$1-run.md
    mkdir -p "${rf%/*}" && runmd >"$rf" && [ "$(wc -c <"$rf" | tr -d ' ')" = "$sz" ] || { echo "실패 $1 @$3: run 지시문 쓰기"; return 1; }
  else
    rf=$(runmd | hc exec -i --on "$on" -- sh -c \
      'd=$HOME/.local/share/hc-fill/runs && mkdir -p "$d" && cat >"$d/$1" && [ "$(wc -c <"$d/$1" | tr -d " ")" = "$2" ] && printf %s "$d/$1"' _ "$1-run.md" "$sz") && [ -n "$rf" ] ||
      { echo "실패 $1 @$3: run 지시문을 그 기계에 두지 못했다"; return 1; }
  fi
  own=${6:--}; [ "$own" != - ] || own=
  # 주인 지휘가 지금 살아 있나: 대기열 레인은 --after 사슬로 몇 시간 뒤에 뜬다 — 그 사이 지휘가 끝났으면 주인 없이(-, 사건은 모든 지휘에게)
  # 띄우고 watch는 살아 있는 지휘(hc-lane coord)에게(감사 [중간] 1 — 죽은 주소를 넘겨 아무 watch도 안 떴다)
  if [ -n "$own" ] && ! ce=$(hc-lane coord --check "$own" 2>&1 </dev/null); then
    echo "알림: $1 의 주인 지휘 $own 가 지금 없다 — 주인 없이 띄움(사건은 모든 지휘에게) ($(printf '%s\n' "$ce" | tail -n 1))"; own=
  fi
  task=${TASK//\{run\}/$rf}
  eval "set -- \"\$1\" \"\$4\" ${LAUNCH//\{task\}/\"\$task\"}"   # 설정의 launch 틀을 인자로(설정 파일은 믿는다)
  lane=$1 repo=$2; shift 2
  # 지휘 주소를 넘겨 그 지휘의 hc-lane watch가 없으면 hc-lane이 띄우게 한다(launchd에는 $HC_TERMINAL_ID가 없다 — lane-push 감사 [중간] 1).
  # 주소는 설정 coord가 아니라 hc-lane coord(지휘마다 남긴 주소·pid·이름을 지금 hc get과 맞춰 본 것 가운데 가장 최근에 레인을 띄운 지휘 —
  # 2차 감사 [중간] B: 박힌 주소는 코어가 다시 뜨면 남의 터미널이 된다). 안 맞으면 넘기지 않고 한 줄 — 사건은 events에 남는다
  # 대기열에 주인 지휘가 있으면(add한 지휘) 그 지휘가 watch 대상이자 레인 주인(HC_LANE_OWNER → 레인 기록) — 사건은 그 지휘에게만.
  # (2026-11-17 hcfill-owner: 주인 없이 띄운 레인 사건을 다른 지휘가 넘겨받아 넣은 지휘가 2시간 못 받음)
  if [ -n "$own" ]; then wco=$own
  else
    wco=$(hc-lane coord 2>&1 </dev/null) || { echo "알림: 지휘 없음 — 감시(hc-lane watch)를 띄우지 않음, $lane 사건은 events에 남아 지휘가 wait/watch를 걸면 받는다 ($(printf %s "$wco" | tail -n 1))"; wco=; }
  fi
  # HC_LANE_FILL=1: hc-lane이 레인 기록에 fill로 적는다(hc-lane wait가 「완료」를 마지막 보고로 봄)
  out=$(HC_LANE_COORD=$wco HC_LANE_OWNER=$own HC_LANE_FILL=1 hc-lane $rd ${on:+--on "$on"} --name "$lane" --repo "$repo" -- "$@" 2>&1); lr=$?
  # 5·6·7: 띄웠지만 시작 확인 실패(터미널은 남음) → 주소를 받아 「상태 안 잡힘」 길로(stuck 기록, 그 기계 빼고 다음으로)
  case $lr in 0|5|6|7) ;; *) echo "실패 $lane @${on:-$LOCAL}: hc-lane: $(printf '%s\n' "$out" | tail -n 3 | tr '\n' ' ')"; return 1 ;; esac
  SWHY=; [ $lr = 0 ] || SWHY=$(printf '%s\n' "$out" | grep -m 1 '^hc-lane: 시작 안 됨' | cut -c 1-200)
  ADDR=$(printf '%s\n' "$out" | tail -n 1 | jq -r '.lane // empty' 2>/dev/null)
  [ -n "$ADDR" ] || { echo "실패 $lane @${on:-$LOCAL}: hc-lane 출력에서 주소를 못 읽음: $(printf '%s\n' "$out" | tail -n 1)"; return 1; }
  # 원격은 hc-lane이 맥 창의 그 기계 공간에 탭으로 붙인다(herdr-balance는 원격 터미널을 맥 탭에 못 넣는다). 못 붙였으면 그 알림 줄을 그대로
  printf '%s\n' "$out" | sed -n 's/^hc-lane: \(Herdr 창.*\)/알림: \1/p'
  bco=${own:-$COORD}   # 로컬 레인은 주인 지휘 옆에(없으면 설정 coord)
  if [ -z "$on" ] && [ -n "$bco" ] && command -v herdr-balance >/dev/null 2>&1; then
    i=0; until herdr-balance --main "$bco" --add "$ADDR" >/dev/null 2>&1; do
      i=$((i + 1)); [ $i -lt 5 ] || { echo "알림: 분할 붙이기 실패 $ADDR (herdr-balance --main $bco --add $ADDR)"; break; }; sleep 2
    done
  fi
  [ $lr = 0 ] || return 5
}

# place <레인> <프로젝트> <지시문> <기계제한> <되돌릴곳> <주인> [<선행 — 먼저 띄움일 때>]: machine 차례에서 처음 자리가 남는 기계에.
# placed=1 띄움 · bad=1 지시문을 못 읽어 이 바퀴엔 그만. stuck(그 줄의 남긴것)을 고쳐 적는다. 먼저 띄움이면 ESEC를 run 지시문 끝에 붙인다
place() {
  placed= bad=
  while read -r -u 4 m cap lcap _; do
    [ "$4" = - ] || inlist "$m" "$4" || continue
    stk=$(printf '%s\n' "$stuck" | tr , '\n' | grep -c "^$m=")
    [ "$stk" = 0 ] || continue
    repo=$(repo_of "$2" "$m"); [ -n "$repo" ] || continue
    case $AK in audit=*) repo=${repo%/}.wt/${AK#audit=} ;; esac   # 자동 감사: 그 레인 작업 트리에서 --read
    if [ "$m" != "$LOCAL" ] && ! printf '%s\n' "$CONN" | grep -Fxq -- "$m"; then
      inlist "$m" "$OFF" || { echo "건너뜀 $m: 연결 안 됨"; OFF="$OFF,$m"; }
      continue
    fi
    [ "$(agents_on "$m")" -lt "$cap" ] || continue
    # 자동 감사 줄은 레인상한을 보지 않고 레인 수에도 안 든다(그 레인의 자리를 이어 쓴다 — 재감사 [높음] 1)
    case ${AK:--} in audit=*) isa=1 ;; *) isa= ;; esac
    [ -n "$isa" ] || [ "$lcap" = - ] || [ "$(lanes_on "$m")" -lt "$lcap" ] || continue
    if [ $dry = 1 ]; then
      echo "${P}${7:+먼저 }띄울 $1 → $m ($repo)${7:+ 선행 $7}"
      NOW=$(printf '%s\n%s' "$NOW" "$m") placed=1 UPNOW="$UPNOW,$1"; [ -n "$isa" ] || NOWL=$(printf '%s\n%s' "$NOWL" "$m"); break
    fi
    ADDR=
    launch "$1" "$3" "$m" "$repo" "$5" "$6"; lr=$?
    [ $lr != 2 ] || { bad=1; break; }
    [ $lr = 0 ] || [ $lr = 5 ] || continue
    NOW=$(printf '%s\n%s' "$NOW" "$m")   # 상태가 안 잡혀도 자리는 차 있다
    if [ $lr = 0 ] && status_ok "$ADDR"; then
      [ -n "$isa" ] || NOWL=$(printf '%s\n%s' "$NOWL" "$m")
      if [ -n "${7-}" ]; then qset "$1" up "$m" "$ADDR" "$stuck" early "$LAUTO"; echo "먼저 띄움 $1 → $m $ADDR ($repo, 선행 $7)"
      else qset "$1" up "$m" "$ADDR" "$stuck" "" "$LAUTO"; echo "띄움 $1 → $m $ADDR ($repo)"; fi
      [ "$LAUTO" != auto ] || adel "$1"   # 새로 띄운 쓰기 줄: 같은 이름의 지난 일 감사 기록을 물려받지 않게(재감사 [중간] 3)
      placed=1 UPNOW="$UPNOW,$1"; break
    fi
    stuck=$([ "$stuck" = - ] && echo "$m=$ADDR" || echo "$stuck,$m=$ADDR")
    qset "$1" wait - - "$stuck"
    echo "상태 안 잡힘 $1 @$m $ADDR: ${SWHY:-${WAIT}초 안에 hc get status 없음}. 그 레인에서 $m 빼고 다음 기계로(그 터미널은 남겨 둠, 확인 뒤 지휘가 정리)"
  done 4<<<"$(machines)"
}

# early_sec <선행 목록> <기본 가지>: 먼저 띄움 레인의 run 지시문 끝에 붙일 절. 선행마다 판정 줄이 따로다
# (2026-11-18 지휘가 손으로 붙일 때 셸 낱말 나누기로 두 선행을 한 줄로 이어 붙였다). 판정은 after_ok와 같은 커밋 제목 머리 규칙.
# 기한은 고정 시각(지금 + 설정 early_wait시간) — 명령 시간 한도로 끊겨 다시 돌려도 늘지 않게
early_sec() {
  dl=$(( $(date +%s) + EWAIT * 3600 ))
  dls=$(date -r "$dl" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$dl" '+%Y-%m-%d %H:%M')
  re1='^([a-z]+(\([^)]*\))?!?: *)?' re2='([^a-z0-9_-]|$)'
  w='until git fetch -q origin'
  for a in $(printf %s "$1" | tr , ' '); do w="$w &&
  git log origin/$2 --format=%s | grep -Eq '$re1$a$re2'"; done
  cat <<EOF

## 먼저 띄움 — 선행 착지 전에 띄웠다 (hc-fill, $(date '+%Y-%m-%d %H:%M'))
자리가 비어 hc-fill이 이 레인을 선행 레인($(printf %s "$1" | sed 's/,/, /g'))이 origin/$2에 들어가기 **전에** 띄웠다. 위 지시문의 본 작업은 선행이 들어간 뒤에 한다.
1. 지금은 준비만: 지시문·계약 읽기, 이 레인 몫 파일의 실패 시험·골든 고정(커밋해도 된다), 선행 레인이 무엇을 바꾸는지 미리 읽기. 선행 레인이 고칠 파일은 아직 고치지 않는다.
2. 준비가 끝나면 아래 블록을 그대로 한 번에 돌려 선행을 기다린다. 배경 실행 금지(\`&\`·nohup도, 도구의 배경 실행 run_in_background도). 명령 시간 한도는 도구가 허락하는 최대로 준다(예: Bash 도구 timeout 600000). 선행마다 판정 줄이 따로다 — 합치거나 줄을 고치지 않는다. 그래도 한도로 끊기면 같은 블록을 다시 돌린다(기한은 고정 시각이다).
\`\`\`sh
$w
do [ "\$(date +%s)" -lt $dl ] || { echo "선행 대기 초과"; break; }; sleep 180; done
\`\`\`
3. 「선행 대기 초과」가 찍혔으면(기한 $dls, ${EWAIT}시간) \`hc-lane report 막힘 - "선행 대기 초과: <아직 안 들어간 선행>"\`을 부르고 멈춘다. 이 레인의 대기열 줄은 「떠 있음」으로 남아 hc-fill이 다시 띄우지 않으니, 지휘가 \`hc-fill rm <레인>\` 뒤 다시 넣는다.
4. 선행이 모두 들어갔으면 \`git rebase origin/$2\` 뒤 본 작업을 한다(준비 커밋은 그대로 둔다).
EOF
}

ELIST=   # 선행에만 묶여 건너뛴 대기 레인: 「,<레인>=<기본 가지>」 — 먼저 띄움 후보(--no-early 빼고)
UPNOW=   # 이번 바퀴에 띄운 레인(「,<레인>」 — 먼저 띄움 포함, dry-run은 띄울 것)
ECAPHIT= # 먼저 띄움 상한에 걸려 남긴 후보가 있음(놀고 있음 알림 사유)
while IFS=$'\t' read -r -u 3 name proj brief after only state m0 a0 stuck added reply owner _ ef ak _; do
  # 상태가 안 잡혀 남긴 터미널이 살아났으면 같은 레인이 둘 돈다: 알리고 그 레인은 더 띄우지 않는다(지휘가 정리)
  dupr=
  if [ "$stuck" != - ]; then
    for sa in $(printf %s "$stuck" | tr , ' '); do
      sa=${sa#*=}
      printf '%s\n' "$TERMS" | awk -F'\t' -v a="$sa" '$2==a {f=1} END {exit !f}' || continue
      hc get "$sa" --json 2>/dev/null | jq -e '(.status | type) == "object"' >/dev/null || continue
      w=; [ "$state" = wait ] || w=" 지금 떠 있는 $a0 와 같은 레인이 둘 돈다."
      echo "중복 위험 $name $sa: 상태가 안 잡혀 남긴 터미널이 살아났다.$w 지휘가 하나를 정리한다"; dupr=1
    done
  fi
  [ "$state" = wait ] || continue
  [ -z "$dupr" ] || { echo "건너뜀 $name: 중복 위험이라 더 띄우지 않음"; continue; }
  # 같은 이름이 살아 있으면(지휘가 손으로 띄웠거나 지난 바퀴의 것) 다시 띄우지 않고 떠 있음으로 표시. 상태 안 잡혀 남긴 기계는 빼고 본다
  # 자동 감사 줄은 지난 바퀴의 감사 터미널(판정 뒤 done·idle로 남음)을 새 바퀴로 잡지 않는다
  live=$(printf '%s\n' "$TERMS" | awk -F'\t' -v n="$name" -v k="${ak:--}" '$4==n && !(k ~ /^audit=/ && ($5 == "done" || $5 == "idle")) {print $1, $2}' | while read -r lm la; do
    inlist "$lm=$la" "$stuck" || echo "$lm $la"; done | head -n 1)
  if [ -n "$live" ]; then
    echo "이미 떠 있음 $name: ${live#* } — 떠 있음으로 표시"
    if [ $dry = 0 ]; then
      [ "${reply:--}" = - ] || old_report "${live%% *}" "$name" || { echo "건너뜀 $name: ${live%% *} 의 옛 보고를 비켜 두지 못했다"; continue; }
      qset "$name" up "${live%% *}" "${live#* }" "$stuck"
    fi
    continue
  fi
  if [ "$after" != - ]; then
    after_ok "$name" "$proj" "$after"; ar=$?
    if [ $ar != 0 ]; then [ $ar != 1 ] || [ "${ef:--}" != - ] || ELIST="$ELIST,$name=$b"; continue; fi
  fi
  why=$(brief_bad "$brief") && { echo "실패 $name: 지시문을 읽지 못함($why): $brief"; continue; }
  AK=${ak:--}; place "$name" "$proj" "$brief" "$only" "${reply:--}" "${owner:--}"
  [ -n "$placed" ] || [ -n "$bad" ] || echo "자리 없음 $name: 대기"
done 3<<<"$ROWS"

# 먼저 띄움: 띄울 수 있는 것을 다 띄우고도 자리가 남으면 선행에만 묶인 레인을 같은 차례(우선순위·넣은 차례)로.
# 설정 early = 살아 있는 먼저 띄움 레인 수 상한(빈 값이면 남은 자리 전부, 0이면 끔), early_wait = 기다림 기한(시간, 기본 5)
ECAP=$(conf early) EWAIT=$(conf early_wait); EWAIT=${EWAIT:-5}
case $EWAIT in *[!0-9]*) ;; *) EWAIT=$((10#$EWAIT)) ;; esac   # 08·09도 십진수로(감사 [낮음] 2), 00은 아래에서 0으로 걸림
case $ECAP in *[!0-9]*) echo "알림: 설정 early는 개수(숫자)다, 먼저 띄움 끔: $ECAP"; ECAP=0 ;; esac
case $EWAIT in '' | *[!0-9]* | 0) echo "알림: 설정 early_wait는 1 이상 시간(숫자)이다, 5로: $EWAIT"; EWAIT=5 ;; esac
if [ -n "$ELIST" ] && [ "$ECAP" != 0 ]; then
  ELIVE=0
  for a in $(printf '%s\n' "$ROWS" | awk -F'\t' '$6=="up" && $14=="early" {print $8}'); do
    printf '%s\n' "$TERMS" | awk -F'\t' -v a="$a" '$2==a {f=1} END {exit !f}' && ELIVE=$((ELIVE + 1))
  done
  while IFS=$'\t' read -r -u 3 name proj brief after only state m0 a0 stuck added reply owner _ _ ak _; do
    eb=$(printf %s "$ELIST" | tr , '\n' | sed -n "s/^$name=//p"); [ -n "$eb" ] || continue
    # 선행 가운데 대기열에서 아직 안 뜬(wait) 레인이 있으면 빼고 그 선행이 자리를 먼저 잡게 한다(감사 [중간] 1 — 뒤 레인이 자리를 다
    # 먹어 선행이 못 떠 기한까지 교착). 그 선행이 이번 바퀴에 떴으면(먼저 띄움 포함) 후보. 대기열 밖 선행은 그대로
    wq=; for a in $(printf %s "$after" | tr , ' '); do
      inlist "$a" "$UPNOW" && continue
      [ "$(printf '%s\n' "$ROWS" | awk -F'\t' -v n="$a" '$1==n {print $6; exit}')" != wait ] || wq="$wq${wq:+,}$a"
    done
    [ -z "$wq" ] || { echo "먼저 띄움 건너뜀 $name: 선행 $wq 가 대기열에서 아직 안 떴다(그 선행이 자리를 먼저)"; continue; }
    [ -z "$ECAP" ] || [ "$ELIVE" -lt "$ECAP" ] || { echo "먼저 띄움 상한 ${ECAP}개(살아 있는 것 $ELIVE) — 나머지는 대기"; ECAPHIT=1; break; }
    why=$(brief_bad "$brief") && { echo "실패 $name: 지시문을 읽지 못함($why): $brief"; continue; }
    ESEC=$(early_sec "$after" "$eb")
    AK=${ak:--}; place "$name" "$proj" "$brief" "$only" "${reply:--}" "${owner:--}" "$after"
    ESEC=
    [ -z "$placed" ] || ELIVE=$((ELIVE + 1))
  done 3<<<"$ROWS"
fi

# 놀고 있음: 바퀴 끝에도 자리가 남은 기계(연결됨, 그 기계 repo 줄이 있음)가 설정 idle분 넘게 이어지면 사건 한 번, 계속 비면 30분마다
# 세 번, 그 뒤로는 2시간마다(감사 [낮음] 3 — 밤새 일이 없으면 지휘 턴이 끝없이). 사유: 먼저 띄움 상한에 걸렸으면 그렇게, 아니면 띄울 것 없음.
# 받는 지휘: 대기 줄의 주인 가운데 살아 있는 것(hc-lane coord --check가 「다름·없음」이 아닌 것). 주인 없는 대기 줄이 있거나 대기 줄이
# 없거나 살아 있는 주인이 없으면 모든 지휘(--to 없이 — 주인 모르는 사건은 모든 지휘 watch가 보낸다). 기록 $DATA/idle.tsv(기계 비기시작 보낸시각 보낸횟수 빈자리수 — 빈 자리 수가 줄면 처음부터)
idle_tick() {
  [ "$IDLE" != 0 ] && [ $dry = 0 ] || return 0
  inow=$(date +%s) inew= idue= imsg=
  while read -r -u 4 m cap lcap _; do
    awk -v m="$m" '$1=="repo" && $3==m {f=1} END {exit !f}' "$CONF" || continue
    [ "$m" = "$LOCAL" ] || printf '%s\n' "$CONN" | grep -Fxq -- "$m" || continue
    fr=$((cap - $(agents_on "$m")))
    [ "$lcap" = - ] || { l=$((lcap - $(lanes_on "$m"))); [ $l -ge $fr ] || fr=$l; }
    [ $fr -gt 0 ] || continue
    read -r isince isent icnt ifr <<<"$(awk -F'\t' -v m="$m" '$1==m {print $2, $3, $4, $5; exit}' "$DATA/idle.tsv" 2>/dev/null)"
    case $isince in '' | *[!0-9]*) isince=$inow isent=0 icnt=0 ;; esac
    case $isent in '' | *[!0-9]*) isent=0 ;; esac
    case $icnt in '' | *[!0-9]*) icnt=0 ;; esac
    case $ifr in '' | *[!0-9]*) ;; *) [ "$fr" -ge "$ifr" ] || isince=$inow isent=0 icnt=0 ;; esac   # 자리가 하나라도 찼으면 처음부터
    inew="$inew$m	$isince	$isent	$icnt	$fr
"
    [ $((inow - isince)) -ge $((IDLE * 60)) ] || continue
    igap=1800; [ "$icnt" -lt 3 ] || igap=7200
    [ "$isent" = 0 ] || [ $((inow - isent)) -ge $igap ] || continue
    idue="$idue $m" imsg="$imsg${imsg:+ · }$m 자리 ${fr}개 $(((inow - isince) / 60))분째 빔"
  done 4<<<"$(machines)"
  if [ -n "$idue" ]; then
    ito= iall=
    for o in $(awk -F'\t' '$6=="wait" {print ($12 == "" ? "-" : $12)}' "$Q" 2>/dev/null | sort -u); do
      if [ "$o" = - ]; then iall=1; continue; fi
      hc-lane coord --check "$o" >/dev/null 2>&1 </dev/null; [ $? = 1 ] || ito="$ito${ito:+,}$o"
    done
    [ -z "$iall" ] || ito=
    iwhy="대기열에 띄울 것 없음"; [ -z "$ECAPHIT" ] || iwhy="먼저 띄움 상한(early ${ECAP})에 걸려 남김 — 상한을 올리거나 일을 더 넣는다"
    if env -u HC_TERMINAL_ID -u HC_LANE hc-lane report 중간 - "$imsg — $iwhy" --name hc-fill-idle ${ito:+--to "$ito"} >/dev/null 2>&1 </dev/null; then
      echo "놀고 있음 알림 → ${ito:-모든 지휘}: $imsg — $iwhy"
      inew=$(printf %s "$inew" | awk -F'\t' -v OFS='\t' -v d="$idue " -v t="$inow" 'index(" " d, " " $1 " ") {$3 = t; $4++} 1')
    else echo "놀고 있음 알림 실패(hc-lane report) — 다음 바퀴에 다시"; fi
  fi
  printf '%s' "$inew" >"$DATA/idle.tsv.tmp" && mv -f "$DATA/idle.tsv.tmp" "$DATA/idle.tsv"
}
idle_tick
gc_tick
exit 0
