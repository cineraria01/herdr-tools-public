#!/bin/bash
# 맥의 실제 파일을 정본으로 두 저장소(범용 도구·개인 설정)와 hc에 등록된 기계에 맞춘다 (계약 CONTRACT.md).
# 무엇을 맞추는지는 개인 저장소의 sync.list와 settings/keys.json이 정한다. 맥에서만 돈다.
#
#   herdr-sync                      저장소 ↔ 맥, 그다음 hc machine ls의 모든 기계에 맞춘다
#   herdr-sync <기계>…              고른 기계만
#   herdr-sync --check [<기계>…]    고치지 않고 비교만 한다 (다름·충돌이 있으면 종료 1, 첫 줄 「맥:」은 맥 ↔ 저장소 방향)
#   herdr-sync --take <기계>:<경로|*>   충돌을 맥 값으로 덮는다 (백업을 남긴다)
#   herdr-sync --pull <기계>:<경로|*>   그 기계 값을 맥 실제 파일로 가져온 뒤 맞춘다
#
# 경로는 sync.list의 맥 경로(~ 아래, 나무 줄은 그 안 파일 하나)나 설정 키(.model, hook:PreToolUse:cotenant-guard.sh 꼴), *는 그 기계의 충돌 전부, <폴더>/**는 그 나무의 충돌 전부다.
# 저장소와의 충돌은 기계 자리에 repo를 쓴다: --take repo:<경로>는 맥 값을, --pull repo:<경로>는 저장소 값을 남긴다.
# 범용 저장소는 HERDR_TOOLS_REPO (기본 ~/Documents/app/herdr-tools), 개인 저장소는 HERDR_TOOLS_CONFIG (기본 ~/.config/herdr-tools).
set -u
REPO=${HERDR_TOOLS_REPO:-$HOME/Documents/app/herdr-tools}
CONF=${HERDR_TOOLS_CONFIG:-$HOME/.config/herdr-tools}
STATE=$HOME/.local/state/herdr-sync
die() { echo "herdr-sync: $*" >&2; exit 1; }
usage() { sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# 맥 확인: Herdr 앱이 있고 hc가 다른 기계를 아는 곳. 워커 맥의 hc는 다른 기계를 모른다.
# (HERDR_SYNC_SYSAPPS는 시험용: /Applications 대신 볼 폴더)
all=$(hc machine ls 2> /dev/null | jq -r '.machines[].name' 2> /dev/null)
if { [ ! -d "$HOME/Applications/Herdr.app" ] && [ ! -d "${HERDR_SYNC_SYSAPPS:-/Applications}/Herdr.app" ]; } || [ -z "$all" ]; then
  echo "herdr-sync: 맥에서만 돈다 (~/Applications/Herdr.app 또는 /Applications/Herdr.app이 있고 hc machine ls에 기계가 있는 곳)" >&2
  exit 2
fi
mkdir -p "$STATE" || exit 1
if [ -z "${HERDR_SYNC_LOCKED-}" ]; then
  HERDR_SYNC_LOCKED=1 lockf -s -t 0 "$STATE/lock" "$0" "$@"
  rc=$?
  [ $rc = 75 ] && echo "herdr-sync: 다른 herdr-sync가 돌고 있다 ($STATE/lock)" >&2
  exit $rc
fi

check=0 takes="" pulls="" machines=""
while [ $# -gt 0 ]; do
  case $1 in
    --check) check=1 ;;
    --take | --pull)
      case ${2-} in *?:?*) ;; *) usage ;; esac
      if [ "$1" = --take ]; then takes="$takes $2"; else pulls="$pulls $2"; fi
      shift ;;
    -*) usage ;;
    *) machines="$machines $1" ;;
  esac
  shift
done
[ $check = 1 ] && [ -n "$takes$pulls" ] && { echo "herdr-sync: --check는 --take·--pull과 함께 쓰지 않는다" >&2; exit 2; }
[ -n "$machines" ] || machines=$all

# 기계마다(맥 포함) 도는 조각. POSIX sh(dash 포함)만 쓴다. 키는 sync.list의 맥 경로다.
#   q <키>… -- <지울 경로>… -- <나무 뿌리>… -- <제외>… -- <링크 대상>…
#                             키마다 "U 현재 base", 있는 지울 경로마다 "R 경로", 있는 링크 대상마다 "Y 경로",
#                             나무 안 파일마다 "F 경로 서명"(링크 "L", 7MB 넘음 "G"), 나무 안 base "B 경로 서명", 끝에 "H $HOME"·"O uname"
#   t <폴더> <머리> <제외 파일>   그 폴더를 나무로 걸어 F·L·G 줄 (경로는 <머리>/<상대 경로>)
#   r <키>                    값을 출력한다
#   w <키> <x|-> <값 서명> <시각>   표준 입력을 값으로 쓴다 (임시 파일 → 바꿔 넣기, 백업, base 갱신)
#   W <시각>                  나무 파일 여럿을 한 번에 쓴다. 표준 입력 = 「키 x 서명 원본」 줄들, 「.」 줄, 원본들의 tar
#   T                         표준 입력의 키(한 줄에 하나)들을 tar로 낸다
#   d <경로> <시각>           백업 폴더로 옮긴다      l <키> <대상>   없으면 심볼릭 링크를 만든다 (대상이 없으면 종료 3)
#   B                         표준 입력의 「키 서명」 줄들로 base만 고친다
# 서명은 "crc.크기.x|-", 없으면 -, 지침 본문 표식이 없으면 !, Codex 지침 파일이 없으면 ~, 그 파일에 codex-shared 표식 한 쌍이 없으면 ?다.
# 링크는 readlink 값.
# base 파일은 HSB(기본 ~/.local/state/herdr-sync/base.tsv), HSB=-이면 base를 고치지 않는다.
IFS= read -r -d '' AGENT << 'EOF'
S=$HOME/.local/state/herdr-sync
B=${HSB:-$S/base.tsv}
T=$(mktemp -d "${TMPDIR:-/tmp}/herdr-sync.XXXXXX") || exit 1
G=$T
MARK='<!-- User customizations -->'
CS='<!-- codex-shared:start -->'
CE='<!-- codex-shared:end -->'
tab=$(printf '\t')
trap 'rm -rf "$T" "$G"' EXIT
trap 'exit 1' HUP INT TERM
at() { p=${1%%#*}; p=${p%@}; f=$HOME/$p; }
mark() { n=$(grep -n -x -F -- "$MARK" "$f" | head -n 1 | cut -d: -f1); [ -n "$n" ]; }
val() {
  at "$1"
  case $1 in
    *'#body') [ -f "$f" ] || return 1; mark || return 3; tail -n +"$((n + 1))" "$f" ;;
    *'#codex-shared') [ -f "$f" ] || return 4; grep -q -x -F -- "$CS" "$f" && grep -q -x -F -- "$CE" "$f" || return 5
      awk -v s="$CS" -v e="$CE" '$0==e{k=0} k; $0==s{k=1}' "$f" ;;
    *) [ -f "$f" ] || return 1; cat "$f" ;;
  esac
}
sum() { cksum < "$1" | awk '{print $1"."$2}'; }
sig() {
  case $1 in *@) at "$1"; if [ -L "$f" ]; then readlink "$f"; elif [ -e "$f" ]; then echo '!'; else echo -; fi; return ;; esac
  val "$1" > "$T/v"
  case $? in 0) ;; 3) echo '!'; return ;; 4) echo '~'; return ;; 5) echo '?'; return ;; *) echo -; return ;; esac
  x=-; case $1 in *'#'*) ;; *) [ -x "$f" ] && x=x ;; esac
  echo "$(sum "$T/v").$x"
}
bsig() { if [ -f "$B" ]; then awk -F'\t' -v k="$1" '$1==k{s=$2} END{print (s=="" ? "-" : s)}' "$B"; else echo -; fi; }
setbf() {   # setbf <파일>: 그 파일의 「키 서명」 줄들로 base를 한 번에 고친다
  [ "$B" = - ] && return 0
  [ -s "$1" ] || return 0
  mkdir -p "${B%/*}" && { [ -f "$B" ] || : > "$B"; } || return 1
  awk -F'\t' -v p="$1" 'BEGIN { while ((getline l < p) > 0) { sub(/\t.*/, "", l); v[l] = 1 } } !($1 in v)' "$B" > "$B.$$" \
    && cat "$1" >> "$B.$$" && mv -f "$B.$$" "$B" || { rm -f "$B.$$"; return 1; }
}
bak() { at "$1"; [ -f "$f" ] || return 0; o=$S/bak/$2/$p; mkdir -p "$(dirname "$o")" && cp -p "$f" "$o"; }
# 나무 걷기. 링크는 따라가지 않고(L로 알린다), 이름이 .으로 시작하는 것·__pycache__·node_modules와 제외 파일의 상대 경로는 들어가지 않는다.
# 7MB(512바이트 블록 14336개, hc exec 입출력 한도 8MB 아래 묶음 상한) 넘는 파일은 cksum하지 않고 G로 알린다. cksum·find는 폴더마다 몇 번만 돈다.
# ponytail: 이름에 탭·줄바꿈이 든 파일, 제외 경로의 glob 글자([*?)는 다루지 않는다
lt() {
  ld=$1 lp=$2 lx=$3
  if [ -L "$ld" ]; then printf 'L\t%s\n' "$lp"; return 0; fi
  [ -d "$ld" ] || return 0
  set -- \( -name '.*' -o -name __pycache__ -o -name node_modules
  if [ -f "$lx" ]; then while IFS= read -r e; do [ -n "$e" ] && set -- "$@" -o -path "./$e"; done < "$lx"; fi
  set -- "$@" \)
  ( cd "$ld" || exit 1
    find . ! -name . "$@" -prune -o -type l -exec printf 'L\t%s\n' {} + -o -type f -size +14336 -exec printf 'G\t%s\n' {} + \
      -o -type f -perm -100 -exec printf 'X\t%s\n' {} +
    find . ! -name . "$@" -prune -o -type f ! -size +14336 -exec cksum {} + ) |
    awk -v p="$lp" '
      /^[LGX]\t/ { t = substr($0, 1, 1); f = substr($0, 3) }
      !/^[LGX]\t/ { t = "F"; c = $1 "." $2; f = $0; sub(/^[^ ]+ [^ ]+ /, "", f) }
      { sub(/^\.\//, "", f); f = p "/" f
        if (t == "X") x[f] = 1; else if (t == "F") printf "F\t%s\t%s.%s\n", f, c, ((f in x) ? "x" : "-"); else printf "%s\t%s\n", t, f }'
}
q() {
  for s in k r t x y; do : > "$T/$s"; done
  s=k
  for a in "$@"; do
    if [ "$a" = -- ]; then case $s in k) s=r ;; r) s=t ;; t) s=x ;; x) s=y ;; esac; continue; fi
    printf '%s\n' "$a" >> "$T/$s"
  done
  while IFS= read -r a; do printf 'U\t%s\t%s\n' "$(sig "$a")" "$(bsig "$a")"; done < "$T/k"
  while IFS= read -r a; do if [ -e "$HOME/$a" ] || [ -L "$HOME/$a" ]; then printf 'R\t%s\n' "$a"; fi; done < "$T/r"
  while IFS= read -r a; do if [ -e "$HOME/$a" ]; then printf 'Y\t%s\n' "$a"; fi; done < "$T/y"
  while IFS= read -r a; do
    awk -v r="$a/" 'index($0, r) == 1 { print substr($0, length(r) + 1) }' "$T/x" > "$T/ex"
    lt "$HOME/$a" "$a" "$T/ex"
  done < "$T/t"
  if [ -s "$T/t" ] && [ -f "$B" ]; then
    awk -F'\t' -v t="$T/t" 'BEGIN { while ((getline l < t) > 0) r[l "/"] = 1 } { for (p in r) if (index($1, p) == 1) { print "B\t" $0; next } }' "$B"
  fi
  printf 'H\t%s\nO\t%s\n' "$HOME" "$(uname -s)"
}
W() {   # 받은 원본을 같은 파일 시스템의 임시 폴더에 풀고, cksum이 맞는 것만 백업한 뒤 바꿔 넣는다. 키마다 「W 키」 또는 「E 키 까닭」
  for o in "$S"/w.*; do   # hc --timeout이 KILL로 끝낸 지난 W가 남긴 임시 폴더 (그 pid가 이제 없으면)
    [ -d "$o" ] && ! kill -0 "${o##*.}" 2> /dev/null && rm -rf "$o"
  done
  G=$S/w.$$
  rm -rf "$G" && mkdir -p "$G" || return 1
  : > "$T/m"
  l=
  while IFS= read -r l; do [ "$l" = . ] && break; printf '%s\n' "$l" >> "$T/m"; done
  [ "$l" = . ] || { echo "받은 내용이 깨졌다: 목록" >&2; return 1; }
  tar -xf - -C "$G" 2> "$T/te" || sed 's/^/tar: /' "$T/te" >&2   # 일부만 풀렸어도 아래 cksum이 가른다
  (cd "$G" && find . -type f -exec cksum {} +) | awk '{ c = $1 "." $2; sub(/^[^ ]+ [^ ]+ \.\//, ""); print $0 "\t" c }' > "$T/s"
  awk -F'\t' -v s="$T/s" 'BEGIN { while ((getline l < s) > 0) { n = split(l, a, "\t"); h[a[1]] = a[n] } }
    { w = $3; sub(/\.[^.]*$/, "", w); print ((($4 in h) && h[$4] == w) ? "ok" : "bad") "\t" $0 }' "$T/m" > "$T/v2"
  : > "$T/p"
  while IFS=$tab read -r ok k x want src; do
    f=$HOME/$k
    if [ "$ok" != ok ]; then printf 'E\t%s\t받은 내용이 깨졌다\n' "$k"; continue; fi
    if [ -d "$f" ] && [ ! -L "$f" ]; then printf 'E\t%s\t그 자리에 폴더가 있다\n' "$k"; continue; fi
    g=$G/$src
    if [ "$x" = x ]; then [ -x "$g" ] || chmod +x "$g"; elif [ -x "$g" ]; then chmod a-x "$g"; fi
    [ -d "${f%/*}" ] || mkdir -p "${f%/*}" || { printf 'E\t%s\t폴더를 만들지 못했다\n' "$k"; continue; }
    if [ -f "$f" ]; then
      o=$S/bak/$1/$k
      { [ -d "${o%/*}" ] || mkdir -p "${o%/*}"; } && cp -p "$f" "$o" || { printf 'E\t%s\t백업하지 못했다\n' "$k"; continue; }
    fi
    mv -f "$g" "$f" || { printf 'E\t%s\t바꿔 넣지 못했다\n' "$k"; continue; }
    printf '%s\t%s\n' "$k" "$want" >> "$T/p"
    printf 'W\t%s\n' "$k"
  done < "$T/v2"
  setbf "$T/p"
}
T() {   # 있는 일반 파일만. bsdtar는 확장 속성을 빼고, 이름을 바이트 그대로 둔다(기본 꼴은 macOS에서 한글 이름을 NFD로 바꿔 푼다)
  while IFS= read -r k; do if [ -f "$HOME/$k" ]; then printf '%s\n' "$k"; fi; done > "$T/l"
  set --
  tar --version 2> /dev/null | grep -q bsdtar && set -- --no-xattrs --no-acls --no-mac-metadata --format=pax --options=hdrcharset=BINARY
  cd "$HOME" && COPYFILE_DISABLE=1 tar "$@" -cf - -T "$T/l"
}
w() {
  k=$1 x=$2 want=$3
  cat > "$T/c"
  [ "$(sum "$T/c")" = "${want%.*}" ] || { echo "받은 내용이 깨졌다: $k" >&2; return 1; }
  at "$k"
  t=$f.hsync.$$
  case $k in
    *'#body') [ -f "$f" ] && mark || return 3
      cp -p "$f" "$t" && { head -n "$n" "$f"; cat "$T/c"; } > "$t" ;;
    *'#codex-shared') [ -f "$f" ] || return 4
      if grep -q -x -F -- "$CS" "$f" && grep -q -x -F -- "$CE" "$f"; then
        cp -p "$f" "$t" && awk -v body="$T/c" -v s="$CS" -v e="$CE" '$0==s{print; while ((getline l < body) > 0) print l; skip=1; next} $0==e{skip=0} !skip' "$f" > "$t"
      else
        cp -p "$f" "$t" && awk '/^<!-- codebase-memory-mcp:start -->$/{k=1} k{print} /^<!-- codebase-memory-mcp:end -->$/{k=0}' "$f" > "$t" \
          && { [ ! -s "$t" ] || echo >> "$t"; } && { echo "$CS"; cat "$T/c"; echo "$CE"; } >> "$t"
      fi ;;
    *) mkdir -p "$(dirname "$f")" && cat "$T/c" > "$t" && if [ "$x" = x ]; then chmod +x "$t"; else chmod a-x "$t"; fi ;;
  esac || { rm -f "$t"; return 1; }
  bak "$k" "$4" || { rm -f "$t"; return 1; }
  if [ -L "$f" ]; then cat "$t" > "$f" && rm -f "$t"; else mv -f "$t" "$f"; fi && printf '%s\t%s\n' "$k" "$want" > "$T/p" && setbf "$T/p"
}
d() { at "$1"; { [ -e "$f" ] || [ -L "$f" ]; } || return 0; o=$S/bak/$2/$p; mkdir -p "$(dirname "$o")" && mv "$f" "$o"; }
l() { at "$1"; { [ -e "$f" ] || [ -L "$f" ]; } && return 1; [ -e "$HOME/$2" ] || return 3; mkdir -p "$(dirname "$f")" && ln -s "$HOME/$2" "$f"; }
op=$1; shift
case $op in
  q) q "$@" ;; t) lt "$@" ;; r) val "$1" ;; w) w "$@" ;; W) W "$@" ;; T) T ;; d) d "$@" ;; l) l "$@" ;; B) cat > "$T/p" && setbf "$T/p" ;; *) exit 2 ;;
esac
EOF

# 개인 저장소가 없으면 아무것도 쓰지 않고 멈춘다 (범용 저장소 pull도 하지 않는다)
[ -f "$CONF/sync.list" ] || { echo "herdr-sync: 개인 저장소가 없다: $CONF (sync.list·settings/keys.json, 꼴은 범용 저장소 config.example 참고)" >&2; exit 2; }
ready() {   # ready <저장소>: git·main·깨끗함 확인 뒤 pull --ff-only
  git -C "$1" rev-parse --git-dir > /dev/null 2>&1 || die "저장소가 없다: $1"
  [ "$(git -C "$1" symbolic-ref --short HEAD 2> /dev/null)" = main ] || die "저장소가 main 브랜치가 아니다: $1"
  [ -z "$(git -C "$1" status --porcelain)" ] || die "저장소에 커밋하지 않은 변경이 있다. 커밋하거나 되돌린 뒤 다시: $1"
  git -C "$1" pull -q --ff-only || die "git pull --ff-only 실패: $1 (지난번 push 못 한 커밋이 있으면 거기서 git pull --rebase 뒤 HERDR_LAND=1 git push origin HEAD:main)"
}
ready "$REPO"
ready "$CONF"
STAMP=$(date +%Y%m%d-%H%M%S)
TMP=$(mktemp -d "${TMPDIR:-/tmp}/herdr-sync.XXXXXX") || exit 1
trap 'rm -rf "$TMP"' EXIT

# sync.list → 단위 배열 UB(묶음) UK(맥 경로) UR(저장소 경로·링크 대상) UD(저장소 폴더) UT(대상) UTR(나무 파일이면 1) UTJ(나무 번호),
# 지울 것 RMK·RMT, 제외 EXK. 저장소 경로가 tools:<경로>면 범용 저장소, 그 밖은 개인 저장소다.
UB=() UK=() UR=() UD=() UT=() UTR=() UTJ=() RMK=() RMT=() EXK=() TLB=() TLK=() TLR=() TLD=() TLT=() n=0
add() { UB[n]=$1 UK[n]=$2 UR[n]=$3 UD[n]=$4 UT[n]=$5 UTR[n]=${6:-0} UTJ[n]=${7:--1}; n=$((n + 1)); }
names() { (cd "$1" 2> /dev/null && for f in $2; do [ -f "$f" ] && echo "$f"; done); }
while read -r b k r t _; do
  case $b in '' | '#'*) continue ;; esac
  [ -n "${t-}" ] || die "sync.list 줄에 칸이 모자란다: $b $k"
  for o in ${t//,/ }; do
    case $o in all9 | mac7 | mac-only)
      case $o in all9) w=all ;; mac7) w=macos ;; *) w=local ;; esac
      echo "herdr-sync: 옛 묶음 이름 ${o} — ${w}로 바꾼다 ($CONF/sync.list: $b $k)" >&2; exit 2 ;;
    esac
  done
  if [ "$b" = 지움 ]; then RMK+=("$k") RMT+=("$t"); continue; fi
  if [ "$b" = 제외 ]; then EXK+=("${k%/}"); continue; fi
  d=$CONF; case $r in tools:*) d=$REPO r=${r#tools:} ;; esac
  case $k in
    */'**') TLB+=("$b") TLK+=("${k%/\*\*}") TLR+=("${r%/}") TLD+=("$d") TLT+=("$t") ;;
    *'*'*) for f in $({ names "$HOME/${k%/*}" "${k##*/}"; names "$d/$r" "${k##*/}"; } | sort -u); do add "$b" "${k%/*}/$f" "${r%/}/$f" "$d" "$t"; done ;;
    *) add "$b" "$k" "$r" "$d" "$t" ;;
  esac
done < "$CONF/sync.list"
# 나무 줄 → 맥과 저장소에 있는 파일 하나하나를 단위로. 따로 적은 줄·앞 나무 줄이 이미 맡은 경로는 건너뛴다.
# 맥이나 저장소 쪽이 7MB 넘으면 단위로 삼지 않는다. 뿌리가 제외 아래면 나무 전체를 뺀다.
# TRK(뿌리) TRD(저장소 폴더) TRR(저장소 안 뿌리) TRX(뿌리 아래 상대 제외 경로 파일)
TRK=() TRD=() TRR=() TRX=()
for ((i = 0; i < n; i++)); do printf '%s\n' "${UK[i]}"; done > "$TMP/seen"
for ((j = 0; j < ${#TLK[@]}; j++)); do
  root=${TLK[j]} out=0
  for e in ${EXK[@]+"${EXK[@]}"}; do case $root in "$e" | "$e"/*) out=1 ;; esac; done
  [ $out = 1 ] && continue
  jt=${#TRK[@]} ex=$TMP/ex${#TRK[@]}
  printf '%s\n' ${EXK[@]+"${EXK[@]}"} | awk -v r="$root/" 'index($0, r) == 1 { print substr($0, length(r) + 1) }' > "$ex"
  TRK+=("$root") TRD+=("${TLD[j]}") TRR+=("${TLR[j]}") TRX+=("$ex")
  { sh -c "$AGENT" _ t "$HOME/$root" "$root" "$ex" && sh -c "$AGENT" _ t "${TLD[j]}/${TLR[j]}" "$root" "$ex"; } > "$TMP/tl" || die "나무를 읽지 못했다: $root"
  awk -F'\t' '$1 == "G" && !s[$2]++ { print "건너뜀 " $2 " (7MB 넘음)" }' "$TMP/tl"
  awk -F'\t' -v sf="$TMP/seen" 'BEGIN { while ((getline l < sf) > 0) seen[l] = 1 }
    $1 == "G" { big[$2] = 1 } $1 == "F" && !($2 in seen) && !($2 in got) { got[$2] = 1; k[++nk] = $2 }
    END { for (i = 1; i <= nk; i++) if (!(k[i] in big)) print k[i] }' "$TMP/tl" | sort > "$TMP/tk"
  # 저장소 .gitignore에 걸리는 것은 맥·저장소·기계 모두에서 뺀다 (모을 수 없으니 한쪽만 「없음」으로 보이지 않게). 나무마다 한 번
  if [ -s "$TMP/tk" ]; then
    awk -v r="$root/" -v rr="${TLR[j]}/" '{ print rr substr($0, length(r) + 1) }' "$TMP/tk" | tr '\n' '\0' \
      | git -C "${TLD[j]}" check-ignore -z --stdin | tr '\0' '\n' > "$TMP/ti"
    case ${PIPESTATUS[2]} in 0 | 1) ;; *) die "git check-ignore 실패: ${TLD[j]}" ;; esac
    awk -v r="$root/" -v rr="${TLR[j]}/" -v f="$TMP/ti" -v o="$TMP/tk2" 'BEGIN { while ((getline l < f) > 0) ig[l] = 1 }
      { if ((rr substr($0, length(r) + 1)) in ig) print "건너뜀 " $0 " (저장소 .gitignore)"; else print > o }' "$TMP/tk"
    if [ -f "$TMP/tk2" ]; then mv -f "$TMP/tk2" "$TMP/tk"; else : > "$TMP/tk"; fi
  fi
  while IFS= read -r k; do add "${TLB[j]}" "$k" "${TLR[j]}/${k#"$root"/}" "${TLD[j]}" "${TLT[j]}" 1 "$jt"; done < "$TMP/tk"
  cat "$TMP/tk" >> "$TMP/seen"
done
[ $n -gt 0 ] || [ ${#TRK[@]} -gt 0 ] || die "sync.list에 맞출 것이 없다"
# 단위 목록 파일(번호 키 나무)과, 조회에 넘길 따로 적은 키 PK·링크 대상 LKT, sync.list 꼴 저장소 경로 URL(tools:<경로> 또는 <경로>)
PK=() LKT=() URL=()
for ((i = 0; i < n; i++)); do
  printf '%s\t%s\t%s\n' "$i" "${UK[i]}" "${UTR[i]}"
  if [ "${UD[i]}" = "$REPO" ]; then URL[i]=tools:${UR[i]}; else URL[i]=${UR[i]}; fi
  [ "${UTR[i]}" = 1 ] && continue
  PK+=("${UK[i]}")
  case ${UK[i]} in *@) LKT+=("${UR[i]}") ;; esac
done > "$TMP/units"

unit() { local k; for k in ${UK[@]+"${UK[@]}"}; do [ "$k" = "$1" ] && return 0; done; return 1; }
treespec() { local r x; case $1 in */'**') r=${1%/\*\*}; for x in ${TRK[@]+"${TRK[@]}"}; do [ "$x" = "$r" ] && return 0; done ;; esac; return 1; }   # <뿌리>/**
KEYS=$CONF/settings/keys.json
setkey() { case $1 in hook:?*:?*) return 0 ;; esac; [ -f "$KEYS" ] && jq -e --arg k "$1" 'any((.values // [])[]; . == $k)' "$KEYS" > /dev/null; }
known() { [ "$1" = '*' ] || unit "$1" || treespec "$1" || setkey "$1"; }
for s in $takes $pulls; do known "${s#*:}" || die "sync.list에 없는 경로: $s"; done
spec() {   # spec <목록> <기계> <키>: 목록에 <기계>:<키>, <기계>:*, 또는 그 키를 담은 <기계>:<뿌리>/**가 있나
  local s r
  for s in $1; do
    case $s in
      "$2:$3" | "$2:*") return 0 ;;
      "$2:"*/'**') r=${s#"$2:"} && r=${r%/\*\*} && case $3 in "$r"/*) return 0 ;; esac ;;
    esac
  done
  return 1
}

# query mac | query on <기계>: 그 자리에서 q를 돌려 단위마다 QC(현재) QB(base) QL(덮은 링크), 있는 지울 경로 QRM·링크 대상 QY, QH QO를 채운다.
# 나무 파일은 F·L·G·B 줄을 단위 목록에 맞춘다: 없으면 -, 그 파일이나 위 폴더가 링크면 L(QL에 그 링크), 7MB 넘으면 G.
query() {
  local tag a b c i=0
  "$@" q ${PK[@]+"${PK[@]}"} -- ${RMK[@]+"${RMK[@]}"} -- ${TRK[@]+"${TRK[@]}"} -- ${EXK[@]+"${EXK[@]}"} -- ${LKT[@]+"${LKT[@]}"} > "$TMP/q" || return 1
  awk -F'\t' -v qf="$TMP/q" '
    BEGIN { while ((getline l < qf) > 0) { split(l, a, "\t")
        if (a[1] == "U") u[++nu] = a[2] "\t" a[3]; else if (a[1] == "F") f[a[2]] = a[3]; else if (a[1] == "L") lk[a[2]] = 1
        else if (a[1] == "G") g[a[2]] = 1; else if (a[1] == "B") b[a[2]] = a[3]; else print l } }
    $3 != 1 { print "U\t" u[++iu]; next }
    { k = $2; s = (k in f) ? f[k] : "-"; if (k in g) s = "G"; w = ""
      for (p = k; ; ) { if (p in lk) { s = "L"; w = p; break } if (p !~ /\//) break; sub(/\/[^\/]*$/, "", p) }
      print "U\t" s "\t" ((k in b) ? b[k] : "-") "\t" w }
    END { if (iu != nu) exit 3 }' "$TMP/units" > "$TMP/qa" || return 1
  QC=() QB=() QL=() QRM=" " QY=" " QH="" QO=""
  while IFS=$'\t' read -r tag a b c; do
    case $tag in U) QC[i]=$a QB[i]=$b QL[i]=$c; i=$((i + 1)) ;; R) QRM="$QRM$a " ;; Y) QY="$QY$a " ;; H) QH=$a ;; O) QO=$a ;; esac
  done < "$TMP/qa"
  [ $i = $n ] && [ -n "$QH" ]
}
mac() { HSB=$STATE/repo-base.tsv sh -c "$AGENT" _ "$@"; }      # 맥에서 돌리기 (base = 저장소와의 base)
on() { local m=$1; shift; hc exec --timeout 600 --on "$m" -- sh -c "$AGENT" _ "$@"; }
oni() { local m=$1; shift; hc exec -i --timeout 600 --on "$m" -- sh -c "$AGENT" _ "$@"; }
rsig() {   # rsig <저장소 파일 절대 경로> <키>: 서명 (맥 서명과 같은 꼴)
  local f=$1 x=-
  [ -f "$f" ] || { echo -; return; }
  case $2 in *'#'*) ;; *) [ -x "$f" ] && x=x ;; esac
  echo "$(cksum < "$f" | awk '{print $1"."$2}').$x"
}
rsigs() {   # RS[i] = 저장소 쪽 서명. 나무는 줄마다 한 번에 걷는다
  local i j l
  for ((j = 0; j < ${#TRK[@]}; j++)); do
    sh -c "$AGENT" _ t "${TRD[j]}/${TRR[j]}" "${TRK[j]}" "${TRX[j]}" || die "저장소 나무를 읽지 못했다: ${TRD[j]}/${TRR[j]}"
  done | awk -F'\t' '$1 == "F" { print $2 "\t" $3 }' > "$TMP/rk"
  RS=() i=0
  while IFS= read -r l; do RS[i]=$l; i=$((i + 1)); done < <(awk -F'\t' -v rf="$TMP/rk" '
    BEGIN { while ((getline l < rf) > 0) { split(l, a, "\t"); v[a[1]] = a[2] } } { print (($2 in v) ? v[$2] : "-") }' "$TMP/units")
  for ((i = 0; i < n; i++)); do [ "${UTR[i]}" = 1 ] || RS[i]=$(rsig "${UD[i]}/${UR[i]}" "${UK[i]}"); done
}
lines() { [ -f "$2" ] || set -- "$1" /dev/null; diff "$1" "$2" | grep -c '^[<>]'; }
targets() {   # targets <대상> <기계> <OS>
  case $1 in
    all) return 0 ;;
    macos) [ "$3" = Darwin ] ;;
    local) [ "$2" = 맥 ] ;;
    *) case ",$1," in *",$2,"*) return 0 ;; esac; return 1 ;;
  esac
}
# 맥 tar(bsdtar): 확장 속성·ACL·맥 메타데이터를 빼고, 이름을 바이트 그대로(hdrcharset=BINARY) 둔다.
# 기본 꼴이면 한글 이름이 NFD로 풀려(맥) 다른 파일이 되거나(리눅스) cksum 대조가 어긋난다.
TARC=(--no-xattrs --no-acls --no-mac-metadata --format=pax --options=hdrcharset=BINARY)
wpack() {   # wpack <폴더> <목록>: 에이전트 W의 입력 = 목록(키 x 서명 원본), 「.」 줄, <폴더> 아래 원본들의 tar
  cat "$2" && echo . && cut -f4 "$2" > "$2.src" && (cd "$1" && COPYFILE_DISABLE=1 tar "${TARC[@]}" -cf - -T "$2.src")
}
wres() {   # wres <목록> <W 출력>: 목록 줄마다 「ok 키」 또는 「fail 키 까닭」
  awk -F'\t' -v o="$2" 'BEGIN { while ((getline l < o) > 0) { split(l, a, "\t"); if (a[1] == "W") ok[a[2]] = 1; else if (a[1] == "E") why[a[2]] = a[3] } }
    { if ($1 in ok) print "ok\t" $1; else print "fail\t" $1 "\t" (($1 in why) ? why[$1] : "답이 없다") }' "$1"
}
# hc exec는 입력·출력을 8MB에서 자른다. 나무 파일을 보내고 받을 때는 7MB 아래 묶음 여러 번으로 나눈다(파일 하나 상한도 7MB).
CAP=7340032
chunks() {   # chunks <목록> <서명 칸>: 줄을 묶음 <목록>.1 …로 나누고(파일 크기+tar 머리 합이 7MB 아래, 묶음마다 적어도 한 줄) 묶음 수를 찍는다
  rm -f "$1".[0-9]*
  awk -F'\t' -v f="$2" -v o="$1" -v cap="$CAP" '{ split($f, a, "."); e = int((a[2] + 511) / 512) * 512 + 1536 + length($0) + 1
      if (c == 0 || u + e > cap) { if (c) close(o "." c); c++; u = 0 } u += e; print > (o "." c) } END { print c + 0 }' "$1"
}
undo() {   # undo <저장소> <이번에 쓴·스테이징한 경로 목록>: 모으다 실패하면 그 경로만 되돌린다. 다음 실행이 「커밋하지 않은 변경」으로 막히지 않게
  [ -s "$2" ] || return 0
  git -C "$1" --literal-pathspecs reset -q --pathspec-from-file="$2" > /dev/null 2>&1
  # 목록 안 경로만: 추적 파일은 HEAD 값으로, 새 파일은 지운다. 그 사이 남이 같은 저장소에 쓴 것은 건드리지 않는다
  git -C "$1" status --porcelain -z --untracked-files=all | tr '\0' '\n' > "$TMP/un"
  awk -v f="$2" 'BEGIN { while ((getline l < f) > 0) w[l] = 1 } (substr($0, 4) in w) && substr($0, 1, 2) != "??" { print substr($0, 4) }' "$TMP/un" > "$TMP/un.t"
  awk -v f="$2" 'BEGIN { while ((getline l < f) > 0) w[l] = 1 } (substr($0, 4) in w) && substr($0, 1, 2) == "??" { print substr($0, 4) }' "$TMP/un" > "$TMP/un.u"
  [ ! -s "$TMP/un.t" ] || git -C "$1" --literal-pathspecs checkout -q --pathspec-from-file="$TMP/un.t" > /dev/null 2>&1
  [ ! -s "$TMP/un.u" ] || (cd "$1" && tr '\n' '\0' < "$TMP/un.u" | xargs -0 rm -f)
}
mpath() { if [ "${UTR[$1]}" = 1 ]; then echo "$HOME/${UK[$1]}"; else macval "$1"; echo "$TMP/v$1"; fi; }   # 맥 값이 든 파일
macval() { [ -f "$TMP/v$1" ] || mac r "${UK[$1]}" > "$TMP/v$1"; }   # 맥 값 (단위 번호) → $TMP/v<번호>

rows="" rc=0
row() {   # row <이름> <다름 묶음 목록> <충돌 수>
  local d s
  d=$(printf '%s\n' $2 | awk 'NF && !seen[$0]++ {s = s (s == "" ? "" : "·") $0} END {print s}')
  s=""
  [ -n "$d" ] && s="다름 ($d)"
  [ "$3" -gt 0 ] && s="${s:+$s · }충돌 $3건"
  [ -n "$s" ] && rc=1
  rows="$rows$1: ${s:-같음}$RSUF"$'\n'
}
# --check의 맥 줄: 맥 ↔ 두 저장소의 방향. 맥이 뒤면 기계 줄 「같음」은 맥 옛 판과 같다는 뜻이라 RSUF를 붙인다
RBH=() RAH=() RSUF=""
few() { local s="${*:1:3}"; [ $# -gt 3 ] && s="$s …"; echo "$s"; }
macrow() {
  local s=""
  [ ${#RBH[@]} -gt 0 ] && s="저장소가 새로움 ${#RBH[@]}개 ($(few "${RBH[@]}")) — herdr-sync로 깐다"
  [ ${#RAH[@]} -gt 0 ] && s="${s:+$s · }저장소보다 새로움 ${#RAH[@]}개 ($(few "${RAH[@]}")) — 커밋 안 됨?"
  case " $rdiff " in *" 지움 "*) s="${s:+$s · }다름 (지움)" ;; esac
  [ $rconf -gt 0 ] && s="${s:+$s · }충돌 ${rconf}건"
  [ -n "$s" ] && rc=1
  rows="맥: ${s:-저장소와 같음}"$'\n'
}

# --pull <기계>:<경로|*|<뿌리>/**> — 그 기계 값을 맥 실제 파일로 가져온다 (저장소 쪽은 아래 repo_sync가 한다).
# 나무 파일은 그 기계에서 tar 한 묶음으로 받아 맥에 한 번에 쓴다.
for s in $pulls; do
  m=${s%%:*} k=${s#*:}
  case $k in *'#codex-shared') die "Codex 구역은 맥 지침에서 다시 만드므로 --pull을 받지 않는다. --take를 쓴다: $s" ;; esac
  [ "$m" = repo ] && continue
  [ "$k" = '*' ] || unit "$k" || treespec "$k" || die "설정 키는 --pull을 받지 않는다. 맥 settings.json을 고친 뒤 --take를 쓴다: $s"
  query mac || die "맥 값을 읽지 못했다"
  MS=("${QC[@]}")
  query on "$m" || die "$m 연결 실패"
  got=0
  : > "$TMP/pl"
  for ((i = 0; i < n; i++)); do
    c=${QC[i]}
    targets "${UT[i]}" "$m" "$QO" || continue
    case ${UK[i]} in *@ | *'#codex-shared') continue ;; esac   # Codex 구역은 맥에서 다시 만들므로 가져오지 않는다
    case $c in - | '!' | '~' | '?' | L | G) continue ;; esac
    case ${MS[i]} in L | G) continue ;; esac
    case $k in
      '*' | */'**') spec "$s" "$m" "${UK[i]}" && [ "${MS[i]}" != - ] && [ "$c" != "${MS[i]}" ] && [ "$c" != "${QB[i]}" ] || continue ;;   # 표에 충돌로 보인 것만
      *) [ "$k" = "${UK[i]}" ] || continue ;;
    esac
    if [ "${UTR[i]}" = 1 ]; then printf '%s\t%s\t%s\t%s\n' "${UK[i]}" "${c##*.}" "$c" "${UK[i]}" >> "$TMP/pl"; continue; fi
    on "$m" r "${UK[i]}" > "$TMP/pull" && HSB=- sh -c "$AGENT" _ w "${UK[i]}" "${c##*.}" "$c" "$STAMP" < "$TMP/pull" \
      || die "${m}에서 ${UK[i]}를 가져오지 못했다"
    echo "맥 가져옴 ${UK[i]} ($m)"
    got=$((got + 1))
  done
  if [ -s "$TMP/pl" ]; then
    : > "$TMP/wo"
    nc=$(chunks "$TMP/pl" 3)
    for ((c = 1; c <= nc; c++)); do
      cut -f1 "$TMP/pl.$c" > "$TMP/plk"
      { cat "$TMP/pl.$c"; echo .; oni "$m" T < "$TMP/plk"; } | HSB=- sh -c "$AGENT" _ W "$STAMP" >> "$TMP/wo"
    done
    wres "$TMP/pl" "$TMP/wo" > "$TMP/wr"
    bad=0
    while IFS=$'\t' read -r st k why; do
      if [ "$st" = ok ]; then echo "맥 가져옴 $k ($m)"; got=$((got + 1)); else echo "herdr-sync: ${m}에서 ${k}를 가져오지 못했다 ($why)" >&2; bad=1; fi
    done < "$TMP/wr"
    [ $bad = 0 ] || exit 1
  fi
  [ $got -gt 0 ] || echo "herdr-sync: ${s}에 가져올 것이 없다" >&2
done

# 맥 ↔ 저장소 3-way. 모두 정한 뒤, 충돌이 하나라도 있으면 쓰지 않는다. 저장소는 줄마다 UD(범용 또는 개인)다.
# 범용 저장소로 모을 맥 값에 개인 값(herdr-tools-config lint, 패턴은 개인 저장소 private-patterns.txt)이 있으면 충돌이다.
rdiff="" rconf=0
leak() {   # leak <단위 번호>: 범용 저장소로 모을 맥 값이 개인 값 검사에 걸리면(또는 검사를 못 하면) 참, 까닭은 why
  [ "${UD[$1]}" = "$REPO" ] || return 1
  why="개인 값 검사 못 함 — $CONF/private-patterns.txt에 패턴이 없다"   # 검사를 못 하면 모으지 않는다(fail-closed)
  grep -q -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$CONF/private-patterns.txt" 2> /dev/null || return 0
  why="개인 값 검사 못 함"
  mac r "${UK[$1]}" > "$TMP/leak" || return 0
  why="개인 값"
  HERDR_TOOLS_CONFIG=$CONF bash "$REPO/bin/herdr-tools-config" lint "$TMP/leak" > /dev/null 2>&1
  [ $? != 0 ]
}
tleaks() {   # 범용 저장소로 모을 수 있는 나무 파일을 개인 값 검사에 한 번에 넣는다. LK[i] = 걸린 까닭 (안 걸리면 비움)
  local i rc why files=()
  LK=()
  : > "$TMP/lc"
  for ((i = 0; i < n; i++)); do
    [ "${UTR[i]}" = 1 ] && [ "${UD[i]}" = "$REPO" ] || continue
    case ${QC[i]} in - | L | G) continue ;; esac
    [ "${QC[i]}" = "${RS[i]}" ] || { printf '%s\t%s\n' "$i" "${UK[i]}" >> "$TMP/lc"; files+=("${UK[i]}"); }
  done
  [ ${#files[@]} -gt 0 ] || return 0
  why="개인 값 검사 못 함 — $CONF/private-patterns.txt에 패턴이 없다"   # 검사를 못 하면 모으지 않는다(fail-closed)
  if grep -q -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$CONF/private-patterns.txt" 2> /dev/null; then
    (cd "$HOME" && HERDR_TOOLS_CONFIG=$CONF bash "$REPO/bin/herdr-tools-config" lint "${files[@]}") > "$TMP/lo" 2> /dev/null
    rc=$?
    case $rc in 0) return 0 ;; 1) why="개인 값" ;; *) why="개인 값 검사 못 함" ;; esac
  fi
  if [ "$why" = "개인 값" ]; then   # 걸린 줄은 「키:줄: 패턴」
    awk -F'\t' -v of="$TMP/lo" 'BEGIN { while ((getline l < of) > 0) o[++no] = l }
      { for (j = 1; j <= no; j++) if (index(o[j], $2 ":") == 1) { print; break } }' "$TMP/lc" > "$TMP/lc2" && mv -f "$TMP/lc2" "$TMP/lc"
  fi
  while IFS=$'\t' read -r i _; do LK[i]=$why; done < "$TMP/lc"
}
repo_sync() {
  local i j g k m r b d act why ctool="" cconf="" acts=() idx="" shown=$'\n' bad=0 l utool=1 uconf=1 RP=()
  query mac || die "맥 값을 읽지 못했다"
  rsigs
  tleaks
  # repo-base 셋째 칸 = 그 base를 적을 때의 저장소 경로. 줄을 옮겨(따로 적은 줄을 지움, 나무 저장소 폴더를 바꿈) 지금 경로와
  # 다르면 base 없음으로 본다: 새 자리에 저장소 파일이 없으면 「맥만 있음」 = 모음이 된다(맥 파일을 지우지 않는다). 옛 두 칸 줄은 그대로 믿는다
  i=0
  while IFS= read -r l; do RP[i]=$l; i=$((i + 1)); done < <(awk -F'\t' -v bf="$STATE/repo-base.tsv" '
    BEGIN { while ((getline l < bf) > 0) { n = split(l, a, "\t"); if (n >= 3) p[a[1]] = a[3]; else delete p[a[1]] } }
    { print (($2 in p) ? p[$2] : "") }' "$TMP/units")
  : > "$TMP/rbp"; : > "$TMP/rbp2"
  for ((i = 0; i < n; i++)); do
    k=${UK[i]} m=${QC[i]} b=${QB[i]} act="" why=""
    [ -z "${RP[i]}" ] || [ "${RP[i]}" = "${URL[i]}" ] || b=-
    case $k in *@) continue ;; esac
    case $m in
      '!') die "맥 ~/${k%%#*}에 '<!-- User customizations -->' 줄이 없다" ;;
      '~' | '?') continue ;;   # 맥에 Codex 지침이나 그 표식이 없다
      L) case $shown in *$'\n'"${QL[i]}"$'\n'*) ;; *) echo "건너뜀 맥 ${QL[i]} (링크 — 따라가지 않음)"; shown="$shown${QL[i]}"$'\n' ;; esac; continue ;;
      G) echo "건너뜀 $k (7MB 넘음)"; continue ;;
    esac
    r=${RS[i]}
    if [ "$m" = "$r" ]; then [ "$b" = "$m" ] && [ "${RP[i]}" = "${URL[i]}" ] || printf '%s\t%s\t%s\n' "$k" "$m" "${URL[i]}" >> "$TMP/rbp"; continue; fi
    if spec "$takes" repo "$k"; then act=모음
    elif spec "$pulls" repo "$k"; then act=깖
    elif [ "$r" = "$b" ]; then act=모음
    elif [ "$m" = "$b" ]; then act=깖; fi
    case $act$r in 깖-) case $k in *'#'*) act="" ;; esac ;; esac   # 구역 파일이 저장소에서 지워졌으면 충돌로
    # 옛 두 칸 base(경로를 모름)에서 저장소 쪽이 없으면, 정말 지운 것인지 줄을 옮긴 것인지 모르니 맥 파일을 지우지 않고 멈춘다
    if [ "$act$r" = 깖- ] && [ -z "${RP[i]}" ] && ! spec "$pulls" repo "$k"; then act="" why="저장소에 없음 — 옛 base라 지운 것인지 모른다"; fi
    if [ "$act" = 모음 ] && [ "$m" != - ]; then
      if [ "${UTR[i]}" = 1 ]; then [ -z "${LK[i]-}" ] || { why=${LK[i]}; act=""; }
      elif leak "$i"; then act=""; fi
    fi
    if [ -z "$act" ]; then
      [ -n "$why" ] || why="$(lines "$(mpath "$i")" "${UD[i]}/${UR[i]}")줄 다름"
      echo "충돌 저장소 $k ($why)"
      rconf=$((rconf + 1))
      continue
    fi
    acts[i]=$act idx="$idx $i"
    rdiff="$rdiff ${UB[i]}"
  done
  if [ $check = 1 ]; then   # 깖 = 저장소가 새로움(RBH), 모음 = 맥이 새로움(RAH). 맥 줄과 기계 줄 끝 표시에 쓴다
    for i in $idx; do
      if [ "${acts[i]}" = 깖 ]; then RBH+=("${UR[i]}"); else RAH+=("${UR[i]}"); fi
      if [ "${acts[i]}${RS[i]}" = 깖- ]; then echo "저장소 다름:지움 ${UK[i]}"; else echo "저장소 다름:${acts[i]} ${UK[i]}"; fi
    done
    return 0
  fi
  [ $rconf -gt 0 ] && { row 맥 "$rdiff" $rconf; printf '%s' "$rows"; echo "herdr-sync: 저장소와 충돌이 있어 멈춘다. --take repo:<경로>(맥 값) 또는 --pull repo:<경로>(저장소 값)로 푼다. 개인 값이면 맥 파일에서 빼거나 그 줄을 개인 저장소로 옮긴다" >&2; exit 1; }
  # 모음을 먼저 커밋·push하고 base를 쓴 뒤에 깐다. 깔다 멈춰도 모은 것이 스테이징에만 남지 않는다.
  # 나무 파일은 나무마다 tar 한 묶음으로 옮기고(실행 권한 포함) git add·rm도 한 번씩 한다.
  # 쓰기·스테이징·커밋이 실패하면 그 저장소에서 이번에 한 것을 되돌리고(undo) 멈춘다. 「맥 모음」 줄은 그 저장소 커밋이 된 뒤에 찍는다.
  : > "$TMP/st.tool"; : > "$TMP/st.conf"; : > "$TMP/mm.tool"; : > "$TMP/mm.conf"
  bail() { [ $utool = 0 ] || undo "$REPO" "$TMP/st.tool"; [ $uconf = 0 ] || undo "$CONF" "$TMP/st.conf"; die "$1"; }
  for ((j = 0; j < ${#TRK[@]}; j++)); do : > "$TMP/mc$j"; : > "$TMP/mr$j"; done
  for i in $idx; do
    [ "${acts[i]}" = 모음 ] || continue
    k=${UK[i]} m=${QC[i]} d=${UD[i]} r=${UD[i]}/${UR[i]} j=${UTJ[i]} g=conf
    [ "$d" = "$REPO" ] && g=tool
    if [ "${UTR[i]}" = 1 ]; then
      if [ "$m" = - ]; then printf '%s\n' "${UR[i]}" >> "$TMP/mr$j"; else printf '%s\n' "${k#"${TRK[j]}"/}" >> "$TMP/mc$j"; fi
    else
      printf '%s\n' "${UR[i]}" >> "$TMP/st.$g"
      if [ "$m" = - ]; then git -C "$d" rm -q -- "${UR[i]}" || bail "git rm 실패: $r"
      else
        mkdir -p "$(dirname "$r")" && mac r "$k" > "$r.hsync.$$" \
          && if [ "${m##*.}" = x ]; then chmod +x "$r.hsync.$$"; else chmod a-x "$r.hsync.$$"; fi \
          && mv -f "$r.hsync.$$" "$r" && git -C "$d" add -- "${UR[i]}" || { rm -f "$r.hsync.$$"; bail "저장소에 쓰지 못했다: $r"; }
      fi
      if [ $g = tool ]; then ctool="$ctool ${UR[i]}"; else cconf="$cconf ${UR[i]}"; fi
    fi
    printf '%s\t%s\t%s\n' "$k" "$m" "${URL[i]}" >> "$TMP/rbp"
    echo "맥 모음 $k" >> "$TMP/mm.$g"
  done
  for ((j = 0; j < ${#TRK[@]}; j++)); do
    [ -s "$TMP/mc$j" ] || [ -s "$TMP/mr$j" ] || continue
    d=${TRD[j]} r=${TRR[j]} g=conf
    [ "$d" = "$REPO" ] && g=tool
    awk -v r="$r/" '{ print r $0 }' "$TMP/mc$j" > "$TMP/ma"
    cat "$TMP/ma" "$TMP/mr$j" >> "$TMP/st.$g"
    if [ -s "$TMP/mc$j" ]; then
      mkdir -p "$d/$r" || bail "저장소에 쓰지 못했다: $d/$r"
      (cd "$HOME/${TRK[j]}" && COPYFILE_DISABLE=1 tar "${TARC[@]}" -cf - -T "$TMP/mc$j") | (cd "$d/$r" && tar -xf -)
      [ "${PIPESTATUS[*]}" = "0 0" ] || bail "저장소에 쓰지 못했다: $d/$r"
      git -C "$d" --literal-pathspecs add --pathspec-from-file="$TMP/ma" || bail "git add 실패: $d/$r"
    fi
    [ ! -s "$TMP/mr$j" ] || git -C "$d" --literal-pathspecs rm -q --pathspec-from-file="$TMP/mr$j" || bail "git rm 실패: $d/$r"
    if [ $g = tool ]; then ctool="$ctool $r"; else cconf="$cconf $r"; fi
  done
  # 저장소마다 따로 커밋·push한다. 지난번에 push하지 못한 커밋도 여기서 다시 보낸다.
  if [ -n "$ctool" ]; then
    git -C "$REPO" --literal-pathspecs commit -q -m "herdr-sync 모음:$ctool" -- $ctool || bail "커밋 실패: $REPO"
    utool=0; cat "$TMP/mm.tool"
  fi
  if [ -n "$cconf" ]; then
    git -C "$CONF" --literal-pathspecs commit -q -m "herdr-sync 모음:$cconf" -- $cconf || bail "커밋 실패: $CONF"
    uconf=0; cat "$TMP/mm.conf"
  fi
  for d in "$CONF" "$REPO"; do
    [ -z "$(git -C "$d" rev-list -1 origin/main..HEAD)" ] && continue
    HERDR_LAND=1 git -C "$d" push -q origin HEAD:main || die "push 실패: $d. 거기서 git pull --rebase 뒤 HERDR_LAND=1 git push origin HEAD:main"
  done
  [ ! -s "$TMP/rbp" ] || mac B < "$TMP/rbp" || die "저장소 base를 쓰지 못했다"
  # 깖: 나무 파일은 저장소마다 tar 한 묶음을 맥 W에 넘긴다
  : > "$TMP/kc0"; : > "$TMP/kc1"; : > "$TMP/kp0"; : > "$TMP/kp1"
  for i in $idx; do
    [ "${acts[i]}" = 깖 ] || continue
    k=${UK[i]} r=${RS[i]}
    [ "${UTR[i]}" = 1 ] || r=$(rsig "${UD[i]}/${UR[i]}" "$k")
    if [ "$r" = - ]; then
      mac d "$k" "$STAMP" || die "맥에서 지우지 못했다: $k"
      printf '%s\t-\t%s\n' "$k" "${URL[i]}" >> "$TMP/rbp2"
      echo "맥 지움 $k (저장소에서 지워짐)"
      continue
    elif [ "${UTR[i]}" = 1 ]; then
      g=0; [ "${UD[i]}" = "$REPO" ] && g=1
      printf '%s\t%s\t%s\t%s\n' "$k" "${r##*.}" "$r" "${UR[i]}" >> "$TMP/kc$g"
      printf '%s\t%s\t%s\n' "$k" "$r" "${URL[i]}" >> "$TMP/kp$g"
      continue
    else mac w "$k" "${r##*.}" "$r" "$STAMP" < "${UD[i]}/${UR[i]}" || die "맥에 깔지 못했다: $k"; fi
    printf '%s\t%s\t%s\n' "$k" "$r" "${URL[i]}" >> "$TMP/rbp2"
    echo "맥 깖 $k"
    [ "$k" = '.claude/CLAUDE.md#body' ] && body=1
  done
  for g in 0 1; do
    [ -s "$TMP/kc$g" ] || continue
    d=$CONF; [ $g = 1 ] && d=$REPO
    wpack "$d" "$TMP/kc$g" | mac W "$STAMP" > "$TMP/wo"
    wres "$TMP/kc$g" "$TMP/wo" > "$TMP/wr"
    while IFS=$'\t' read -r st k why; do
      if [ "$st" = ok ]; then echo "맥 깖 $k"; else echo "herdr-sync: 맥에 깔지 못했다: $k ($why)" >&2; bad=1; fi
    done < "$TMP/wr"
    awk -F'\t' -v w="$TMP/wr" 'BEGIN { while ((getline l < w) > 0) { split(l, a, "\t"); if (a[1] == "ok") ok[a[2]] = 1 } } $1 in ok' "$TMP/kp$g" >> "$TMP/rbp2"
  done
  [ ! -s "$TMP/rbp2" ] || mac B < "$TMP/rbp2" || die "저장소 base를 쓰지 못했다"   # 깐 것의 base에 저장소 경로를 함께
  [ $bad = 0 ] || exit 1
  rdiff=""
}
# 맞추기 전에 개인 설정 sync.prebuild를 sh -c로 돌린다(예: 맥 지침에서 Codex 공통 구역을 다시 만듦). 없으면 아무것도 안 한다.
# 저장소에서 지침 본문을 깔았으면 한 번 더 돌리고 모은다.
build() {
  local pre
  [ $check = 0 ] || return 0
  pre=$(HERDR_TOOLS_CONFIG=$CONF bash "$REPO/bin/herdr-tools-config" get sync.prebuild "") || die "개인 설정을 읽지 못했다: $CONF/config"
  [ -n "$pre" ] || return 0
  sh -c "$pre" > /dev/null || die "sync.prebuild 실패: $pre"
}
body=0
build
repo_sync
[ $body = 1 ] && build && repo_sync
[ ${#RBH[@]} -gt 0 ] && RSUF=" (맥 판 기준 — 저장소 새 판은 아직)"
query mac || die "맥 값을 읽지 못했다"
MS=("${QC[@]}") MRM=$QRM

SIN=""
sin() {   # 계약의 표준 입력. 기계마다 같다(예외 키·$HOME 바꿔 넣기는 herdr-settings-merge가 한다)
  local refs="{}" k c
  [ -n "$SIN" ] && return 0
  for k in $(jq -r '(.refs // [])[]' "$KEYS"); do
    c=$(printf '%s\n' "$(jq -cS "$k" "$HOME/.claude/settings.json")" | cksum | awk '{print $1, $2}')
    refs=$(jq -c --arg k "$k" --arg c "$c" '. + {($k): $c}' <<< "$refs") || return 1
  done
  SIN=$(jq -c --slurpfile k "$KEYS" --argjson refs "$refs" --arg home "$HOME" '
    $k[0] as $k | . as $s
    | {values: (reduce ($k.values // [])[] as $p ({}; . + {($p): ($s | getpath($p | ltrimstr(".") | split(".")))})),
       hooks: [($k.hooks // {}) | to_entries[] | .key as $ev | .value as $marks
         | $s.hooks[$ev][]? as $e | $e.hooks[]? | select(.command as $c | any($marks[]; . as $h | $c | contains($h)))
         | {event: $ev, matcher: ($e.matcher // "")} + .],
       refs: $refs, home: $home}' "$HOME/.claude/settings.json") && [ -n "$SIN" ]
}
settings() {   # settings <기계> — 대상 기계의 herdr-settings-merge에 넘기고 판정 줄을 옮긴다
  local m=$1 out opts="" s line r c0=$conf wrote=0
  [ -f "$KEYS" ] || return 0
  sin || { echo "herdr-sync: 설정 입력을 만들지 못했다 ($KEYS·~/.claude/settings.json)" >&2; sdiff=도구문제:설정; return; }
  [ $check = 1 ] && opts=--check
  for s in $takes; do
    case $s in "$m:*") opts="$opts --take *" ;; "$m:"*) unit "${s#"$m:"}" || treespec "${s#"$m:"}" || opts="$opts --take ${s#"$m:"}" ;; esac
  done
  set -f
  out=$(printf '%s\n' "$SIN" | hc exec -i --on "$m" -- env HERDR_MACHINE="$m" \
    sh -c 'x=$HOME/.local/bin/herdr-settings-merge; [ -x "$x" ] || exit 127; exec "$x" "$@"' _ $opts 2> "$TMP/serr")
  r=$?
  set +f
  while read -r s line; do
    case $s in
      충돌) echo "충돌 $m $line"; conf=$((conf + 1)) ;;
      씀) if [ $check = 1 ]; then echo "$m 다름 $line"; else echo "$m 씀 $line"; fi; wrote=1 ;;
      예외 | 참고) echo "$m $s $line" ;;
    esac
  done <<< "$out"
  [ $check = 1 ] && [ $wrote = 1 ] && sdiff=설정
  case $r in
    0) ;;
    1) # 충돌이 아니고, --check의 다름(표준 오류 없음)도 아니면 도구 문제
      if [ $conf -gt $c0 ]; then :; elif [ $check = 1 ] && [ $wrote = 1 ] && [ ! -s "$TMP/serr" ]; then :; else r=x; fi ;;
    127) echo "herdr-sync: ${m}에 ~/.local/bin/herdr-settings-merge가 없다 (설정을 맞추지 않음)" >&2; sdiff=도구문제:설정 ;;
    *) r=x ;;
  esac
  [ "$r" = x ] && sdiff=도구문제:설정
  [ -s "$TMP/serr" ] && sed "s/^/herdr-sync: $m: /" "$TMP/serr" >&2
  return 0
}

there() {   # there <~ 아래 경로>: 그 기계에 있거나, 이번에 그 아래에 쓸 파일이 있다 (링크 대상)
  case $QY in *" $1 "*) return 0 ;; esac
  awk -v t="$1" '$0 == t || index($0, t "/") == 1 { f = 1; exit } END { exit !f }' "$TMP/wk"
}
for m in $machines; do
  if ! query on "$m"; then echo "herdr-sync: $m 연결 실패" >&2; row "$m" 연결 0; continue; fi
  diffs="" conf=0 sdiff="" links="" shown=$'\n'
  : > "$TMP/bp"; : > "$TMP/wm"; : > "$TMP/wi"; : > "$TMP/cf"; : > "$TMP/wk"
  for ((i = 0; i < n; i++)); do
    targets "${UT[i]}" "$m" "$QO" || continue
    k=${UK[i]} mv=${MS[i]} c=${QC[i]} b=${QB[i]}
    case $k in *@) links="$links $i"; continue ;; esac   # 링크는 쓰기 뒤에 (가리킬 곳을 이번에 쓸 수 있다)
    case $mv in - | '~' | '?' | L | G) continue ;; esac   # 맥에 없는 것은 맞추지 않는다 (지울 것은 지움 줄로)
    case $c in
      '~') continue ;;              # Codex 지침이 없는 기계 (표식만 없으면 ?로 충돌, --take로 넣는다)
      '!') echo "herdr-sync: $m ~/${k%%#*}에 '<!-- User customizations -->' 줄이 없다" >&2; diffs="$diffs ${UB[i]}"; continue ;;
      L) case $shown in *$'\n'"${QL[i]}"$'\n'*) ;; *) echo "건너뜀 $m ${QL[i]} (링크 — 따라가지 않음)"; shown="$shown${QL[i]}"$'\n' ;; esac; continue ;;
      G) echo "건너뜀 $m $k (7MB 넘음)"; continue ;;
    esac
    if [ "$c" = "$mv" ]; then [ "$b" = "$mv" ] || printf '%s\t%s\n' "$k" "$mv" >> "$TMP/bp"; continue; fi
    # 3-way는 내용(crc.크기)으로 본다: 내용이 맥과 같고 실행 권한만 다르면 충돌이 아니라 씀이다
    if [ "${c%.*}" != "${mv%.*}" ] && [ "$c" != "$b" ] && ! spec "$takes" "$m" "$k"; then
      if [ "${UTR[i]}" = 1 ]; then printf '%s\t%s\n' "$k" "$c" >> "$TMP/cf"
      else
        macval "$i"
        on "$m" r "$k" > "$TMP/cur" 2> /dev/null
        echo "충돌 $m $k ($(lines "$TMP/v$i" "$TMP/cur")줄 다름)"
      fi
      conf=$((conf + 1))
      continue
    fi
    printf '%s\n' "$k" >> "$TMP/wk"
    if [ $check = 1 ]; then echo "$m 다름 $k"; diffs="$diffs ${UB[i]}"; continue; fi
    if [ "${UTR[i]}" = 1 ]; then printf '%s\t%s\t%s\t%s\n' "$k" "${mv##*.}" "$mv" "$k" >> "$TMP/wm"; printf '%s\n' "$i" >> "$TMP/wi"; continue; fi
    macval "$i"
    if oni "$m" w "$k" "${mv##*.}" "$mv" "$STAMP" < "$TMP/v$i" > /dev/null; then echo "$m 씀 $k"
    else echo "herdr-sync: $m $k 쓰기 실패" >&2; diffs="$diffs ${UB[i]}"; fi
  done
  # 나무 파일: 충돌 내용 읽기와 쓰기는 7MB 아래 묶음마다 hc 한 번 (파일 수가 아니라 바이트에 비례, 평소 한 번)
  if [ -s "$TMP/cf" ]; then
    rm -rf "$TMP/cur.d" && mkdir "$TMP/cur.d"
    nc=$(chunks "$TMP/cf" 2)
    for ((c = 1; c <= nc; c++)); do cut -f1 "$TMP/cf.$c" | oni "$m" T | (cd "$TMP/cur.d" && tar -xf - 2> /dev/null); done
    while IFS=$'\t' read -r k _; do echo "충돌 $m $k ($(lines "$HOME/$k" "$TMP/cur.d/$k")줄 다름)"; done < "$TMP/cf"
  fi
  if [ -s "$TMP/wm" ]; then
    : > "$TMP/wo"
    nc=$(chunks "$TMP/wm" 3)
    for ((c = 1; c <= nc; c++)); do wpack "$HOME" "$TMP/wm.$c" | oni "$m" W "$STAMP" >> "$TMP/wo"; done
    wres "$TMP/wm" "$TMP/wo" | paste "$TMP/wi" - > "$TMP/wr"
    while IFS=$'\t' read -r i st k why; do
      if [ "$st" = ok ]; then echo "$m 씀 $k"; else echo "herdr-sync: $m $k 쓰기 실패 ($why)" >&2; diffs="$diffs ${UB[i]}"; fi
    done < "$TMP/wr"
  fi
  for i in $links; do
    k=${UK[i]} c=${QC[i]} want=$QH/${UR[i]}
    [ "$c" = "$want" ] && continue
    if [ "$c" != - ] && ! spec "$takes" "$m" "$k"; then echo "충돌 $m $k (링크가 아니거나 다른 곳을 가리킨다: $c)"; conf=$((conf + 1)); continue; fi
    there "${UR[i]}" || { echo "건너뜀 $m $k (가리킬 곳 없음)"; continue; }
    if [ $check = 1 ]; then echo "$m 다름:링크 $k"; diffs="$diffs ${UB[i]}"; continue; fi
    if [ "$c" = - ] || on "$m" d "$k" "$STAMP" > /dev/null; then
      on "$m" l "$k" "${UR[i]}" > /dev/null
      case $? in
        0) echo "$m 씀 $k" ;;
        3) echo "건너뜀 $m $k (가리킬 곳 없음)" ;;
        *) echo "herdr-sync: $m $k 링크를 만들지 못했다" >&2; diffs="$diffs ${UB[i]}" ;;
      esac
    else echo "herdr-sync: $m $k 링크를 만들지 못했다" >&2; diffs="$diffs ${UB[i]}"; fi
  done
  [ $check = 1 ] || [ ! -s "$TMP/bp" ] || oni "$m" B < "$TMP/bp" > /dev/null || echo "herdr-sync: $m base를 쓰지 못했다" >&2
  settings "$m"
  diffs="$diffs $sdiff"
  for ((j = 0; j < ${#RMK[@]}; j++)); do
    targets "${RMT[j]}" "$m" "$QO" || continue
    case $QRM in *" ${RMK[j]} "*) ;; *) continue ;; esac
    if [ $check = 1 ]; then echo "$m 다름:지움 ${RMK[j]}"; diffs="$diffs 지움"
    elif on "$m" d "${RMK[j]}" "$STAMP" > /dev/null; then echo "$m 지움 ${RMK[j]}"
    else echo "herdr-sync: $m ${RMK[j]} 지우기 실패" >&2; diffs="$diffs 지움"; fi
  done
  row "$m" "$diffs" $conf
done

# 맥에서 지울 것 (지움 줄은 대상이 무엇이든 맥을 포함한다)
for ((j = 0; j < ${#RMK[@]}; j++)); do
  case $MRM in *" ${RMK[j]} "*) ;; *) continue ;; esac
  if [ $check = 1 ]; then echo "맥 다름:지움 ${RMK[j]}"; rdiff="$rdiff 지움"
  elif mac d "${RMK[j]}" "$STAMP"; then echo "맥 지움 ${RMK[j]}"
  else echo "herdr-sync: 맥 ${RMK[j]} 지우기 실패" >&2; rdiff="$rdiff 지움"; fi
done
saved=$rows rows=""
if [ $check = 1 ]; then macrow; else row 맥 "$rdiff" $rconf; fi
printf '%s%s' "$rows" "$saved"

# 다 맞춘 뒤, 설정 publish.repo가 있으면 범용 저장소를 공개 저장소로 내보낸다(herdr-tools-publish, 기록 없이·검사 뒤).
# 기계 맞추기와 별개라, 실패해도 크게 경고만 하고 종료 코드는 바꾸지 않는다.
if [ $check = 0 ]; then
  pubwarn() { printf '!!! herdr-sync: %s !!!\n' "$1" >&2; }
  if ! pub=$(HERDR_TOOLS_CONFIG=$CONF bash "$REPO/bin/herdr-tools-config" get publish.repo ""); then
    pubwarn "개인 설정을 읽지 못해 공개 저장소 내보내기를 건너뜀 ($CONF/config)"
  elif [ -n "$pub" ]; then
    HERDR_TOOLS_CONFIG=$CONF HERDR_TOOLS_REPO=$REPO bash "$REPO/bin/herdr-tools-publish" \
      || pubwarn "공개 저장소 내보내기 실패 (맞추기는 끝났다) — herdr-tools-publish 출력을 보고 고친 뒤 herdr-tools-publish를 다시"
  fi
fi
exit $rc
