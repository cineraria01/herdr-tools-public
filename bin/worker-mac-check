#!/bin/bash
# worker-mac-check: Go 판(cmd/worker-mac-check) 포장 (2026-11-21 사용자 「모두 고로 옮기고 싶어」) — 되돌리기 WORKER_MAC_CHECK_IMPL=bash(또는 HERDR_IMPL=bash)면 셸 판 lib/worker-mac-check/worker-mac-check.sh
s=$0; while [ -L "$s" ]; do l=$(readlink "$s"); case $l in /*) s=$l ;; *) s=$(dirname "$s")/$l ;; esac; done
d=$(cd "$(dirname "$s")" && pwd) || exit 1
if . "$d/../lib/go-run.sh" 2>/dev/null; then go_run worker-mac-check "$@" || exit
else echo "worker-mac-check: !!!!!! 경고: 공통 실행기를 못 읽었다($d/../lib/go-run.sh) — 셸 판으로 돈다 !!!!!!" >&2; fi
exec bash "$d/../lib/worker-mac-check/worker-mac-check.sh" "$@"
