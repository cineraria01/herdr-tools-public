#!/usr/bin/env python3
"""hc-sweep: Go 판(cmd/hc-sweep) 포장 (2026-11-21 사용자 「모두 고로 옮기고 싶어」) — 되돌리기 HC_SWEEP_IMPL=bash(또는 HERDR_IMPL=bash)면
셸 판 lib/hc-sweep/sweep.py. 하는 일·규칙은 lib/hc-sweep/sweep.py 머리글(두 판이 같다).
파이썬 파일인 까닭: 기계마다 launchd plist가 「python3 ~/.local/bin/hc-sweep」으로 부른다 — bash 포장이면 깔리는 순간 쓸기가 멈춘다.
그래서 공통 실행기(lib/go-run.sh, bash)를 bash로 부르고, 셸 판을 고르면 그 bash가 같은 파이썬으로 sweep.py를 돈다."""
import os
import sys

d = os.path.dirname(os.path.realpath(__file__))
os.execv("/bin/bash", ["bash", "-c", r'''
if . "$1/../lib/go-run.sh" 2>/dev/null; then HERDR_BIN_DIR=$1 go_run hc-sweep "${@:3}" || exit
else echo "hc-sweep: !!!!!! 경고: 공통 실행기를 못 읽었다($1/../lib/go-run.sh) — 셸 판으로 돈다 !!!!!!" >&2; fi
exec "$2" "$1/../lib/hc-sweep/sweep.py" "${@:3}"''', "hc-sweep", d, sys.executable or "python3"] + sys.argv[1:])
