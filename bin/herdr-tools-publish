#!/bin/bash
# herdr-tools-publish: 범용 저장소(비공개)의 origin/main 트리를 공개 저장소에 기록 없이 내보낸다.
#   herdr-tools-publish            검사 → 공개 main 위에 커밋 하나(「herdr-tools <sha> 내보냄」) → push
#   herdr-tools-publish --dry-run  바뀔 파일 목록과 검사 결과만 (push 없음, publish.dir을 만들지 않음)
# 비공개 커밋 메시지·작성자는 싣지 않는다. 공개 트리는 비공개 트리와 같은 객체다(attributes를 거치지 않음). 같으면 「같음」.
# 막기(fail-closed): 겹치는 경로(대소문자·정규화)나 글이 아닌 블롭(NUL·UTF-8 아님)이 있거나, 블롭 내용·경로·링크 대상·공개 커밋 작성자에 개인 값(herdr-tools-config lint)이나 비밀 꼴이 있거나,
# 검사를 못 하면 아무것도 push하지 않고 종료 1. 설정 키: publish.repo(없으면 종료 2)·publish.dir·publish.author·publish.secrets.
set -u
# Go 판(cmd/herdr-tools-publish)으로 exec — 되돌리기 HERDR_TOOLS_PUBLISH_IMPL=bash(또는 HERDR_IMPL=bash). 아래는 셸 판
# 공통 실행기(lib/go-run.sh)가 곁에 없으면(Go 소스를 안 깐 기계) 조용히 셸 판, IMPL=go로 못박았으면 종료 1
gr=$(dirname "$0")/../lib/go-run.sh
if [ -f "$gr" ]; then
  . "$gr" || exit 1
  go_run herdr-tools-publish "$@" || exit
elif [ "${HERDR_TOOLS_PUBLISH_IMPL:-${HERDR_IMPL:-auto}}" = go ]; then
  echo "herdr-tools-publish: Go 판을 쓸 수 없다 — 공통 실행기 없음: $gr" >&2; exit 1
fi
me=herdr-tools-publish
die() { echo "$me: $*" >&2; exit 1; }
REPO=${HERDR_TOOLS_REPO:-$HOME/Documents/app/herdr-tools}
CONF=${HERDR_TOOLS_CONFIG:-$HOME/.config/herdr-tools}
dry=0
case ${1-} in
  '') ;;
  --dry-run) dry=1 ;;
  *) sed -n '2,7s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
esac
# 공개 커밋 작성자는 명시값만: 부른 쪽 환경의 작성자 변수는 지우고, git이 호스트 이름으로 지어내지 못하게 한다(useConfigOnly).
# push·fetch가 인증 질문에서 멈추지 않게 한다(herdr-sync 끝에서 사람 없이 부른다)
unset GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_AUTHOR_DATE GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL GIT_COMMITTER_DATE EMAIL
export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND=${GIT_SSH_COMMAND:-ssh -o BatchMode=yes}
# replace ref(refs/replace/*)를 따르지 않는다: cat-file·ls-tree는 따르고 pack-objects는 안 따라 검사한 블롭과 옮기는 블롭이 달라진다
export GIT_NO_REPLACE_OBJECTS=1
tool=$(dirname "$0")/herdr-tools-config
[ -f "$tool" ] || die "검사 도구 없음: $tool (herdr-tools-config가 곁에 있어야 한다)"
cfg() { HERDR_TOOLS_CONFIG=$CONF bash "$tool" get "$@"; }
url=$(cfg publish.repo "") || die "설정을 읽지 못했다: $CONF/config"
[ -n "$url" ] || { echo "$me: 설정 없음 publish.repo ($CONF/config — 예: config.example/config)" >&2; exit 2; }
dir=$(cfg publish.dir "~/.local/share/herdr-tools/public") || die "설정을 읽지 못했다: $CONF/config"
author=$(cfg publish.author "") || die "설정을 읽지 못했다: $CONF/config"
extra=$(cfg publish.secrets "") || die "설정을 읽지 못했다: $CONF/config"
case $dir in "~") dir=$HOME ;; "~/"*) dir=$HOME/${dir#"~/"} ;; esac
if [ -n "$author" ]; then
  case $author in *' <'*'>') ;; *) die "publish.author 꼴: 이름 <메일>" ;; esac
  name=${author% <*} mail=${author##* <} mail=${mail%>}
  export GIT_AUTHOR_NAME=$name GIT_AUTHOR_EMAIL=$mail GIT_COMMITTER_NAME=$name GIT_COMMITTER_EMAIL=$mail
fi

git -C "$REPO" fetch -q origin main || die "fetch 실패: $REPO"
src=$(git -C "$REPO" rev-parse -q --verify 'refs/remotes/origin/main^{commit}')   # 전체 이름: 같은 이름의 로컬 가지·태그에 속지 않게
[ -n "$src" ] || die "origin/main 없음: $REPO"
tree=$(git -C "$REPO" rev-parse "$src^{tree}") || die "origin/main 트리를 읽지 못했다"
short=$(git -C "$REPO" rev-parse --short "$src")
T=$(mktemp -d "${TMPDIR:-/tmp}/$me.XXXXXX") || exit 1
trap 'rm -rf "$T"' EXIT

# 트리의 블롭마다 검사한다. 경로대로 디스크에 꺼내지 않는다 — macOS 디스크는 대소문자·유니코드 정규화를 구분하지 않아
# 경로가 겹치고(한쪽이 검사 없이 나감) 링크를 따라 바깥에 쓴다. 블롭은 $T/b/<sha>로만 꺼낸다: 검사한 바이트 = 공개로 가는 객체.
# 링크 블롭의 내용은 링크 대상 글자라 함께 검사된다.
# -t: 하위 트리 항목도 받아 그 이름을 검사한다(옮기는 트리 객체의 이름 전부 — 빈 하위 트리 이름은 -r만으로는 안 나온다).
# 받는 항목은 일반 파일·실행 파일·링크 블롭과 비어 있지 않은 하위 트리뿐이다. 빈 하위 트리·하위 모듈·낯선 mode는 막는다
git -C "$REPO" ls-tree -r -t -z --full-tree "$tree" > "$T/ls" || die "트리 목록을 읽지 못했다"
empty=$(git -C "$REPO" hash-object -t tree /dev/null) || exit 1
mkdir "$T/b" && : > "$T/map" || exit 1   # map 줄: 「sha<탭>경로」
masked() { printf '%s/(이름 가림)' "$(dirname -- "$1")"; }   # 이름이 곧 값일 수 있어 막을 때는 폴더만 찍는다
paths=() tpaths=() bad=0
while IFS= read -r -d '' ent; do
  path=${ent#*$'\t'}
  read -r mode type sha <<< "${ent%%$'\t'*}"
  case $path in *$'\n'*) die "줄바꿈이 든 경로는 내보내지 않는다" ;; esac
  case $mode:$type in
    100644:blob | 100755:blob | 120000:blob) ;;
    040000:tree)
      tpaths+=("$path")
      [ "$sha" = "$empty" ] && { echo "빈 하위 트리는 내보내지 않는다: $(masked "$path")"; bad=1; }
      continue ;;
    *) die "내보내지 않는 항목(mode $mode $type — 하위 모듈 등): $(masked "$path")" ;;
  esac
  [ -e "$T/b/$sha" ] || git -C "$REPO" cat-file blob "$sha" > "$T/b/$sha" || die "블롭을 꺼내지 못했다: $(masked "$path")"
  printf '%s\t%s\n' "$sha" "$path" >> "$T/map"
  paths+=("$path")
done < "$T/ls"
[ ${#paths[@]} -gt 0 ] || die "트리가 비었다"
printf '%s\n' "${paths[@]}" ${tpaths[@]+"${tpaths[@]}"} > "$T/names"   # 줄 i = 파일 경로, 그 뒤는 하위 트리 이름
# show <가림 0|1>: 검사 출력 「$T/b/<sha>:줄: 까닭」을 그 블롭의 경로들로, 「$T/names:줄: 까닭」을 경로(가림이면 폴더만)로 바꿔 찍는다
show() {
  awk -v b="$T/b/" -v nm="$T/names:" -v mask="$1" '
    FILENAME == ARGV[1] { t = index($0, "\t"); s = substr($0, 1, t - 1); p[s] = p[s] "\n" substr($0, t + 1); next }
    FILENAME == ARGV[2] { name[FNR] = $0; next }
    index($0, b) == 1 { r = substr($0, length(b) + 1); s = substr(r, 1, index(r, ":") - 1); rest = substr(r, length(s) + 1)
      n = split(substr(p[s], 2), ps, "\n"); for (k = 1; k <= n; k++) print ps[k] rest; next }
    index($0, nm) == 1 { r = substr($0, length(nm) + 1); l = substr(r, 1, index(r, ":") - 1); rest = substr(r, length(l) + 2)
      f = name[l + 0]
      if (mask) { d = f; if (!sub(/\/[^\/]*$/, "", d)) d = "."; f = d "/(이름 가림, " l "번째 파일)" }
      print f ":0:" rest " (경로)"; next }
    { print }' "$T/map" "$T/names" - | sort -u
}

# 검사 0: 겹치는 경로 — NFC·대소문자 접기로 같아지는 서로 다른 경로(폴더 포함)는 macOS 디스크에서 한 자리다
overlap=$(python3 -I -c '
import sys, unicodedata
seen, out = {}, []
for i, line in enumerate(sys.stdin.buffer.read().split(b"\n")[:-1], 1):
    parts = line.decode("utf-8", "surrogateescape").split("/")
    for k in range(1, len(parts) + 1):
        o = "/".join(parts[:k])
        j, prev = seen.setdefault(unicodedata.normalize("NFC", o).casefold(), (i, o))
        if prev != o:
            out.append("%d번째·%d번째 파일" % (j, i))
            break
print("\n".join(out))' < "$T/names") || die "경로 겹침 검사 못 함 (python3)"
if [ -n "$overlap" ]; then
  while IFS= read -r o; do echo "경로가 겹친다(대소문자·유니코드 정규화만 다름 — macOS에서 한 파일): $o"; done <<< "$overlap"
  bad=1
fi

# 검사 0-2: 글이 아닌 블롭 — NUL이 들었거나 UTF-8로 안 풀리는 블롭(UTF-16·압축·이미지 등)은 글자 검사가 속을 못 보니 내보내지 않는다.
# 범용 도구 저장소에 이진 파일은 없어야 정상이다(허용 목록 없음 — 필요해지면 그때 설정 키로)
nontext=$(python3 -I -c '
import sys
for f in sys.argv[1:]:
    d = open(f, "rb").read()
    try:
        d.decode("utf-8")
        ok = b"\0" not in d
    except UnicodeDecodeError:
        ok = False
    if not ok:
        print(f + ":0: 글이 아닌 블롭(NUL 또는 UTF-8 아님)은 내보내지 않는다")' "$T"/b/*) || die "글 검사 못 함 (python3)"
[ -n "$nontext" ] && { printf '%s\n' "$nontext" | show 0; bad=1; }

# 검사 1: 개인 값 — 블롭 내용(이진·UTF-8 아닌 것도 바이트로, 링크 대상 글자 포함)과 경로를 lint로
grep -q -v -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$CONF/private-patterns.txt" 2> /dev/null \
  || die "개인 값 검사 못 함 — $CONF/private-patterns.txt에 패턴이 없다"
lint() { HERDR_TOOLS_CONFIG=$CONF bash "$tool" lint "$@"; }
lint "$T"/b/* "$T/names" > "$T/lint"
case $? in 0) ;; 1) show 0 < "$T/lint"; bad=1 ;; *) die "개인 값 검사 못 함 (herdr-tools-config lint 실패)" ;; esac

# 검사 2: 비밀 꼴 — 범용 꼴(ERE) + 설정 publish.secrets(ERE 하나, 여러 꼴은 |로). 블롭 내용·경로를 바이트로
pats=('-----BEGIN[A-Z0-9 ]*PRIVATE KEY' 'gh[pousr]_[A-Za-z0-9]{30,}' 'github_pat_[A-Za-z0-9_]{30,}'
  '(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{30,}' 'xox[abprs]-[A-Za-z0-9-]{10,}' 'AKIA[0-9A-Z]{16}' 'AIza[0-9A-Za-z_-]{35}'
  '(^|[^0-9A-Fa-f])[0-9A-Fa-f]{40,}')
[ -n "$extra" ] && pats+=("$extra")
scan() {   # scan <파일>…: 걸린 곳마다 「파일:줄: 까닭」(값은 안 찍음), 못 읽으면 「!」 줄
  local p f l tok
  for p in "${pats[@]}"; do
    LC_ALL=C grep -naHE --null -e "$p" -- "$@" |
      while IFS= read -r -d '' f && IFS= read -r l; do printf '%s:%s: 비밀 꼴 %s\n' "$f" "${l%%:*}" "$p"; done
    [ "${PIPESTATUS[0]}" -le 1 ] || echo '!'
  done
  # 긴 base64 꼴 토큰: 32자 넘게 이어지고 대·소문자·숫자가 다 있음. 알파벳 목록(ABCDEFGH…·0123456789)은 뺀다
  LC_ALL=C grep -naHoE --null '[A-Za-z0-9+/=_-]{32,}' -- "$@" |
    while IFS= read -r -d '' f && IFS= read -r l; do
      tok=${l#*:}
      [[ $tok =~ [A-Z] && $tok =~ [a-z] && $tok =~ [0-9] && ! $tok =~ ABCDEFGH|abcdefgh|0123456789 ]] &&
        printf '%s:%s: 비밀 꼴 긴 토큰\n' "$f" "${l%%:*}"
    done
  [ "${PIPESTATUS[0]}" -le 1 ] || echo '!'
}
hits=$(scan "$T"/b/* "$T/names")
case $'\n'$hits$'\n' in *$'\n!\n'*) die "비밀 꼴 검사 못 함 (grep 실패)" ;; esac
[ -n "$hits" ] && { printf '%s\n' "$hits" | show 1; bad=1; }   # 경로가 걸리면 이름이 곧 값이라 가린다
blocked() { echo "$me: 막음 — 위 줄을 고치기 전에는 내보내지 않는다 (비공개 $short)" >&2; [ $dry = 1 ] || exit 1; }
[ $bad = 1 ] && blocked

# 공개 쪽 git 폴더(bare): 있으면 origin이 publish.repo인지 보고, 없으면 만든다.
# --dry-run은 아무것도 쓰지 않는다: 객체는 임시 bare에 받고, 작성자는 실제 폴더가 있으면 거기서 읽기만 한다
if [ -e "$dir" ]; then
  [ "$(git --git-dir="$dir" rev-parse --is-bare-repository 2> /dev/null)" = true ] || die "publish.dir이 bare git 저장소가 아니다: $dir"
  [ "$(git --git-dir="$dir" remote get-url origin 2> /dev/null)" = "$url" ] || die "publish.dir의 origin이 publish.repo와 다르다: $dir"
  idir=$dir
  [ $dry = 1 ] && dir=$T/public.git
else
  [ $dry = 1 ] && dir=$T/public.git
  idir=$dir
fi
if [ ! -e "$dir" ]; then
  mkdir -p "$(dirname "$dir")" && git init -q --bare "$dir" && git --git-dir="$dir" remote add origin "$url" || die "공개 clone을 만들지 못했다: $dir"
fi
g() { git -c user.useConfigOnly=true --git-dir="$dir" "$@"; }

# 검사 3: 공개 커밋 작성자·커미터 — 커밋을 만들 그 git 폴더에서 본다(publish.author, 없으면 그 폴더의 git 설정, 지어낸 값은 안 받음)
for v in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  id=$(git -c user.useConfigOnly=true --git-dir="$idir" var "$v" 2> /dev/null) || die "공개 커밋 작성자를 정하지 못했다 — 설정 publish.author(이름 <메일>)를 둔다"
  printf '%s\n' "${id% * *}" >> "$T/ident"
done
lint "$T/ident" > /dev/null
case $? in
  0) ;;
  1) echo "공개 커밋 작성자·커미터가 개인 값에 걸린다 — 설정 publish.author(이름 <noreply 메일>)를 둔다"; bad=1; blocked ;;
  *) die "개인 값 검사 못 함 (작성자)" ;;
esac
[ $bad = 0 ] && echo "검사 통과 (비공개 $short, 파일 ${#paths[@]}개)"
parent=$(g ls-remote "$url" refs/heads/main) || die "공개 저장소를 읽지 못했다: $url"
parent=${parent%%[[:space:]]*}
if [ -n "$parent" ]; then
  g fetch -q "$url" refs/heads/main || die "공개 저장소 fetch 실패: $url"
  ptree=$(g rev-parse "$parent^{tree}") || die "공개 main을 읽지 못했다"
else
  ptree=$(g hash-object -t tree /dev/null)
fi
if [ "$tree" = "$ptree" ]; then echo "같음 (비공개 $short)"; [ $bad = 1 ] && exit 1; exit 0; fi
# 트리·블롭 객체만 옮긴다(비공개 커밋 객체는 옮기지 않는다). 공개 트리 = 비공개 트리 sha
(set -o pipefail
  { echo "$tree"; tr '\0' '\n' < "$T/ls" | awk '{print $3}'; } | git -C "$REPO" pack-objects -q --stdout | g unpack-objects -q) \
  && g rev-list --objects "$tree" > /dev/null || die "트리 객체를 공개 쪽으로 옮기지 못했다"   # 검사한 목록 그대로, 블롭까지 있는지 확인
g diff-tree -r --name-status "$ptree" "$tree"
[ $dry = 1 ] && { [ $bad = 1 ] && exit 1; echo "(--dry-run: push 안 함)"; exit 0; }

commit=$(g commit-tree "$tree" ${parent:+-p "$parent"} -m "herdr-tools $short 내보냄") || die "커밋을 만들지 못했다"
g push -q "$url" "$commit:refs/heads/main" || die "push 실패: $url (fast-forward만 한다)"
g update-ref refs/heads/main "$commit"
echo "내보냄 $(g rev-parse --short "$commit") (비공개 $short → $url)"
